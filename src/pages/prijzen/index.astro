---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/pagina/Hero.astro';
import Bewijs from '../../components/pagina/Bewijs.astro';
import Faq from '../../components/pagina/Faq.astro';
import Actie from '../../components/pagina/Actie.astro';
import { diensten, type Pijler } from '../../data/diensten';
import { site } from '../../data/site';
import Prijslabel from '../../components/teken/Prijslabel.astro';
import Tekening from '../../components/teken/Tekening.astro';
import { perOnderwerp } from '../../data/tekeningen';
import PrijzenSamensteller from '../../components/tool/PrijzenSamensteller.astro';
import WieDoetHet from '../../components/pagina/WieDoetHet.astro';

const groepen: { pijler: Pijler; titel: string }[] = [
  { pijler: 'Gevonden', titel: 'Klanten vinden je in Google' },
  { pijler: 'Genoemd', titel: 'AI en klanten noemen je' },
  { pijler: 'Gekozen', titel: 'Je site maakt er een aanvraag van' },
  { pijler: 'Advies', titel: 'Alles in één hand, of eerst sparren' },
];
const schema = [{
  '@type': 'WebPage',
  dateModified: '2026-10-19',
  // Marktprijzen voor uitbesteden en uurtarieven in de tabel "Zo verhouden onze prijzen zich tot de markt" (opgehaald 19-10-2026).
  // De andere marktbedragen komen uit de kostengidsen waar de tabel naar linkt; daar staan hun bronnen.
  citation: ['https://roxtar.nl/wat-kost-een-online-marketing-bureau/'],
}, {
  '@type': 'OfferCatalog',
  name: 'Prijzen Drijfveer Media',
  url: `${site.url}/prijzen/`,
  itemListElement: diensten.filter((d) => d.prijsWaarde).map((d) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: d.naam, url: `${site.url}${d.url}` },
    priceCurrency: 'EUR',
    price: d.prijsWaarde,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: d.prijsWaarde,
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: false,
      ...(d.prijsEenheid === 'maand' ? { unitCode: 'MON', unitText: 'per maand' } : d.prijsEenheid === 'uur' ? { unitCode: 'HUR', unitText: 'per uur' } : d.prijsEenheid === 'pagina' ? { unitText: 'per pagina' } : { unitText: 'eenmalig' }),
    },
  })),
}];
---
<Base
  title="Prijzen online marketing: SEO, GEO, websites en Google Ads"
  description="Alle prijzen van Drijfveer Media op een rij: SEO vanaf € 495 per maand, lokale SEO vanaf € 295 en een website vanaf € 250. Zonder kleine lettertjes."
  kruimels={[{ naam: 'Prijzen', url: '/prijzen/' }]}
  schema={schema}
>
  <Hero kicker="Prijzen" titel="Prijzen: wat online marketing bij ons kost, per dienst">
    <p>Veel bureaus zetten hun prijzen niet online. Wij wel. Het zijn vanaf-prijzen, exclusief btw. Wat je precies betaalt, hoor je na een kort gesprek, en dat bedrag staat vast.</p>
    <Prijslabel slot="beeld" />
  </Hero>

  <section class="wrap sectie prijzen" data-aida="interest">
    <PrijzenSamensteller />
    <ul class="chips tabs" aria-label="Spring naar">
      {groepen.map((g) => <li><a href={`#${g.pijler.toLowerCase()}`} class="chip-link">{g.pijler === 'Advies' ? 'Uitbesteden' : g.pijler}</a></li>)}
    </ul>
    {groepen.map((g) => (
      <div class="groep" id={g.pijler.toLowerCase()}>
        <div class="stap-kop"><Tekening naam={perOnderwerp[g.pijler]} maat={52} /><h2>{g.pijler === 'Advies' ? 'Uitbesteden' : g.pijler}<span class="merk-punt">.</span> {g.titel}</h2></div>
        <ul class="lijst">
          {diensten.filter((d) => d.pijler === g.pijler).map((d) => (
            <li class:list={{ sub: !!d.ouder && diensten.find((x) => x.url === d.ouder)?.pijler === g.pijler }}>
              <a href={d.url}><b>{d.naam}</b><span class="muted">{d.kort}</span></a>
              <span class="prijs">{d.prijs}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="tekst" style="margin-top:56px">
      <h2>Wat kost een website laten maken?</h2>
      <p>Een website die we met AI bouwen en met de hand afmaken, begint bij € 250. Een maatwerk website in WordPress begint bij € 2.000. Waar je tussen die twee uitkomt, hangt af van drie dingen: hoeveel pagina's je nodig hebt, of wij de teksten schrijven en of er bijzondere functies in moeten, zoals een boekingssysteem of een koppeling met je software. Meer weten? Lees de gids <a href="/kennisbank/gidsen/wat-kost-een-website/">wat kost een website laten maken</a>.</p>

      <h2>Zo verhouden onze prijzen zich tot de markt</h2>
      <p>De marktbedragen komen uit openbare prijspagina's en prijsgidsen, opgehaald in oktober 2026. In de kostengids per dienst staat waar elk bedrag vandaan komt.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Dienst</th><th>Bij ons</th><th>Gangbaar in de markt</th><th>Kostengids</th></tr></thead>
          <tbody>
            <tr><td>SEO</td><td>vanaf € 495 p/m</td><td>€ 500 tot € 3.500 p/m</td><td><a href="/kennisbank/gidsen/wat-kost-seo/">Wat kost SEO?</a></td></tr>
            <tr><td>Lokale SEO</td><td>vanaf € 295 p/m</td><td>€ 300 tot € 1.000 p/m</td><td>Idem</td></tr>
            <tr><td>Website</td><td>€ 250 (met AI) tot € 2.000+ (maatwerk)</td><td>Freelancer € 500 tot € 4.000, bureau vanaf ongeveer € 3.500</td><td><a href="/kennisbank/gidsen/wat-kost-een-website/">Wat kost een website?</a></td></tr>
            <tr><td>Linkbuilding</td><td>€ 75 per uur, meestal 3 tot 5 links per uur</td><td>Bureau met maandpakket € 500 tot € 3.000 p/m</td><td><a href="/kennisbank/gidsen/wat-kost-linkbuilding/">Wat kost linkbuilding?</a></td></tr>
            <tr><td>Alles uitbesteden</td><td>vanaf € 595 p/m</td><td>Mkb vaak € 1.000 tot € 2.500 p/m</td><td>Prijsgids ROXTAR (bron onderaan)</td></tr>
            <tr><td>Uurtarief advies</td><td>Consult € 85, interim € 95</td><td>Bureau € 75 tot € 175, gemiddeld rond € 110</td><td>Idem</td></tr>
            <tr><td>Google Ads</td><td>beheer vanaf € 249 p/m, plus je budget</td><td>Klikprijzen per branche</td><td><a href="/kennisbank/gidsen/wat-kost-google-ads/">Wat kost Google Ads?</a></td></tr>
          </tbody>
        </table>
      </div>
      <p>Waarom we lager kunnen zitten: AI doet bij ons het rekenwerk en de eerste versies, en een mens controleert alles. Nieuwe technieken testen we eerst op onze eigen sites, dus je betaalt geen leergeld. En we zijn met z'n vieren, in een bedrijfsverzamelpand in Assen, zonder accountmanagers.</p>

      <h2>Wat er altijd bij zit</h2>
      <ul class="vink">
        <li>Een vast aanspreekpunt dat je binnen 15 minuten terugbelt, op werkdagen tussen 8.00 en 17.00 uur.</li>
        <li>Elke maand één A4: wat we deden, wat het opleverde en wat we nu doen.</li>
        <li>Maandelijkse diensten zeg je per maand op, met één maand opzegtermijn, per e-mail.</li>
        <li>Bij maandelijkse diensten een doel waar je ons op mag afrekenen, met <a href="/garantie/">onze garantie</a> erbij. Bij eenmalig werk een vaste prijs vooraf.</li>
      </ul>
      <p>Twijfel je? Lees <a href="/veelgestelde-vragen/">alle vragen over prijzen en afspraken</a>, of begin met een <a href="/gratis-website-analyse/">gratis scan</a> of een <a href="/consult/">consult</a> van € 85 per uur.</p>
    </div>
  </section>

  <Bewijs />

  <Faq
    vragen={[
      { v: 'Zijn de prijzen inclusief btw?', a: 'Nee. Alle prijzen op deze pagina zijn exclusief btw. Onze diensten zijn bedoeld voor ondernemers en organisaties, niet voor particulieren.' },
      { v: 'Wat betekent vanaf?', a: 'Dat is de prijs voor de kleinste vorm van de dienst. Heb je meer nodig, bijvoorbeeld omdat je landelijk wilt scoren of veel concurrentie hebt, dan wordt het meer. Je hoort dat altijd vooraf.' },
      { v: 'Zit ik vast aan een contract?', a: 'Nee. Maandelijkse diensten zeg je per maand op, met één maand opzegtermijn, per e-mail. Alleen als we samen schriftelijk iets anders afspreken, geldt dat.' },
      { v: 'Wat kost Google Ads bij jullie?', a: 'Het beheer begint bij € 249 per maand, exclusief btw en maandelijks opzegbaar. Je advertentiebudget betaal je rechtstreeks aan Google. Bij een groot budget of veel campagnes is er meer werk; wat het voor jou wordt, hoor je vooraf.' },
      { v: 'Waarom geen pakketten met een vast aantal uren?', a: 'Omdat we eerst willen weten wat je wilt bereiken. Een installateur in Hoogeveen heeft iets anders nodig dan een advocatenkantoor in Groningen. Na één gesprek hoor je wat je krijgt en wat het kost. Dat staat in het voorstel, en dat bedrag staat vast.' },
      { v: 'Is goedkoper niet slechter?', a: 'Niet als je weet waar het verschil zit. Wij hebben geen accountmanagers, AI doet het rekenwerk en wat we bij jou doen, hebben we eerst op onze eigen sites getest. Je ziet elke maand op één A4 wat het oplevert, en bij maandelijkse diensten staat er een doel op papier.' },
    ]}
  />

  <WieDoetHet titel="Wie je prijs met je doorneemt" wie={[{ slug: 'thorgall', taak: 'Belt je terug, vraagt wat je wilt bereiken en noemt na één gesprek wat het voor jou kost.' }]} />

  <Actie titel="Wil je weten wat het voor jou kost?" tekst={`${site.contactpersoon} belt je op werkdagen binnen 15 minuten terug. Na één gesprek weet je wat je nodig hebt en wat het kost.`} />
</Base>
<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .tabs a { text-decoration: none; }
  .tabs a:hover { background: var(--navy); color: #fff; }
  .groep { margin-bottom: 40px; scroll-margin-top: 100px; }
  .groep h2 { margin-bottom: 12px; }
  .lijst { list-style: none; padding: 0; margin: 0; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .lijst li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 20px; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--line); }
  .lijst li:last-child { border-bottom: 0; }
  .lijst li.sub { padding-left: 40px; background: #fbfcfd; }
  .lijst a { display: grid; gap: 2px; text-decoration: none; color: var(--ink); }
  .lijst a:hover b { text-decoration: underline; }
  .lijst .muted { font-size: 0.95rem; }
  .prijs { font-weight: 800; text-align: right; white-space: nowrap; }
  @media (max-width: 640px) {
    .lijst li { grid-template-columns: minmax(0, 1fr); }
    .prijs { text-align: left; white-space: normal; color: var(--navy); }
  }
</style>
