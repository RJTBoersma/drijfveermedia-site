---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/pagina/Hero.astro';
import Bewijs from '../../components/pagina/Bewijs.astro';
import Faq from '../../components/pagina/Faq.astro';
import Actie from '../../components/pagina/Actie.astro';
import { diensten, type Pijler } from '../../data/diensten';
import { site } from '../../data/site';
import Prijslabel from '../../components/teken/Prijslabel.astro';
import Tekening from '../../components/teken/Tekening.astro';
import { perOnderwerp } from '../../data/tekeningen';

const groepen: { pijler: Pijler; titel: string }[] = [
  { pijler: 'Gevonden', titel: 'Hoger in Google' },
  { pijler: 'Genoemd', titel: 'Aanbevolen door AI' },
  { pijler: 'Gekozen', titel: 'Meer klanten uit je site' },
  { pijler: 'Advies', titel: 'Advies en uitbesteden' },
];
const schema = [{
  '@type': 'OfferCatalog',
  name: 'Prijzen Drijfveer Media',
  url: `${site.url}/prijzen/`,
  itemListElement: diensten.filter((d) => d.prijsWaarde).map((d) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: d.naam, url: `${site.url}${d.url}` },
    priceCurrency: 'EUR',
    price: d.prijsWaarde,
  })),
}];
---
<Base
  title="Prijzen online marketing en SEO | Drijfveer Media"
  description="Alle prijzen van Drijfveer Media op een rij: SEO vanaf € 495 per maand, lokale SEO vanaf € 295 en een website vanaf € 250. Zonder kleine lettertjes."
  kruimels={[{ naam: 'Prijzen', url: '/prijzen/' }]}
  schema={schema}
>
  <Hero kicker="Prijzen" titel="Wat het kost, gewoon op een rij">
    <p>Veel bureaus zetten hun prijzen niet online. Wij wel. Het zijn vanaf-prijzen, exclusief btw. Wat je precies betaalt, hoor je na een kort gesprek, en dat bedrag staat vast. Zo hoort het.</p>
    <Prijslabel slot="beeld" />
  </Hero>

  <section class="wrap sectie prijzen" data-aida="interest">
    <div class="tabs" role="list">
      {groepen.map((g) => <a role="listitem" href={`#${g.pijler.toLowerCase()}`} class="chip">{g.pijler}</a>)}
    </div>
    {groepen.map((g) => (
      <div class="groep" id={g.pijler.toLowerCase()}>
        <div class="stap-kop"><Tekening naam={perOnderwerp[g.pijler]} maat={52} /><h2><span class="oranje-punt">{g.pijler}.</span> {g.titel}</h2></div>
        <ul class="lijst">
          {diensten.filter((d) => d.pijler === g.pijler).map((d) => (
            <li class:list={{ sub: !!d.ouder }}>
              <a href={d.url}><b>{d.naam}</b><span class="muted">{d.kort}</span></a>
              <span class="prijs">{d.prijs}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="tekst" style="margin-top:56px">
      <h2>Wat kost een website laten maken?</h2>
      <p>Een website die we met AI bouwen en met de hand afmaken, begint bij € 250. Een maatwerk website in WordPress begint bij € 2.000. Waar je tussen die twee uitkomt, hangt af van drie dingen: hoeveel pagina's je nodig hebt, of wij de teksten schrijven en of er bijzondere functies in moeten, zoals een boekingssysteem of een koppeling met je software. Meer weten? Lees de gids <a href="/kennisbank/gidsen/wat-kost-een-website/">wat kost een website laten maken</a>.</p>

      <h2>Waarom we goedkoper zijn dan de meeste bureaus</h2>
      <p>Een gemiddeld mkb-bureau rekent voor SEO al snel € 1.000 tot € 3.500 per maand. Wij beginnen bij € 495. Dat komt niet doordat we minder doen. We gebruiken AI voor het rekenwerk en de eerste versies. We testen alles eerst op onze eigen sites, dus we verspillen geen tijd aan wat niet werkt. En we hebben een klein team zonder dure kantoorvilla. Het verschil merk je in je portemonnee. Dat scheelt flink.</p>

      <h2>Wat er altijd bij zit</h2>
      <ul class="vink">
        <li>Een vast aanspreekpunt dat je binnen 15 minuten terugbelt, op werkdagen tussen 8.00 en 17.00 uur.</li>
        <li>Een maandelijks overzicht in gewone taal: wat we deden en wat het opleverde.</li>
        <li>Afspraken die maandelijks opzegbaar zijn, tenzij we samen iets anders afspreken.</li>
        <li>Een doel waar je ons op mag afrekenen, met <a href="/garantie/">onze garantie</a> erbij.</li>
      </ul>
      <p>Twijfel je welke dienst je nodig hebt? Begin met een <a href="/gratis-website-analyse/">gratis scan</a> of een <a href="/consult/">consult</a> van € 85 per uur.</p>
    </div>
  </section>

  <Bewijs />

  <Faq
    vragen={[
      { v: 'Zijn de prijzen inclusief btw?', a: 'Nee. Alle prijzen op deze pagina zijn exclusief btw. Zo vergelijk je ze makkelijk met offertes van andere bureaus.' },
      { v: 'Wat betekent vanaf?', a: 'Dat is de prijs voor de kleinste vorm van de dienst. Heb je meer nodig, bijvoorbeeld omdat je landelijk wilt scoren of veel concurrentie hebt, dan wordt het meer. Je hoort dat altijd vooraf.' },
      { v: 'Zit ik vast aan een contract?', a: 'Nee. Maandelijkse diensten zijn maandelijks opzegbaar, tenzij we samen iets anders afspreken.' },
      { v: 'Waarom staat er bij Google Ads geen prijs?', a: 'Omdat de kosten vooral afhangen van je advertentiebudget. Na een kort gesprek hoor je welk budget past bij je doel en wat ons beheer daarvan kost.' },
    ]}
  />

  <Actie titel="Wil je weten wat het voor jou kost?" tekst={`${site.contactpersoon} belt je binnen 15 minuten terug. Na één gesprek weet je wat je nodig hebt en wat het kost.`} />
</Base>
<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .tabs a { text-decoration: none; }
  .tabs a:hover { background: var(--navy); color: #fff; }
  .groep { margin-bottom: 40px; scroll-margin-top: 100px; }
  .groep h2 { margin-bottom: 12px; }
  .lijst { list-style: none; padding: 0; margin: 0; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .lijst li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 20px; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--line); }
  .lijst li:last-child { border-bottom: 0; }
  .lijst li.sub { padding-left: 40px; background: #fbfcfd; }
  .lijst a { display: grid; gap: 2px; text-decoration: none; color: var(--ink); }
  .lijst a:hover b { text-decoration: underline; }
  .lijst .muted { font-size: 0.95rem; }
  .prijs { font-weight: 800; text-align: right; white-space: nowrap; }
  @media (max-width: 640px) {
    .lijst li { grid-template-columns: minmax(0, 1fr); }
    .prijs { text-align: left; white-space: normal; color: var(--navy); }
  }
</style>
