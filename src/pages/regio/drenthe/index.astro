import WieDoetHet from '../../../components/pagina/WieDoetHet.astro';

const url = '/regio/drenthe/';
const omtrek: [number, number][] = [[6.11, 52.7], [6.25, 52.66], [6.45, 52.665], [6.62, 52.63], [6.75, 52.65], [6.9, 52.64], [7.07, 52.64], [7.09, 52.75], [7.05, 52.85], [6.98, 52.95], [6.88, 53.05], [6.75, 53.12], [6.62, 53.2], [6.5, 53.2], [6.4, 53.18], [6.33, 53.1], [6.3, 53.02], [6.22, 52.92], [6.12, 52.85], [6.1, 52.78]];
const plaatsen = [
  { naam: 'Assen', lat: 52.993, lng: 6.564, href: '/webdesign-assen/', thuis: true },
  { naam: 'Emmen', lat: 52.785, lng: 6.897, href: '/webdesign-emmen/' },
  { naam: 'Hoogeveen', lat: 52.723, lng: 6.476, href: '/webdesign-hoogeveen/' },
