  { plaats: 'Meppel', links: [['SEO', '/seo-meppel/']] },
  { plaats: 'Heel Drenthe', links: [['Webdesign', '/webdesign-drenthe/']] },
];
// Inwoners: CBS, eind augustus 2026. Vestigingen: CBS, 1 januari 2026 (voorlopig). Banen: provincie Drenthe (LISA), 1 april 2025.
const gemeenten = [
  { naam: 'Emmen', inwoners: '109.820', vestigingen: '11.690', banen: '50.970' },
  { naam: 'Assen', inwoners: '70.852', vestigingen: '7.225', banen: '44.650' },
  { naam: 'Hoogeveen', inwoners: '56.573', vestigingen: '6.285', banen: '31.400' },
  { naam: 'Meppel', inwoners: '36.843', vestigingen: '4.315', banen: '21.630' },
  { naam: 'Coevorden', inwoners: '35.835', vestigingen: '4.455', banen: '16.460' },
  { naam: 'Tynaarlo', inwoners: '35.202', vestigingen: '4.880', banen: '14.100' },
  { naam: 'Midden-Drenthe', inwoners: '34.530', vestigingen: '4.440', banen: '15.210' },
  { naam: 'Noordenveld', inwoners: '31.883', vestigingen: '4.060', banen: '12.580' },
  { naam: 'Borger-Odoorn', inwoners: '26.269', vestigingen: '3.310', banen: '8.450' },
  { naam: 'Aa en Hunze', inwoners: '26.162', vestigingen: '3.430', banen: '9.050' },
  { naam: 'De Wolden', inwoners: '24.732', vestigingen: '3.855', banen: '9.310' },
