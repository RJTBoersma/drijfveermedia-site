---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/pagina/Hero.astro';
import Bewijs from '../../../components/pagina/Bewijs.astro';
import Faq from '../../../components/pagina/Faq.astro';
import Actie from '../../../components/pagina/Actie.astro';
import Verder from '../../../components/pagina/Verder.astro';
import Tekening from '../../../components/teken/Tekening.astro';
import Scene from '../../../components/scenes/regio--groningen.astro';
import { site } from '../../../data/site';
import Tussenactie from '../../../components/pagina/Tussenactie.astro';

const url = '/regio/groningen/';
const metPagina = [
  { plaats: 'Groningen', wat: 'De grootste stad van Noord-Nederland, met ruim 200.000 inwoners en tienduizenden studenten.', links: [['Webdesign', '/webdesign-groningen/'], ['SEO', '/seo-groningen/'], ['Online marketing', '/online-marketing-groningen/']] },
  { plaats: 'Veendam', wat: 'Parkstad aan de N33, de weg van de Eemshaven naar Assen.', links: [['Webdesign', '/webdesign-veendam/']] },
  { plaats: 'Stadskanaal', wat: 'Derde winkelstad van de provincie, als lintdorp langs het kanaal gegroeid.', links: [['Webdesign', '/webdesign-stadskanaal/']] },
];
const zonderPagina = [
  { plaats: 'Hoogezand', wat: 'Met ruim 22.000 inwoners de grootste woonplaats van Midden-Groningen.' },
  { plaats: 'Winschoten', wat: 'Na de stad de tweede koopstad van de provincie. Trekt ook klanten uit Ostfriesland en het Emsland.' },
  { plaats: 'Delfzijl', wat: 'De belangrijkste haven van Noord-Nederland, met veel industrie eromheen.' },
  { plaats: 'Leek', wat: 'In het Westerkwartier, met een centrum dat direct grenst aan het Drentse Nietap.' },
];
const schema = [{
  '@type': 'Service',
  name: 'Online marketing in Groningen',
  serviceType: 'Online marketing',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Groningen' },
  url: `${site.url}${url}`,
}];
---
<Base
  title="Marketingbureau Groningen | Drijfveer Media"
  description="Marketingbureau voor Groningen, vanuit Assen. SEO, websites, GEO en Google Ads voor ondernemers in de Stad, Veendam, Stadskanaal, Winschoten en Delfzijl."
  kruimels={[{ naam: 'Werkgebied', url: '/werkgebied/' }, { naam: 'Groningen', url }]}
  schema={schema}
>
  <Hero kicker="Werkgebied · Groningen" titel="Marketingbureau voor Groningen, in de stad en de Ommelanden">
    <p>Van een adviseur in de binnenstad tot een akkerbouwer in het Oldambt. Vanuit Assen, op een kleine twintig minuten met de trein, zorgen we dat Groningse klanten jou vinden en kiezen.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="tekst">
      <h2>Een marketingbureau voor Groningen, met kantoor in Assen</h2>
      <p>Drijfveer Media zit sinds 2011 aan de Lauwers in Assen. Dat is onze enige vestiging. Voor ondernemers in de regio Groningen is dat dichtbij. De intercity naar de stad doet er een kleine twintig minuten over, en over de N33 ben je zo in Veendam. Het eerste gesprek voeren we bij jou, bij ons op de koffie of aan de telefoon. Daarna gaat veel werk op afstand.</p>
      <p>De provincie telt ruim 601.000 inwoners, en meer dan een derde daarvan woont in de stad (bron: <a href="https://nl.wikipedia.org/wiki/Groningen_(provincie)" rel="noopener">Wikipedia</a>). Niet voor niets heet de provincie ook wel Stad en Ommelanden. Voor online marketing zijn dat twee verschillende markten.</p>

      <h2>In Groningen kies je per markt een andere aanpak</h2>
      <p>Wat in de binnenstad werkt, werkt niet vanzelf in Appingedam. Een goed marketingbureau voor Groningen kijkt daarom eerst waar jouw klanten zitten.</p>
    </div>
    <div class="raster raster-2 markten">
      <div class="card">
        <Tekening naam="team" />
        <span class="kicker">De Stad</span>
        <h3>Veel concurrentie, veel kansen</h3>
        <p>Groningen is de grootste stad van het Noorden en een echte studentenstad. De Rijksuniversiteit Groningen alleen al telt zo'n 33.000 studenten, van wie ruim een kwart uit het buitenland komt. Op algemene zoekwoorden als "kapper Groningen" is het druk. Hier win je met specifieke pagina's per dienst en doelgroep, sterke links en soms een Engelse pagina voor internationale klanten.</p>
      </div>
      <div class="card">
        <Tekening naam="pin" vertraging={200} />
        <span class="kicker">De Ommelanden</span>
        <h3>Weinig concurrentie, snel resultaat</h3>
        <p>In de dorpen en kleine steden buiten de stad zijn er minder sterke websites. Een goed ingericht Google Bedrijfsprofiel, een pagina per werkgebied en een handvol reviews brengen je hier vaak sneller bovenaan dan in de stad. Juist in het buitengebied belt een klant de eerste die hij vindt.</p>
      </div>
    </div>

    <div class="tekst" style="margin-top:48px">
      <Tussenactie />
      <h2>Plaatsen in Groningen met een eigen pagina</h2>
      <p>Voor de plaatsen waar het meest gezocht wordt, schreven we een aparte pagina met lokale details.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Plaats</th><th>Wat er speelt</th><th>Pagina's</th></tr></thead>
          <tbody>
            {metPagina.map((p) => (
              <tr>
                <td><b>{p.plaats}</b></td>
                <td>{p.wat}</td>
                <td><ul class="chips">{p.links.map(([n, h]) => <li><a class="chip" href={h}>{n}</a></li>)}</ul></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3>Ook in deze plaatsen werken we</h3>
      <p>Geen eigen pagina, wel net zo welkom. Een paar voorbeelden:</p>
      <ul>
        {zonderPagina.map((p) => <li><b>{p.plaats}.</b> {p.wat}</li>)}
      </ul>
      <p>Zit je in Appingedam, Zuidhorn, Uithuizen of een dorp in Westerwolde? Bel gerust. De aanpak is dezelfde, alleen de zoekwoorden verschillen.</p>

      <h2>Wat we doen voor Groningse ondernemers</h2>
      <p>Alle prijzen zijn vanaf-prijzen, exclusief btw, en maandelijks opzegbaar.</p>
      <ul class="vink">
        <li><a href="/zoekmachine-optimalisatie/">SEO</a> vanaf € 495 per maand. Hoger in Google op de woorden waarop klanten zoeken.</li>
        <li><a href="/lokale-seo/">Lokale SEO</a> vanaf € 295 per maand. Bovenaan op de kaart, met reviews.</li>
        <li><a href="/linkbuilding/">Linkbuilding</a> vanaf € 395 per maand. Links die we eerst op onze eigen sites testen.</li>
        <li><a href="/generative-engine-optimization/">GEO</a> vanaf € 495 per maand. Genoemd worden door ChatGPT en Google AI.</li>
        <li><a href="/website-laten-maken/">Een website</a> vanaf € 250 met AI, of maatwerk in WordPress vanaf € 2.000.</li>
        <li><a href="/social-media-beheer/">Social media beheer</a> vanaf € 395 per maand.</li>
        <li><a href="/online-adverteren/google-ads-bureau/">Google Ads</a>, met beheer vanaf € 249 per maand plus je advertentiebudget.</li>
      </ul>
      <p>Wat we niet zijn: een mediabureau dat advertentieruimte inkoopt, of een club creatieven die met een gelikte pitch binnenkomt. Social media marketing doen we in de vorm van beheer. Advertenties op Facebook en Instagram laten we aan anderen.</p>
      <p>Wat we wel zijn: een klein en gedreven team van vier, met een community van freelancers. We spreken vooraf doelen af waar je ons op kunt afrekenen, en we slaan geen stap over om ze te halen. Dat levert structurele groei op, geen piekje van één maand. Een site die zelf klanten trekt, maakt je bedrijf ook schaalbaarder dan mond-tot-mondreclame alleen.</p>

      <h2>Branches met kansen in Groningen</h2>
    </div>
    <div class="raster raster-2 branches">
      <div class="card"><Tekening naam="tandwiel" /><h3>Haven, energie en hun leveranciers</h3><p>Rond de Eemshaven en Delfzijl zitten veel technische bedrijven en hun leveranciers. Inkopers zoeken op specificaties en lezen alles. Heldere vakpagina's en een paar sterke links doen hier meer dan een campagne.</p></div>
      <div class="card"><Tekening naam="huis" vertraging={150} /><h3>Landbouw en voedsel</h3><p>De zeeklei van het Hogeland en het Oldambt is akkerbouwland, en de aardappel ligt aan de basis van een hele industrie. Loonwerkers, toeleveranciers en boerderijwinkels worden vooral lokaal gezocht.</p></div>
      <div class="card"><Tekening naam="munten" vertraging={300} /><h3>Winkels bij de grens</h3><p>Winschoten en de rest van Oost-Groningen liggen tegen Duitsland aan. Wie Duitse klanten wil bereiken, zorgt dat zijn openingstijden, adres en aanbod ook voor een Duitser duidelijk zijn.</p></div>
      <div class="card"><Tekening naam="kompas" vertraging={450} /><h3>Dienstverlening in de stad</h3><p>Steeds meer mensen stellen hun vraag eerst aan een AI-assistent, ook als ze een adviseur of accountant zoeken in het hart van de stad. Wie daar genoemd wil worden, heeft een duidelijke site en vermeldingen op andere plekken nodig.</p></div>
    </div>
  </section>

  <Bewijs />

  <Faq
    vragen={[
      { v: 'Hebben jullie een kantoor in de stad Groningen?', a: 'Nee. Assen is onze enige vestiging. Assen ligt om de hoek, dus we komen graag langs. Je kunt ook bij ons koffie drinken aan de Lauwers 9.' },
      { v: 'Waarom een bureau uit Assen en niet een bureau in Groningen?', a: 'Waar het kantoor staat, maakt voor je vindbaarheid niets uit. Kies het bureau dat het helderst uitlegt wat het gaat doen, en waar je het op kunt afrekenen. Bij ons is dat een vast doel, met een maand gratis doorwerken als we het door eigen schuld niet halen.' },
      { v: 'Wat kost een marketingbureau in Groningen?', a: 'Bij ons begint lokale SEO bij € 295 per maand, SEO bij € 495 en een website bij € 250. Je ziet alle bedragen op de pagina <a href="/prijzen/">prijzen</a>.' },
      { v: 'Doen jullie ook advertenties op Facebook en Instagram?', a: 'Nee. We beheren wel je social media, vanaf € 395 per maand. Voor betaalde advertenties richten we ons op Google en ChatGPT, waar mensen actief zoeken.' },
      { v: 'Schrijven jullie in het Gronings?', a: 'Nee, niemand van ons spreekt Gronings. We schrijven in helder Nederlands, en dat leest in Delfzijl net zo goed als in de stad.' },
    ]}
  />

  <Verder
    titel="Meer in Groningen"
    links={[
      { label: 'Groningen', titel: 'Webdesign in Groningen', href: '/webdesign-groningen/', tekst: 'Een website die Stadjers overtuigt.', teken: 'scherm' },
      { label: 'Groningen', titel: 'SEO in Groningen', href: '/seo-groningen/', tekst: 'Bovenaan in een drukke markt.', teken: 'vergrootglas' },
      { label: 'Groningen', titel: 'Online marketing in Groningen', href: '/online-marketing-groningen/', tekst: 'Alle kanalen in één hand.', teken: 'megafoon' },
      { label: 'Regio', titel: 'Friesland', href: '/regio/friesland/', tekst: 'Onze diensten in de buurprovincie.' },
    ]}
  />

  <Actie titel="Ondernemer in Stad of Ommeland?" tekst={`Bel of mail ${site.contactpersoon}. Hij belt je binnen 15 minuten terug. Daarna komen we langs, of je stapt in Groningen op de trein naar Assen.`} />
</Base>
<style>
  .markten, .branches { margin-top: 8px; }
  td .chips { gap: 6px; }
</style>
