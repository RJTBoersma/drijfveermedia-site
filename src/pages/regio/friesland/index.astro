---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/pagina/Hero.astro';
import Bewijs from '../../../components/pagina/Bewijs.astro';
import Faq from '../../../components/pagina/Faq.astro';
import Actie from '../../../components/pagina/Actie.astro';
import Verder from '../../../components/pagina/Verder.astro';
import Inhoud from '../../../components/pagina/Inhoud.astro';
import Tekening from '../../../components/teken/Tekening.astro';
import Scene from '../../../components/scenes/regio--friesland.astro';
import { site } from '../../../data/site';
import Tussenactie from '../../../components/pagina/Tussenactie.astro';

const url = '/regio/friesland/';
const datum = '2026-10-18';
const hoofdstukken = [
  { id: 'kantoor', titel: 'Kantoor in Drenthe, klanten in Friesland' },
  { id: 'plaatsen', titel: 'Plaatsen met een eigen pagina' },
  { id: 'diensten', titel: 'Wat we doen' },
  { id: 'kanaal', titel: 'Welk kanaal bij welk doel' },
  { id: 'maand', titel: 'Zo ziet een maand eruit' },
  { id: 'resultaat', titel: 'Wat dit elders opleverde' },
  { id: 'sectoren', titel: 'Waar het meest te halen is' },
  { id: 'strategie', titel: 'Van koffie tot resultaat' },
  { id: 'kiezen', titel: 'Een bureau kiezen' },
];
// Gemeentecijfers: CBS, Kerncijfers wijken en buurten 2024.
const plaatsen = [
  { plaats: 'Leeuwarden', over: 'Grootste gemeente van de provincie: 128.810 inwoners en 15.995 bedrijfsvestigingen.', links: [['Webdesign', '/webdesign-leeuwarden/'], ['SEO', '/seo-leeuwarden/'], ['Online marketing', '/online-marketing-leeuwarden/']] },
  { plaats: 'Drachten', over: 'Ligt in Smallingerland, met 56.661 inwoners de derde gemeente van Friesland.', links: [['Webdesign', '/webdesign-drachten/'], ['SEO', '/seo-drachten/'], ['Online marketing', '/online-marketing-drachten/']] },
  { plaats: 'Heerenveen', over: 'Gemeente met 51.787 inwoners en 7.015 vestigingen, waarvan 1.765 in de zakelijke dienstverlening.', links: [['Webdesign', '/webdesign-heerenveen/'], ['SEO', '/seo-heerenveen/'], ['Online marketing', '/online-marketing-heerenveen/']] },
  { plaats: 'Sneek', over: 'Ligt in Súdwest-Fryslân, na Leeuwarden de gemeente met de meeste vestigingen: 12.660.', links: [['Webdesign', '/webdesign-sneek/'], ['Online marketing', '/online-marketing-sneek/']] },
  { plaats: 'Joure', over: 'Ligt in De Fryske Marren, waar 22 procent van de werkende inwoners zelfstandige is.', links: [['Webdesign', '/webdesign-joure/']] },
  { plaats: 'Heel Friesland', over: 'Voor bedrijven die in de hele provincie klanten zoeken.', links: [['Webdesign', '/webdesign-friesland/'], ['SEO', '/seo-friesland/']] },
];
const schema = [{
  '@type': 'Service',
  name: 'Online marketing in Friesland',
  serviceType: 'Online marketing',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Friesland' },
  url: `${site.url}${url}`,
  dateModified: datum,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 595, priceSpecification: { '@type': 'UnitPriceSpecification', price: 595, priceCurrency: 'EUR', unitText: 'MONTH', valueAddedTaxIncluded: false } },
}, {
  '@type': 'WebPage',
  citation: [
    'https://www.cbs.nl/nl-nl/cijfers/detail/85984NED',
    'https://www.cbs.nl/nl-nl/cijfers/detail/82061NED',
  ],
}];
---
<Base
  title="Marketingbureau Friesland: online marketing vanaf € 295 p/m"
  description="Marketingbureau voor Friesland: SEO, websites, GEO en Google Ads voor ondernemers van Leeuwarden tot Lemmer. Vanuit Assen, met vaste vanaf-prijzen."
  kruimels={[{ naam: 'Werkgebied', url: '/werkgebied/' }, { naam: 'Friesland', url }]}
  schema={schema}
>
  <Hero kicker="Werkgebied · Friesland" titel="Marketingbureau voor Friesland, vanuit Assen">
    <p>Friese ondernemers willen weten waar ze aan toe zijn. We zorgen dat klanten je vinden in Google, dat AI je noemt en dat je website aanvragen oplevert. Met prijzen die je vooraf kent.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="met-zijkolom">
      <article class="tekst">
        <p>Zoek je een marketingbureau in Friesland? Dan wil je weten wie er achter het bureau zit, wat het kost en of het waarmaakt wat het belooft. Op deze pagina lees je wat we voor Friese ondernemers doen, in welke plaatsen we werken, waar in de provincie het meest te halen is en hoe je een bureau kiest. Ook als dat bureau uiteindelijk niet het onze wordt.</p>

        <h2 id="kantoor">Een marketingbureau voor Friesland, met kantoor in Drenthe</h2>
        <p>Ons kantoor staat niet in Friesland. Drijfveer Media zit sinds 2011 in Assen, aan de Lauwers. Dat is ook onze enige vestiging. Voor jou maakt dat weinig uit. Het eerste gesprek voeren we bij jou op de zaak, bij ons in Assen of aan de telefoon. Daarna gaat het meeste werk op afstand: teksten, techniek, links en campagnes. Wat telt, is dat je ons snel te pakken hebt. Op werkdagen bellen we binnen 15 minuten terug.</p>
        <p>Zo ver is het rijden vanaf ons kantoor:</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Plaats</th><th>Afstand</th><th>Rijtijd, ongeveer</th></tr></thead>
            <tbody>
              <tr><td>Drachten</td><td>48 km</td><td>50 minuten</td></tr>
              <tr><td>Wolvega</td><td>50 km</td><td>50 minuten</td></tr>
              <tr><td>Heerenveen</td><td>61 km</td><td>1 uur</td></tr>
              <tr><td>Leeuwarden</td><td>72 km</td><td>1 uur en 5 minuten</td></tr>
              <tr><td>Joure</td><td>75 km</td><td>1 uur en 5 minuten</td></tr>
              <tr><td>Dokkum</td><td>79 km</td><td>1 uur en 10 minuten</td></tr>
              <tr><td>Sneek</td><td>89 km</td><td>1 uur en 20 minuten</td></tr>
              <tr><td>Harlingen</td><td>100 km</td><td>1 uur en 25 minuten</td></tr>
            </tbody>
          </table>
        </div>
        <p class="muted klein">Berekend met een routeplanner op basis van OpenStreetMap, van Lauwers 9 in Assen naar het centrum, zonder file.</p>
        <p>Friesland is groot. Begin 2024 woonden er volgens het CBS 661.904 mensen, verdeeld over 18 gemeenten, met samen 85.030 bedrijfsvestigingen. Een klant in Dokkum zoekt anders dan een klant in Lemmer. Daar houden we rekening mee in elke marketingstrategie.</p>

        <h2 id="plaatsen">Plaatsen in Friesland met een eigen pagina</h2>
        <p>Zoek je een marketingbureau in Friesland voor één bepaalde plaats? Voor de plaatsen waar het meest gezocht wordt, hebben we een aparte pagina. Daar lees je wat er lokaal speelt en wat we er doen.</p>
        <div class="raster plaatsen">
          {plaatsen.map((p) => (
            <div class="card">
              <h3>{p.plaats}</h3>
              <p>{p.over}</p>
              <ul class="chips">{p.links.map(([n, h]) => <li><a class="chip" href={h}>{n}</a></li>)}</ul>
            </div>
          ))}
        </div>
        <p class="muted klein">Cijfers: <a href="https://www.cbs.nl/nl-nl/cijfers/detail/85984NED" rel="noopener">CBS, Kerncijfers wijken en buurten 2024</a>, per gemeente.</p>
        <h3>En de rest van Friesland</h3>
        <p>Zit je in Harlingen, Franeker, Dokkum, Wolvega, Bolsward of Lemmer? Ook dan helpen we je graag. Elke plaats vraagt om andere zoekwoorden, maar de aanpak is dezelfde. Een paar dingen die opvallen in de cijfers:</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Plaats</th><th>Gemeente</th><th>Wat opvalt (CBS)</th></tr></thead>
            <tbody>
              <tr><td>Harlingen</td><td>Harlingen</td><td>220 van de 2.030 vestigingen zitten in vervoer, informatie en communicatie: naar verhouding veel.</td></tr>
              <tr><td>Franeker</td><td>Waadhoeke</td><td>5.740 vestigingen, waarvan 715 in de landbouw.</td></tr>
              <tr><td>Dokkum</td><td>Noardeast-Fryslân</td><td>5.585 vestigingen, waarvan 1.075 in nijverheid, energie en bouw.</td></tr>
              <tr><td>Wolvega</td><td>Weststellingwerf</td><td>3.500 vestigingen; 20 procent van de werkenden is zelfstandige.</td></tr>
              <tr><td>Bolsward</td><td>Súdwest-Fryslân</td><td>Ruim 40 procent van de gemeente is water. Watersport en recreatie liggen voor de hand.</td></tr>
              <tr><td>Lemmer</td><td>De Fryske Marren</td><td>7.775 vestigingen; ruim een derde van de gemeente is water.</td></tr>
            </tbody>
          </table>
        </div>

        <Tussenactie />
        <h2 id="diensten">Wat we doen voor Friese ondernemers</h2>
        <p>We werken in drie lagen. Eerst zorgen we dat je gevonden wordt, dan dat AI je noemt, en dan dat bezoekers kiezen voor jou.</p>
        <div class="raster drie">
          <div class="card">
            <Tekening naam="vergrootglas" />
            <span class="kicker">Gevonden</span>
            <h3>Zoekmachineoptimalisatie</h3>
            <p><a href="/zoekmachine-optimalisatie/">SEO</a> vanaf € 495 per maand, <a href="/lokale-seo/">lokale SEO</a> vanaf € 295. Voor een continue stroom bezoekers uit Google, zonder te betalen per klik. Liever een duurzame plek bovenaan dan een trucje dat na de volgende update wegvalt.</p>
          </div>
          <div class="card">
            <Tekening naam="megafoon" vertraging={150} />
            <span class="kicker">Gevonden</span>
            <h3>Zoekmachine adverteren</h3>
            <p><a href="/online-adverteren/google-ads-bureau/">Google Ads</a> voor wie morgen al bovenaan wil staan. Beheer vanaf € 249 per maand, plus je advertentiebudget. We sturen op rendement, niet op klikken.</p>
          </div>
          <div class="card">
            <Tekening naam="ai" vertraging={300} />
            <span class="kicker">Genoemd</span>
            <h3>Aanbevolen door AI</h3>
            <p><a href="/generative-engine-optimization/">GEO</a> vanaf € 495 per maand. Zodat ChatGPT en Google AI jouw naam noemen als iemand in Friesland om advies vraagt.</p>
          </div>
          <div class="card">
            <Tekening naam="merk" vertraging={450} />
            <span class="kicker">Gekozen</span>
            <h3>Website en huisstijl</h3>
            <p><a href="/website-laten-maken/">Websites</a> vanaf € 250, een <a href="/branding/huisstijl-laten-maken/">huisstijl</a> vanaf € 995. Een eerste indruk die past bij wie je bent.</p>
          </div>
        </div>
        <p>Geen vast pakket dus. Bij de ene klant ligt de grootste kans in een beter Google Bedrijfsprofiel, bij de andere in een website die eindelijk laat zien wat het bedrijf kan. De uitvoering doen we zelf, met ons team van vier en een vaste groep freelancers die we al jaren kennen. Zo werken we voor eenmanszaken en voor grotere organisaties. Wil je alles in één hand, dan kan dat vanaf € 595 per maand met <a href="/online-marketing-uitbesteden/">online marketing uitbesteden</a>: één aanspreekpunt, één plan en elke maand één A4 met wat het opleverde.</p>
        <p>Een paar dingen laten we bewust aan anderen. Advertenties op Facebook, Instagram, LinkedIn, TikTok of Microsoft doen we niet. Webshops bouwen of optimaliseren ook niet; Google Shopping voor een bestaande webshop wel. Wij richten ons op klanten die nu al zoeken naar wat jij doet: in Google, in je bedrijfsprofiel en steeds vaker in AI-assistenten.</p>

        <h2 id="kanaal">Online marketing in Friesland: welk kanaal bij welk doel?</h2>
        <p>Een bakker in Joure wil klanten binnen een paar kilometer. Een installateur in Heerenveen werkt in de halve provincie. Een jachthaven aan het Sneekermeer zoekt gasten in heel Nederland en Duitsland. Drie bedrijven, drie verschillende plannen. Dit is waar we meestal beginnen:</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Je wilt</th><th>Wat meestal het meest oplevert</th><th>Hoe snel</th></tr></thead>
            <tbody>
              <tr><td>Meer telefoontjes uit je eigen regio</td><td>Lokale SEO en een sterk Google Bedrijfsprofiel, vanaf € 295 per maand</td><td>Kleine winst vaak binnen een paar weken</td></tr>
              <tr><td>Deze maand nog aanvragen voor een nieuwe dienst</td><td>Een gerichte campagne in Google Ads</td><td>Online na goedkeuring door Google, meestal binnen een werkdag</td></tr>
              <tr><td>Op lange termijn minder afhankelijk zijn van advertenties</td><td>SEO en <a href="/linkbuilding/">linkbuilding</a>, met stijggarantie</td><td>Drie tot zes maanden</td></tr>
              <tr><td>Genoemd worden als iemand ChatGPT om advies vraagt</td><td>GEO, vanaf € 495 per maand</td><td>Een paar maanden</td></tr>
              <tr><td>Gasten of klanten vaker terug laten komen</td><td><a href="/leadgeneratie/e-mailmarketing/">E-mailmarketing</a>, vanaf € 295 per maand</td><td>Vanaf de eerste mailing</td></tr>
            </tbody>
          </table>
        </div>
        <p>Kies je voor zoekmachine adverteren, dan betaal je per klik en stopt het verkeer zodra je budget op is. SEO kost meer tijd, maar blijft werken. De meeste Friese mkb'ers hebben baat bij een mix: adverteren voor nu, SEO voor straks.</p>

        <h2 id="maand">Zo ziet een maand online marketing eruit</h2>
        <p>Wat doen we eigenlijk voor dat maandbedrag? Een voorbeeld van één maand voor een verzonnen installatiebedrijf in Heerenveen, dat vooral meer aanvragen voor warmtepompen wil.</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Kanaal</th><th>Wat we die maand doen</th></tr></thead>
            <tbody>
              <tr><td>SEO</td><td>Een nieuwe pagina over warmtepompen, met prijzen en vragen van klanten. Twee bestaande pagina's verbeterd.</td></tr>
              <tr><td>Google Bedrijfsprofiel</td><td>Vier nieuwe foto's van klussen, één bericht, reacties op drie reviews.</td></tr>
              <tr><td>Google Ads</td><td>Zoektermen nagekeken, tien woorden uitgesloten die geld kostten zonder aanvragen.</td></tr>
              <tr><td>E-mail</td><td>Een mailing aan bestaande klanten over onderhoud voor de winter.</td></tr>
              <tr><td>Rapport</td><td>Eén A4: hoeveel mensen belden, mailden en via welk kanaal.</td></tr>
            </tbody>
          </table>
        </div>
        <p class="muted klein">Verzonnen voorbeeld. Wat er per maand gebeurt, hangt af van je doel en je markt.</p>
        <div class="kader">
          <p class="kader-titel">Rekenvoorbeeld (verzonnen cijfers)</p>
          <p>Dit bedrijf geeft € 595 per maand uit aan ons werk en € 400 aan advertenties. Samen € 995. Dat levert in deze maand 14 aanvragen op, dus een aanvraag kost ongeveer € 71. Wordt een op de drie aanvragen een klant, dan kost een klant zo'n € 213. Is een klant gemiddeld € 1.000 waard, dan is het rendement duidelijk. Is een klant € 150 waard, dan moet het plan anders.</p>
        </div>
        <p>Zo zie je per kanaal wat een aanvraag kost. Dat meten kan zonder cookiemelding, met <a href="/leadgeneratie/tracking-en-analytics/">tracking en analytics</a>. Een kanaal dat duur blijft, schrappen we.</p>

        <h2 id="resultaat">Wat dit elders opleverde</h2>
        <p>Onze cases komen niet uit Friesland. Ze hebben wel echte cijfers, en ze laten zien hoe we werken. Die aanpak is in Friesland niet anders.</p>
        <ul>
          <li><strong><a href="/cases/#conflictbemiddeling">Conflictbemiddeling Nederland</a></strong>: nieuwe website, SEO, linkbuilding en Google Ads. Resultaat: 47 procent meer bezoekers uit Google en een eerste positie op "mediation opleiding".</li>
          <li><strong><a href="/cases/#dakraamconcurrent">Dakraam Concurrent</a></strong>: eerst een nieuwe website, daarna linkbuilding, daarna SEO. Resultaat: 32 procent meer bezoekers uit Google en nummer 1 op "dakraam plaatsen".</li>
        </ul>
        <p>Let op de volgorde in die tweede case. We begonnen niet met alles tegelijk, maar met wat het meeste tegenhield. Zo pakken we het voor een Fries bedrijf ook aan.</p>

        <h2 id="sectoren">Waar online marketing in Friesland het meest oplevert</h2>
        <p>De Friese economie heeft een eigen karakter. Dat zie je terug in de cijfers, en in hoe klanten zoeken.</p>
        <div class="stap-kop"><Tekening naam="kalender" maat={44} /><h3>Toerisme en watersport</h3></div>
        <p>Friese hotels ontvingen in 2025 volgens het CBS 982.000 gasten, onder wie 76.000 Duitsers. Gasten plannen vooruit en vergelijken online. Een jachthaven of verhuurbedrijf dat in februari al goed vindbaar is, vult zijn agenda voordat het seizoen begint. Effectieve marketing begint hier dus in de winter.</p>
        <div class="stap-kop"><Tekening naam="tandwiel" maat={44} vertraging={150} /><h3>Landbouw, industrie en bouw</h3></div>
        <p>Friesland telt 6.220 vestigingen in de landbouw en 14.405 in nijverheid, energie en bouw. Hier verkoop je vaak aan andere bedrijven. Inkopers zoeken op specifieke termen en lezen lang. Goede vakpagina's en een paar sterke links doen dan meer dan een opvallende advertentie.</p>
        <div class="stap-kop"><Tekening naam="kompas" maat={44} vertraging={300} /><h3>Zakelijke dienstverlening</h3></div>
        <p>Met 17.645 vestigingen is dit de grootste sector van de provincie. Wie een accountant of adviseur zoekt, vraagt dat steeds vaker eerst aan ChatGPT of Google AI. Wie daar genoemd wil worden, heeft een duidelijke online aanwezigheid nodig: dezelfde gegevens overal, heldere antwoorden op je site en vermeldingen op andere sites.</p>
        <div class="stap-kop"><Tekening naam="ster" maat={44} vertraging={450} /><h3>Winkels, horeca en ambachten</h3></div>
        <p>Handel en horeca zijn samen goed voor 15.775 vestigingen. In plaatsen als Sneek, Joure en Dokkum werkt lokaal gevonden worden het best. Een volledig Google Bedrijfsprofiel, echte foto's en reviews van klanten uit de buurt. Het is weinig werk en het levert vaak het meeste op. Reviews vragen kost niets, alleen een beetje discipline.</p>
        <p class="muted klein">Sectorcijfers: <a href="https://www.cbs.nl/nl-nl/cijfers/detail/85984NED" rel="noopener">CBS, Kerncijfers wijken en buurten 2024</a>, opgeteld voor de 18 Friese gemeenten. Hotelgasten: <a href="https://www.cbs.nl/nl-nl/cijfers/detail/82061NED" rel="noopener">CBS, Hotels; gasten, overnachtingen, woonland, regio</a>, 2025.</p>

        <h2 id="strategie">Van koffie tot resultaat: zo werkt ons marketingbureau voor Friesland</h2>
        <ol>
          <li><strong>Binnen 15 minuten terugbellen.</strong> Op werkdagen. Thorgall vraagt eerst wat je wilt bereiken.</li>
          <li><strong>Vragen, vragen, vragen.</strong> Tot we weten wat je echt wilt. Meer klanten, betere klanten of klanten in een ander deel van de provincie.</li>
          <li><strong>Mogelijkheden voorleggen.</strong> Bij jou op de zaak, bij ons op de koffie in Assen of aan de telefoon.</li>
          <li><strong>Lage investering, concrete doelen.</strong> Je weet vooraf wat het kost en waar je ons op kunt afrekenen.</li>
          <li><strong>Beginnen waar het snelst verschil zit.</strong> Daarna perfectioneren. Twintig procent van het werk levert vaak tachtig procent van het resultaat.</li>
        </ol>
        <p>Halen we het afgesproken doel niet en ligt het aan ons, dan werken we een maand gratis door. Voorwaarde is dat jij doet wat nodig is om het doel te halen. Je zegt per maand op, met één maand opzegtermijn. Lees hoe dat werkt op de pagina over onze <a href="/garantie/">garantie</a>.</p>

        <h2 id="kiezen">Een online marketingbureau in Friesland kiezen</h2>
        <p>Let op deze signalen, bij elk bureau.</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Waar je op let</th><th>Goed teken</th><th>Reden tot twijfel</th></tr></thead>
            <tbody>
              <tr><td>Bewijs</td><td>Een case met echte cijfers, en uitleg wat er gedaan is</td><td>Alleen logo's en mooie woorden</td></tr>
              <tr><td>Contract</td><td>Maandelijks opzegbaar</td><td>Een jaar vast, zonder doel</td></tr>
              <tr><td>Uitvoering</td><td>Je weet wie het werk doet</td><td>Je spreekt alleen een verkoper</td></tr>
              <tr><td>Rapport</td><td>Te begrijpen zonder uitleg</td><td>Veel grafieken, weinig conclusies</td></tr>
              <tr><td>Advies</td><td>Het bureau zegt ook waar je mee moet stoppen</td><td>Elk kanaal is volgens hen een goed idee</td></tr>
            </tbody>
          </table>
        </div>
        <p>Vakjargon verbergt vaak gebrek aan inhoud. Als een bureau niet helder kan uitleggen wat het doet, begrijpt het dat misschien zelf niet goed. Vraag het ons gerust ook.</p>
      </article>
      <aside class="zijkolom">
        <Inhoud items={hoofdstukken} leestijd={10} />
        <div class="card prijs-eigen">
          <p class="kicker">Vanaf-prijzen</p>
          <ul class="prijslijst">
            <li><span>Website</span><b>€ 250</b></li>
            <li><span>Lokale SEO</span><b>€ 295 p/m</b></li>
            <li><span>SEO</span><b>€ 495 p/m</b></li>
            <li><span>Alles in één hand</span><b>€ 595 p/m</b></li>
          </ul>
          <p class="muted klein">Exclusief btw. Maandelijks opzegbaar.</p>
          <a class="btn" href="/gratis-website-analyse/">Gratis scan aanvragen</a>
        </div>
      </aside>
    </div>
  </section>

  <Bewijs />

  <Faq
    vragen={[
      { v: 'Hebben jullie een kantoor in Friesland?', a: 'Nee. Assen is onze enige vestiging. We komen graag naar je toe in Friesland, of je komt langs aan de Lauwers 9 in Assen. Veel werk doen we op afstand, zonder dat je daar iets van merkt.' },
