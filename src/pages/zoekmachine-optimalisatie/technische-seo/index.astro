import Tekening from '../../../components/teken/Tekening.astro';
import Scene from '../../../components/scenes/zoekmachine-optimalisatie--technische-seo.astro';
import WieDoetHet from '../../../components/pagina/WieDoetHet.astro';
import { site } from '../../../data/site';
import { nietWebshop } from '../../../data/niet';
import Tussenactie from '../../../components/pagina/Tussenactie.astro';

const url = '/zoekmachine-optimalisatie/technische-seo/';
const datum = '2026-10-18';
const hoofdstukken = [
  { id: 'wat-is', titel: 'Wat is technische SEO?' },
  { id: 'wat-je-krijgt', titel: 'Wat je krijgt voor € 395' },
  { id: 'belangrijker', titel: 'Waarom het belangrijker is geworden' },
  { id: 'signalen', titel: 'Signalen van een technisch probleem' },
  { id: 'audit', titel: 'Wat er in de audit zit' },
  { id: 'werkwijze', titel: 'Zo verloopt de audit' },
  { id: 'rapport', titel: 'Wat je krijgt' },
  { id: 'checklist', titel: 'Checklist in 15 punten' },
  { id: 'fouten', titel: 'Fouten die vaak voorkomen' },
  { id: 'wanneer', titel: 'Wanneer een audit zinvol is' },
  { id: 'vergelijken', titel: 'Gratis tool, webbouwer of audit' },
  { id: 'kosten', titel: 'Wat het kost' },
  { id: 'na-de-audit', titel: 'Na de audit' },
];
const check = [
  'Je site staat in Google Search Console en je hebt de sitemap ingediend.',
  'Het rapport Pagina\'s in Search Console toont geen belangrijke pagina\'s onder "Niet geïndexeerd".',
  'Je robots.txt blokkeert geen pagina\'s, CSS of scripts die Google nodig heeft.',
  'Er staat nergens een vergeten noindex op een pagina die in Google moet.',
  'Je site werkt op één adres: met of zonder www, altijd https. De andere varianten sturen door.',
  'Oude adressen sturen met een 301 in één stap door naar de best passende nieuwe pagina.',
  'Er zijn geen interne links naar pagina\'s die een 404 geven.',
  'Elke belangrijke pagina is in hooguit drie klikken vanaf de homepage te bereiken.',
  'Er zijn geen twee pagina\'s die op hetzelfde zoekwoord mikken.',
  'Elke pagina heeft een eigen title, meta description en precies één H1.',
  'In het Core Web Vitals-rapport staan je pagina\'s op mobiel op "Goed".',
  'Foto\'s zijn verkleind, in WebP of AVIF, met breedte en hoogte in de code.',
  'Je bedrijfsgegevens staan als structured data (JSON-LD) op de site, zonder fouten.',
  'Er staat geen onveilige (http) inhoud op je https-pagina\'s.',
  'De crawlers van zoekmachines en AI-diensten die je wilt toelaten, worden niet geblokkeerd.',
