              <tr><td><b>Vast zitten</b></td><td>Nee</td><td>Per klus</td><td>Soms drie tot twaalf maanden</td><td>Per maand opzegbaar</td></tr>
              <tr><td><b>Kennis</b></td><td>Met vallen en opstaan</td><td>Vaak sterk in één onderdeel</td><td>Techniek, teksten en links onder één dak</td><td>Techniek, teksten en links onder één dak</td></tr>
              <tr><td><b>Wie je spreekt</b></td><td>Jezelf</td><td>De freelancer</td><td>Een accountmanager of het team</td><td>{site.contactpersoon}, je vaste aanspreekpunt</td></tr>
