  { id: 'waarom-nu', titel: 'Waarom het nu telt' },
  { id: 'voor-wie', titel: 'Voor wie het werkt' },
  { id: 'verschil-seo', titel: 'Het verschil met SEO' },
  { id: 'google', titel: 'Wat Google er zelf over zegt' },
  { id: 'aanpak', titel: 'Zo zorgen we dat AI je noemt' },
  { id: 'meten', titel: 'Zo meet je of AI je noemt' },
  { id: 'zelf-doen', titel: 'Wat je vandaag zelf kunt doen' },
  { id: 'kosten', titel: 'Wat het kost' },
