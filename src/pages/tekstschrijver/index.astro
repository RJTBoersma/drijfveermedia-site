---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/pagina/Hero.astro';
import Bewijs from '../../components/pagina/Bewijs.astro';
import Faq from '../../components/pagina/Faq.astro';
import Actie from '../../components/pagina/Actie.astro';
import WieDoetHet from '../../components/pagina/WieDoetHet.astro';
import Inhoud from '../../components/pagina/Inhoud.astro';
import Prijskaart from '../../components/pagina/Prijskaart.astro';
import Verder from '../../components/pagina/Verder.astro';
import Auteur from '../../components/pagina/Auteur.astro';
import Tekening from '../../components/teken/Tekening.astro';
import Scene from '../../components/scenes/tekstschrijver.astro';
import { site } from '../../data/site';
import Tussenactie from '../../components/pagina/Tussenactie.astro';

const url = '/tekstschrijver/';
const hoofdstukken = [
  { id: 'wat-doet', titel: 'Wat doet een tekstschrijver?' },
  { id: 'soorten', titel: 'Welke teksten we schrijven' },
  { id: 'waarom', titel: 'Waarom goede tekst geld oplevert' },
  { id: 'aanpak', titel: 'Zo schrijven we jouw tekst' },
  { id: 'google-ai', titel: 'Schrijven voor Google en AI' },
  { id: 'kiezen', titel: 'Freelancer, bureau of zelf doen?' },
  { id: 'kosten', titel: 'Wat een tekstschrijver kost' },
  { id: 'eerlijk', titel: 'Over AI en wat we niet doen' },
];
const schema = [{
  '@type': 'Service',
  name: 'Tekstschrijver voor websites, mailings en pagina\'s',
  serviceType: 'Tekstschrijven en copywriting',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  url: `${site.url}${url}`,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 75, priceSpecification: { '@type': 'UnitPriceSpecification', price: 75, priceCurrency: 'EUR', unitText: 'pagina', valueAddedTaxIncluded: false } },
}];
---
<Base
  title="Website tekstschrijver nodig? Vanaf € 75 per pagina"
  description="Tekstschrijver nodig? We schrijven webteksten, mailings en pagina's die gelezen, gevonden en gekozen worden. Vanaf € 75 per pagina, met een vaste prijs vooraf."
  kruimels={[{ naam: 'Tekstschrijver', url }]}
  schema={schema}
>
  <Hero kicker="Gekozen · Teksten" titel="Tekstschrijver voor je website: we schrijven op wat jij doet, zodat klanten bellen" prijs="vanaf € 75 per pagina" eenmalig>
    <p>Vanaf € 75 per pagina, met een vaste prijs vooraf. Leesbaar voor je klant, vindbaar voor Google. Je weet precies wat je doet. Alleen staat het nog niet zo op je website. Wij schrijven het op zoals jouw klant het wil lezen, en zoals Google het kan vinden.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="met-zijkolom">
      <article class="tekst">
        <Auteur slug="robert" datum="2026-10-17" />
        <div class="kader kader-oranje in-het-kort">
          <p class="kader-titel">In het kort</p>
          <p>Een tekstschrijver zet jouw kennis om in tekst die mensen lezen en waar ze iets mee doen: bellen, mailen of een offerte aanvragen. Drijfveer Media schrijft webteksten, dienstpagina's, mailings en artikelen voor mkb-bedrijven. Elke tekst begint met vragen aan jou en is geschreven voor je klant, voor Google en voor AI-assistenten zoals ChatGPT. Een pagina kost vanaf € 75, exclusief btw. Je weet vooraf wat je betaalt.</p>
        </div>

        <h2 id="wat-doet">Wat doet een tekstschrijver?</h2>
        <p>Een tekstschrijver is iemand die voor een ander teksten schrijft met een doel: informeren, overtuigen of verkopen. Voor een bedrijf zijn dat vooral webteksten, mailings, brochures en artikelen. Het woord copywriter betekent bijna hetzelfde. Meestal bedoelen mensen met copywriting de wervende kant: koppen, slogans en teksten die aanzetten tot actie.</p>
        <p>Het vak is niet beschermd. Volgens <a href="https://nl.wikipedia.org/wiki/Tekstschrijver" rel="noopener">Wikipedia</a> bestaat er sinds 2002 in Nederland geen aparte opleiding meer tot tekstschrijver. Iedereen mag zich zo noemen, en een diploma zegt dus weinig. Wat wel telt: vaardigheden die je terugziet in het werk. Kan iemand luisteren, ordenen, schrappen en schrijven in de taal van jouw klant?</p>
        <p>Goed tekstschrijven is voor de helft vragen stellen. De andere helft is weglaten. De meeste ondernemers weten te veel van hun vak om er eenvoudig over te schrijven. Een tekstschrijver kijkt er met de ogen van een buitenstaander naar.</p>

        <h2 id="soorten">Website tekstschrijver: welke teksten we schrijven</h2>
        <p>Als website tekstschrijver schrijven we alles wat een bezoeker op weg helpt naar een aanvraag. Denk aan:</p>
        <ul>
          <li><b>Webteksten.</b> Je homepage, dienstpagina's, over-ons en contactpagina. De pagina's waar een bezoeker beslist of hij blijft.</li>
          <li><b>Landingspagina's.</b> Eén pagina, één doel, bijvoorbeeld voor een actie of een advertentie. Lees meer over een <a href="/leadgeneratie/landingspagina-laten-maken/">landingspagina laten maken</a>.</li>
          <li><b>Mailings en nieuwsbrieven.</b> Een mail die mensen openen en uitlezen, met één duidelijke vervolgstap.</li>
          <li><b>Artikelen en blogs.</b> Uitleg die antwoord geeft op de vragen van je klanten. Wil je daar elke maand een vast ritme in, kijk dan bij <a href="/tekstschrijver/contentmarketing/">contentmarketing</a>.</li>
          <li><b>Veelgestelde vragen.</b> Korte, directe antwoorden. Klanten lezen ze graag en AI-assistenten gebruiken ze vaak als bron.</li>
          <li><b>Je Google Bedrijfsprofiel.</b> De beschrijving en de diensten, zodat ook je vermelding op de kaart overtuigt.</li>
        </ul>
        <p>We werken voor ondernemers in allerlei sectoren: installateurs, opleiders, adviseurs en zakelijke dienstverleners. Een tekst over mediation vraagt een andere toon dan een tekst over dakramen. Daarom begint elke opdracht bij jou en niet bij een sjabloon.</p>

        <h2 id="waarom">Waarom goede tekst geld oplevert</h2>
        <p>Bezoekers lezen weinig. Onderzoek van de Nielsen Norman Group laat zien dat mensen op een gemiddelde webpagina hooguit 28 procent van de woorden lezen, en meestal eerder 20 procent (<a href="https://www.nngroup.com/articles/how-little-do-users-read/" rel="noopener">Nielsen, 2008</a>). Die twintig procent moet dus raak zijn. Staat daar "Wij zijn een klantgerichte specialist met passie voor kwaliteit", dan is je kans voorbij. Dat zegt elke concurrent.</p>
        <p>Een goede tekst hoeft niet te schreeuwen. Hij geeft de lezer binnen een paar seconden drie antwoorden: ben ik hier goed, kan dit bedrijf mijn probleem oplossen, en wat moet ik nu doen? Daarna volgt het bewijs. Prijzen, werkwijze, voorbeelden, garanties.</p>
        <blockquote>Wie niet helder kan uitleggen wat hij doet, overtuigt niemand. Vakjargon verbergt vaak dat er weinig te zeggen is.</blockquote>
        <h3>Een voorbeeld</h3>
        <p>Verzonnen voorbeeld: een installatiebedrijf in Emmen opent zijn site met "Uw partner in installatietechniek sinds 1998". Klopt allemaal. Maar wie om half acht 's avonds een lekkende cv-ketel heeft, zoekt iets anders. Wij zouden schrijven: "Cv-ketel kapot? We komen morgen langs, in heel Zuidoost-Drenthe." Daaronder het telefoonnummer en de prijs van een storingsbezoek. Zelfde bedrijf, andere tekst, meer telefoontjes.</p>

        <Tussenactie />
        <h2 id="aanpak">Zo schrijven we jouw tekst</h2>
        <p>Een sterke tekst begint niet met schrijven. Hij begint met luisteren. Dit zijn de vijf stappen die elke opdracht doorloopt.</p>

        <div class="stap-kop"><Tekening naam="telefoon" maat={48} /><h3>1. We bellen en vragen door</h3></div>
        <p>In een gesprek van een halfuur vragen we wat je doet, voor wie, en waarom klanten voor jou kiezen. Vaak zit het beste verhaal in een bijzin. "Ach, we zijn ook in het weekend bereikbaar." Zo'n bijzin is vaak je kop.</p>

        <div class="stap-kop"><Tekening naam="vergrootglas" maat={48} /><h3>2. We doen research</h3></div>
        <p>We kijken waar je klanten op zoeken, welke vragen ze stellen en wat je concurrenten al schrijven. Daarvoor gebruiken we onder meer SE Ranking voor zoekwoorden en de vragen die Google zelf toont. Zo weten we welke woorden in de tekst horen, en welke vragen beantwoord moeten worden.</p>

        <div class="stap-kop"><Tekening naam="kompas" maat={48} /><h3>3. We leggen de opbouw voor</h3></div>
        <p>Voordat we gaan schrijven, krijg je de opzet: de koppen, de volgorde en de belangrijkste boodschap per pagina. Klopt de richting niet, dan merken we dat nu. Dat scheelt later een hoop herschrijven.</p>

        <div class="stap-kop"><Tekening naam="pen" maat={48} /><h3>4. We schrijven in jouw toon</h3></div>
        <p>Een bakker uit Assen praat anders dan een advocaat uit Zwolle. We schrijven in de toon die bij jouw bedrijf en je klanten past, met karakter, maar zonder toeters en bellen. Korte zinnen waar het kan, uitleg waar het moet. Weet je je toon nog niet? Lees dan de gids <a href="/kennisbank/gidsen/tone-of-voice/">tone of voice bepalen</a>.</p>

        <div class="stap-kop"><Tekening naam="doel" maat={48} /><h3>5. Jij leest mee, wij schaven bij</h3></div>
        <p>Je krijgt de tekst om te lezen en aan te vullen. Klopt een feit niet, of zou je iets nooit zo zeggen? Dan passen we het aan. Pas als jij zegt dat het klopt, is de tekst af. Wil je dat we hem ook op je website zetten, dan doen we dat.</p>

        <h2 id="google-ai">Schrijven voor Google en AI tegelijk</h2>
        <p>Een tekst die niemand vindt, verkoopt niets. Daarom schrijven we elke webtekst ook voor zoekmachines. Dat betekent niet dat we een zoekwoord twintig keer herhalen. Het betekent dat de tekst de vraag van de zoeker helder beantwoordt, met de woorden die hij zelf gebruikt. Daarbij horen een goede titel, een meta description die uitnodigt tot klikken en logische tussenkoppen. Over die kant lees je meer bij <a href="/zoekmachine-optimalisatie/seo-teksten/">SEO-teksten</a>.</p>
        <p>Steeds meer mensen stellen hun vraag aan ChatGPT, Gemini of Copilot. Die assistenten halen hun antwoord uit teksten die duidelijke feiten geven. Wat doe je, waar, voor wie, wat kost het. Een vage tekst slaan ze over. Een tekst die we schrijven, is dus meteen bruikbaar voor <a href="/generative-engine-optimization/">generative engine optimization</a>. Zo werkt één goede tekst voor drie lezers: je klant, Google en AI.</p>

        <h2 id="kiezen">Freelance tekstschrijver, bureau of zelf doen?</h2>
        <p>Je hebt drie routes. Ze kunnen alle drie goed uitpakken, als je weet waar je op moet letten.</p>
        <p><b>Zelf schrijven.</b> Niemand kent je bedrijf beter dan jij. Heb je tijd en schrijf je graag, begin dan zelf. De gids <a href="/kennisbank/gidsen/seo-teksten-schrijven/">SEO-teksten schrijven</a> helpt je op weg, ook als je AI wilt gebruiken. Het lastige is afstand nemen. Je weet zo veel dat je de verkeerde dingen uitlegt.</p>
        <p><b>Een freelance tekstschrijver of freelance copywriter.</b> Er zijn er duizenden, veel werken vanuit huis. Dat is prima. Let wel op specialisatie. Wie vooral vacatureteksten of magazineverhalen schrijft, is niet vanzelf goed in webteksten die aanvragen opleveren. Vraag naar voorbeelden van teksten die online staan, en vraag wat die teksten hebben opgeleverd.</p>
        <p><b>Een bureau dat ook de rest doet.</b> Een tekst staat nooit los. Hij moet passen bij je site, je vindbaarheid en je advertenties. Bij Drijfveer Media schrijven we teksten met die hele keten in het hoofd. We zien ook in de cijfers wat een tekst doet, omdat we de vindbaarheid en het verkeer van de site kunnen meten.</p>
        <h3>Vijf vragen voordat je een tekstschrijver inhuurt</h3>
        <ul class="vink">
          <li>Stelt hij vragen over je klanten, of alleen over je bedrijf?</li>
          <li>Weet hij hoe een tekst gevonden wordt in Google?</li>
          <li>Krijg je een vaste prijs, of een uurtarief zonder plafond?</li>
          <li>Hoeveel correcties zitten erbij, en wat als het echt niet klikt?</li>
          <li>Van wie is de tekst als hij af is? Bij ons: van jou.</li>
        </ul>

        <h2 id="kosten">Wat kost een tekstschrijver?</h2>
        <p>Bij Drijfveer Media kost een tekst vanaf € 75 per pagina, exclusief btw. Dat geldt voor een gewone webpagina, zoals een dienstpagina of je over-ons. Daarbij horen het gesprek vooraf, het zoekwoordonderzoek, de tekst zelf, een title en meta description, en een correctieronde. Vraagt een pagina veel onderzoek, of wordt het een lange gids? Dan hoor je vooraf wat het kost. Nooit achteraf.</p>
        <p>Een rekenvoorbeeld. Een kleine dienstverlener heeft meestal een homepage, drie of vier dienstpagina's, een over-ons en een contactpagina. Dat zijn zes tot zeven pagina's. Vanaf € 75 per stuk kom je dan uit rond de € 450 tot € 525 voor een complete set nieuwe webteksten. Wil je elke maand nieuwe artikelen? Dan is <a href="/tekstschrijver/contentmarketing/">contentmarketing</a> vanaf € 495 per maand voordeliger dan losse opdrachten.</p>

        <h2 id="eerlijk">Over AI, en wat we niet doen</h2>
        <p>We zijn een online marketingbureau dat AI gebruikt, ook bij tekstschrijven. Bijvoorbeeld om research te ordenen, een gesprek uit te werken of tien varianten van een kop naast elkaar te zetten. Claude en ChatGPT zijn daar goed in. Het denkwerk, de keuzes en de eindredactie doen we zelf. Een tekst die naar niets klinkt, gaat de deur niet uit. Wil je liever helemaal geen AI bij je project? Vraag het gerust. Bij sommige diensten kan dat, en we zeggen je vooraf of het bij jouw opdracht lukt. Lees meer op <a href="/zo-werken-we-met-ai/">zo werken we met AI</a>.</p>
        <p>Teksten voor webshops schrijven we niet, want webshops bouwen of optimaliseren doen we niet. Heb je al een webshop, dan kunnen we wel je <a href="/online-adverteren/google-shopping/">Google Shopping</a>-campagnes doen. Dat zeggen we liever meteen dan dat je er later achter komt.</p>
      </article>

      <aside class="zijkolom">
        <Inhoud items={hoofdstukken} leestijd={9} />
        <Prijskaart naam="Webteksten" prijs="€ 75" eenheid="per pagina" eenmalig punten={['Gesprek en zoekwoordonderzoek', 'Tekst in jouw toon', 'Title en meta description', 'Een correctieronde', 'De tekst is van jou']} />
        <Prijskaart naam="Contentmarketing" prijs="€ 495" eenheid="per maand" punten={['Elke maand nieuwe artikelen', 'Onderwerpen op basis van zoekvragen', 'Geschreven voor Google en AI', 'Per maand opzegbaar']} />
      </aside>
    </div>
  </section>

  <Bewijs />

  <Verder
    titel="Meer over teksten"
    links={[
      { label: 'Dienst', titel: 'Contentmarketing', href: '/tekstschrijver/contentmarketing/', tekst: 'Elke maand artikelen die klanten trekken.' },
      { label: 'Dienst', titel: 'SEO-teksten', href: '/zoekmachine-optimalisatie/seo-teksten/', tekst: 'Teksten die gevonden worden en overtuigen.' },
      { label: 'Gids', titel: 'SEO-teksten schrijven', href: '/kennisbank/gidsen/seo-teksten-schrijven/', tekst: 'Zelf schrijven, ook met hulp van AI.' },
      { label: 'Gids', titel: 'Een bedrijfsblog beginnen', href: '/kennisbank/gidsen/bedrijfsblog-beginnen/', tekst: 'Zonder de bekende fouten.' },
    ]}
  />

  <Faq
    vragen={[
      { v: 'Wat is het verschil tussen een tekstschrijver en een copywriter?', a: 'Weinig. Een copywriter schrijft vooral wervende tekst, zoals koppen, slogans en advertenties. Een tekstschrijver doet dat ook, maar schrijft daarnaast uitleg, artikelen en informatieve pagina\'s. Wij doen allebei.' },
      { v: 'Wat kost een tekstschrijver per pagina?', a: 'Bij ons vanaf € 75 per pagina, exclusief btw. Daar zitten het gesprek, het zoekwoordonderzoek, de tekst, een title en meta description en een correctieronde in. Je hoort de vaste prijs vooraf.' },
      { v: 'Hoe lang duurt het voordat mijn webteksten klaar zijn?', a: 'Dat hangt af van het aantal pagina\'s en van hoe snel we elkaar spreken. Na het eerste gesprek krijg je een planning met een datum per tekst. Zo weet je waar je aan toe bent.' },
      { v: 'Wat moet ik aanleveren voor mijn webteksten?', a: 'Weinig. Een halfuur aan de telefoon is meestal genoeg. Heb je al teksten, folders of offertes, stuur die dan mee. Daar staat vaak meer bruikbaars in dan je denkt.' },
      { v: 'Kunnen jullie mijn bestaande teksten verbeteren in plaats van nieuwe schrijven?', a: 'Ja. Soms is herschrijven genoeg. We kijken eerst wat er staat en zeggen je of herschrijven of opnieuw beginnen slimmer is. Herschrijven valt onder dezelfde prijs per pagina.' },
      { v: 'Van wie zijn de teksten?', a: 'Van jou. Als de tekst af en betaald is, mag je hem overal gebruiken: op je site, in een folder of in een mail.' },
      { v: 'Schrijven jullie ook in het Engels?', a: 'We werken ook voor bedrijven in het buitenland. Vraag het gerust. We zeggen je eerlijk of we jouw Engelse tekst zelf goed genoeg kunnen schrijven.' },
    ]}
  />

  <WieDoetHet wie={[{ slug: 'robert', taak: 'Doet SEO, content en strategie, sinds hij Drijfveer Media in 2011 oprichtte.' }, { slug: 'thorgall', taak: 'Je eerste aanspreekpunt. Hij belt je terug en houdt je project bij.' }]} />

  <Actie titel="Zullen we jouw teksten eens lezen?" tekst={`${site.contactpersoon} kijkt naar je website en belt je met de drie zinnen die het eerst beter moeten. Gratis, en je zit nergens aan vast.`} knop={{ tekst: 'Laat je teksten gratis nakijken', href: '/gratis-website-analyse/' }} />
</Base>
