---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/pagina/Hero.astro';
import Bewijs from '../../components/pagina/Bewijs.astro';
import Actie from '../../components/pagina/Actie.astro';
import Faq from '../../components/pagina/Faq.astro';
import SeoOpbrengst from '../../components/tool/SeoOpbrengst.astro';
import Scene from '../../components/scenes/cases.astro';
import { site } from '../../data/site';

const url = '/cases/';
const cases: { id: string; diensten: string[]; naam: string; soort: string; getal: string; wat: string; klant: string; vraag: string; deden: string[]; resultaat: string; reeks?: [string, number][]; bron?: string }[] = [
  {
    id: 'dakraamplaza',
    diensten: ['SEO', 'Linkbuilding'],
    naam: 'Dakraamplaza.nl',
    soort: 'Webshop in VELUX-dakramen',
    getal: '11.602',
    wat: 'zoekwoorden in de top 10 van Google',
    klant: 'Dakraamplaza.nl verkoopt dakramen, rolgordijnen en rolluiken van VELUX, met een eigen magazijn en bezorging door heel Nederland.',
    vraag: 'Bij de start had de webshop nog geen enkele positie in Google en geen verkeer om op voort te bouwen. Het doel: uitgroeien tot een van de best gevonden aanbieders van VELUX-dakramen.',
    deden: ['SEO vanaf de eerste dag, met een logische opbouw rond de productgroepen', 'On-page SEO op de belangrijkste pagina\'s', 'Structureel linkbuilding', 'Posities volgen en blijven bijsturen'],
    resultaat: 'Van 7 naar 11.602 zoekwoorden in de top 10 van Google. Nummer 1 op "VELUX dakraam", "VELUX dakraam maten" en "VELUX rolluik", nummer 2 op "dakramen", "dakraam" en "VELUX dakraam prijzen".',
    reeks: [['maart 2022', 7], ['maart 2023', 2380], ['maart 2024', 7592], ['maart 2025', 9317], ['oktober 2026', 11602]],
    bron: 'Top 10: historische gegevens van SE Ranking. Posities op de zoekwoorden gemeten op 20 oktober 2026.',
  },
  {
    id: 'willemfikstt',
    diensten: ['SEO', 'Linkbuilding', 'Teksten'],
    naam: 'Willemfikstt.nl',
    soort: 'Klusplatform',
    getal: '+87%',
    wat: 'bezoekers uit Google',
    klant: 'Een platform dat mensen met een klus koppelt aan klusbedrijven uit hun regio.',
    vraag: 'De site stond al op een paar goede posities. De vraag: die posities sterker maken en gevonden worden op woorden waar de site nog niet stond.',
    deden: ['Nieuwe pagina\'s per klus en plaats', 'Linkbuilding', 'Betere teksten', 'Eén vaste marketeer als aanspreekpunt'],
    resultaat: '87% meer bezoekers uit Google, de eerste plek op "klusjesman Amsterdam" en 60% meer aanvragen via de site.',
  },
  {
    id: 'conflictbemiddeling',
    diensten: ['Website', 'SEO', 'Linkbuilding', 'Google Ads'],
    naam: 'Conflictbemiddeling.nl',
    soort: 'Opleider voor mediators',
    getal: '+47%',
    wat: 'bezoekers uit Google',
    klant: 'Conflictbemiddeling Nederland leidt mediators op.',
    vraag: 'De basis lag er, maar voor de groei die ze wilden, was meer nodig dan losse acties.',
    deden: ['Een nieuwe, responsive website', 'SEO rond "mediation opleiding"', 'Linkbuilding', 'Google Ads, voor aanvragen terwijl de posities groeiden'],
    resultaat: '47% meer bezoekers uit Google en de eerste posities op "mediation opleiding".',
  },
  {
    id: 'dakraamconcurrent',
    diensten: ['Website', 'Linkbuilding', 'SEO'],
    naam: 'Dakraamconcurrent.nl',
    soort: 'VELUX-installatiepartner',
    getal: '+32%',
    wat: 'bezoekers uit Google',
    klant: 'Dakraam Concurrent plaatst en vervangt dakramen van VELUX.',
    vraag: 'Het bedrijf wilde de eerste plek zijn als mensen online naar dakramen zoeken. Daar was eerst een stevig fundament voor nodig.',
    deden: ['Eerst een nieuwe website', 'Daarna linkbuilding', 'Daarna SEO, met "dakraam plaatsen" voorop'],
    resultaat: '32% meer bezoekers uit Google en nummer 1 op "dakraam plaatsen".',
  },
  {
    id: 'cijferbaas',
    diensten: ['Website', 'SEO', 'Linkbuilding'],
    naam: 'Cijferbaas.nl',
    soort: 'Administratie- en boekhoudkantoor',
    getal: '+63%',
    wat: 'bezoekers uit Google',
    klant: 'Cijferbaas doet de boekhouding en belastingaangiftes voor ondernemers en geeft financieel advies.',
    vraag: 'Het doel: sterk online staan in Amsterdam en omgeving, met een site die makkelijk werkt en op elk scherm goed oogt.',
    deden: ['Een nieuwe, responsive website', 'SEO en linkbuilding'],
    resultaat: '63% meer bezoekers uit Google en meerdere eerste plekken, onder meer op "boekhouder webshop" en "boekhouder Amsterdam".',
  },
  {
    id: 'dw-huisontruiming',
    diensten: ['Website', 'SEO', 'Linkbuilding', 'Google Ads'],
    naam: 'DWhuisontruiming.nl',
    soort: 'Woningontruiming in Noord-Nederland',
    getal: '+40%',
    wat: 'bezoekers uit Google',
    klant: 'DW Huisontruiming ruimt woningen leeg en levert ze bezemschoon op, vaak na een overlijden.',
    vraag: 'Ze wilden meer aanvragen via de site. De oude site was een paar jaar oud en bijwerken zou veel kosten, dus kwam er een nieuwe.',
    deden: ['Een nieuwe website, met SEO vanaf het ontwerp', 'Na de lancering elke maand linkbuilding', 'Google Ads'],
    resultaat: '40% meer bezoekers uit Google en eerste plekken op belangrijke zoekwoorden in Drenthe, Friesland en Groningen.',
  },
  {
    id: 'industrialfreezing',
    diensten: ['Internationale SEO', 'Linkbuilding'],
    naam: 'IndustrialFreezing.com',
    soort: 'Leverancier van gebruikte vriesapparatuur',
    getal: '+32%',
    wat: 'bezoekers uit Google',
    klant: 'Industrial Freezing koopt, verkoopt, reviseert en installeert industriële vries- en koelapparatuur, voor voedselproducenten over de hele wereld.',
    vraag: 'De vraag: beter gevonden worden in het buitenland.',
    deden: ['Een grondig zoekwoordonderzoek voor een internationale SEO-strategie', 'Daarna internationale linkbuilding'],
    resultaat: '32% meer bezoekers uit Google, hogere posities in Nederland en het Verenigd Koninkrijk, en meer aanvragen via de eigen site.',
  },
  {
    id: 'van-leeuwen-bemiddeling',
    diensten: ['SEO', 'Linkbuilding'],
    naam: 'Van Leeuwen Bemiddeling',
    soort: 'Mediator',
    getal: '+650%',
    wat: 'zoekwoorden in de top 10 van Google',
    klant: 'Van Leeuwen Bemiddeling is mediator bij scheidingen, familieconflicten en zakelijke geschillen.',
    vraag: 'In 2023 kwamen ze bij ons, nadat de resultaten bij hun vorige marketingbureau tegenvielen. Het doel: op meer zoekopdrachten zichtbaar worden.',
    deden: ['On-page SEO: teksten en techniek afgestemd op wat mensen zoeken', 'Doorlopend linkbuilding', 'Elke maand de posities volgen'],
    resultaat: 'Van 4 naar 30 zoekwoorden in de top 10 van Google sinds januari 2023. Ook buiten de eerste pagina wordt de site op meer zoekopdrachten gevonden.',
    reeks: [['januari 2023', 4], ['januari 2024', 18], ['januari 2025', 19], ['oktober 2026', 30]],
    bron: 'Historische gegevens van SE Ranking.',
  },
  {
    id: 'zoekeenvakantiepark',
    diensten: ['Domeinverhuizing', 'Linkbuilding'],
    naam: 'ZoekEenVakantiepark.nl',
    soort: 'Vergelijker van vakantieparken',
    getal: '+575%',
    wat: 'zoekwoorden in de top 10, na een nieuwe naam',
    klant: 'ZoekEenVakantiepark.nl helpt mensen vakantieparken in Nederland te vinden en te vergelijken. Eerst heette het platform GoedkopeBungalowsNederland.nl.',
    vraag: 'De eigenaresse koos voor een nieuwe naam en een nieuwe site. De plek die de oude site in Google had opgebouwd, mocht daarbij niet verloren gaan.',
    deden: ['De verhuizing naar het nieuwe domein: alle oude adressen in kaart, 301-redirects ingesteld en nagekeken', 'Daarna structureel linkbuilding'],
    resultaat: 'Van 154 naar 1.039 zoekwoorden in de top 10 tussen april 2025 en oktober 2026. De oude site had er in december 2024 1.014. Het nieuwe domein staat er dus weer net zo sterk voor, nu onder de nieuwe naam.',
    reeks: [['april 2025', 154], ['juli 2025', 1076], ['oktober 2025', 960], ['oktober 2026', 1039]],
    bron: 'Historische gegevens van SE Ranking.',
  },
  {
    id: 'kantoorverhuur-zuidlaren',
    diensten: ['Website', 'Lokale SEO'],
    naam: 'Kantoorverhuur Zuidlaren',
    soort: 'Verhuur van kantoor- en praktijkruimtes',
    getal: '3 → 37',
    wat: 'zoekwoorden in Google',
    klant: 'Kantoorverhuur Zuidlaren verhuurt ingerichte werk- en praktijkruimtes in de voormalige Marechausseekazerne in Zuidlaren, aan zelfstandigen zoals coaches, therapeuten en adviseurs.',
    vraag: 'Er was nog geen website. De vraag: een site waarop huurders zelf de ruimtes bekijken en een bezichtiging aanvragen.',
    deden: ['Een eigen ontwerp', 'De hele site in WordPress, met een pagina per ruimte: foto\'s, afmetingen en voorzieningen', 'Huurprijzen en beschikbaarheid per weekdag in één overzicht', 'Een technische basis voor lokale vindbaarheid'],
    resultaat: 'Van 3 zoekwoorden in Google in november 2023 naar 37 in oktober 2026, met meerdere plekken op de eerste pagina.',
    bron: 'Historische gegevens van SE Ranking.',
  },
];
// Volgorde op de pagina: Dakraamplaza uitgelicht, daarna de rest.
const volgorde = ['willemfikstt', 'van-leeuwen-bemiddeling', 'zoekeenvakantiepark', 'conflictbemiddeling', 'cijferbaas', 'dw-huisontruiming', 'dakraamconcurrent', 'industrialfreezing', 'kantoorverhuur-zuidlaren'];
const uitgelicht = cases.find((c) => c.id === 'dakraamplaza')!;
const overige = volgorde.map((id) => cases.find((c) => c.id === id)!);
const maanden: Record<string, string> = { januari: 'jan', februari: 'feb', maart: 'mrt', april: 'apr', mei: 'mei', juni: 'jun', juli: 'jul', augustus: 'aug', september: 'sep', oktober: 'okt', november: 'nov', december: 'dec' };
const kortMaand = (m: string) => { const [maand, jaar] = m.split(' '); return `${maanden[maand] ?? maand} '${jaar.slice(2)}`; };
// Staafjes voor de meetmomenten: hoogte naar verhouding, de laatste staaf oranje.
const staven = (reeks: [string, number][], b = 320, h = 150) => {
  const max = Math.max(...reeks.map(([, n]) => n));
  const w = b / reeks.length;
  return reeks.map(([m, n], i) => {
    const hoog = Math.max(3, Math.round((n / max) * (h - 44)));
    return { x: i * w + w * 0.18, w: w * 0.64, y: h - 22 - hoog, hoog, label: kortMaand(m), waarde: n.toLocaleString('nl-NL'), laatste: i === reeks.length - 1, midden: i * w + w / 2 };
  });
};
const namen = ['Kärcher', 'bol.com', 'Nyenrode', 'Conflictbemiddeling Nederland', 'Glaspunt'];
const schema = [{
  '@type': 'CollectionPage',
  name: 'Cases van Drijfveer Media',
  url: `${site.url}${url}`,
  inLanguage: 'nl-NL',
  about: { '@id': `${site.url}/#organisatie` },
  dateModified: '2026-10-21',
}];
---
<Base
  title="Resultaten: wat ons werk opleverde | Drijfveer Media"
  description="Wat ons werk opleverde bij tien klanten: van 7 naar 11.602 top 10-posities, meer bezoekers uit Google en meer aanvragen. Per case wat we deden."
  kruimels={[{ naam: 'Resultaten', url }]}
  schema={schema}
>
  <Hero kicker="Resultaten" titel="Wat ons werk opleverde, in echte cijfers">
    <p>Beloven kan iedereen. Hier zie je wat er gebeurde bij tien klanten: meer bezoekers uit Google, de eerste plek op de woorden die ertoe doen en meer aanvragen. Per klant lees je wat we deden, in welke volgorde.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <h2>Tien klanten, tien aanpakken</h2>
    <p class="sectie-intro">Een webshop die bij nul begon. Een klusplatform dat al goed stond. Een mediator die van een ander bureau kwam en een platform dat een nieuwe naam kreeg. Een dakramenspecialist, een woningontruimer en een verhuurder van kantoren die eerst een nieuwe site nodig hadden. Elke case begon ergens anders, maar steeds op de plek waar het snelst verschil te maken was.</p>
    <article class="card case-uitgelicht" id={uitgelicht.id}>
      <div class="cu-tekst">
        <span class="kicker">Uitgelicht · {uitgelicht.soort}</span>
        <h3>{uitgelicht.naam}</h3>
        <p class="cu-getal"><b>{uitgelicht.getal}</b> <span>{uitgelicht.wat}</span></p>
        <p>{uitgelicht.klant} {uitgelicht.vraag}</p>
        <ul class="tags" aria-label="Diensten">{uitgelicht.diensten.map((d) => <li>{d}</li>)}</ul>
        <p class="kop-klein">Wat het opleverde</p>
        <p>{uitgelicht.resultaat}</p>
      </div>
      <figure class="cu-grafiek">
        <svg viewBox="0 0 320 150" role="img" aria-label={`Zoekwoorden in de top 10 van ${uitgelicht.naam}: ${uitgelicht.reeks!.map(([m, n]) => `${m} ${n.toLocaleString('nl-NL')}`).join(', ')}`}>
          {staven(uitgelicht.reeks!).map((st) => (
            <g>
              <rect x={st.x} y={st.y} width={st.w} height={st.hoog} rx="4" class:list={['staaf', { laatste: st.laatste }]} />
              <text x={st.midden} y={st.y - 6} text-anchor="middle" class="waarde">{st.waarde}</text>
              <text x={st.midden} y="144" text-anchor="middle" class="label">{st.label}</text>
            </g>
          ))}
        </svg>
        <figcaption class="klein muted">{uitgelicht.bron}</figcaption>
      </figure>
    </article>

    <div class="case-rijen">
      {overige.map((c) => (
        <article class="card case-rij" id={c.id}>
          <header class="cr-kop">
            <span class="kicker">{c.soort}</span>
            <h3>{c.naam}</h3>
            <p class="cr-getal"><b>{c.getal}</b><span>{c.wat}</span></p>
          </header>
          <div class="cr-verhaal">
            <p>{c.klant} {c.vraag}</p>
            <p class="kop-klein">Wat we deden</p>
            <ul class="deden">{c.deden.map((d) => <li>{d}</li>)}</ul>
          </div>
          <div class="cr-resultaat">
            <p class="kop-klein">Wat het opleverde</p>
            <p>{c.resultaat}</p>
            {c.reeks && (
              <svg class="mini" viewBox="0 0 320 150" role="img" aria-label={`Zoekwoorden in de top 10: ${c.reeks.map(([m, n]) => `${m} ${n.toLocaleString('nl-NL')}`).join(', ')}`}>
                {staven(c.reeks).map((st) => (
                  <g>
                    <rect x={st.x} y={st.y} width={st.w} height={st.hoog} rx="4" class:list={['staaf', { laatste: st.laatste }]} />
                    <text x={st.midden} y={st.y - 6} text-anchor="middle" class="waarde">{st.waarde}</text>
                    <text x={st.midden} y="144" text-anchor="middle" class="label">{st.label}</text>
                  </g>
                ))}
              </svg>
            )}
            <ul class="tags" aria-label="Diensten">{c.diensten.map((d) => <li>{d}</li>)}</ul>
            {c.bron && <p class="klein muted bron">{c.bron}</p>}
          </div>
        </article>
      ))}
    </div>

    <p class="muted volgt">Hoe de sites van DW Huisontruiming en Dakraam Concurrent eruitzien, zie je in ons <a href="/website-laten-maken/portfolio/">portfolio met websites</a>.</p>

    <div class="tekst onder">
      <h2>Wat deze cases gemeen hebben</h2>
      <p>Tien verschillende bedrijven, toch zie je hetzelfde patroon terug: eerst de basis, dan groei. Zo werken we bij elke klant.</p>
      <ul class="vink">
        <li><b>Eerst het doel, dan het werk.</b> Meestal is dat doel geen bezoekers, maar aanvragen.</li>
        <li><b>Woorden van mensen die iets willen.</b> "VELUX dakraam", "klusjesman Amsterdam", "dakraam plaatsen". Wie zo zoekt, staat op het punt om te kiezen.</li>
        <li><b>Links die autoriteit geven.</b> In negen van de tien cases hoorde <a href="/linkbuilding/">linkbuilding</a> erbij.</li>
        <li><b>De grootste kans eerst.</b> Daarna schaven we bij. Lees hoe dat gaat in <a href="/werkwijze/">onze werkwijze</a>.</li>
      </ul>

      <h2>Wat zou dit voor jou betekenen?</h2>
    </div>
    <SeoOpbrengst volume={400} van="o10" naar="o3" conversie={5} klant={33} waarde={1000} intro="Procenten zeggen pas iets als je ze omrekent naar je eigen zaak. Vul in hoe vaak er op je dienst wordt gezocht, waar je nu staat en waar je wilt staan." />
    <div class="tekst">

      <h2>Voor wie we nog meer werkten</h2>
      <p>Naast deze tien werkten we voor bedrijven en organisaties van heel verschillende grootte. Een paar namen:</p>
      <ul class="namen">
        {namen.map((n) => <li>{n}</li>)}
      </ul>
      <p>Voor hen deden we werk in online marketing, tekstschrijven, leadgeneratie en linkbuilding. Grote namen, maar we pakken het niet anders aan dan voor een eenmanszaak. Eerst vragen wat je wilt bereiken. Dan beginnen waar de grootste kans zit.</p>
      <p>Onze klanten komen uit het Noorden, uit de rest van Nederland en soms uit het buitenland. De meeste blijven jaren, terwijl alles per maand opzegbaar is.</p>
    </div>
  </section>

  <Bewijs case={false} />

  <Faq
    vragen={[
      { v: 'Waarom staat niet bij elke case een meetperiode?', a: 'Bij Dakraamplaza, Van Leeuwen Bemiddeling, ZoekEenVakantiepark en Kantoorverhuur Zuidlaren staat de periode erbij, met de bron. Bij de oudere cases komen de percentages uit de analytics van de klant, maar de precieze meetperiode hebben we niet meer. Dan noemen we hem liever niet dan dat we hem gokken. Bij nieuwe klanten leggen we de nulmeting en het doel vanaf dag één vast.' },
      { v: 'Wat zijn top 10-posities?', a: 'Het aantal zoekwoorden waarop een site op de eerste pagina van Google staat, volgens de database van SE Ranking. Het is een schatting, want SE Ranking volgt niet elke zoekopdracht. Maar het laat goed zien hoe breed een site gevonden wordt, en hoe dat verandert.' },
      { v: 'Hoe weet ik dat jullie dit bij mij ook halen?', a: 'Zeker weten doe je het vooraf nooit. Daarom spreken we bij maandelijkse diensten een meetbaar doel af, met een datum. Halen we dat niet en ligt het aan ons, dan werken we een maand gratis door. Zo werkt <a href="/garantie/">onze garantie</a>.' },
      { v: 'Wat deden jullie voor Kärcher en bol.com?', a: 'Voor de namen op deze pagina deden we werk in online marketing, tekstschrijven, leadgeneratie en linkbuilding. Wat precies voor wie, zetten we niet online.' },
    ]}
  />

  <Actie titel="Wat zou dit voor jouw bedrijf opleveren?" />
</Base>
<style>
  /* Uitgelichte case: tekst links, grafiek rechts */
  .case-uitgelicht { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px; align-items: center; padding: 32px; margin-bottom: 20px; scroll-margin-top: 100px; }
  .case-uitgelicht h3 { font-size: var(--step-2); margin: 4px 0 0; }
  .cu-tekst { display: flex; flex-direction: column; gap: 10px; }
  .cu-tekst p { margin: 0; }
  .cu-getal b { font-size: var(--step-4); font-weight: 900; color: var(--orange-tekst); letter-spacing: -0.04em; line-height: 1; }
  .cu-getal span { display: block; color: var(--muted); font-weight: 700; margin-top: 4px; }
  .cu-grafiek { margin: 0; background: color-mix(in srgb, var(--navy) 5%, transparent); border-radius: var(--radius); padding: 20px 18px 12px; }
  .cu-grafiek svg { width: 100%; height: auto; display: block; }
  .cu-grafiek figcaption { margin-top: 8px; }
  /* Overige cases: volle breedte, drie kolommen */
  .case-rijen { display: grid; gap: 16px; }
  .case-rij { display: grid; grid-template-columns: 240px minmax(0, 1.3fr) minmax(0, 1fr); gap: 28px; padding: 26px 28px; scroll-margin-top: 100px; }
  .case-rij p { margin: 0; }
  .cr-kop h3 { font-size: 1.3rem; margin: 4px 0 12px; }
  .cr-getal b { display: block; font-size: var(--step-3); font-weight: 900; color: var(--orange-tekst); letter-spacing: -0.04em; line-height: 1; }
  .cr-getal span { display: block; color: var(--muted); font-weight: 700; margin-top: 6px; line-height: 1.35; }
  .cr-verhaal, .cr-resultaat { display: flex; flex-direction: column; gap: 8px; }
  .cr-resultaat { border-left: 1px solid var(--line); padding-left: 28px; }
  .deden { margin: 0; padding-left: 1.1em; display: grid; gap: 4px; }
  .kop-klein { font-weight: 800; color: var(--navy); margin-top: 6px !important; }
  .tags { list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { margin: 0; font-size: 0.85rem; font-weight: 700; color: var(--navy); background: color-mix(in srgb, var(--navy) 8%, transparent); border-radius: 999px; padding: 4px 10px; }
  .mini { width: 100%; max-width: 300px; height: auto; margin-top: 4px; }
  .staaf { fill: color-mix(in srgb, var(--navy) 22%, transparent); }
  .staaf.laatste { fill: var(--orange); }
  .waarde { font-size: 13px; font-weight: 800; fill: var(--navy); }
  .label { font-size: 12px; fill: var(--muted); }
  .bron { margin-top: 4px !important; }
  @media (max-width: 1000px) {
    .case-rij { grid-template-columns: 200px minmax(0, 1fr); }
    .cr-resultaat { grid-column: 2; border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 14px; }
  }
  @media (max-width: 720px) {
    .case-uitgelicht { grid-template-columns: minmax(0, 1fr); padding: 22px; }
    .case-rij { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 22px; }
    .cr-resultaat { grid-column: auto; }
    .cr-kop h3 { margin-bottom: 8px; }
  }
  .volgt { margin-top: 16px; }
  .onder { margin-top: 56px; }
  .namen { list-style: none; padding: 0; margin: 8px 0 24px; display: flex; flex-wrap: wrap; gap: 10px; }
  .namen li { margin: 0; padding: 12px 18px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; font-weight: 800; font-size: 1.1rem; color: var(--navy); }
</style>
