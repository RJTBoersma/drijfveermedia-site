<script>
  // Rekenhulp: rekent opnieuw bij elke wijziging. Zonder JavaScript blijft het voorbeeld met de standaardwaarden staan.
  const blok = document.querySelector('[data-seo-zwolle-reken]');
  if (blok) {
    const euro = (n: number) => '€ ' + Math.round(n).toLocaleString('nl-NL');
    const waarde = (naam: string) => {
      const veld = blok.querySelector<HTMLInputElement>(`input[name="${naam}"]`);
      const n = parseFloat((veld?.value ?? '0').replace(',', '.'));
      return Number.isFinite(n) && n > 0 ? n : 0;
    };
    const reken = () => {
      const rest = (waarde('aanvraag') / 100) * (waarde('klant') / 100) * waarde('waarde');
      const nu = waarde('volume') * (waarde('nu') / 100) * rest;
      const straks = waarde('volume') * (waarde('straks') / 100) * rest;
      const zet = (sleutel: string, tekst: string) => { const el = blok.querySelector(`[data-uit="${sleutel}"]`); if (el) el.textContent = tekst; };
      zet('nu', euro(nu));
      zet('straks', euro(straks));
      zet('verschil', euro(straks - nu));
    };
    blok.addEventListener('input', reken);
    reken();
  }
</script>
