const hoofdstukken = [
  { id: 'waarom', titel: 'Waarom plannen werkt' },
  { id: 'begrippen', titel: 'Strategie, plan en kalender' },
  { id: 'vooruit', titel: 'Hoe ver plan je vooruit?' },
  { id: 'stappen', titel: 'Zo maak je je planning' },
  { id: 'voorbeeld', titel: 'Voorbeeld van een maand' },
  { id: 'meten', titel: 'Wat je meet, per doel' },
  { id: 'tools', titel: 'Welke planner kies je?' },
