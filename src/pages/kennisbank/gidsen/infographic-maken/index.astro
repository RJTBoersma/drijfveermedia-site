const url = '/kennisbank/gidsen/infographic-maken/';
const datum = '2026-10-18';
const hoofdstukken = [
  { id: 'wat-is', titel: 'Wat is een infographic?' },
  { id: 'wanneer', titel: 'Wanneer het werkt' },
  { id: 'soorten', titel: 'Zeven soorten' },
  { id: 'stappen', titel: 'In negen stappen' },
  { id: 'tools', titel: 'Welke tool kies je?' },
  { id: 'seo', titel: 'Bezoekers en links' },
  { id: 'voorbeeld', titel: 'Voorbeeld: een dakdekker' },
  { id: 'fouten', titel: 'Veelgemaakte fouten' },
  { id: 'checklist', titel: 'Checklist om af te vinken' },
  { id: 'hulp', titel: 'Zelf maken of laten maken?' },
];
const checklist = [
  'De boodschap past in één zin, en die zin staat bovenaan.',
  'Elk getal heeft een bron, en de bron staat onderaan met jaartal.',
  'Er zijn hooguit twee lettertypes en drie of vier kleuren gebruikt.',
  'Tekst haalt een contrast van minstens 4,5 staat tot 1 met de achtergrond.',
  'Betekenis zit niet alleen in kleur: er staan ook labels of vormen bij.',
  'De infographic is leesbaar op een telefoon, zonder in te zoomen.',
  'Iemand die het onderwerp niet kent, snapt de kern binnen tien seconden.',
  'Spelling, getallen en eenheden zijn door een tweede persoon gecontroleerd.',
  'Je logo en je webadres staan erop, klein en onderaan.',
  'De bestandsnaam beschrijft wat erop staat.',
  'Op de pagina staat een alt-tekst en de kern als gewone tekst.',
];
const download = 'data:text/plain;charset=utf-8,' + encodeURIComponent(
  'Checklist infographic maken\nDrijfveer Media, www.drijfveermedia.nl' + url + '\n\n' +
  checklist.map((c, i) => `[ ] ${i + 1}. ${c}`).join('\n') +
  `\n\nVragen? Bel ${site.contactpersoon}: ${site.telefoon}\n`
);
const stapTekst = [
  "Wat moet de lezer na het kijken weten of doen? En wie is die lezer? Een plaat voor vakgenoten mag vaktermen bevatten.",
  "Een infographic met vijf boodschappen heeft er geen. Vat het verhaal samen in één zin. Die zin wordt meestal je titel.",
  "Goede cijfers maken je plaat betrouwbaar en deelbaar. Er zijn drie soorten bronnen.",
  "De vraag is niet welke grafiek mooi is, maar wat je wilt laten zien. Deze tabel helpt bij het kiezen.",
  "Pak pen en papier voordat je een tool opent. Een schets kost vijf minuten en voorkomt uren schuiven.",
  "Begin bij je huisstijl. Een infographic in je eigen kleuren herken je later terug, ook als iemand anders hem deelt.",
  "Nu pas open je een programma. Welke tool past, lees je hieronder. Werk met een raster, zodat blokken netjes uitlijnen.",
  "Laat iemand die het onderwerp niet kent tien seconden kijken. Vraag daarna wat de boodschap was.",
  "Een infographic die alleen op je computer staat, levert niets op. Zet hem op een eigen pagina op je site, met uitleg erbij.",
];
const schema = [{
  '@type': 'Article',
  headline: 'Infographic maken: van losse cijfers naar één helder beeld',
  datePublished: datum,
  dateModified: datum,
  author: { '@type': 'Person', name: persoon('robert').naam, jobTitle: persoon('robert').rol, url: `${site.url}/over-ons/` },
  publisher: { '@id': `${site.url}/#organisatie` },
  mainEntityOfPage: `${site.url}${url}`,
  inLanguage: 'nl-NL',
  about: 'Infographic',
  citation: [
    'https://developers.google.com/search/docs/appearance/google-images',
    'https://developers.google.com/search/docs/essentials/spam-policies',
    'https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html',
    'https://www.w3.org/WAI/WCAG22/Understanding/non-text-contrast.html',
    'https://www.cbs.nl/nl-nl/over-ons/website/copyright',
    'https://help.pinterest.com/en/business/article/pinterest-product-specs',
    'https://www.linkedin.com/help/linkedin/answer/a564109',
    'https://www.datawrapper.de/pricing',
  ],
}, {
  '@type': 'HowTo',
  name: 'Een infographic maken',
  step: [
    'Bepaal doel en doelgroep', 'Kies één boodschap', 'Verzamel data en bronnen', 'Kies de juiste grafiek', 'Schets de indeling op papier',
    'Kies kleuren, lettertype en pictogrammen', 'Bouw het ontwerp in een tool', 'Laat het controleren', 'Publiceer en deel',
  ].map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s, text: stapTekst[i], url: `${site.url}${url}#stappen` })),
