<style>
  .promptbouwer .pb-velden { display: grid; gap: 12px; margin-bottom: 14px; }
  .promptbouwer label { display: grid; gap: 4px; font-weight: 700; font-size: 0.98rem; }
  .promptbouwer input { font: inherit; font-weight: 400; padding: 10px 12px; border: 1px solid var(--lijn, #d9e1ea); border-radius: 8px; background: #fff; color: inherit; width: 100%; box-sizing: border-box; }
  .promptbouwer .pb-uit { white-space: pre-wrap; word-break: break-word; background: #fff; border: 1px solid var(--lijn, #d9e1ea); border-radius: 8px; padding: 12px 14px; font-size: 0.95rem; margin: 0 0 14px; }
</style>
<script>
  const veld = (id: string) => document.getElementById(id) as HTMLInputElement | null;
  const uit = document.getElementById('pb-uit');
  const knop = document.getElementById('pb-kopieer') as HTMLButtonElement | null;
  const schoon = (s: string) => s.trim().replace(/[.\s]+$/, '');
  const maak = () => {
    if (!uit) return;
    const wie = schoon(veld('pb-wie')?.value ?? '');
    const wat = schoon(veld('pb-wat')?.value ?? '');
    const voor = schoon(veld('pb-voor')?.value ?? '');
    const vorm = schoon(veld('pb-vorm')?.value ?? '');
    const delen = [];
    if (wie) delen.push(wie + '.');
    if (wat) delen.push(wat + '.');
    if (voor) delen.push('Het is bedoeld voor: ' + voor.charAt(0).toLowerCase() + voor.slice(1) + '.');
    if (vorm) delen.push('Vorm: ' + vorm.charAt(0).toLowerCase() + vorm.slice(1) + '.');
    delen.push('Stel me eerst vragen als je iets mist.');
    uit.textContent = delen.join(' ');
  };
  ['pb-wie', 'pb-wat', 'pb-voor', 'pb-vorm'].forEach((id) => veld(id)?.addEventListener('input', maak));
  if (knop && navigator.clipboard) {
    knop.hidden = false;
    knop.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(uit?.textContent ?? '');
        knop.textContent = 'Gekopieerd';
        setTimeout(() => { knop.textContent = 'Kopieer prompt'; }, 2000);
      } catch { /* kopiëren niet toegestaan: tekst blijft zichtbaar om zelf te selecteren */ }
    });
  }
</script>
