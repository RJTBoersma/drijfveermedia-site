const hoofdstukken = [
  { id: 'wat-is-conversie', titel: 'Wat is conversie?' },
  { id: 'rekenvoorbeeld', titel: 'Wat een procent oplevert' },
  { id: 'meten', titel: 'Eerst meten' },
  { id: 'trechter', titel: 'Waar het lekt' },
  { id: 'verbeteringen', titel: 'Vijftien verbeteringen' },
  { id: 'teksten', titel: 'Knoppen en koppen' },
  { id: 'triggers', titel: 'Psychologie, eerlijk gebruikt' },
