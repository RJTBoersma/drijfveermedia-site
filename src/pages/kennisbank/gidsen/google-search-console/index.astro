  author: { '@type': 'Person', name: persoon('robert').naam, jobTitle: persoon('robert').rol, url: `${site.url}/over-ons/` },
  publisher: { '@id': `${site.url}/#organisatie` },
  mainEntityOfPage: `${site.url}${url}`,
  inLanguage: 'nl-NL',
  about: 'Google Search Console',
  citation: [
    'https://support.google.com/webmasters/answer/9128668?hl=nl',
    'https://support.google.com/webmasters/answer/34592?hl=nl',
    'https://support.google.com/webmasters/answer/9008080?hl=nl',
    'https://support.google.com/webmasters/answer/7687615?hl=nl',
    'https://support.google.com/webmasters/answer/7576553?hl=nl',
    'https://support.google.com/webmasters/answer/9012289?hl=nl',
    'https://support.google.com/webmasters/answer/7440203?hl=nl',
    'https://support.google.com/webmasters/answer/7451001?hl=nl',
    'https://support.google.com/webmasters/answer/9205520?hl=nl',
    'https://support.google.com/webmasters/answer/9044101?hl=nl',
    'https://support.google.com/webmasters/answer/9044175?hl=nl',
    'https://support.google.com/webmasters/answer/9689846?hl=nl',
