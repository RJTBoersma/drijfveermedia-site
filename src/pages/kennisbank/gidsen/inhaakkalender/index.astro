// De weekdag en het weeknummer rekenen we uit de datum zelf uit, zodat die altijd kloppen.
const maandNamen = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
const dagNamen = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];
const lees = (iso: string) => {
  const d = new Date(iso + 'T12:00:00Z');
  return `${dagNamen[d.getUTCDay()]} ${d.getUTCDate()} ${maandNamen[d.getUTCMonth()]}`;
};
// ISO-weeknummer, zoals in Nederlandse agenda's
const week = (iso: string) => {
  const d = new Date(iso + 'T12:00:00Z');
  const dag = (d.getUTCDay() + 6) % 7;
  d.setUTCDate(d.getUTCDate() - dag + 3);
  const jan4 = new Date(Date.UTC(d.getUTCFullYear(), 0, 4, 12));
  const dag4 = (jan4.getUTCDay() + 6) % 7;
  jan4.setUTCDate(jan4.getUTCDate() - dag4 + 3);
  return 1 + Math.round((d.getTime() - jan4.getTime()) / (7 * 86400000));
};
