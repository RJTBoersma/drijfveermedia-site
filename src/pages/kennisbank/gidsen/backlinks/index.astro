  { id: 'zelf-of-uitbesteden', titel: 'Zelf doen of uitbesteden?' },
];
const schema = [{
  '@type': 'Article',
  headline: 'Wat zijn backlinks? Uitleg, soorten en hoe je eraan komt',
  datePublished: datum,
  dateModified: gewijzigd,
  author: { '@type': 'Person', name: persoon('robert').naam, jobTitle: persoon('robert').rol, url: `${site.url}/over-ons/` },
