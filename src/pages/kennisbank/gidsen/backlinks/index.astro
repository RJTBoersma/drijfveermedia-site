  { id: 'waarom', titel: 'Waarom Google naar links kijkt' },
  { id: 'waardevol', titel: 'Wat een link waardevol maakt' },
  { id: 'soorten', titel: 'Soorten backlinks' },
  { id: 'eraan-komen', titel: 'Hoe kom je aan backlinks?' },
  { id: 'vermijden', titel: 'Links die je moet vermijden' },
