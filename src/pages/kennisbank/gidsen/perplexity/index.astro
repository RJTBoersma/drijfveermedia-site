<Base
  bronnenBlok={false}
  title="Perplexity: wat is het en hoe word je bron?"
  description="Perplexity uitgelegd: hoe de AI-zoekmachine met bronvermelding werkt, wat elk abonnement kost, hoe veilig het is en hoe je bedrijf bron wordt."
  kruimels={[{ naam: 'Kennisbank', url: '/kennisbank/' }, { naam: 'Gidsen', url: '/kennisbank/gidsen/' }, { naam: 'Wat is Perplexity?', url }]}
