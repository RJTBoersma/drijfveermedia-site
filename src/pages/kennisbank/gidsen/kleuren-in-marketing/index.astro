// Contrast volgens de formule van de WCAG-richtlijn, zodat de getallen in de tabel altijd kloppen.
const lin = (c: number) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const lum = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => lin(parseInt(hex.slice(i, i + 2), 16) / 255));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};
const getal = (n: number) => n.toFixed(1).replace('.', ',');
const tekstOp = (hex: string) => {
  const wit = contrast(hex, '#ffffff');
  const zwart = contrast(hex, '#000000');
  return wit >= zwart ? `Witte tekst (${getal(wit)} : 1)` : `Zwarte tekst (${getal(zwart)} : 1)`;
};

const kleuren = [
  { naam: 'Blauw', hex: '#1d5fa8', gevoel: 'Vertrouwen, rust, deskundig', zie: 'Banken, verzekeraars, zorg, IT', valkuil: 'Koel en afstandelijk, je valt niet op' },
  { naam: 'Rood', hex: '#d62828', gevoel: 'Energie, urgentie, passie', zie: 'Supermarkten, fastfood, aanbiedingen', valkuil: 'Kan agressief of goedkoop overkomen' },
  { naam: 'Oranje', hex: '#ff6600', gevoel: 'Vriendelijk, actief, betaalbaar', zie: 'Knoppen, acties, energiebedrijven', valkuil: 'Te veel oranje oogt druk' },
  { naam: 'Geel', hex: '#f2c230', gevoel: 'Optimisme, aandacht, vrolijk', zie: 'Bouw, waarschuwingen, kinderen', valkuil: 'Slecht leesbaar op wit' },
  { naam: 'Groen', hex: '#1f8a5b', gevoel: 'Natuur, gezond, groei', zie: 'Duurzaamheid, hoveniers, zorg', valkuil: 'Groen alleen maakt je niet duurzaam' },
  { naam: 'Paars', hex: '#6a3d9a', gevoel: 'Luxe, creatief, bijzonder', zie: 'Beauty, wellness, opleidingen', valkuil: 'Kan zweverig worden' },
  { naam: 'Roze', hex: '#d6457a', gevoel: 'Zacht, speels, zorgzaam', zie: 'Beauty, snoep, kinderproducten', valkuil: 'Kan te zoet of kinderachtig lijken' },
  { naam: 'Bruin', hex: '#7b4a2a', gevoel: 'Aards, ambachtelijk, warm', zie: 'Koffie, hout, bakkers, leer', valkuil: 'Oogt snel ouderwets of dof' },
  { naam: 'Zwart', hex: '#111111', gevoel: 'Stijl, kracht, exclusief', zie: 'Mode, auto\'s, premium merken', valkuil: 'Zwaar of somber zonder accent' },
  { naam: 'Wit en grijs', hex: '#c9d3dd', gevoel: 'Rust, ruimte, neutraal', zie: 'Tech, architectuur, als achtergrond', valkuil: 'Saai zonder één sterke kleur' },
];
const palet = [
  { rol: 'Hoofdkleur', naam: 'Bosgroen', hex: '#2f5d3a', aandeel: '30%' },
  { rol: 'Accentkleur', naam: 'Zonnegeel', hex: '#f2b705', aandeel: '10%' },
  { rol: 'Tekst', naam: 'Antraciet', hex: '#22272b', aandeel: 'Lopende tekst' },
  { rol: 'Achtergrond', naam: 'Gebroken wit', hex: '#f7f5ef', aandeel: '60%' },
];
---
<Base
  title="Kleuren in marketing: betekenis en keuze | Drijfveer Media"
  description="Kleuren in marketing: wat betekenen rood, blauw, groen en oranje, wat zegt het onderzoek en hoe kies je kleuren voor je merk en website? Met tabellen."
  kruimels={[{ naam: 'Kennisbank', url: '/kennisbank/' }, { naam: 'Gidsen', url: '/kennisbank/gidsen/' }, { naam: 'Kleuren in marketing', url }]}
