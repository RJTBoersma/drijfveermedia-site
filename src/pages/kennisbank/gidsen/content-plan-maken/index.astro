<script>
  document.querySelectorAll<HTMLElement>('[data-rekenhulp]').forEach((blok) => {
    const veld = (k: string) => blok.querySelector<HTMLInputElement>(`[data-k="${k}"]`);
    const uit = (k: string) => blok.querySelector<HTMLElement>(`[data-u="${k}"]`);
    const getal = (n: number) => Math.ceil(n).toLocaleString('nl-NL');
    const reken = () => {
      const klanten = Number(veld('klanten')?.value) || 0;
      const sluit = (Number(veld('sluit')?.value) || 0) / 100;
      const conv = (Number(veld('conv')?.value) || 0) / 100;
      const bezoek = Number(veld('bezoek')?.value) || 0;
      if (!klanten || !sluit || !conv || !bezoek) return;
      const aanvragen = klanten / sluit;
      const bezoekers = aanvragen / conv;
      const a = uit('aanvragen'), b = uit('bezoekers'), c = uit('artikelen');
      if (a) a.textContent = getal(aanvragen);
      if (b) b.textContent = getal(bezoekers);
      if (c) c.textContent = getal(bezoekers / bezoek);
    };
    blok.addEventListener('input', reken);
  });
</script>
