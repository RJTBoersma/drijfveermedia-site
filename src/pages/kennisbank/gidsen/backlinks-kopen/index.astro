const url = '/kennisbank/gidsen/backlinks-kopen/';
const datum = '2026-10-19';
const hoofdstukken = [
  { id: 'wat', titel: 'Wat je koopt' },
  { id: 'google', titel: 'Wat Google zegt' },
  { id: 'misgaat', titel: 'Als het misgaat' },
  { id: 'checklist', titel: 'Een aanbieding beoordelen' },
  { id: 'prijzen', titel: 'Wat het kost' },
  { id: 'alternatieven', titel: 'Alternatieven' },
