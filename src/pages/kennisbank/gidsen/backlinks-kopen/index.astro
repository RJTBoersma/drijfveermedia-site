      { label: 'Gids', titel: 'Wat kost linkbuilding?', href: '/kennisbank/gidsen/wat-kost-linkbuilding/', tekst: 'Prijzen per link en per maand, met bronnen en een rekenhulp.', teken: 'munten' },
      { label: 'Dienst', titel: 'Google disavow tool', href: '/linkbuilding/google-disavow-tool/', tekst: 'Slechte links onschadelijk maken.' },
      { label: 'Gids', titel: 'Lokale linkbuilding', href: '/kennisbank/gidsen/lokale-linkbuilding/', tekst: 'Linkkansen in Drenthe, Groningen en Friesland.' },
      { label: 'Dienst', titel: 'Linkbuilding uitbesteden', href: '/linkbuilding/linkbuilding-uitbesteden/', tekst: '€ 75 per uur, meestal drie tot vijf links per uur.' },
