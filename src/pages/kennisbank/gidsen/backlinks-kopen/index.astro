];
// Opgehaald met curl op 19 oktober 2026.
const bronnen = [
  'https://developers.google.com/search/docs/essentials/spam-policies?hl=nl',
  'https://developers.google.com/search/docs/crawling-indexing/qualify-outbound-links?hl=nl',
