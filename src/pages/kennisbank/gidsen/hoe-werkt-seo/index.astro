<Base
  title="Wat is SEO en hoe werkt SEO? Uitleg voor ondernemers"
  description="Hoe werkt SEO? Heldere uitleg voor ondernemers: hoe Google pagina's vindt en rangschikt, wat telt en wat niet, en hoe lang het duurt voor het werkt."
  kruimels={[{ naam: 'Kennisbank', url: '/kennisbank/' }, { naam: 'Gidsen', url: '/kennisbank/gidsen/' }, { naam: 'Hoe werkt SEO?', url }]}
