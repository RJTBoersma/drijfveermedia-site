---
<Base
  bronnenBlok={false}
  title="Claude Code: wat is het en wat kost het in 2026?"
  description="Wat is Claude Code? De programmeeragent van Anthropic uitgelegd: hoe het werkt, wat het kost, installeren in vijf stappen en veilig werken met toestemmingen."
  kruimels={[{ naam: 'Kennisbank', url: '/kennisbank/' }, { naam: 'Gidsen', url: '/kennisbank/gidsen/' }, { naam: 'Claude Code', url }]}
  schema={schema}
