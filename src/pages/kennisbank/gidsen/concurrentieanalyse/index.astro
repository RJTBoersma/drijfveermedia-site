<script>
  document.querySelectorAll<HTMLElement>('[data-matrix]').forEach((blok) => {
    const rijen = [...blok.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const totalen = [...blok.querySelectorAll<HTMLOutputElement>('[data-tot]')];
    const namen = [...blok.querySelectorAll<HTMLInputElement>('[data-naam]')];
    const knop = blok.querySelector<HTMLAnchorElement>('[data-download]');
    const getal = (el: HTMLInputElement | null, min: number) => Math.min(5, Math.max(min, Number(el?.value) || 0));
    const cel = (c: string | number) => `"${String(c).replace(/"/g, '""')}"`;
    const reken = () => {
      const som = totalen.map(() => 0);
      let gewicht = 0;
      const regels = [['Criterium', 'Weging', ...namen.map((n) => n.value)]];
      rijen.forEach((r) => {
        const w = getal(r.querySelector('[data-w]'), 0);
        gewicht += w;
        const scores = totalen.map((_, i) => getal(r.querySelector(`[data-s="${i}"]`), 1));
        scores.forEach((s, i) => { som[i] += s * w; });
        regels.push([r.querySelector('th')?.firstChild?.textContent?.trim() ?? '', String(w), ...scores.map(String)]);
      });
      const uit = som.map((s) => (gewicht ? s / gewicht : 0));
      const hoogste = Math.max(...uit);
      totalen.forEach((t, i) => {
        t.textContent = uit[i].toLocaleString('nl-NL', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
        t.classList.toggle('beste', gewicht > 0 && uit[i] === hoogste);
      });
      regels.push(['Gewogen score', '', ...uit.map((u) => u.toFixed(1).replace('.', ','))]);
      if (knop) knop.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent('﻿' + regels.map((r) => r.map(cel).join(';')).join('\r\n'));
    };
    blok.addEventListener('input', reken);
    reken();
  });
</script>
