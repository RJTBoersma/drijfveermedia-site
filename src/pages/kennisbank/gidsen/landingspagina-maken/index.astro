const check = [
  'De pagina heeft één doel en één soort knop.',
  'De kop gebruikt dezelfde woorden als de advertentie, mail of flyer.',
  'Boven in beeld staan de kop, de belofte, de knop en je telefoonnummer.',
  'Het menu en andere uitgangen zijn weg.',
  'Er staat een prijs, vanaf-prijs of prijsindicatie op.',
  'Er staat echt bewijs op: reviews, foto\'s van eigen werk of een case.',
  'De drie tot vijf vragen die klanten altijd stellen, zijn beantwoord.',
  'Het formulier vraagt alleen wat je nodig hebt om terug te bellen.',
  'Onder de knop staat wat er na het versturen gebeurt.',
  'De pagina laadt snel op een telefoon met mobiele data.',
  'Kleuren, beeld en toon passen bij de advertentie of mail.',
  'Er is een bedankpagina, en die wordt gemeten als conversie.',
  'Klikken op je telefoonnummer worden ook gemeten.',
  'Je weet of de pagina in Google moet komen of op noindex staat.',
