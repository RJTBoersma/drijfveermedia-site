import Scene from '../../../../components/scenes/kennisbank--gidsen--landingspagina-maken.astro';
import { site, persoon } from '../../../../data/site';
import Tussenactie from '../../../../components/pagina/Tussenactie.astro';

const url = '/kennisbank/gidsen/landingspagina-maken/';
const gepubliceerd = '2026-10-17';
const datum = '2026-10-18';
const hoofdstukken = [
  { id: 'wat-is-het', titel: 'Wat is een landingspagina?' },
  { id: 'soorten', titel: 'Soorten pagina\'s' },
  { id: 'vooraf', titel: 'Drie vragen vooraf' },
  { id: 'stappen', titel: 'Tien stappen' },
  { id: 'opbouw', titel: 'De opbouw van boven naar beneden' },
  { id: 'teksten', titel: 'De teksten' },
  { id: 'ontwerp', titel: 'Ontwerp en beeld' },
  { id: 'lengte', titel: 'Hoe lang?' },
  { id: 'formulier', titel: 'Het formulier' },
  { id: 'voorbeeld', titel: 'Uitgewerkt voorbeeld' },
  { id: 'voorbeeld-download', titel: 'Tweede voorbeeld' },
  { id: 'tools', titel: 'Waarmee bouw je hem?' },
  { id: 'google', titel: 'Google Ads en SEO' },
  { id: 'meten', titel: 'Meten en verbeteren' },
  { id: 'opvolging', titel: 'Na de aanvraag' },
  { id: 'fouten', titel: 'Fouten die we vaak zien' },
  { id: 'checklist', titel: 'Checklist' },
  { id: 'zelf-of-laten', titel: 'Zelf maken of laten maken?' },
