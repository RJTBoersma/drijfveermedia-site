const hoofdstukken = [
  { id: 'wat-is-branding', titel: 'Wat is branding?' },
  { id: 'verschil', titel: 'Merk, logo en huisstijl' },
  { id: 'waarom', titel: 'Waarom het ook voor jou telt' },
  { id: 'stappen', titel: 'Je merk bouwen in zes stappen' },
  { id: 'consistent', titel: 'Overal hetzelfde verhaal' },
