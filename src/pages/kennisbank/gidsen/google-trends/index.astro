<style>
  .planner-keuze { display: grid; gap: 6px; font-weight: 700; max-width: 320px; margin-bottom: 14px; }
  .planner-keuze select { font: inherit; font-weight: 400; padding: 10px 12px; border: 1px solid var(--lijn, #d9e1ea); border-radius: 8px; background: #fff; color: inherit; }
  .planner-uit { margin: 0 0 10px; padding-left: 20px; }
  .planner-uit li { margin-bottom: 6px; }
</style>
<script>
  const maanden = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
  const stappen = [
    [-4, 'kijk welke vragen er vorig jaar opkwamen bij de gerelateerde zoekopdrachten.'],
    [-3, 'schrijf of vernieuw je pagina en zet hem online.'],
    [-2, 'controleer in Search Console of de pagina gevonden wordt, en vul hem aan.'],
    [-1, 'zet je advertenties en social posts klaar.'],
    [0, 'de piek. Kijk dagelijks naar je aanvragen.'],
    [1, 'schrijf op wat werkte, voor volgend jaar.'],
  ] as const;
  const keuze = document.getElementById('sp-maand') as HTMLSelectElement | null;
  const uit = document.getElementById('sp-uit');
  const toon = () => {
    if (!keuze || !uit) return;
    const piek = Number(keuze.value);
    uit.innerHTML = stappen.map(([d, t]) => `<li><b>${maanden[(piek + d + 12) % 12]}:</b> ${t}</li>`).join('');
  };
  keuze?.addEventListener('change', toon);
</script>
