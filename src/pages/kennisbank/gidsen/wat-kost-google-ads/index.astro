<script>
  const form = document.querySelector<HTMLFormElement>('[data-ads-reken]');
  const uit = (k: string) => document.querySelector<HTMLElement>(`[data-uit="${k}"]`);
  const eur = (n: number) => '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const een = (n: number) => n.toLocaleString('nl-NL', { maximumFractionDigits: 1 });
  function reken() {
    if (!form) return;
    const d = new FormData(form);
    const g = (k: string) => Math.max(0, Number(String(d.get(k) ?? '').replace(',', '.')) || 0);
    const budget = g('budget'), cpc = g('cpc'), conv = g('conversie') / 100, win = g('winkans') / 100, waarde = g('waarde');
    const klikken = cpc ? budget / cpc : 0;
    const aanvragen = klikken * conv;
    const klanten = aanvragen * win;
    const zet = (k: string, v: string) => { const el = uit(k); if (el) el.textContent = v; };
    zet('dag', eur(budget / 30.4));
    zet('klikken', String(Math.round(klikken)));
    zet('aanvragen', een(aanvragen));
    zet('cpa', aanvragen ? eur(budget / aanvragen) : 'n.v.t.');
    zet('klanten', een(klanten));
    zet('perKlant', klanten ? eur(budget / klanten) : 'n.v.t.');
    zet('terug', budget ? eur((klanten * waarde) / budget) : 'n.v.t.');
    zet('maxCpc', eur(waarde * conv * win));
  }
  form?.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement | HTMLSelectElement;
    if (t.name === 'beroep' && t.value) { const c = form.querySelector<HTMLInputElement>('input[name="cpc"]'); if (c) c.value = t.value; }
    reken();
  });
  form?.addEventListener('change', reken);
</script>
