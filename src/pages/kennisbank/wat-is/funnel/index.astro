  { id: 'verschil', titel: 'Marketing funnel of sales funnel' },
  { id: 'modellen', titel: 'Funnel, AIDA en customer journey' },
  { id: 'rekenvoorbeeld', titel: 'Rekenvoorbeeld: waar lekt het?' },
