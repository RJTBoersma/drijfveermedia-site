import Tussenactie from '../../../../components/pagina/Tussenactie.astro';

const url = '/kennisbank/wat-is/interne-links/';
const datum = '2026-10-18';
const definitie = 'Interne links zijn links van de ene pagina op je website naar een andere pagina op dezelfde website.';
const hoofdstukken = [
  { id: 'soorten', titel: 'Soorten interne links' },
  { id: 'wat-ze-doen', titel: 'Wat ze doen' },
  { id: 'google-leest', titel: 'Hoe Google een link leest' },
  { id: 'structuur', titel: 'De ideale linkstructuur' },
  { id: 'anchortekst', titel: 'De woorden waarop je klikt' },
  { id: 'hoeveel', titel: 'Hoeveel links per pagina?' },
  { id: 'search-console', titel: 'Controleren in Search Console' },
  { id: 'stappenplan', titel: 'Stappenplan in één middag' },
  { id: 'wordpress', titel: 'Links leggen in WordPress' },
  { id: 'regio', titel: 'Plaatsen en regio\'s' },
  { id: 'fouten', titel: 'Acht fouten' },
  { id: 'voorbeeld', titel: 'Een voorbeeld' },
  { id: 'checklist', titel: 'Checklist bij elke nieuwe pagina' },
];
const soorten = [
  ['Menu', 'Bovenaan elke pagina', 'Laat zien wat de hoofdonderwerpen van je site zijn.'],
  ['Footer', 'Onderaan elke pagina', 'Vangnet voor contact, voorwaarden en je belangrijkste diensten.'],
  ['Kruimelpad', 'Boven de kop van een pagina', 'Laat zien waar een pagina in je site hoort, en linkt terug naar de laag erboven.'],
  ['Links in de tekst', 'Midden in een alinea', 'Zegt het meest over het verband tussen twee pagina\'s, omdat de zin eromheen het uitlegt.'],
  ['Blok met verwante pagina\'s', 'Onder een artikel', 'Geeft de lezer een volgende stap en houdt oudere pagina\'s in beeld.'],
  ['Overzichtspagina', 'Een pagina met alleen kaarten of een lijst', 'Bundelt alles over één onderwerp, zoals een begrippenlijst.'],
  ['Inhoudsopgave', 'Bovenaan een lange pagina', 'Springt naar een kop op dezelfde pagina. Handig voor wie snel een antwoord zoekt.'],
  ['Knop of afbeelding', 'Overal', 'Telt ook als link. Bij een afbeelding gebruikt Google de alt-tekst als linktekst.'],
];
const schema = [{
  '@type': 'DefinedTerm',
  name: 'Interne links',
  alternateName: ['Interne link', 'Interne linkbuilding'],
  description: definitie,
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Begrippen van Drijfveer Media', url: `${site.url}/kennisbank/wat-is/` },
  url: `${site.url}${url}`,
}, {
  '@type': 'Article',
  headline: 'Wat zijn interne links? Uitleg en tips',
  datePublished: '2026-10-17',
  dateModified: datum,
  author: { '@type': 'Person', name: persoon('thorgall').naam, jobTitle: persoon('thorgall').rol, url: `${site.url}/over-ons/` },
  publisher: { '@id': `${site.url}/#organisatie` },
  mainEntityOfPage: `${site.url}${url}`,
  inLanguage: 'nl-NL',
  about: 'Interne links',
}];
---
<Base
  title="Wat zijn interne links? Uitleg en tips | Drijfveer Media"
  description="Wat zijn interne links? Links tussen pagina's van je eigen site. Lees wat ze voor Google en bezoekers doen en hoe je ze slim legt, met een voorbeeld."
  kruimels={[{ naam: 'Kennisbank', url: '/kennisbank/' }, { naam: 'Begrippen', url: '/kennisbank/wat-is/' }, { naam: 'Interne links', url }]}
  schema={schema}
  ogType="article"
>
  <section class="wrap begrip">
    <div class="kop-rij">
      <div>
        <p class="kicker">Begrip · SEO</p>
        <h1>Wat zijn interne links?</h1>
        <div class="card definitie">
          <p class="kader-titel">In één zin</p>
          <p>{definitie}</p>
        </div>
      </div>
      <div style={`view-transition-name:${overgang(url)}`}><Scene /></div>
    </div>

    <article class="tekst">
      <Auteur slug="thorgall" datum={datum} />
      <p>Je hebt ze op elke site, ook als je er nooit over nadacht. Het menu, de knop naar je contactpagina, het woordje in een blog dat naar je prijzen wijst. Allemaal links binnen je eigen site. Een link naar een andere website heet een externe link. Komt een link van een andere site naar jou toe, dan is het een backlink.</p>
      <p>Van al het werk aan SEO is dit het meest onderschatte stuk. Je hebt er geen andere sites voor nodig, het kost niets en je kunt er vandaag mee beginnen. Hieronder lees je hoe het werkt, hoe je het controleert en hoe je het in één middag beter maakt.</p>

      <div class="inhoud-blok"><Inhoud items={hoofdstukken} leestijd={12} /></div>

      <div class="stap-kop"><Tekening naam="ketting" maat={52} /><h2 id="soorten">Soorten interne links</h2></div>
      <p>Niet elke interne link doet hetzelfde. Dit zijn de soorten die je op bijna elke site tegenkomt:</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Soort</th><th>Waar</th><th>Wat het doet</th></tr></thead>
          <tbody>
            {soorten.map(([s, w, d]) => <tr><td><b>{s}</b></td><td>{w}</td><td>{d}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>Menu, footer en <a href="/kennisbank/wat-is/breadcrumbs/">kruimelpad</a> staan op elke pagina hetzelfde. Ze zorgen dat alles bereikbaar is. De links in je tekst zijn het interessantst, omdat jij per pagina kiest waarnaar je verwijst.</p>

      <div class="stap-kop"><Tekening naam="vergrootglas" maat={52} /><h2 id="wat-ze-doen">Wat interne links doen</h2></div>
      <p><b>Google vindt je pagina's.</b> Googlebot volgt links. Een pagina waar geen enkele interne link naartoe gaat, een weespagina, vindt hij moeilijk of helemaal niet. Google schrijft het zelf in zijn richtlijnen: elke pagina die je belangrijk vindt, hoort een link te hebben vanaf minstens één andere pagina op je site.</p>
      <p><b>Je laat zien wat belangrijk is.</b> Een pagina waar veel van je eigen pagina's naar verwijzen, weegt zwaarder. Via je links kun je ook SEO-waarde doorgeven: kracht die een pagina van backlinks krijgt, stroomt via jouw links door naar andere pagina's. Dat heet <a href="/kennisbank/wat-is/link-juice/">link juice</a>.</p>
      <p><b>Je vertelt waar een pagina over gaat.</b> De woorden waarop je klikt, de <a href="/kennisbank/wat-is/anchortekst/">anchortekst</a>, zijn een hint voor Google. En de zin eromheen ook.</p>
      <p><b>Je bezoeker vindt de volgende stap.</b> Wie een artikel uit heeft, wil verder. Een goede link brengt hem naar de dienst, de prijs of het contactformulier. Zo leveren ook je blogs aanvragen op.</p>

      <div class="stap-kop"><Tekening naam="scan" maat={52} /><h2 id="google-leest">Hoe Google een interne link leest</h2></div>
      <p>Voor jou is een link iets waar je op klikt. Voor Google moet het technisch een gewone link zijn. In zijn documentatie zegt Google dat het een link alleen betrouwbaar volgt als het een &lt;a&gt;-element met een href is, met een echt webadres erin.</p>
      <ul class="vink">
        <li><b>Gewone link met href:</b> Google volgt hem. Ook als hij met JavaScript op de pagina wordt gezet, zolang de code zo'n gewone link oplevert.</li>
        <li><b>Knop die alleen met JavaScript werkt:</b> Google probeert het misschien, maar je kunt er niet op rekenen.</li>
        <li><b>Afbeelding als link:</b> Google gebruikt de alt-tekst van de afbeelding als linktekst. Laat die dus niet leeg.</li>
        <li><b>Lege link:</b> geen tekst, geen alt. Dan valt Google soms terug op het title-attribuut, maar beter is gewoon tekst.</li>
      </ul>
      <p>Twijfel je of je menu goed gelezen wordt? Gebruik de URL-inspectie in Search Console. Die laat zien wat Google op de pagina ziet.</p>

      <div class="stap-kop"><Tekening naam="huis" maat={52} /><h2 id="structuur">De ideale interne linkstructuur</h2></div>
      <p>Zie je site als een boom. De homepage is de stam. Daaraan hangen je hoofdonderwerpen, en daaraan de pagina's die er dieper op ingaan. Elke pagina linkt omhoog naar haar hoofdonderwerp en opzij naar pagina's over hetzelfde onderwerp. Zo ontstaat samenhang. Sommigen noemen dat een SEO-spinnenweb of een cluster.</p>
      <p>Zo ziet dat eruit voor een hovenier:</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Laag</th><th>Pagina</th><th>Linkt naar</th></tr></thead>
          <tbody>
            <tr><td>1. Homepage</td><td>Hoveniersbedrijf</td><td>De drie hoofddiensten en contact</td></tr>
            <tr><td>2. Hoofddienst</td><td>Tuinaanleg</td><td>Gazon, bestrating, schuttingen, en terug naar home</td></tr>
            <tr><td>3. Deeldienst</td><td>Gazon aanleggen</td><td>Tuinaanleg, de prijzen, en het blog over gazononderhoud</td></tr>
            <tr><td>3. Kennis</td><td>Blog: gazon in de eerste maand</td><td>Gazon aanleggen, en de pagina over onderhoud</td></tr>
          </tbody>
        </table>
      </div>
      <p>Twee vuistregels. Elke belangrijke pagina is binnen drie klikken vanaf de homepage te bereiken. En elke kennispagina linkt naar de dienst die erbij hoort. Op deze site werken we zelf ook zo: elke dienst heeft een hoofdpagina met pagina's eronder die ernaar terug linken, elke gids linkt naar zijn dienst en elk begrip naar de gidsen eromheen.</p>
      <h3>Klikdiepte: hoe ver weg ligt je pagina?</h3>
      <p>Klikdiepte is het aantal klikken dat je vanaf de homepage nodig hebt om bij een pagina te komen. Hoe dieper, hoe minder bezoekers en hoe minder waarde er aankomt.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Klikdiepte</th><th>Voorbeeld</th><th>Wat je ermee doet</th></tr></thead>
          <tbody>
            <tr><td>1 klik</td><td>Hoofddiensten, contact</td><td>Hier horen je belangrijkste pagina's</td></tr>
            <tr><td>2 klikken</td><td>Deeldiensten, prijzen, cases</td><td>Prima voor alles wat geld oplevert</td></tr>
            <tr><td>3 klikken</td><td>Blogs, begrippen, oudere projecten</td><td>De grens voor pagina's die moeten scoren</td></tr>
            <tr><td>4 of meer</td><td>Pagina 7 van je blogarchief</td><td>Haal belangrijke pagina's hier weg met een link van hogerop</td></tr>
          </tbody>
        </table>
      </div>
      <p>Een crawler laat per pagina de klikdiepte zien. Staat een dienst op diepte vier, dan heb je je eerste klus gevonden.</p>
      <p>Zo past je interne linkstructuur bij je SEO-strategie. De pagina's die het meest moeten opleveren, krijgen de meeste links. Niet de pagina over je bedrijfsuitje van 2019.</p>

      <div class="stap-kop"><Tekening naam="pen" maat={52} /><h2 id="anchortekst">Anchortekst: de woorden waarop je klikt</h2></div>
      <p>Google geeft in zijn richtlijnen duidelijke voorbeelden. Een goede linktekst is beschrijvend, redelijk kort en past bij de pagina waar hij naartoe gaat. Lees de linktekst los van de zin. Snap je dan nog waar de link heen gaat? Dan zit het goed.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Zwak</th><th>Beter</th><th>Waarom</th></tr></thead>
          <tbody>
            <tr><td>Klik hier</td><td>Bekijk de prijzen voor tuinaanleg</td><td>Zegt wat je achter de link vindt</td></tr>
            <tr><td>Lees meer</td><td>Zo leg je zelf graszoden</td><td>Beschrijft het onderwerp</td></tr>
            <tr><td>Hovenier Hoogeveen tuinaanleg goedkoop beste hovenier</td><td>Tuinaanleg in Hoogeveen</td><td>Geen opgepropte zoekwoorden. Google noemt dat spam.</td></tr>
            <tr><td>Een hele zin van twintig woorden als link</td><td>Alleen de vier woorden die ertoe doen</td><td>Kort en duidelijk</td></tr>
          </tbody>
        </table>
      </div>
      <p>Zet geen links vlak achter elkaar. Vijf links in één zin zijn voor de lezer niet uit elkaar te houden, en elke link verliest de woorden eromheen. En gebruik niet dezelfde linktekst voor twee verschillende pagina's. Dan weet Google niet welke pagina bij die woorden hoort. Dat leidt tot <a href="/kennisbank/wat-is/keyword-cannibalization/">keyword cannibalization</a>.</p>

      <Tussenactie />
      <div class="stap-kop"><Tekening naam="munten" maat={52} /><h2 id="hoeveel">Hoeveel interne links per pagina?</h2></div>
      <p>Google zegt dat er geen magisch getal is. Maar ook: als jij denkt dat het te veel is, dan is het dat waarschijnlijk. Onze vuistregel voor een gewone tekst is twee tot vijf links per duizend woorden, plus je menu en footer. Elke link moet de lezer helpen.</p>
      <p>Meer links is niet altijd beter. De waarde van een pagina wordt verdeeld over al haar links. Een footer met tachtig linkjes geeft elke link een klein beetje. En wat overal staat, valt nergens op.</p>

      <h3>Van blog naar aanvraag</h3>
      <p>Interne links zijn niet alleen voor Google. Kijk naar een blog met 600 lezers per maand. Staat er geen enkele link naar je dienst in, dan klikt bijna niemand door. Zet je er twee goede links in, op het moment dat de lezer zich afvraagt of hij het zelf kan, dan klikt misschien 3% door. Dat zijn 18 bezoekers per maand op je dienstpagina die er eerst niet waren. <span class="muted">(Verzonnen cijfers.)</span></p>
      <p>De beste plek voor zo'n link is het moment van twijfel. Na de uitleg hoe je zelf een gazon legt: "Geen zin om zelf te sjouwen? Dan laat je graszoden leggen." Dat voelt als hulp, niet als reclame.</p>

      <div class="stap-kop"><Tekening naam="grafiek" maat={52} /><h2 id="search-console">Interne links controleren in Google Search Console</h2></div>
      <p>Google Search Console laat zien welke van je pagina's de meeste interne links krijgen. Zo vind je het:</p>
      <ol>
        <li>Open Search Console en kies je site.</li>
        <li>Klik in het linkermenu op <b>Links</b>.</li>
        <li>Kijk naar de tabel <b>Pagina's met de meeste interne links</b>. Klik op <b>Meer</b> voor de hele lijst.</li>
        <li>Klik op een pagina om te zien welke andere pagina's ernaar linken.</li>
      </ol>
      <p>Google raadt zelf aan om zo te controleren of je kernpagina's, zoals je homepage en contactpagina, goed binnen je site gelinkt zijn. Staat je belangrijkste dienst niet bovenaan? Dan klopt je structuur niet met wat je wilt verkopen.</p>
      <p>Twee kanttekeningen uit de documentatie. Het rapport is een steekproef, geen volledige lijst. En pagina's worden gegroepeerd op hun canonieke adres. Voor een complete lijst gebruik je een crawler, zoals Screaming Frog. Die is gratis tot 500 url's, genoeg voor de meeste mkb-sites.</p>

      <div class="stap-kop"><Tekening naam="tandwiel" maat={52} /><h2 id="stappenplan">Stappenplan: je interne links verbeteren in één middag</h2></div>
      <ol>
        <li><b>Kies je vijf geldpagina's.</b> De pagina's die aanvragen moeten opleveren: je hoofddiensten en je contactpagina.</li>
        <li><b>Zoek je sterkste pagina's.</b> In Search Console bij Links, onder externe links: welke pagina's krijgen de meeste backlinks? Vaak is dat de homepage en een paar oude blogs.</li>
        <li><b>Leg de verbinding.</b> Zet op elke sterke pagina een link in de tekst naar de geldpagina die er inhoudelijk bij past.</li>
        <li><b>Zoek weespagina's.</b> Laat een crawler je site doorlopen en vergelijk met je sitemap. Een pagina in de sitemap zonder interne links naar zich toe, is een wees.</li>
        <li><b>Repareer kapotte links.</b> Links naar pagina's die een foutmelding geven, of die via een <a href="/kennisbank/wat-is/redirect/">redirect</a> lopen. Laat ze direct naar het juiste adres wijzen.</li>
        <li><b>Werk oude teksten bij.</b> Schreef je een nieuwe pagina, zoek dan drie oudere teksten over hetzelfde onderwerp en link vanuit daar naar de nieuwe.</li>
        <li><b>Kijk na vier weken.</b> Vergelijk in Search Console de vertoningen en klikken van je geldpagina's met de vier weken ervoor.</li>
      </ol>

      <div class="stap-kop"><Tekening naam="scherm" maat={52} /><h2 id="wordpress">Interne links leggen in WordPress</h2></div>
      <p>De meeste mkb-sites draaien op WordPress. Daar kost een interne link een paar seconden, als je de sneltoetsen kent. Volgens de documentatie van WordPress werkt het zo in de blokeditor:</p>
      <ol>
        <li>Selecteer de woorden die de link moeten worden.</li>
        <li>Druk op Ctrl + K, of op een Mac op Cmd + K.</li>
        <li>Typ een paar woorden uit de titel van de pagina waar je naartoe wilt. WordPress zoekt zelf in je eigen pagina's en berichten.</li>
        <li>Kies de juiste pagina en druk op Enter.</li>
      </ol>
      <p>Nog sneller: typ twee vierkante haken, [[, gevolgd door een stukje van de titel. WordPress laat dan meteen een lijst met je eigen pagina's zien. Zo plak je nooit per ongeluk een oud of verkeerd adres.</p>
      <p>Er zijn plug-ins die zelf links voorstellen of automatisch leggen. Een voorstel is handig. Automatisch leggen raden we af: een programma snapt niet welke pagina de lezer op dat moment verder helpt.</p>

      <Tussenactie />
      <div class="stap-kop"><Tekening naam="pin" maat={52} /><h2 id="regio">Interne links bij plaatsen en regio's</h2></div>
      <p>Werk je in een regio, dan heb je misschien pagina's per plaats. Een schilder met een pagina voor Assen, Emmen en Hoogeveen. Zulke pagina's hangen vaak los: ze staan alleen in de footer, als lange rij plaatsnamen. Google ziet dan een stapel losse pagina's die op elkaar lijken.</p>
      <p>Beter is een duidelijke lijn. Elke plaatspagina linkt naar de dienst waar hij over gaat. De dienstpagina linkt naar een overzicht van het werkgebied, en dat overzicht naar alle plaatsen. Op deze site linken de plaatspagina's naar hun dienst en naar hun provincie, zoals <a href="/regio/drenthe/">Drenthe</a>. Zo hoort elke plaats ergens bij.</p>
      <p>Zorg wel dat elke plaatspagina echt iets eigens te vertellen heeft. Tien keer dezelfde tekst met een andere plaatsnaam is geen structuur, maar <a href="/kennisbank/wat-is/duplicate-content/">duplicate content</a>.</p>

      <div class="stap-kop"><Tekening naam="schild" maat={52} /><h2 id="fouten">Acht fouten die we vaak tegenkomen</h2></div>
      <ol>
        <li><b>Weespagina's.</b> Een mooie dienstpagina die alleen via de zoekfunctie te vinden is.</li>
        <li><b>Alles naar de homepage.</b> Elke tekst eindigt met een link naar home, nooit naar de dienst waar de tekst over ging.</li>
        <li><b>"Klik hier" en "lees meer".</b> Zegt niets over waar de link heen gaat.</li>
        <li><b>Links via een omweg.</b> Na een nieuwe site linken oude teksten nog naar oude adressen. Elke klik gaat dan via een doorverwijzing.</li>
        <li><b>Nofollow op eigen links.</b> Dat spaart geen waarde, die waarde verdwijnt.</li>
        <li><b>Een overvolle footer.</b> Alle plaatsnamen en diensten onderaan elke pagina. Voor bezoekers onleesbaar, voor Google weinig zeggend.</li>
        <li><b>Automatische links zonder controle.</b> Plug-ins die elk woord "tuin" naar dezelfde pagina laten wijzen. Dat leest raar en levert weinig op.</li>
        <li><b>Een menu dat Google niet kan lezen.</b> Knoppen die alleen met JavaScript werken. Controleer het met de URL-inspectie.</li>
      </ol>

      <div class="stap-kop"><Tekening naam="team" maat={52} /><h2 id="voorbeeld">Een voorbeeld</h2></div>
      <p>Stel: een hovenier uit Hoogeveen schrijft een blog over een gazon aanleggen in het voorjaar. In de tekst linkt hij "graszoden laten leggen" naar zijn dienstpagina. Die dienstpagina linkt terug naar het blog over onderhoud in de eerste maand, en naar de pagina met prijzen. Zo verbinden de pagina's zich rond één onderwerp. Google ziet de samenhang en snapt dat deze hovenier inhoudelijk iets te zeggen heeft over gazons. <span class="muted">(Verzonnen voorbeeld.)</span></p>
      <p>Een jaar later heeft hij twintig blogs. Hij kijkt in Search Console en ziet dat zijn pagina over bestrating maar twee interne links krijgt, terwijl zijn blog over mollen er veertien heeft. Hij zet in vijf blogs over tuinontwerp een link naar bestrating. Klaar in een uur.</p>

      <div class="stap-kop"><Tekening naam="lamp" maat={52} /><h2 id="checklist">Checklist bij elke nieuwe pagina</h2></div>
      <p>Publiceer je een nieuwe pagina of blog? Loop dan deze punten na. Het kost vijf minuten en voorkomt dat de pagina als wees begint.</p>
      <ul class="vink">
        <li>De pagina linkt naar de dienst of het hoofdonderwerp waar hij bij hoort.</li>
        <li>Er staan twee tot vier links in de tekst naar verwante pagina's.</li>
        <li>Minstens drie oudere pagina's linken nu naar deze nieuwe pagina.</li>
        <li>Elke linktekst zegt wat er achter de link zit.</li>
        <li>Geen link wijst naar een oud adres dat via een redirect loopt.</li>
        <li>De belangrijkste pagina is binnen drie klikken vanaf de homepage te bereiken.</li>
        <li>Na vier weken kijk je in Search Console of de pagina vertoningen krijgt.</li>
      </ul>
      <p>Verander je ooit een adres, zet dan een redirect en pas ook de links in je eigen teksten aan. Dan hoeft niemand een omweg te maken.</p>

      <div class="kader">
        <p class="kader-titel">Lees ook</p>
        <p>Hoe Google je site leest, staat in de gids <a href="/kennisbank/gidsen/hoe-werkt-seo/">Hoe werkt SEO?</a>. Hoe je Search Console instelt, lees je in de gids over <a href="/kennisbank/gidsen/google-search-console/">Google Search Console</a>. Wil je dat iemand je structuur nakijkt en verbetert, lees dan wat we doen aan <a href="/zoekmachine-optimalisatie/technische-seo/">technische SEO</a>, vanaf € 395, of aan <a href="/zoekmachine-optimalisatie/">zoekmachine-optimalisatie</a> als geheel.</p>
      </div>
    </article>
  </section>

  <Faq
    vragen={[
