<script>
  const lijst = document.querySelector<HTMLElement>('[data-checklist]');
  if (lijst) {
    const vakjes = [...lijst.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const teller = lijst.querySelector<HTMLElement>('[data-teller]');
    const balk = lijst.querySelector<HTMLElement>('[data-balk]');
    const wis = lijst.querySelector<HTMLButtonElement>('[data-wis]');
    const sleutel = 'drijfveer-onpage-checklist';
    try {
      const bewaard = JSON.parse(localStorage.getItem(sleutel) ?? '[]');
      if (Array.isArray(bewaard)) vakjes.forEach((v, i) => { v.checked = !!bewaard[i]; });
    } catch { /* geen opslag beschikbaar */ }
    const bij = () => {
      const aan = vakjes.filter((v) => v.checked).length;
      if (teller) teller.textContent = String(aan);
      if (balk) balk.style.width = `${Math.round((aan / vakjes.length) * 100)}%`;
      try { localStorage.setItem(sleutel, JSON.stringify(vakjes.map((v) => v.checked))); } catch { /* negeren */ }
    };
    vakjes.forEach((v) => v.addEventListener('change', bij));
    if (wis) {
      wis.hidden = false;
      wis.addEventListener('click', () => { vakjes.forEach((v) => { v.checked = false; }); bij(); });
    }
    bij();
  }
</script>

