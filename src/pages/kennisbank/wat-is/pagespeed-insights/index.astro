<script>
  const vorm = document.getElementById('psi-meter') as HTMLFormElement | null;
  if (vorm) {
    const lijst = vorm.querySelector('.uitslag') as HTMLUListElement;
    const grenzen: Record<string, { naam: string; goed: number; slecht: number; eenheid: string; tip: string }> = {
      lcp: { naam: 'LCP', goed: 2.5, slecht: 4, eenheid: ' s', tip: 'Begin bij de grootste afbeelding bovenaan en de reactietijd van je server.' },
      inp: { naam: 'INP', goed: 200, slecht: 500, eenheid: ' ms', tip: 'Kijk naar zware scripts: chatwidgets, trackers, sliders en pagebuilders.' },
      cls: { naam: 'CLS', goed: 0.1, slecht: 0.25, eenheid: '', tip: 'Geef afbeeldingen vaste afmetingen en reserveer ruimte voor banners.' },
      fcp: { naam: 'FCP', goed: 1.8, slecht: 3, eenheid: ' s', tip: 'Kijk naar CSS en scripts die de eerste weergave tegenhouden.' },
      ttfb: { naam: 'TTFB', goed: 0.8, slecht: 1.8, eenheid: ' s', tip: 'Zet paginacache aan en vraag je hostingpartij naar de serversnelheid.' },
    };
    const toon = () => {
      const regels: string[] = [];
      for (const [veld, g] of Object.entries(grenzen)) {
        const invoer = vorm.elements.namedItem(veld) as HTMLInputElement;
        const ruw = invoer.value.replace(',', '.');
        if (ruw === '') continue;
        const w = Number(ruw);
        if (Number.isNaN(w)) continue;
        const oordeel = w <= g.goed ? 'goed' : w <= g.slecht ? 'matig' : 'slecht';
        const label = oordeel === 'goed' ? 'goed' : oordeel === 'matig' ? 'verbetering nodig' : 'slecht';
        const waarde = String(w).replace('.', ',');
        regels.push(`<li class="${oordeel}"><b>${g.naam} ${waarde}${g.eenheid}: ${label}.</b>${oordeel === 'goed' ? '' : ' ' + g.tip}</li>`);
      }
      lijst.innerHTML = regels.length ? regels.join('') : '<li class="leeg">Vul een of meer waarden in.</li>';
    };
    vorm.addEventListener('input', toon);
    toon();
  }
</script>
