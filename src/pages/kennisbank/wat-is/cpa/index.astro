<script>
  const f = document.querySelector<HTMLFormElement>('[data-cpa]');
  const euro = (n: number) => '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 });
  function reken() {
    if (!f) return;
    const g = (n: string) => Math.max(0, Number((f.elements.namedItem(n) as HTMLInputElement).value.replace(',', '.')) || 0);
    const o = (n: string) => f.elements.namedItem(n) as HTMLOutputElement;
    const kosten = g('kosten');
    const conv = g('conversies');
    const max = g('waarde') * (g('marge') / 100) * (g('afsluit') / 100);
    const cpa = conv > 0 ? kosten / conv : 0;
    o('cpa').value = conv > 0 ? euro(Math.round(cpa * 100) / 100) : 'vul het aantal conversies in';
    o('max').value = euro(Math.round(max * 100) / 100);
    let oordeel = '';
    if (conv === 0 || max === 0) oordeel = 'Vul alle velden in om je kosten met je maximum te vergelijken.';
    else if (cpa <= max) oordeel = `Een conversie kost nu ${euro(Math.round(cpa * 100) / 100)}. Dat ligt onder je maximum van ${euro(Math.round(max * 100) / 100)}. Elke aanvraag levert gemiddeld ${euro(Math.round((max - cpa) * 100) / 100)} brutowinst op na advertentiekosten.`;
    else oordeel = `Een conversie kost nu ${euro(Math.round(cpa * 100) / 100)}. Dat ligt boven je maximum van ${euro(Math.round(max * 100) / 100)}. Op elke aanvraag verlies je gemiddeld ${euro(Math.round((cpa - max) * 100) / 100)}. Kijk eerst naar je landingspagina en je zoektermen.`;
    o('oordeel').value = oordeel;
  }
  f?.addEventListener('input', reken);
  f?.addEventListener('submit', (e) => e.preventDefault());
</script>
