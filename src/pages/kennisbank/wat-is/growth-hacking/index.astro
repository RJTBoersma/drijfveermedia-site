const hoofdstukken = [
  { id: 'betekenis', titel: 'Wat het betekent' },
  { id: 'herkomst', titel: 'Hoe de term ontstond' },
  { id: 'verschil', titel: 'Verschil met gewone marketing' },
  { id: 'aarrr', titel: 'Het AARRR-model' },
  { id: 'cyclus', titel: 'De experimentcyclus' },
  { id: 'ice', titel: 'Kiezen met de ICE-score' },
  { id: 'hypothese', titel: 'Een goede hypothese' },
  { id: 'testen', titel: 'Testen met weinig bezoekers' },
  { id: 'voorbeelden', titel: 'Drie bekende voorbeelden' },
  { id: 'mkb', titel: 'Tien experimenten voor het mkb' },
  { id: 'regels', titel: 'Wat niet mag' },
  { id: 'team', titel: 'Heb je een growth hacker nodig?' },
