        <Inhoud items={hoofdstukken} leestijd={13} />
      </aside>
    </div>
  </section>

  <Faq
    vragen={[
      { v: 'Wat is het verschil tussen content en contentmarketing?', a: 'Content is de inhoud zelf: een artikel, een video, een post. Contentmarketing is de aanpak erachter: welke content je maakt, voor wie, met welk doel en hoe je meet of het werkt.' },
