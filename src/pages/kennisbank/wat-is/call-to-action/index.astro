  { id: 'fouten', titel: 'Zeven fouten' },
  { id: 'meten', titel: 'Meten en testen' },
  { id: 'na-de-klik', titel: 'Na de klik' },
  { id: 'check', titel: 'Checklist voor je eigen site' },
];
const voorbeelden = [
  ['Installateur', 'Verzenden', 'Plan een monteur in', 'Zegt wat er gebeurt, niet wat de knop technisch doet.'],
  ['Kapsalon', 'Meer info', 'Kies een tijd die je past', 'De klant wil een afspraak, geen informatie.'],
  ['Accountant', 'Neem contact op', 'Vraag een vaste prijs voor je jaarrekening', 'Concreet en het antwoord op de vraag waar de klant mee zit: wat kost het?'],
