<Base
  title="Wat is DNS? Uitleg, records en voorbeeld | Drijfveer Media"
  description="Wat is DNS? Het adresboek van internet koppelt je domeinnaam aan je website en e-mail. Zo werken nameservers, records, TTL en propagatie, met voorbeelden."
  kruimels={[{ naam: 'Kennisbank', url: '/kennisbank/' }, { naam: 'Begrippen', url: '/kennisbank/wat-is/' }, { naam: 'DNS', url }]}
