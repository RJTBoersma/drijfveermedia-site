<script>
  const f = document.querySelector<HTMLFormElement>('[data-viraal]');
  const kUit = document.querySelector<HTMLElement>('[data-k]');
  const oordeel = document.querySelector<HTMLElement>('[data-oordeel]');
  const rondesUit = document.querySelector<HTMLElement>('[data-rondes]');
  const totaalUit = document.querySelector<HTMLElement>('[data-totaal]');
  function reken() {
    if (!f || !kUit || !oordeel || !rondesUit || !totaalUit) return;
    const d = new FormData(f);
    const start = Math.max(0, Number(d.get('start')) || 0);
    const deelt = Math.min(100, Math.max(0, Number(d.get('deelt')) || 0));
    const per = Math.max(0, Number(d.get('per')) || 0);
    const k = (deelt / 100) * per;
    const rondes = Array.from({ length: 5 }, (_, i) => Math.round(start * k ** i));
    kUit.textContent = k.toLocaleString('nl-NL', { maximumFractionDigits: 2 });
    oordeel.textContent = k < 1 ? 'Onder de 1: het bereik dooft na een paar rondes uit.' : k === 1 ? 'Precies 1: elke ronde is even groot.' : 'Boven de 1: elke ronde is groter dan de vorige.';
    rondesUit.innerHTML = rondes.map((r, i) => `<tr><td>${i + 1}</td><td>${r.toLocaleString('nl-NL')}</td></tr>`).join('');
    totaalUit.textContent = rondes.reduce((a, b) => a + b, 0).toLocaleString('nl-NL');
  }
  f?.addEventListener('input', reken);
</script>
