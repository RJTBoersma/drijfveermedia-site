const klikprijzen = [
  ['hypotheekadviseur', '€ 8,15', '9.900'],
  ['dakdekker', '€ 4,81', '9.900'],
  ['boekhouder', '€ 3,80', '8.000'],
  ['elektricien', '€ 3,29', '10.800'],
  ['kozijnen', '€ 2,57', '14.800'],
  ['loodgieter', '€ 2,25', '18.100'],
  ['schilder', '€ 1,73', '10.800'],
  ['hovenier', '€ 0,88', '10.800'],
  ['glazenwasser', '€ 0,56', '4.400'],
];
const schema = [{
  '@type': 'DefinedTerm',
  name: 'SEA (search engine advertising)',
  alternateName: ['Zoekmachine adverteren', 'Search engine advertising'],
  description: definitie,
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Begrippen van Drijfveer Media', url: `${site.url}/kennisbank/wat-is/` },
  url: `${site.url}${url}`,
}, {
