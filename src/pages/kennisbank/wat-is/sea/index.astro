  { id: 'advertentie', titel: 'Zo ziet een advertentie eruit' },
  { id: 'veiling', titel: 'Hoe de veiling werkt' },
  { id: 'kwaliteitsscore', titel: 'De kwaliteitsscore' },
  { id: 'campagnetypes', titel: 'Campagnetypes' },
  { id: 'bieden', titel: 'Biedstrategieën' },
