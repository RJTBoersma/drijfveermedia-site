---
import Base from '../../layouts/Base.astro';
import paginas from '../../../scripts/paginas.json';
import Tekening from '../../components/teken/Tekening.astro';
import { perOnderwerp } from '../../data/tekeningen';
import Plaatje from '../../components/teken/Plaatje.astro';
import { overgang, tekeningVoor } from '../../data/miniaturen';

// Gidsen gegroepeerd naar de drie pijlers. Volgorde binnen een groep: zoals in de structuur.
const groepen: { titel: string; pijler: string; onderwerpen: string[] }[] = [
  { titel: 'Hoger in Google', pijler: 'Gevonden', onderwerpen: ['SEO', 'Lokale SEO', 'Linkbuilding'] },
  { titel: 'Aanbevolen door AI', pijler: 'Genoemd', onderwerpen: ['GEO', 'Trainingen'] },
  { titel: 'Meer klanten uit je site', pijler: 'Gekozen', onderwerpen: ['Website', 'Tekstschrijver', 'Branding', 'Online adverteren', 'Social media beheer', 'Leadgeneratie', 'Tracking en analytics'] },
  { titel: 'Plannen en aanpak', pijler: 'Advies', onderwerpen: ['Online marketing uitbesteden', 'Consult'] },
];
const gidsen = paginas.filter((p: any) => p.type === 'gids' && p.url.startsWith('/kennisbank/gidsen/'));
const begrippen = paginas.filter((p: any) => p.type === 'begrip').sort((a: any, b: any) => a.naam.localeCompare(b.naam, 'nl'));
---
<Base
  title="Kennisbank: online marketing uitgelegd | Drijfveer Media"
  description="Gidsen en begrippen over SEO, GEO, websites, Google Ads en leadgeneratie. Geschreven door de mensen van Drijfveer Media, in gewone taal en zonder jargon."
  kruimels={[{ naam: 'Kennisbank', url: '/kennisbank/' }]}
>
  <section class="wrap kb-kop">
    <div class="kb-beeld" aria-hidden="true" style={`view-transition-name:${overgang('/kennisbank/')}`}>
      <Tekening naam="boek" maat={150} class="groot" />
      <Tekening naam="vergrootglas" maat={74} class="z1" vertraging={500} />
      <Tekening naam="ai" maat={74} class="z2" vertraging={800} />
      <Tekening naam="klik" maat={74} class="z3" vertraging={1100} />
    </div>
    <p class="kicker">Kennisbank</p>
    <h1>Online marketing, uitgelegd in gewone taal</h1>
    <p class="lead">{gidsen.length} gidsen en {begrippen.length} begrippen over gevonden, genoemd en gekozen worden. Geschreven door de mensen die het elke dag doen.</p>
    <label class="zoek" for="kb-zoek">
      <span class="sr-only">Zoek in de kennisbank</span>
      <span aria-hidden="true">⌕</span>
      <input id="kb-zoek" type="search" placeholder="Zoek, bijvoorbeeld: reviews, Google Ads of ChatGPT" autocomplete="off" />
    </label>
    <p class="muted klein" id="kb-telling" aria-live="polite"></p>
  </section>

  <section class="wrap sectie kb">
    {groepen.map((g) => {
      const lijst = gidsen.filter((x: any) => g.onderwerpen.includes(x.onderwerp));
      return lijst.length > 0 && (
        <div class="groep" data-groep>
          <h2><span class="pijl">{g.pijler}.</span> {g.titel}</h2>
          <ul class="gidsen">
            {lijst.map((x: any) => (
              <li data-item data-zoek={`${x.naam} ${x.onderwerp} ${x.zoekwoord ?? ''}`.toLowerCase()}>
                <div class="kl"><div aria-hidden="true"><Plaatje href={x.url} onderwerp={tekeningVoor(x.url, perOnderwerp[x.onderwerp] ?? 'boek')} /></div><span class="tx"><span class="kicker">{x.onderwerp}</span><a href={x.url}><b>{x.naam}</b></a></span></div>
              </li>
            ))}
          </ul>
        </div>
      );
    })}

    <div class="groep" data-groep>
      <h2>Begrippen van A tot Z</h2>
      <ul class="chips begrippen">
        {begrippen.map((b: any) => <li data-item data-zoek={b.naam.toLowerCase()}><a class="chip" href={b.url}>{b.naam}</a></li>)}
      </ul>
    </div>
    <p class="leeg muted" hidden>Niets gevonden. Probeer een ander woord, of <a href="/contact/">stel je vraag aan ons</a>.</p>
  </section>
</Base>

<script>
  const veld = document.getElementById('kb-zoek') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const groepen = [...document.querySelectorAll<HTMLElement>('[data-groep]')];
  const telling = document.getElementById('kb-telling');
  const leeg = document.querySelector<HTMLElement>('.leeg');
  veld?.addEventListener('input', () => {
    const q = veld.value.trim().toLowerCase();
    let n = 0;
    items.forEach((i) => { const ja = !q || (i.dataset.zoek ?? '').includes(q); i.hidden = !ja; if (ja) n++; });
    groepen.forEach((g) => { g.hidden = ![...g.querySelectorAll<HTMLElement>('[data-item]')].some((i) => !i.hidden); });
    if (telling) telling.textContent = q ? `${n} resultaten voor "${veld.value.trim()}"` : '';
    if (leeg) leeg.hidden = n > 0;
  });
</script>

<style>
  .kb-kop { padding-block: 24px 8px; }
  .kb-kop > :not(.kb-beeld) { max-width: 760px; }
  .kb-kop { margin-inline: auto; position: relative; }
  .tx { display: grid; gap: 4px; }
  .kb-beeld { position: absolute; right: 0; top: 30px; width: 260px; height: 230px; }
  .kb-beeld :global(.tekening) { position: absolute; }
  .kb-beeld :global(.groot) { left: 50px; top: 50px; }
  .kb-beeld :global(.z1) { left: 0; top: 0; animation: zweef 5s ease-in-out infinite; }
  .kb-beeld :global(.z2) { right: 0; top: 10px; animation: zweef 6s ease-in-out 0.7s infinite; }
  .kb-beeld :global(.z3) { right: 20px; bottom: 0; animation: zweef 5.5s ease-in-out 1.2s infinite; }
  @keyframes zweef { 50% { transform: translateY(-8px); } }
  @media (max-width: 1000px) { .kb-beeld { display: none; } }
  @media (prefers-reduced-motion: reduce) { .kb-beeld :global(.tekening) { animation: none; } }
  h1 { margin: 10px 0 14px; }
  .lead { font-size: var(--step-1); line-height: 1.45; max-width: 46ch; }
  .zoek { display: flex; align-items: center; gap: 10px; margin-top: 24px; background: #fff; border: 2px solid var(--line); border-radius: 14px; padding: 6px 16px; font-size: 1.3rem; color: var(--muted); }
  .zoek:focus-within { border-color: var(--navy); box-shadow: 0 0 0 4px rgb(7 70 99 / 0.12); }
  .zoek input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 1.1rem; padding: 10px 0; color: var(--ink); background: transparent; }
  .groep { margin-bottom: 48px; }
  .groep h2 { margin-bottom: 18px; }
  .pijl { color: var(--orange); }
  .gidsen { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .gidsen .kl { display: grid; align-content: start; gap: 8px; height: 100%; padding: 16px 18px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); transition: border-color 0.15s, transform 0.15s; }
  .gidsen .kl:hover { border-color: var(--navy); transform: translateY(-2px); }
  .gidsen b { font-weight: 700; line-height: 1.3; }
  .begrippen a { text-decoration: none; }
  .begrippen a:hover { background: var(--navy); color: #fff; }
</style>
