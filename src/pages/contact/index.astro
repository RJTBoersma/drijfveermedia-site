---
import Base from '../../layouts/Base.astro';
import Reach from '../../components/Reach.astro';
import Aanvraagformulier from '../../components/pagina/Aanvraagformulier.astro';
import { site } from '../../data/site';
import RouteAssen from '../../components/teken/RouteAssen.astro';

const route = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${site.straat}, ${site.postcode} ${site.plaats}`)}`;
const schema = [{ '@type': 'ContactPage', name: 'Contact met Drijfveer Media', url: `${site.url}/contact/`, about: { '@id': `${site.url}/#organisatie` } }];
---
<Base
  title="Contact: bel, mail of kom langs | Drijfveer Media"
  description="Bel 088 11 55 666 en we bellen je op werkdagen binnen 15 minuten terug. Of mail, vul het formulier in of kom langs op Lauwers 9 in Assen."
  kruimels={[{ naam: 'Contact', url: '/contact/' }]}
  schema={schema}
>
  <section class="wrap contact">
    <div class="links">
      <p class="kicker">Contact</p>
      <h1>Bel, mail of kom langs</h1>
      <p class="lead">Op werkdagen tussen 8.00 en 17.00 uur bellen we je binnen 15 minuten terug. Daarbuiten de volgende werkdag vóór 8.15 uur.</p>

      <div class="card persoon">
        <img src="/img/team/thorgall-klein.webp" width="88" height="88" alt={`${site.contactpersoon} van Drijfveer Media`} />
        <div>
          <p class="naam">{site.contactpersoon} van Eeden</p>
          <p class="muted">Je eerste aanspreekpunt</p>
          <Reach />
        </div>
      </div>

      <dl class="gegevens na">
        <div><dt>Telefoon</dt><dd><a href={site.telefoonLink}>{site.telefoon}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Adres</dt><dd>{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={route} rel="noopener">Plan je route</a></dd></div>
        <div><dt>Bereikbaar</dt><dd>Maandag tot en met vrijdag<br />8.00 tot 17.00 uur</dd></div>
      </dl>
      <div class="na"><RouteAssen /></div>
      <p class="muted na">We zitten in een bedrijfsverzamelpand aan de Lauwers, tussen andere ondernemers. Je bent welkom, maar bel even van tevoren. Dan staat de koffie klaar en zit er iemand voor je.</p>
      <img class="pand na" src="/img/kantoor-assen-klein.webp" width="660" height="624" alt="Ons kantoorpand aan de Lauwers in Assen" loading="lazy" decoding="async" />
    </div>

    <div class="rechts" id="terugbellen">
      <h2>Liever dat wij jou bellen?</h2>
      <p class="muted">Laat je nummer achter. Dan bellen we je binnen een kwartier, of de volgende werkdag voor 8.15 uur.</p>
      <p class="fout" role="alert" hidden data-fout>Er ging iets mis met versturen. Je gegevens zijn wel bewaard, maar bel voor de zekerheid even: <a href={site.telefoonLink}>{site.telefoon}</a>.</p>
      <Aanvraagformulier soort="Contact" knop="Bel me terug" moment />
      <h2 class="waarvoor">Waarvoor kun je ons bellen?</h2>
      <ul class="vink">
        <li>Een vraag over je website, je vindbaarheid of je advertenties.</li>
        <li>Een second opinion over een offerte van een ander bureau.</li>
        <li>Spoedhulp als je <a href="/website-laten-maken/wordpress-hack/">WordPress-site gehackt</a> is.</li>
        <li>Een <a href="/gratis-website-analyse/">gratis scan</a> van je website, met tips die je meteen kunt gebruiken.</li>
      </ul>
      <p class="muted">Je zit nergens aan vast. We vragen eerst wat je wilt bereiken, en pas daarna praten we over geld.</p>
      <p class="muted">Snel antwoord op vragen over openingstijden, prijzen of afspraken? Kijk bij de <a href="/veelgestelde-vragen/">veelgestelde vragen</a>.</p>
    </div>
  </section>
</Base>
<script>
  const fout = new URLSearchParams(location.search).get('fout');
  const melding = document.querySelector<HTMLElement>('[data-fout]');
  if (fout && melding) {
    if (fout === 'gegevens') melding.firstChild!.textContent = 'Vul je telefoonnummer of e-mailadres in, dan kunnen we je bereiken. Of bel: ';
    melding.hidden = false;
  }
</script>
<style>
  .fout { background: #fdecea; border: 1px solid #f5c2bd; color: #7a1d14; border-radius: 10px; padding: 12px 16px; font-weight: 600; }
  .fout a { color: inherit; }
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; padding-block: 24px 64px; align-items: start; }
  h1 { margin: 10px 0 14px; }
  .lead { font-size: var(--step-1); line-height: 1.45; }
  .persoon { display: flex; gap: 18px; align-items: center; padding: 20px; margin: 24px 0; }
  .persoon img { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; flex: none; }
  .persoon p { margin: 0; }
  .persoon > div { min-width: 0; }
  .persoon :global(.reach) { white-space: normal; align-items: flex-start; margin-top: 6px; }
  .naam { font-weight: 800; font-size: 1.2rem; }
  .gegevens { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0 0 24px; }
  dt { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  dd { margin: 4px 0 0; font-weight: 600; }
  dd a { color: var(--ink); }
  .rechts h2 { margin-bottom: 8px; }
  .waarvoor { margin-top: 40px !important; font-size: var(--step-1); }
  @media (max-width: 900px) { .contact { display: flex; flex-direction: column; gap: 0; } .links { display: contents; } .rechts { order: 2; margin-bottom: 32px; } .na { order: 3; } }
  @media (max-width: 420px) { .gegevens { grid-template-columns: minmax(0, 1fr); } }
  .pand { width: 100%; height: auto; border-radius: var(--radius); margin-top: 16px; display: block; }
</style>
