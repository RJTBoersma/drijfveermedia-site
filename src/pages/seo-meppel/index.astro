---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/pagina/Hero.astro';
import Bewijs from '../../components/pagina/Bewijs.astro';
import Faq from '../../components/pagina/Faq.astro';
import Actie from '../../components/pagina/Actie.astro';
import Verder from '../../components/pagina/Verder.astro';
import Tekening from '../../components/teken/Tekening.astro';
import Scene from '../../components/scenes/seo-meppel.astro';
import { site } from '../../data/site';
import Tussenactie from '../../components/pagina/Tussenactie.astro';
import Plaatsfeiten from '../../components/pagina/Plaatsfeiten.astro';
import KaartCheck from '../../components/tool/KaartCheck.astro';
import WieDoetHet from '../../components/pagina/WieDoetHet.astro';

const url = '/seo-meppel/';
const schema = [{
  '@type': 'Service',
  name: 'SEO in Meppel',
  serviceType: 'Zoekmachineoptimalisatie',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: [{ '@type': 'City', name: 'Meppel' }, { '@type': 'AdministrativeArea', name: 'Drenthe' }],
  url: `${site.url}${url}`,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 495, priceSpecification: { '@type': 'UnitPriceSpecification', price: 495, priceCurrency: 'EUR', unitText: 'MONTH', valueAddedTaxIncluded: false } },
  dateModified: '2026-10-19',
}, {
  '@type': 'WebPage',
  citation: [
    'https://www.cbs.nl/nl-nl/cijfers/detail/37230ned',
    'https://www.cbs.nl/nl-nl/cijfers/detail/81575NED',
  ],
}];

// CBS, bevolking 1 januari 2015 en eind augustus 2026 (tabel 37230ned).
const groei = [
  { gemeente: 'Meppel', van: '32.799', naar: '36.843', pct: '+12,3%' },
  { gemeente: 'Tynaarlo', van: '32.570', naar: '35.202', pct: '+8,1%' },
  { gemeente: 'Assen', van: '67.165', naar: '70.852', pct: '+5,5%' },
  { gemeente: 'Westerveld', van: '19.085', naar: '20.121', pct: '+5,4%' },
  { gemeente: 'De Wolden', van: '23.661', naar: '24.732', pct: '+4,5%' },
  { gemeente: 'Hoogeveen', van: '54.860', naar: '56.573', pct: '+3,1%' },
  { gemeente: 'Emmen', van: '107.775', naar: '109.820', pct: '+1,9%' },
];
---
<Base
  title="SEO Meppel: gevonden in stad en regio | Drijfveer Media"
  description="SEO in Meppel voor ondernemers in de stad en de omgeving. Beter vindbaar in Google, ook bij klanten uit Nijeveen, De Wolden en Staphorst. Met stijggarantie."
  kruimels={[{ naam: 'Werkgebied', url: '/werkgebied/' }, { naam: 'Drenthe', url: '/regio/drenthe/' }, { naam: 'SEO Meppel', url }]}
  schema={schema}
  marktbron
>
  <Hero kicker="Gevonden · Meppel" titel="SEO in Meppel: beter vindbaar in een stad die blijft groeien" prijs="vanaf € 495 per maand">
    <p>Voor ondernemers in Meppel, Nijeveen en de dorpen tot Staphorst. Geen Drentse gemeente groeide sinds 2015 zo hard. Elke nieuwe inwoner zoekt een kapper, een schilder of een fysio, via Google. Wij zorgen dat ze bij jou uitkomen, met een doel op papier.</p>
    <p>Alleen op de kaart staan? Lokale SEO kan vanaf € 295 per maand.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="tekst">
      <Plaatsfeiten waar={`Vanuit ons enige kantoor, aan de ${site.straat} in Assen. Over de A28 zijn we in zo'n veertig minuten in Meppel, dus we komen graag bij je langs.`} />
      <h2>Meppel groeit harder dan de rest van Drenthe</h2>
      <p>Begin 2015 woonden er volgens het CBS 32.799 mensen in de gemeente Meppel. Eind augustus 2026 waren dat er 36.843. Dat is ruim 12 procent erbij, meer dan in welke andere gemeente in Drenthe ook. Ter vergelijking:</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Gemeente</th><th>Inwoners begin 2015</th><th>Inwoners eind aug. 2026</th><th>Groei</th></tr></thead>
          <tbody>
            {groei.map((g) => <tr><td><b>{g.gemeente}</b></td><td>{g.van}</td><td>{g.naar}</td><td>{g.pct}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="muted klein">Bron: <a href="https://www.cbs.nl/nl-nl/cijfers/detail/37230ned" rel="noopener">CBS, Bevolkingsontwikkeling per regio per maand</a>. Een selectie van de twaalf Drentse gemeenten.</p>
      <p>Het aantal bedrijven groeide mee. Het <a href="https://www.cbs.nl/nl-nl/cijfers/detail/81575NED" rel="noopener">CBS</a> telde in Meppel in 2016 3.050 bedrijfsvestigingen, begin 2026 waren het er 4.315 (voorlopig cijfer). De grootste groep is opvallend: specialistische zakelijke dienstverlening, met 875 vestigingen. Daarna volgen handel (715) en zorg (515). Meer bedrijven betekent meer concurrentie in Google. Wie nu werk maakt van SEO in Meppel, heeft een voorsprong op wie wacht.</p>

      <h2>Een stad op de grens van drie provincies</h2>
      <p>Meppel ligt in de uiterste zuidwesthoek van Drenthe. De gemeente omschrijft haar ligging zelf als gunstig, in de regio Zwolle. Staphorst en Steenwijk horen al bij Overijssel, en over de A32 ben je zo in Friesland. Dat maakt Meppel een echte regiostad, met klanten uit een wijde omgeving.</p>
      <p>Het betekent ook dat je concurrenten niet alleen in Meppel zitten. Wie in Nijeveen of Ruinerwold "dakdekker" intypt, krijgt net zo makkelijk een bedrijf uit Zwolle of Staphorst te zien als een uit Meppel. Google kijkt naar afstand, maar ook naar welk bedrijf het duidelijkst laat zien dat het daar werkt. Daar win je het.</p>
      <p>Concreet: één sterke pagina per dienst waarop staat welk gebied je bedient. Meppel, Nijeveen, Rogat, de dorpen in De Wolden en Westerveld. Met echte voorbeelden van klussen in die omgeving, niet met twintig kopieën van dezelfde tekst met een andere plaatsnaam. Google noemt dat laatste in zijn spamregels als voorbeeld van misbruik: veel pagina's per stad die allemaal naar dezelfde plek leiden.</p>
      <h3>Je werkgebied in cijfers</h3>
      <p>De twee buurgemeenten aan de Drentse kant zijn geen kleintjes. Het CBS telde begin 2026 in De Wolden 3.855 bedrijfsvestigingen en in Westerveld 3.025. Samen zijn dat er meer dan in Meppel zelf. Werk je ook daar, zet die dorpen dan op je site en in je Google Bedrijfsprofiel. Volgens de provincie Drenthe groeide Zuidwest-Drenthe, waar Meppel bij hoort, tussen april 2024 en april 2025 met bijna 900 banen het hardst van de drie Drentse regio's.</p>

      <h2>Nieuwe wijken, nieuwe klanten die nog niemand kennen</h2>
      <p>Aan de noordwestkant bouwt de gemeente de duurzame uitbreidingswijk Nieuwveense Landen, met buurten als Broeklanden, Boshoven en Parkwonen. Begin 2027 start daar volgens de gemeente de bouw van twee basisscholen en een sporthal. Tussen de watertoren en de binnenstad verandert het oude bedrijventerrein Noordpoort in een woonwijk met circa 1.000 woningen.</p>
      <p>Wie net verhuisd is, heeft geen buurman die een goede loodgieter weet. Die pakt zijn telefoon. Wie dan bovenaan staat, krijgt de klus, en vaak de jaren daarna ook.</p>
      <p>Voor veel bedrijven in Meppel is dat de grootste kans van dit moment. Begin met een Google Bedrijfsprofiel dat compleet is, vraag elke tevreden klant om een review en noem de wijken waar je werkt op je site. Dat kost weinig en levert relatief snel iets op.</p>
      <div class="kader">
        <p class="kader-titel">Rekenvoorbeeld (verzonnen voorbeeld, verzonnen cijfers)</p>
        <p>Een installateur uit Meppel kijkt naar Noordpoort. De gemeente plant daar circa 1.000 woningen. Stel dat één op de tien nieuwe huishoudens in het eerste jaar via Google een installateur zoekt. Dat zijn 100 zoekers. Stel dat de helft van hen een van de drie bedrijven in het kaartje belt, en dat jij daar tussen staat. Krijg jij een derde van die telefoontjes, dan zijn dat zo'n 17 klussen. Bij € 250 marge per klus is dat ruim € 4.000. Lokale SEO kost vanaf € 295 per maand, dus € 3.540 per jaar. En dat is alleen Noordpoort. De bestaande wijken en de dorpen komen er nog bij.</p>
      </div>
      <p>Alle aantallen in dit voorbeeld behalve de 1.000 woningen zijn bedacht. Ze laten zien hoe je de som maakt. Reken hem gerust na met je eigen cijfers, of laat ons het doen.</p>

      <Tussenactie />
      <h2>SEO in Meppel verschilt per branche</h2>
      <p>Niet elke ondernemer in Meppel zoekt dezelfde klant. Wij kijken per branche wat werkt.</p>
    </div>
    <div class="raster raster-2 meppel-soort">
      <div class="card">
        <Tekening naam="pin" />
        <h3>Winkel en horeca in het centrum</h3>
        <p>In de wijk Centrum telt het CBS ruim duizend bedrijfsvestigingen. Voor een winkel in de binnenstad telt vooral de kaart. Kloppende openingstijden, ook op de weekmarkt op donderdag en de foodmarkt op zaterdag op het Kerkplein. Foto's van je zaak, reviews, en een pagina die laat zien waarom je onderscheidend bent.</p>
      </div>
      <div class="card">
        <Tekening naam="tandwiel" vertraging={150} />
        <h3>Zakelijk, op een bedrijventerrein</h3>
        <p>Meppel heeft een rij bedrijventerreinen, van Blankenstein en Noord I tot de Oevers aan het Meppelerdiep. Zakelijke klanten zoeken specifieker en vaak zonder plaatsnaam. Een leverancier wordt gevonden op wat hij maakt, niet op "bedrijf Meppel".</p>
      </div>
      <div class="card">
        <Tekening naam="team" vertraging={300} />
        <h3>Zakelijke dienstverlening</h3>
        <p>De grootste groep bedrijven in Meppel. Adviseurs, administratiekantoren en bureaus. Hun klanten vergelijken rustig en vragen steeds vaker eerst een AI-assistent om advies. Artikelen die echte vragen beantwoorden, maken je vindbaar in Google én in AI-antwoorden.</p>
      </div>
      <div class="card">
        <Tekening naam="huis" vertraging={450} />
        <h3>Vakmensen aan huis</h3>
        <p>Schilders, hoveniers, installateurs. Je werkt bij de klant thuis, in de nieuwe wijken en in de dorpen. Een servicegebied in je bedrijfsprofiel en een werkgebiedpagina met foto's van echte klussen doen hier het meeste.</p>
      </div>
    </div>
    <div class="tekst">
      <p>Bij de eerste en de laatste groep draait het om <a href="/lokale-seo/">lokale SEO</a>. Bij de andere twee om <a href="/zoekmachine-optimalisatie/">zoekmachineoptimalisatie</a>, of search engine optimization, op de woorden die jouw klanten gebruiken. Veel bedrijven hebben een beetje van allebei nodig.</p>

      <h2>Je Google Bedrijfsprofiel in Meppel goed instellen</h2>
      <p>Google schrijft dat lokale resultaten vooral draaien om relevantie, afstand en prominentie. Prominentie hangt onder meer af van hoeveel sites naar je linken en hoeveel reviews je hebt. Zo pak je de basis aan:</p>
      <ol>
        <li><b>Kies je bedrijfstype.</b> Heb je een winkel of praktijk waar klanten komen? Dan toon je je adres. Kom je bij de klant thuis, dan stel je een servicegebied in.</li>
        <li><b>Stel het servicegebied in.</b> Via Profiel bewerken, Locatie, Servicegebied. Google staat maximaal 20 gebieden toe, op hooguit zo'n twee uur rijden. Meppel, Nijeveen, Ruinerwold, Havelte en Staphorst passen daar ruim in.</li>
      </ol>
      <p>Daarna gaat het om een volledig profiel, reviews en een update per maand. Hoe sta jij ervoor? Zoek op je vak plus "meppel" en loop de punten na. Zo zie je in vijf minuten waar SEO in Meppel voor jou begint.</p>
      <KaartCheck plaats="Meppel" vak="dakdekker" />
      <p>Wil je dit zelf doen, volg dan onze <a href="/kennisbank/gidsen/google-bedrijfsprofiel/">gids over het Google Bedrijfsprofiel</a>. Laat je het liever doen, dan richten we je profiel bij Google, Bing en Apple in vanaf € 249.</p>

      <h2>Zo verloopt een SEO-traject bij ons</h2>
    </div>
    <ol class="stappen-rij">
      <li><strong>We bellen terug</strong><p>Binnen 15 minuten, op werkdagen. Thorgall vraagt eerst wat je wilt bereiken.</p></li>
      <li><strong>We vragen door</strong><p>Wat wil je echt? Meer klussen in de buurt, of zakelijke klanten uit heel het land?</p></li>
      <li><strong>We leggen het voor</strong><p>Telefonisch, bij ons in Assen of bij jou in Meppel. Over de A28 zijn we er in zo'n veertig minuten.</p></li>
      <li><strong>We spreken doelen af</strong><p>Een lage investering en targets waar je ons op kunt afrekenen.</p></li>
      <li><strong>We beginnen bij de grootste kans</strong><p>Eerst wat snel verschil maakt. Daarna perfectioneren.</p></li>
    </ol>
    <div class="tekst" style="margin-top:40px">
      <p>Bij SEO in Meppel heb je één vast aanspreekpunt, Thorgall, en korte lijnen met de mensen die het werk doen. Dat houdt ons betrokken bij je bedrijf, ook na jaren. We hebben voor ondernemers in heel Nederland gewerkt, en onze langstlopende klant zit al meer dan vijf jaar bij ons.</p>
      <h3>Wat we in de eerste drie maanden doen</h3>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Wanneer</th><th>Wat</th><th>Wat jij merkt</th></tr></thead>
          <tbody>
            <tr><td>Week 1 tot 2</td><td>Nulmeting: posities, bedrijfsprofiel, techniek, concurrenten in Meppel en omgeving</td><td>Je krijgt een kort overzicht van waar je staat</td></tr>
            <tr><td>Week 2 tot 4</td><td>Bedrijfsprofiel op orde, technische fouten eruit, reviewlink klaar</td><td>Vaak al meer weergaven in het kaartje</td></tr>
            <tr><td>Maand 2</td><td>Dienstpagina's herschrijven of nieuw maken, met je werkgebied erin</td><td>Pagina's die je zelf ook beter vindt lezen</td></tr>
            <tr><td>Maand 3</td><td>Eerste links uit de regio, meten wat werkt, bijsturen</td><td>De eerste posities verschuiven</td></tr>
          </tbody>
        </table>
      </div>
      <p>Dit is een gemiddeld beeld. Bij een site die technisch veel mist, duurt de eerste stap langer. Bij een bedrijf dat al een goed profiel heeft, gaan we sneller door naar de content.</p>

      <h2>Social media of SEO?</h2>
      <p>Die vraag krijgen we vaak. Social media kan je merk versterken. Mensen die je al kennen, zien je terug en onthouden je. Maar wie een dakdekker zoekt, zoekt in Google, niet op Instagram. Begin daarom bij je vindbaarheid. Daarna kun je kijken of social media een mooi extraatje is. Wil je het uitbesteden, dan doen we <a href="/social-media-beheer/">social media beheer</a> vanaf € 395 per maand. Adverteren op social media doen we niet.</p>

      <h2>Vier fouten die SEO in Meppel in de weg zitten</h2>
      <ul>
        <li><b>Alleen "Meppel" op de site.</b> Terwijl je ook in Nijeveen, Havelte en Staphorst werkt. Noem die plaatsen, met een voorbeeld.</li>
        <li><b>Geen aparte pagina per dienst.</b> Eén pagina "diensten" met tien opsommingen wordt op geen enkele dienst goed gevonden.</li>
        <li><b>Een profiel zonder reviews.</b> Ook goede bedrijven vergeten erom te vragen. Twee reviews per maand maakt na een jaar al verschil.</li>
        <li><b>Een trage site op mobiel.</b> Google wil dat het grootste deel van een pagina binnen 2,5 seconden staat. Veel sites halen dat niet door te zware foto's.</li>
      </ul>

      <h2>Wat SEO in Meppel kost, en wat je krijgt</h2>
      <p>SEO begint bij € 495 per maand, exclusief btw. Werk je vooral voor klanten in Meppel en omgeving, dan is lokale SEO vanaf € 295 per maand vaak genoeg. Allebei per maand opzegbaar, met één maand opzegtermijn. Bij SEO in Meppel krijg je elke maand:</p>
      <ul class="vink">
        <li>Zoekwoordonderzoek en een nulmeting, ook voor de dorpen waar je werkt.</li>
        <li>Techniek op orde en nieuwe of betere pagina's per dienst.</li>
        <li>Werk aan je autoriteit, met verwijzingen uit de regio.</li>
        <li>Eén A4: wat we deden, wat het opleverde en wat we nu doen.</li>
        <li>Een doel met een datum. Halen we het niet en ligt het aan ons, dan werken we een maand gratis door (<a href="/garantie/">de voorwaarden</a>).</li>
      </ul>
      <div class="kader">
        <p class="kader-titel">Verzonnen voorbeeld: de A4 van een dakdekker uit Meppel, maand drie</p>
        <p>Gedaan: Nijeveen, Ruinerwold en Staphorst in het servicegebied, een pagina over dakgoten met foto's van klussen in Noordpoort. Opgeleverd: op "dakdekker meppel" van plek 9 naar plek 5, twee aanvragen uit Nieuwveense Landen. Volgende maand: reviewlink op de factuur.</p>
      </div>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Dienst</th><th>Vanaf</th><th>Past bij</th></tr></thead>
          <tbody>
            <tr><td>Google Bedrijfsprofiel, Bing en Apple inrichten</td><td>€ 249 eenmalig</td><td>Wie eerst de basis wil leggen</td></tr>
            <tr><td>Lokale SEO</td><td>€ 295 per maand</td><td>Winkel, horeca, vakman met klanten in de omgeving</td></tr>
            <tr><td>SEO</td><td>€ 495 per maand</td><td>Bedrijf met meer diensten of klanten buiten de regio</td></tr>
            <tr><td>Linkbuilding</td><td>€ 75 per uur</td><td>Wie al goede pagina's heeft maar autoriteit mist</td></tr>
          </tbody>
        </table>
      </div>
      <h3>Wat kost SEO in Meppel bij anderen?</h3>
      <p>Meppel ligt tussen Drenthe en de regio Zwolle, en dat zie je aan de aanbieders. Een zelfstandige SEO-specialist uit de regio Zwolle noemt € 300 tot € 500 per maand voor lokale SEO in één stad en € 500 tot € 1.000 voor regionaal mkb. Een Drents marketingbureau noemt voor een basis SEO-pakket in Drenthe € 500 tot € 800 per maand. Een zelfstandige werkt alleen; vraag wat er gebeurt bij ziekte of vakantie. Een bureau heeft meer handen, vraag dan wie je site echt onder handen neemt. Meer bedragen staan in <a href="/kennisbank/gidsen/wat-kost-seo/">wat kost SEO</a>.</p>
      <p>Wanneer we SEO afraden: als je deze maand al klanten nodig hebt (dan eerst <a href="/online-adverteren/google-ads-bureau/">Google Ads</a>), of als er op jouw dienst in Meppel amper wordt gezocht. Dat zie je in de nulmeting, en dan hoor je het van ons.</p>
      <p>Bel gerust als je twijfelt welke bij je past. Of kijk eerst hoe we het aanpakken in onze eigen stad, bij <a href="/seo-assen/">SEO in Assen</a>, en wat we elders in <a href="/regio/drenthe/">Drenthe</a> doen.</p>
    </div>
  </section>

  <Bewijs case="conflictbemiddeling" />

  <Faq
    vragen={[
      { v: 'Zitten jullie in Meppel?', a: 'Nee. Ons enige kantoor staat aan de Lauwers in Assen. Naar Meppel is het zo\'n veertig minuten rijden, dus we komen graag bij je langs. Veel werk regelen we telefonisch of online.' },
      { v: 'Wat kost SEO in Meppel?', a: 'SEO begint bij € 495 per maand, lokale SEO bij € 295 per maand. Beide exclusief btw en maandelijks opzegbaar. Na een gratis analyse hoor je wat bij je past.' },
      { v: 'Ik word gevonden in Meppel, maar niet in de omliggende dorpen. Hoe kan dat?', a: 'Google toont op de kaart vooral bedrijven dicht bij de zoeker. Buiten je eigen plaats win je het met pagina\'s die duidelijk laten zien waar je werkt, met echte voorbeelden, en met reviews van klanten uit die dorpen.' },
      { v: 'Ik krijg concurrentie uit Zwolle. Kan ik daar tegenop?', a: 'Vaak wel. In het kaartje telt afstand zwaar mee, en daar sta je als bedrijf uit Meppel dichter bij je klant. In de gewone resultaten wint wie de beste pagina heeft voor die zoekopdracht. Daar maakt de grootte van je bedrijf minder uit dan je denkt.' },
      { v: 'Wat als het niets oplevert?', a: 'Dan staat het doel op papier. Halen we het niet vóór de afgesproken datum en ligt het aan ons, dan werken we een maand gratis door. Voorwaarde is dat jij doet wat nodig is, zoals reviews vragen en teksten nalezen.' },
      { v: 'Wat moet ik zelf doen?', a: 'Leestoegang geven tot Search Console en je Bedrijfsprofiel, teksten nalezen en tevreden klanten om een review vragen. Foto\'s van echte klussen helpen ook. De rest doen wij.' },
      { v: 'Hoe snel sta ik hoger in Meppel?', a: 'Kleine aanpassingen aan je Bedrijfsprofiel zie je vaak binnen een paar weken terug op de kaart. Hoger komen in Meppel en de dorpen kost meestal een paar maanden. In de gewone zoekresultaten reken je op drie tot zes maanden voor duidelijke stijgingen.' },
      { v: 'Werkt SEO ook voor een winkel?', a: 'Ja. Voor een winkel in het centrum draait het vooral om het kaartje, reviews en kloppende openingstijden. Webshops bouwen of optimaliseren doen we niet. Heb je al een webshop, dan kunnen we wel je Google Shopping-campagnes doen.' },
    ]}
  />

  <Verder
    titel="Meer in de buurt van Meppel"
    links={[
      { label: 'Pillar', titel: 'Zoekmachine-optimalisatie', href: '/zoekmachine-optimalisatie/', tekst: 'Hoger in Google, met stijggarantie.' },
      { label: 'Regio', titel: 'Webdesign in Hoogeveen', href: '/webdesign-hoogeveen/', tekst: 'Een nieuwe site voor ondernemers verderop langs de A28.' },
      { label: 'Assen', titel: 'SEO in Assen', href: '/seo-assen/', tekst: 'Hoe we het aanpakken in onze eigen stad.' },
      { label: 'Dienst', titel: 'Lokale SEO', href: '/lokale-seo/', tekst: 'Bovenaan in het kaartje, met reviews.', teken: 'pin' },
    ]}
  />

  <WieDoetHet wie={[{ slug: 'thorgall', taak: 'Je vaste aanspreekpunt. Hij belt je terug, komt in veertig minuten naar Meppel en zoekt je links in de regio.' }, { slug: 'robert', taak: 'Doet sinds 2011 SEO, content en strategie. Hij kiest met je de dorpen en diensten die het eerst aan de beurt zijn.' }]} />

  <Actie titel="Waar sta jij op de kaart in Meppel?" tekst={`${site.contactpersoon} zoekt op jouw vak in Meppel en de dorpen, en belt je met wat hij ziet op de kaart en in Google. Op werkdagen binnen 15 minuten.`} />
