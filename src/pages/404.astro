---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Pagina niet gevonden | Drijfveer Media" description="Deze pagina bestaat niet (meer)." noindex>
  <section class="wrap niet-gevonden">
    <p class="kicker">404</p>
    <h1>Moi. Deze pagina is er niet (meer).</h1>
    <p>Misschien is hij verhuisd, of zat er een tikfout in de link. Zoek hem op in de kennisbank, of kies hieronder waar je naartoe wilt.</p>
    <form class="zoek-404" action="/kennisbank/" method="get" role="search">
      <label for="zoek-404">Zoek in de kennisbank</label>
      <div><input id="zoek-404" name="q" type="search" placeholder="Bijvoorbeeld: reviews, Google Ads of ChatGPT" /><button class="btn" type="submit">Zoek</button></div>
    </form>
    <p id="suggestie" hidden></p>
    <div class="card omkeer">
      <h2>Deze pagina vond je niet. Vinden je klanten jóu wel?</h2>
      <p class="muted">Laat je site gratis nakijken. Op werkdagen tussen 8.00 en 17.00 uur bellen we je binnen 15 minuten terug.</p>
      <a class="btn" href="/gratis-website-analyse/">Doe de gratis scan</a>
    </div>
    <ul class="pijlers-404">
      <li><a class="chip" href="/zoekmachine-optimalisatie/">Gevonden in Google</a></li>
      <li><a class="chip" href="/generative-engine-optimization/">Genoemd door AI</a></li>
      <li><a class="chip" href="/website-laten-maken/">Een website die werkt</a></li>
      <li><a class="chip" href="/online-marketing-uitbesteden/">Alles uitbesteden</a></li>
    </ul>
    <p>Of ga naar <a href="/">de homepage</a>, <a href="/prijzen/">de prijzen</a> of <a href="/kennisbank/">de kennisbank</a>. Liever bellen? <a href={site.telefoonLink}>{site.telefoon}</a>.</p>
  </section>
</Base>
<script>
  // Raad op basis van het adres welke pagina bedoeld was.
  const slug = location.pathname.toLowerCase();
  const kandidaten: [RegExp, string, string][] = [
    [/webdesign-([a-z-]+)/, '/webdesign-$1/', 'Webdesign'],
    [/seo-([a-z-]+)/, '/seo-$1/', 'SEO'],
    [/website/, '/website-laten-maken/', 'Website laten maken'],
    [/link/, '/linkbuilding/', 'Linkbuilding'],
    [/seo|zoekmachine/, '/zoekmachine-optimalisatie/', 'SEO'],
    [/ads|adverte/, '/online-adverteren/', 'Online adverteren'],
    [/geo|chatgpt|ai/, '/generative-engine-optimization/', 'GEO'],
    [/blog|kennis/, '/kennisbank/', 'De kennisbank'],
  ];
  for (const [re, doel, naam] of kandidaten) {
    const m = slug.match(re);
    if (m) {
      const url = doel.replace('$1', (m[1] || '').replace(/-(oud|old|\d+)$/, ''));
      const p = document.getElementById('suggestie');
      if (p) { p.hidden = false; p.innerHTML = `Zocht je <a href="${url}">${naam}${m[1] ? ' in ' + m[1].replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase()) : ''}</a>?`; }
      break;
    }
  }
</script>
<style>
  .zoek-404 { margin: 20px 0 28px; max-width: 560px; }
  .zoek-404 label { display: block; font-weight: 700; margin-bottom: 6px; }
  .zoek-404 div { display: flex; gap: 8px; }
  .zoek-404 input { flex: 1; min-width: 0; min-height: 48px; padding: 10px 14px; border: 2px solid var(--line); border-radius: 12px; font: inherit; }
  .pijlers-404 { list-style: none; padding: 0; margin: 8px 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pijlers-404 .chip { text-decoration: none; padding: 10px 16px; min-height: 44px; display: inline-flex; align-items: center; font-weight: 700; }
  .niet-gevonden { padding-block: 48px; display: grid; gap: 18px; }
  .niet-gevonden > * { max-width: 760px; }
  blockquote { margin: 0; }
  blockquote p { font-size: var(--step-2); font-weight: 800; margin: 0; line-height: 1.2; }
  blockquote footer { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); margin-top: 8px; }
  .omkeer { padding: 26px; display: grid; gap: 10px; justify-items: start; }
  .omkeer h2 { font-size: var(--step-1); }
  .omkeer p { margin: 0; }
</style>
