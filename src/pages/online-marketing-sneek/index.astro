    ]}
  />

  <Actie titel="Hoe ver reikt jouw winkel?" tekst={`Vertel ${site.contactpersoon} waar je klanten nu vandaan komen. Hij belt je binnen 15 minuten terug en zegt welke ring de snelste winst oplevert.`} />
</Base>
