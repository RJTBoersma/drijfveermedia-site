    titel="Meer in en rond Sneek"
    links={[
      { label: 'Dienst', titel: 'Online marketing uitbesteden', href: '/online-marketing-uitbesteden/', tekst: 'Alles in één hand, maandelijks opzegbaar.', teken: 'team' },
      { label: 'Sneek', titel: 'Webdesign in Sneek', href: '/webdesign-sneek/', tekst: 'Een website die het hoogseizoen aankan.', teken: 'scherm' },
