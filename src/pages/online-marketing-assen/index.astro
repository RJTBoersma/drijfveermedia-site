---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/pagina/Hero.astro';
import Bewijs from '../../components/pagina/Bewijs.astro';
import Faq from '../../components/pagina/Faq.astro';
import Actie from '../../components/pagina/Actie.astro';
import Verder from '../../components/pagina/Verder.astro';
import Tekening from '../../components/teken/Tekening.astro';
import Scene from '../../components/scenes/online-marketing-assen.astro';
import { site } from '../../data/site';
import Tussenactie from '../../components/pagina/Tussenactie.astro';
import Plaatsfeiten from '../../components/pagina/Plaatsfeiten.astro';
import ZelfOfUitbesteden from '../../components/tool/ZelfOfUitbesteden.astro';
import WieDoetHet from '../../components/pagina/WieDoetHet.astro';

const url = '/online-marketing-assen/';
const schema = [{
  '@type': 'Service',
  name: 'Online marketing in Assen',
  serviceType: 'Online marketing uitbesteden',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: [{ '@type': 'City', name: 'Assen' }, { '@type': 'AdministrativeArea', name: 'Drenthe' }],
  url: `${site.url}${url}`,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 595, priceSpecification: { '@type': 'UnitPriceSpecification', price: 595, priceCurrency: 'EUR', unitText: 'MONTH', valueAddedTaxIncluded: false } },
  dateModified: '2026-10-19',
  citation: ['https://punthelder.nl/', 'https://pienter.nl/', 'https://fanatics.nu/', 'https://unhyped.nl/online-marketing-assen/', 'https://www.samonlinemarketing.nl/online-marketing-uitbesteden/'],
}];
---
<Base
  title="Online marketing Assen: marketingbureau aan de Lauwers"
  description="Online marketing in Assen door een marketingbureau waar je binnenloopt. SEO, Google Ads en je site in één hand, vanaf € 595 per maand, met een doel op papier."
  kruimels={[{ naam: 'Werkgebied', url: '/werkgebied/' }, { naam: 'Drenthe', url: '/regio/drenthe/' }, { naam: 'Online marketing Assen', url }]}
  schema={schema}
>
  <Hero kicker="Online marketing · Assen" titel="Online marketing in Assen, bij een bureau waar je binnenloopt" prijs="vanaf € 595 per maand">
    <p>Voor ondernemers in Assen en omgeving die meer aanvragen willen. Vier mensen aan de Lauwers 9 pakken je online marketing op, van Google tot je website. Geen accountmanager ertussen, wel een doel op papier. Kom gerust langs.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="tekst">
      <Plaatsfeiten waar={`Ons kantoor staat aan de ${site.straat} in Assen. Op werkdagen ben je welkom; bel even van tevoren, dan is er tijd voor je.`} />
      <h2>Een marketingbureau in Assen waar je kunt aanbellen</h2>
      <p>Lauwers 9 is een bedrijfsverzamelpand. Op de gang kom je allerlei ondernemers tegen, een community van mensen die hard werken voor hun eigen zaak. Daar zitten wij tussen. Wie binnenloopt, zit binnen een paar minuten aan tafel met de mensen die het werk ook echt doen. Bel wel even van tevoren.</p>
      <p>Waarom dat ertoe doet? Je geeft ons toegang tot je website en je advertentiebudget. Dan wil je weten wie dat is, en dat zie je het best aan tafel.</p>
      <p>Assen telt ruim 70.000 inwoners en is de hoofdstad van Drenthe. Groot genoeg voor stevige concurrentie in Google, klein genoeg dat je elkaar tegenkomt. Een installateur op Messchenveld, een winkel aan de Brink en een adviseur op het Stadsbedrijvenpark hebben elk een andere klant. Dus ook een andere aanpak.</p>

      <h2>Wat online marketing voor een Asser bedrijf meestal inhoudt</h2>
      <p>Geen pakket met tien onderdelen waarvan je er zes niet nodig hebt. Wij kiezen de kanalen die bij jouw doelen passen. Meestal zijn dat er twee of drie uit dit rijtje.</p>
    </div>
    <div class="raster raster-2 kanalen">
      <div class="card">
        <Tekening naam="vergrootglas" />
        <h3>Gevonden in Google</h3>
        <p>Met <a href="/zoekmachine-optimalisatie/">SEO</a> kom je hoger in de gewone zoekresultaten en op de kaart. Het kost tijd, maar elke bezoeker daarna is gratis. Voor Assen zelf lees je meer bij <a href="/seo-assen/">SEO in Assen</a>.</p>
      </div>
      <div class="card">
        <Tekening naam="megafoon" vertraging={150} />
        <h3>Google Ads (SEA)</h3>
        <p>Adverteren in Google levert vanaf dag één bezoekers op. Handig als je snel klanten nodig hebt, of voor een piek. We zetten <a href="/online-adverteren/google-ads-bureau/">Google Ads</a> op en houden elke euro in de gaten.</p>
      </div>
      <div class="card">
        <Tekening naam="ai" vertraging={300} />
        <h3>Genoemd door AI</h3>
        <p>Steeds meer mensen vragen ChatGPT of Gemini om een bedrijf in de buurt. Met <a href="/generative-engine-optimization/">GEO</a> zorgen we dat jouw naam in dat antwoord valt.</p>
      </div>
      <div class="card">
        <Tekening naam="klik" vertraging={450} />
        <h3>Een site die klanten oplevert</h3>
        <p>Bezoekers zijn pas wat waard als ze converteren: bellen, mailen, een offerte vragen. Is je site de zwakke plek, dan beginnen we daar. Zie <a href="/webdesign-assen/">webdesign in Assen</a>.</p>
      </div>
    </div>
    <div class="tekst">
      <Tussenactie />
      <h2>We beginnen waar het snelst verschil maakt</h2>
      <p>De kracht zit zelden in meer doen. Meestal zit hij in het juiste eerst doen. Na een eerste gesprek kijken we waar de grootste kans ligt en beginnen we daar. Pas als dat loopt, gaan we perfectioneren.</p>
      <div class="kader">
        <p class="kader-titel">Verzonnen voorbeeld: een fysiotherapeut in Marsdijk</p>
        <p>Ze adverteert al een jaar in Google, krijgt twee aanvragen per maand en weet niet waar het geld blijft. Wij zetten eerst de campagne stil die niets oplevert. Daarna richten we haar Google Bedrijfsprofiel goed in en zetten we een belknop bovenaan elke pagina. Dat kost weinig en kan snel meer telefoontjes opleveren. Pas daarna kijken we of adverteren weer zin heeft.</p>
      </div>
      <p>Dat stopadvies krijg je vaker van ons dan je misschien verwacht. Verspild budget schrappen levert soms meer op dan een nieuwe campagne. Je betaalt ons ook voor eerlijk advies over wat niet werkt.</p>

      <h2>De TT, de koopzondag en andere Asser pieken</h2>
      <p>Assen heeft een eigen ritme. In de laatste week van juni draait de stad om de TT, met de TT Nacht in de binnenstad als drukste avond. Voor horeca, verhuur en winkels is dat de week van het jaar. Voor een loodgieter juist niet. Elke laatste zondag van de maand is er koopzondag, en op woensdag en zaterdag staat de markt van de Nieuwehuizen tot aan de Brink.</p>
      <p>Wij plannen daar omheen. Een advertentie voor de TT-week zet je in mei klaar, niet in de week zelf. Zo ben je er als de zoekers er zijn.</p>

      <h2>Online marketing in Assen: wat het kost en wat je krijgt</h2>
      <p>Wil je alles in één hand, dan begint <a href="/online-marketing-uitbesteden/">online marketing uitbesteden</a> bij € 595 per maand, exclusief btw. Losse diensten kan ook, zoals <a href="/seo-assen/">SEO in Assen</a> vanaf € 495 of lokale SEO vanaf € 295 per maand. Voor € 595 krijg je:</p>
      <ul class="vink">
        <li>Thorgall als vast aanspreekpunt, die je op werkdagen binnen 15 minuten terugbelt.</li>
        <li>Elke maand werk aan de twee of drie kanalen die nu het meeste opleveren.</li>
        <li>Doelen die we samen vastleggen, met een getal en een datum: zoveel aanvragen, zoveel bezoekers.</li>
        <li>Elke maand één A4: wat we deden, wat het opleverde en wat we nu doen.</li>
        <li>Per maand opzegbaar, met één maand opzegtermijn, en de <a href="/garantie/">garantie</a>: halen we het doel niet en ligt het aan ons, dan werken we een maand gratis door.</li>
      </ul>
      <p>Adverteer je in Google, dan komt het advertentiebudget daar los bij. Dat bedrag spreken we vooraf af. Advertenties op Facebook of Instagram, video en webshops doen we niet.</p>
      <h3>De A4 van de fysiotherapeut, na twee maanden</h3>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Wat we deden</th><th>Wat het opleverde</th><th>Wat we nu doen</th></tr></thead>
          <tbody>
            <tr><td>De campagne zonder aanvragen stilgezet</td><td>€ 300 per maand bespaard</td><td>Eén kleine campagne op "fysio assen", alleen op werkdagen</td></tr>
            <tr><td>Bedrijfsprofiel ingericht, belknop op elke pagina</td><td>Van 2 naar 6 telefoontjes per maand</td><td>Reviewlink na elke behandeling</td></tr>
          </tbody>
        </table>
      </div>
      <p class="klein muted">(Verzonnen voorbeeld bij de praktijk in Marsdijk hierboven. De praktijk en de cijfers bestaan niet.)</p>

      <h2>Een marketingbureau in Assen kiezen</h2>
      <p>In Assen zelf zitten meer bureaus, en je kunt ook voor een zelfstandige marketeer of een landelijk bureau kiezen. Zo verhouden ze zich.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Route</th><th>Prijs</th><th>Waar je op let</th></tr></thead>
          <tbody>
            <tr><td><b>Drijfveer Media</b>, Lauwers 9</td><td>Op de site: vanaf € 595 per maand, losse diensten vanaf € 295</td><td>Drie cases met naam op de site, plus een <a href="/logboek/">logboek</a> waarin we onze eigen cijfers laten zien</td></tr>
            <tr><td>Andere bureaus in Assen</td><td>De bureaus bovenaan voor "online marketing assen" noemen op die pagina's geen prijs</td><td>Ze laten cases van Asser bedrijven en reviews zien. Vraag welke klant je mag bellen</td></tr>
            <tr><td>Zelfstandige marketeer</td><td>Per uur of per maand</td><td>Eén persoon doet alles. Vraag wat er gebeurt bij ziekte of vakantie</td></tr>
            <tr><td>Groot landelijk bureau</td><td>SAM Online Marketing noemt uitbesteden minder geschikt onder € 1.000 per maand</td><td>Meer specialisten, vaak een accountmanager ertussen</td></tr>
          </tbody>
        </table>
      </div>
      <p>Wat ons onderscheidt: we testen elke techniek eerst op meer dan 100 eigen sites in ons <a href="/proeflab/">proeflab</a>, en het doel waarop je ons afrekent staat op papier. Hoeveel tijd je zelf kwijt bent als je het niet uitbesteedt, reken je hieronder uit.</p>
      <ZelfOfUitbesteden dienst="alles" tarief={60} uren={12} />
      <p>Heb je eigenlijk maar één ding nodig, zoals een Bedrijfsprofiel dat klopt of een nieuwe site, neem dan die losse dienst. Dat is goedkoper dan alles uitbesteden, en dat zeggen we je ook.</p>
      <p>We willen een fijne marketingpartner voor de lange termijn zijn. Je blijft alleen zolang het iets oplevert, en succesvol samenwerken begint bij een helder doel.</p>
    </div>
  </section>

  <Bewijs />

  <Faq
    vragen={[
      { v: 'Kan ik zomaar langskomen aan de Lauwers?', a: 'Ja. Op werkdagen van 8.00 tot 17.00 uur ben je welkom aan de Lauwers 9 in Assen. Bel of mail even van tevoren, dan weten we dat je komt en is er tijd voor je.' },
      { v: 'Doen jullie voor bedrijven in Assen ook advertenties op Facebook en Instagram?', a: 'Nee, advertenties op social media doen we niet. Wel houden we je kanalen bij met <a href="/social-media-beheer/">social media beheer</a>, als dat bij je doelen past.' },
      { v: 'Moet ik voor online marketing in Assen een jaarcontract tekenen?', a: 'Nee. Je zegt per maand op, met één maand opzegtermijn, per e-mail. Alleen als we samen schriftelijk iets anders afspreken, geldt dat.' },
      { v: 'Wat als het niets oplevert?', a: 'Bij de start leggen we een doel vast, met een datum. Halen we dat niet en ligt het aan ons, dan werken we een maand gratis door. Voorwaarde is dat jij doet wat nodig is, zoals snel reageren op aanvragen of een tekst nalezen.' },
      { v: 'Ik werk nu met een ander bureau in Assen. Hoe stap ik over?', a: 'Zeg daar op volgens je contract en zorg dat je advertentieaccount, je Bedrijfsprofiel en je site op jouw naam staan. Wij beginnen met een nulmeting. Wat goed werkt, laten we staan.' },
      { v: 'Werken jullie alleen voor bedrijven in Assen?', a: 'Nee. We hebben klanten in heel Nederland en daarbuiten. Ook in de rest van <a href="/regio/drenthe/">Drenthe</a> komen we graag langs.' },
    ]}
  />

  <Verder
    titel="Meer in en rond Assen"
    links={[
      { label: 'Overzicht', titel: 'Online marketingbureau', href: '/', tekst: 'Alles wat we doen, voor ondernemers in heel Nederland.' },
      { label: 'Pillar', titel: 'Online marketing uitbesteden', href: '/online-marketing-uitbesteden/', tekst: 'Alles in één hand, maandelijks opzegbaar.' },
      { label: 'Assen', titel: 'SEO in Assen', href: '/seo-assen/', tekst: 'Hoger in Google bij klanten uit je eigen stad.' },
      { label: 'Regio', titel: 'Drenthe', href: '/regio/drenthe/', tekst: 'Al onze diensten in de provincie.' },
    ]}
  />

  <WieDoetHet titel="Wie je aan de Lauwers tegenkomt" wie={[{ slug: 'thorgall', taak: 'Je vaste aanspreekpunt. Hij belt je terug en zet je plan op één A4.' }, { slug: 'robert', taak: 'Doet sinds 2011 SEO, content en strategie voor ondernemers in Assen en ver daarbuiten.' }, { slug: 'evelien', taak: 'Richtte Drijfveer Media in 2011 met Robert op en houdt de zaak draaiende.' }, { slug: 'johan', taak: 'Werkt mee aan de online marketing voor klanten.' }]} extra="Voor specialistisch werk schakelen we een vaste groep freelancers in die we al jaren kennen." />

  <Actie titel="Loop eens binnen aan de Lauwers 9" tekst={`Of bel ${site.contactpersoon}. Hij belt je op werkdagen binnen 15 minuten terug en vraagt eerst wat jij wilt bereiken.`} />
</Base>
<style>
  .kanalen { margin: 8px 0 8px; }
</style>
