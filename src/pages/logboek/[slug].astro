---
// Eén maand uit het logboek. De tekst komt uit src/content/logboek/ (bij te houden via /admin/).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Auteur from '../../components/pagina/Auteur.astro';
import Actie from '../../components/pagina/Actie.astro';
import Verder from '../../components/pagina/Verder.astro';
import Groeilijn from '../../components/beeld/Groeilijn.astro';
import { site } from '../../data/site';
import { overgang } from '../../data/miniaturen';

export async function getStaticPaths() {
  const items = await getCollection('logboek');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const url = `/logboek/${item.id}/`;
const alle = (await getCollection('logboek')).sort((a, b) => a.data.maand.localeCompare(b.data.maand));
const reeks = new Map<string, number>();
for (const i of alle) { if (i.data.maand > d.maand) continue; for (const [m, v] of i.data.historie ?? []) reeks.set(m, v); reeks.set(i.data.maand, i.data.verkeer); }
const punten = [...reeks.entries()].sort((a, b) => a[0].localeCompare(b[0])).slice(-18) as [string, number][];
const scenes = import.meta.glob('../../components/scenes/logboek--*.astro', { eager: true }) as Record<string, { default: any }>;
const Scene = scenes[`../../components/scenes/logboek--${item.id}.astro`]?.default;
const maandNaam = new Date(d.maand + '-15').toLocaleDateString('nl-NL', { month: 'long', year: 'numeric' });
const fmt = (n: number) => n.toLocaleString('nl-NL');
const schema = [{
  '@type': 'BlogPosting',
  headline: d.titel,
  description: d.beschrijving,
  datePublished: d.datum.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Robert Boersma' },
  publisher: { '@id': `${site.url}/#organisatie` },
  mainEntityOfPage: `${site.url}${url}`,
  inLanguage: 'nl-NL',
}];
const andere = alle.filter((i) => i.id !== item.id).slice(-2).reverse();
---
<Base
  title={`${d.titel.length > 42 ? d.titel : d.titel + ' | Drijfveer Media'}`}
  description={d.beschrijving}
  kruimels={[{ naam: 'Logboek', url: '/logboek/' }, { naam: maandNaam, url }]}
  schema={schema}
  ogType="article"
>
  <section class="wrap logboek-kop">
    <div>
      <p class="kicker">Logboek · {maandNaam}</p>
      <h1>{d.titel}</h1>
      <ul class="getallen">
        <li class="card"><b>{fmt(d.verkeer)}</b><span>klikken uit Google per maand</span></li>
        <li class="card"><b>{fmt(d.top10)}</b><span>zoekwoorden in de top 10</span></li>
        <li class="card"><b>{fmt(d.zoekwoorden)}</b><span>zoekwoorden in de top 100</span></li>
        {d.aanvragen !== undefined && <li class="card"><b>{fmt(d.aanvragen)}</b><span>aanvragen via de site</span></li>}
      </ul>
    </div>
    <div style={`view-transition-name:${overgang(url)}`}>
      {Scene ? <Scene /> : <Groeilijn punten={punten} id={`logboek-${item.id}`} />}
    </div>
  </section>
  <section class="wrap sectie">
    <article class="tekst">
      <Auteur slug="robert" datum={d.datum.toISOString().slice(0, 10)} />
      <Content />
      <p class="klein muted">Klikken uit Google: Google Search Console. Zoekwoorden en posities: schattingen van SE Ranking voor Google Nederland, gemeten in {maandNaam}. Aanvragen: eigen telling.</p>
    </article>
  </section>
  {andere.length > 0 && <Verder titel="Eerder in het logboek" links={andere.map((a) => ({ titel: a.data.titel, href: `/logboek/${a.id}/`, label: 'Logboek', teken: 'grafiek' }))} />}
  <Actie titel="Hoe scoort jouw eigen site?" tekst={`We kijken hem gratis na en zijn net zo open als hier. ${site.contactpersoon} belt je binnen 15 minuten terug.`} />
</Base>
<style>
  .logboek-kop { padding-block: 28px 8px; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 40px; align-items: center; }
  h1 { margin: 10px 0 20px; }
  .getallen { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .getallen li { padding: 14px 16px; }
  .getallen b { display: block; font-size: var(--step-2); line-height: 1.1; color: var(--ink); }
  .getallen span { font-size: 0.92rem; color: var(--muted); }
  @media (max-width: 900px) { .logboek-kop { grid-template-columns: minmax(0, 1fr); } }
</style>
