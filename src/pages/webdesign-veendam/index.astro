      { v: 'Van wie is de website?', a: 'Van jou. De site, de teksten en de foto\'s zijn jouw eigendom. Wil je ooit overstappen, dan neem je alles mee.' },
    ]}
  />

  <Verder
    titel="Meer in de buurt"
    links={[
      { label: 'In de buurt', titel: 'Webdesign in Stadskanaal', href: '/webdesign-stadskanaal/', tekst: 'Gevonden in de hele gemeente.', teken: 'scherm' },
      { label: 'Groningen', titel: 'Webdesign in Groningen', href: '/webdesign-groningen/', tekst: 'Een site die opvalt in een volle stad.', teken: 'scherm' },
      { label: 'Dienst', titel: 'Website laten maken', href: '/website-laten-maken/', tekst: 'Twee routes, van € 250 tot maatwerk.', teken: 'scherm' },
