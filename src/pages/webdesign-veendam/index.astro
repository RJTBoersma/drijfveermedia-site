  />

  <Actie titel="Even kennismaken in Veendam?" tekst={`Bel of mail ${site.contactpersoon}. Hij belt je op werkdagen binnen 15 minuten terug en spreekt een moment af, bij jou in Veendam of bij ons in Assen.`} />
</Base>
