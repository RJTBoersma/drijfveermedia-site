import Hero from '../../components/pagina/Hero.astro';
import Bewijs from '../../components/pagina/Bewijs.astro';
import Faq from '../../components/pagina/Faq.astro';
import Actie from '../../components/pagina/Actie.astro';
import Verder from '../../components/pagina/Verder.astro';
import Tekening from '../../components/teken/Tekening.astro';
import Scene from '../../components/scenes/online-marketing-drachten.astro';

import { site } from '../../data/site';

const url = '/online-marketing-drachten/';
const schema = [{
  '@type': 'Service',
  name: 'Online marketing in Drachten',
  serviceType: 'Online marketing uitbesteden',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: [{ '@type': 'City', name: 'Drachten' }, { '@type': 'AdministrativeArea', name: 'Smallingerland' }, { '@type': 'AdministrativeArea', name: 'Friesland' }],
  url: `${site.url}${url}`,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 595, priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: 595, priceCurrency: 'EUR', unitText: 'maand', valueAddedTaxIncluded: false } },
}];
---
<Base
  title="Online marketing Drachten in één hand | Drijfveer Media"
  description="Online marketing in Drachten in één hand: SEO, Google Ads, je bedrijfsprofiel en e-mail in één plan. Vanaf € 595 per maand, maandelijks opzegbaar."
  kruimels={[{ naam: 'Werkgebied', url: '/werkgebied/' }, { naam: 'Friesland', url: '/regio/friesland/' }, { naam: 'Online marketing Drachten', url }]}
  schema={schema}
>
  <Hero kicker="Advies · Drachten" titel="Online marketing in Drachten: één hand aan alle knoppen" prijs="vanaf € 595 per maand">
    <p>SEO bij de een, advertenties bij de ander en social media doe je 's avonds zelf. Niemand ziet het geheel. Bij online marketing in Drachten nemen wij alle knoppen over, met één plan, één budget en één aanspreekpunt.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="tekst">
      <h2>Online marketing in Drachten begint bij je klant</h2>
      <p>De meeste ondernemers die ons bellen, beginnen over kanalen. Moet ik op Instagram? Werkt Google Ads nog? Dat zijn goede vragen, maar het zijn de tweede vragen. De eerste is: wie is je klant, en waar zoekt hij? Een groothandel op De Haven heeft een heel andere klant dan een kapsalon aan De Kaden. Toch krijgen ze vaak hetzelfde pakket aangeboden.</p>
      <p>Wij draaien het om. Eerst verdiepen we ons in je onderneming, je klanten en je cijfers. Dan pas kiezen we de kanalen. Zo geef je geen geld uit aan een kanaal omdat het in de mode is.</p>

      <h2>Wie er in Drachten onderneemt</h2>
      <p>Drachten is de grootste plaats van de gemeente Smallingerland. Het CBS telt in de dertien wijken van Drachten zelf, zonder het buitengebied, 46.030 inwoners en 4.885 bedrijfsvestigingen. In de hele gemeente zijn het 57.084 inwoners en 6.370 vestigingen.</p>
    </div>
    <div class="getallen cijfers">
      <div class="getal-kaart"><b>4.885</b><span>bedrijfsvestigingen in de wijken van Drachten</span></div>
      <div class="getal-kaart"><b>500</b><span>daarvan in de wijk De Haven</span></div>
      <div class="getal-kaart"><b>380</b><span>in het centrum, waarvan 180 in handel en horeca</span></div>
      <div class="getal-kaart"><b>100</b><span>zoekopdrachten per maand op "online marketing drachten"</span></div>
    </div>
    <div class="tekst">
      <p class="klein muted">Bron: CBS, Kerncijfers wijken en buurten 2025 (wijken 01 tot en met 13 van Smallingerland). Het zoekvolume komt uit SE Ranking (oktober 2026).</p>
      <p>Per sector ziet de mix er anders uit. Dit is hoe het CBS de vestigingen in Drachten indeelt, met daarnaast waar wij bij zo'n bedrijf meestal beginnen.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Sector (CBS)</th><th>Vestigingen</th><th>Waar we vaak beginnen</th></tr></thead>
          <tbody>
            <tr><td>Zakelijke dienstverlening</td><td>1.095</td><td>SEO op vakpagina's en een landingspagina die aanvragen oplevert</td></tr>
            <tr><td>Handel en horeca</td><td>1.060</td><td>Google Bedrijfsprofiel, reviews en lokale zoekwoorden</td></tr>
            <tr><td>Overheid, onderwijs en zorg</td><td>970</td><td>Een vindbare site met duidelijke informatie over afspraken en wachttijden</td></tr>
            <tr><td>Nijverheid en energie</td><td>715</td><td>Google Ads op specifieke producten, plus SEO voor heel Nederland</td></tr>
            <tr><td>Cultuur, recreatie en overige diensten</td><td>485</td><td>Bedrijfsprofiel, social media en een agenda op de site</td></tr>
            <tr><td>Vervoer, informatie en communicatie</td><td>320</td><td>SEO en opvolging van offertes per e-mail</td></tr>
            <tr><td>Financiële diensten en onroerend goed</td><td>215</td><td>Vertrouwen: reviews, uitleg en snelle bereikbaarheid</td></tr>
          </tbody>
        </table>
      </div>
      <p class="klein muted">Bron: CBS, Kerncijfers wijken en buurten 2025. De rechterkolom is ons advies, geen CBS-cijfer.</p>

      <h2>Twee soorten klanten: De Haven en het centrum</h2>
      <p>Veel bedrijven in Drachten hebben twee kanten. Een zakelijke tak die levert aan bedrijven, en een particuliere tak met klanten uit Drachten en de dorpen. Die twee vragen een andere aanpak.</p>
    </div>
    <div class="raster raster-2 twee">
      <div class="card">
        <Tekening naam="tandwiel" />
        <h3>Zakelijk, vanaf De Haven en de A7</h3>
        <p>Volgens de gemeente Smallingerland is De Haven een van de grootste aaneengesloten bedrijventerreinen van Noord-Nederland, met ongeveer 550 bedrijven en iets meer dan 10.000 werknemers. Langs de A7 groeit bedrijvenpark Azeven-Noord. Wie hier zit, verkoopt vaak aan inkopers in heel Nederland. Die zoeken zonder plaatsnaam, vergelijken lang en vragen pas een offerte aan als ze overtuigd zijn.</p>
      </div>
      <div class="card">
        <Tekening naam="huis" vertraging={150} />
        <h3>Particulier, in het centrum en de wijken</h3>
        <p>Een klant uit De Wiken, Opeinde of Boornbergum zoekt iets in de buurt. Hij typt de plaatsnaam erbij of laat Google het werk doen. Hij beslist snel: wie staat er op de kaart, wat zeggen de reviews, is de zaak nu open? Hier wint wie lokaal goed vindbaar is.</p>
      </div>
    </div>
    <div class="tekst" style="margin-top:28px">
      <p>Heb je beide kanten, dan maken we twee sporen in één plan. Het zakelijke spoor draait om vakpagina's, Google Ads op specifieke producten en een nette opvolging van offertes. Het particuliere spoor draait om je bedrijfsprofiel, reviews en een site die op de telefoon in tien seconden antwoord geeft. Eén budget, één rapport, maar wel twee verhalen.</p>
      <p class="klein muted">Bron: gemeente Smallingerland, pagina's Toekomstplan de Haven en Verkoop grond voor uitbreiding bedrijvenpark Azeven-Noord.</p>

      <h2>Welk kanaal wanneer</h2>
      <p>Een goed marketingbureau begint niet met een vast pakket, maar met de vraag waar je potentiële klanten zoeken. Zo kijken wij naar de kanalen die we zelf beheren:</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Kanaal</th><th>Werkt goed als</th><th>Werkt slecht als</th><th>Bij ons vanaf</th></tr></thead>
          <tbody>
            <tr><td>SEO</td><td>je blijvende vindbaarheid wilt opbouwen</td><td>je volgende week al klanten nodig hebt</td><td>€ 495 per maand</td></tr>
            <tr><td>Google Ads</td><td>je snel zichtbaar wilt zijn op zoekwoorden met koopintentie</td><td>de klikkosten hoger zijn dan wat een klant oplevert</td><td>afhankelijk van je advertentiebudget</td></tr>
            <tr><td>Google Bedrijfsprofiel en lokale SEO</td><td>je klanten uit de buurt komen</td><td>je alleen landelijk levert</td><td>€ 295 per maand</td></tr>
            <tr><td>Social media beheer</td><td>je vertrouwen en naamsbekendheid wilt opbouwen</td><td>je er directe aanvragen van verwacht</td><td>€ 395 per maand</td></tr>
            <tr><td>E-mailmarketing</td><td>je terugkerende klanten of lange offertetrajecten hebt</td><td>je nog geen lijst met adressen hebt</td><td>€ 295 per maand</td></tr>
          </tbody>
        </table>
      </div>
      <p>Wie SEO combineert met Google Ads, ziet snel welke zoekwoorden echt klanten opleveren. Die kennis gebruiken we weer voor je teksten. Zo versterken de kanalen elkaar, in plaats van dat ze elk een eigen verhaal vertellen. Alles samen, met één vast plan, is <a href="/online-marketing-uitbesteden/">online marketing uitbesteden</a> vanaf € 595 per maand. Advertenties op Facebook, Instagram of TikTok doen we niet. Dat zeggen we liever meteen.</p>
      <div class="kader">
        <p class="kader-titel">Verzonnen voorbeeld</p>
        <p>Stel: een sport- en fietszaak in het centrum van Drachten. In maart en april zoekt iedereen een nieuwe fiets. Dan zetten we Google Ads in op de modellen die op voorraad zijn. Het hele jaar door werken we aan SEO voor reparatie en onderhoud, want daar wordt elke week op gezocht. Social media marketing laat de werkplaats zien. En wie een fiets kocht, krijgt in het najaar een mail over de winterbeurt.</p>
      </div>

      <h2>Rekenvoorbeeld: wat mag een aanvraag kosten?</h2>
      <p>De vraag "werkt online marketing?" is te vaag. De echte vraag is: wat mag een aanvraag je kosten, en zit je daar onder? Dat reken je zo uit. Alle cijfers hieronder zijn verzonnen, voor een installateur in Drachten die warmtepompen plaatst.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Stap</th><th>Verzonnen cijfer</th><th>Uitleg</th></tr></thead>
          <tbody>
            <tr><td>Brutowinst per opdracht</td><td>€ 1.600</td><td>Omzet min inkoop en uren</td></tr>
            <tr><td>Van de aanvragen wordt opdracht</td><td>1 op 4</td><td>Haal je uit je eigen offerteadministratie</td></tr>
            <tr><td>Maximaal per aanvraag (break-even)</td><td>€ 400</td><td>€ 1.600 gedeeld door 4</td></tr>
            <tr><td>Advertentiebudget per maand</td><td>€ 600</td><td>Betaal je rechtstreeks aan Google</td></tr>
            <tr><td>Gemiddelde klikkosten</td><td>€ 3</td><td>Dus 200 klikken per maand</td></tr>
            <tr><td>Van de klikkers vraagt offerte aan</td><td>5%</td><td>10 aanvragen per maand</td></tr>
            <tr><td>Kosten per aanvraag</td><td>€ 60</td><td>Ruim onder de € 400</td></tr>
          </tbody>
        </table>
      </div>
      <p>In dit voorbeeld kun je gerust meer uitgeven, want elke aanvraag is veel meer waard dan hij kost. Kom je in jouw eigen sommetje boven het maximum uit, dan stoppen we eerst met de zoekwoorden die het duurst zijn. Of we maken de pagina beter, zodat meer bezoekers bellen. Dat zijn de structurele verbeteringen waar het om draait: niet meer klikken kopen, maar meer halen uit elke klik. Meer over het opzetten van zo'n campagne lees je bij ons <a href="/online-adverteren/google-ads-bureau/">Google Ads-beheer</a>.</p>

      <h2>Hoe mensen rond Drachten zoeken</h2>
      <p>Niet elke zoekopdracht is hetzelfde. Wie "cv-ketel kapot" typt, wil vandaag iemand aan de deur. Wie "warmtepomp ervaringen" zoekt, oriënteert zich nog. Per moment past een ander kanaal.</p>
      <div class="tabel-scroll">
        <table>
          <thead><tr><th>Moment</th><th>Voorbeeld van een zoekopdracht</th><th>Wat werkt</th></tr></thead>
          <tbody>
            <tr><td>Nu nodig, dichtbij</td><td>"loodgieter drachten", "kapper in de buurt"</td><td>Google Bedrijfsprofiel en Google Ads met een straal rond Drachten</td></tr>
            <tr><td>Uit een dorp</td><td>"hovenier rottevalle", "garage boornbergum"</td><td>Je werkgebied duidelijk op je site en in je profiel</td></tr>
            <tr><td>Oriënteren</td><td>"wat kost een dakkapel", "warmtepomp of hybride"</td><td>Uitlegpagina's en SEO</td></tr>
            <tr><td>Vergelijken</td><td>"beste schilder drachten", "reviews aannemer"</td><td>Reviews, voorbeelden van werk en een heldere prijsindicatie</td></tr>
            <tr><td>Zakelijk, landelijk</td><td>"rvs constructie laten maken"</td><td>Vakpagina's, links van andere sites en gerichte advertenties</td></tr>
          </tbody>
        </table>
      </div>
      <p>Met Google Ads kun je adverteren in een straal rond een adres. Volgens Google moet die straal minstens 1 kilometer zijn, en een heel kleine straal geeft soms weinig vertoningen. Voor een installateur in Drachten werkt een straal van 15 of 20 kilometer vaak beter dan alleen de plaatsnaam. Dan bereik je ook Opeinde, De Wilgen en Houtigehage.</p>

      <h2>Je Google Bedrijfsprofiel als etalage</h2>
      <p>Zoekt iemand een bedrijf in Drachten, dan ziet hij vaak eerst een kaartje met drie bedrijven. Volgens Google bepalen drie dingen wie daar staat: relevantie, afstand en prominentie. Bij prominentie telt volgens Google onder meer hoeveel websites naar je bedrijf linken en hoeveel reviews je hebt.</p>
      <ul class="vink">
        <li>Kies de juiste hoofdcategorie. Een "installatiebedrijf" wordt anders gevonden dan een "loodgieter".</li>
        <li>Kom je bij klanten thuis? Stel dan een servicegebied in. Google staat er maximaal 20 toe.</li>
        <li>Vraag na elke klus om een review, met een vaste link of een QR-code op de factuur.</li>
        <li>Zet echte foto's van je werk en je team erin, niet alleen je logo.</li>
      </ul>
      <p>Dit regelen we eenmalig vanaf € 249 bij <a href="/lokale-seo/google-bedrijfsprofiel/">Google Bedrijfsprofiel, Bing en Apple</a>. Wil je het zelf doen, lees dan onze gids over het <a href="/kennisbank/gidsen/google-bedrijfsprofiel/">Google Bedrijfsprofiel</a>.</p>

      <h2>Het centrum gaat op de schop</h2>
      <p>De gemeente Smallingerland werkt aan een nieuw centrum. In de centrumaanpak staan projecten voor het Raadhuisplein, De Kaden, het Cultuurkwartier, Museum Dr8888 en Vogelzang. De gemeente schrijft zelf dat die aanpak meerdere jaren duurt en stap voor stap wordt uitgevoerd.</p>
      <p>Heb je een zaak in het centrum, dan merk je dat online eerder dan je denkt. Een klant die leest dat de straat open ligt, rijdt naar de woonboulevard of bestelt online. Dit kun je doen zolang er gewerkt wordt:</p>
      <ol>
        <li>Zet in je Google Bedrijfsprofiel een update over de bereikbaarheid, met de beste looproute en waar je kunt parkeren.</li>
        <li>Zet afwijkende openingstijden in je profiel als je die hebt. Dat kan via Profiel bewerken en dan Openingstijden. Zo toont Google geen verkeerde tijden.</li>
        <li>Zet bovenaan je site één zin: "We zijn gewoon open, zo kom je bij ons."</li>
        <li>Deel op je sociale kanalen foto's van de vorderingen. Mensen zijn nieuwsgierig naar het nieuwe plein.</li>
        <li>Maak na de oplevering nieuwe foto's van je gevel. Oude foto's laten anders een bouwput zien.</li>
      </ol>
      <p class="klein muted">Bron: gemeente Smallingerland, pagina Aanpak Centrum Drachten.</p>

      <h2>Ondernemersfonds Smallingerland: samen promoten</h2>
      <p>Sinds 1 januari 2026 heeft Smallingerland een ondernemersfonds. Het geld komt uit een opslag op de onroerendezaakbelasting voor niet-woningen. Volgens de gemeente gaat het naar gezamenlijke projecten, zoals promotie en marketing, veiligheid, bereikbaarheid, duurzaamheid en evenementen. Ondernemers beslissen zelf, per gebied of sector, waar het aan wordt besteed. De gemeenteraad koos voor een proefperiode van vijf jaar.</p>
      <p>Dat raakt je eigen marketing. Een gezamenlijke campagne voor het centrum of een evenement stuurt mensen naar één centrale site. Zorg dat je daar goed op staat, met een link naar je eigen site. Zo'n link uit je eigen plaats helpt je ook in Google. Zit je in een werkgroep, denk dan mee over het meten: hoeveel bezoekers kwamen er via de campagne, en waar klikten ze heen?</p>
      <p class="klein muted">Bron: gemeente Smallingerland, pagina Ondernemersfonds.</p>

      <h2>Waar we mee stoppen</h2>
      <p>Bureaus adviseren te weinig om ergens mee te stoppen. Toch levert verspild budget schrappen vaak meer op dan een nieuwe campagne. Daarom kijken we in de eerste maand naar wat er nu al loopt. Vaak vinden we advertenties op zoekwoorden waar niemand op koopt, berichten op vijf kanalen waar niemand op reageert, of een nieuwsbrief die al jaren in de spam belandt. Wat niets oplevert, gaat eruit. Dat geld zetten we in op wat wel werkt.</p>

      <h2>Wat online marketing in Drachten per maand kost</h2>
      <p>Online marketing uitbesteden begint bij € 595 per maand, exclusief btw. Je advertentiebudget komt daar los bij en betaal je rechtstreeks aan Google. Daarvoor krijg je:</p>
      <ul class="vink">
        <li>Eén aanspreekpunt: {site.contactpersoon}, die je onderneming kent en de kanalen op elkaar afstemt.</li>
        <li>Concrete doelen, zoals een aantal aanvragen per maand, waar je ons op kunt afrekenen.</li>
        <li>Structurele verbeteringen aan je website, zodat meer bezoekers bellen of mailen.</li>
        <li>Elke maand een kort overzicht in gewone taal. Geen rapport waar je een marketeer bij nodig hebt.</li>
        <li>Iemand die de ontwikkelingen bijhoudt, zoals AI-antwoorden in Google en adverteren in ChatGPT.</li>
      </ul>
      <p>Heb je zelf een marketeer en zoek je vooral een tweede paar handen, dan is een <a href="/online-marketing-uitbesteden/interim-marketeer/">interim-marketeer</a> vanaf € 95 per uur misschien handiger. Eerst een uur sparren kan ook, met een <a href="/consult/">consult</a> vanaf € 85 per uur.</p>

      <h2>De eerste negentig dagen</h2>
      <p>We beginnen waar de grootste kans op snel verschil zit. Daarna perfectioneren we. Zo ziet dat er bij de meeste klanten uit:</p>
    </div>
    <ol class="stappen-rij">
      <li><strong>Week 1 en 2</strong><p>Meten wat er nu is: aanvragen, telefoontjes, advertenties, posities en je profiel. Zonder nulmeting weet niemand later wat werkte.</p></li>
      <li><strong>Week 3 tot 6</strong><p>De snelle winst: verspild budget eruit, je profiel op orde, de drukste pagina's beter laten converteren.</p></li>
      <li><strong>Week 7 tot 13</strong><p>Bouwen: nieuwe pagina's, een eerste campagne op de beste zoekwoorden, opvolging van offertes per e-mail.</p></li>
      <li><strong>Daarna</strong><p>Elke maand bijsturen op de cijfers. Wat werkt krijgt meer budget, wat niet werkt stopt.</p></li>
    </ol>
    <div class="tekst" style="margin-top:40px">
      <h2>Vanuit Assen naar Drachten</h2>
      <p>Drijfveer Media is gevestigd in Assen, sinds 2011. We zitten dus niet in Drachten, en we doen ook niet alsof. Naar Drachten is het ongeveer 50 kilometer, over de N381 zo'n 50 minuten rijden. We komen graag langs om je plannen te bespreken. Je bent ook welkom op ons kantoor aan de Lauwers. Daarna werken we vooral op afstand, met een vast belmoment.</p>
      <p>Het team is klein en gedreven: vier mensen plus een groep freelancers die we al jaren kennen. Alles wat we doen aan vindbaarheid, testen we eerst op ons <a href="/proeflab/">proeflab</a> van meer dan 100 eigen websites. Wil je eerst weten waar je staat? Vraag dan een <a href="/gratis-website-analyse/">gratis website-analyse</a> aan. Zoek je alleen meer bezoekers uit Google, kijk dan bij <a href="/seo-drachten/">SEO in Drachten</a>. Werk je ook voor klanten verderop in Fryslân, kijk dan bij <a href="/regio/friesland/">onze diensten in Friesland</a> of bij <a href="/online-marketing-heerenveen/">online marketing in Heerenveen</a>.</p>
    </div>
  </section>

  <Bewijs />

  <Faq
