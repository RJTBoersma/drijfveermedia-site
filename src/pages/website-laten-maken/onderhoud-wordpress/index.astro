    url: `${site.url}${url}`,
    offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 39, priceSpecification: { '@type': 'UnitPriceSpecification', price: 39, priceCurrency: 'EUR', unitText: 'MONTH', valueAddedTaxIncluded: false } },
