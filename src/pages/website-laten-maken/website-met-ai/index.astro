---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/pagina/Hero.astro';
import Bewijs from '../../../components/pagina/Bewijs.astro';
import Faq from '../../../components/pagina/Faq.astro';
import Actie from '../../../components/pagina/Actie.astro';
import Prijskaart from '../../../components/pagina/Prijskaart.astro';
import Verder from '../../../components/pagina/Verder.astro';
import Inhoud from '../../../components/pagina/Inhoud.astro';
import Auteur from '../../../components/pagina/Auteur.astro';
import Tekening from '../../../components/teken/Tekening.astro';
import Scene from '../../../components/scenes/website-laten-maken--website-met-ai.astro';
import { site, persoon } from '../../../data/site';
import Tussenactie from '../../../components/pagina/Tussenactie.astro';

const url = '/website-laten-maken/website-met-ai/';
const datum = '2026-10-18';
const hoofdstukken = [
  { id: 'wat', titel: 'Wat het bij ons betekent' },
  { id: 'ai-mens', titel: 'Wat AI doet en wat wij doen' },
  { id: 'zelf', titel: 'Waarom niet zelf?' },
  { id: 'google', titel: 'Wordt hij gevonden?' },
  { id: 'werkwijze', titel: 'Zo werkt het' },
  { id: 'prijs', titel: 'Wat je krijgt voor € 250' },
  { id: 'voor-wie', titel: 'Voor wie het past' },
  { id: 'daarna', titel: 'Na de oplevering' },
];
const schema = [
  {
    '@type': 'Service',
    '@id': `${site.url}${url}#dienst`,
    name: 'Website met AI laten maken',
    serviceType: 'Webdesign',
    provider: { '@id': `${site.url}/#organisatie` },
    areaServed: { '@type': 'Country', name: 'Nederland' },
    url: `${site.url}${url}`,
    offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 250, priceSpecification: { '@type': 'PriceSpecification', minPrice: 250, priceCurrency: 'EUR', valueAddedTaxIncluded: false } },
  },
  {
    '@type': 'WebPage',
    '@id': `${site.url}${url}#pagina`,
    url: `${site.url}${url}`,
    name: 'Website met AI laten maken, door mensen afgemaakt',
    inLanguage: 'nl-NL',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}${url}#dienst` },
    dateModified: datum,
    author: { '@type': 'Person', name: persoon('robert').naam, jobTitle: persoon('robert').rol, url: `${site.url}/over-ons/` },
  },
];
---
<Base
  title="Website met AI laten maken vanaf € 250 | Drijfveer Media"
  description="Website met AI laten maken, en door vakmensen afgemaakt. Vanaf € 250 eenmalig, vaak binnen twee weken online, zonder verplicht abonnement."
  kruimels={[{ naam: 'Website laten maken', url: '/website-laten-maken/' }, { naam: 'Website met AI', url }]}
  schema={schema}
>
  <Hero kicker="Gekozen · Website" titel="Website met AI laten maken, door mensen afgemaakt" prijs="vanaf € 250" eenmalig>
    <p>Snel online met een professionele website die klopt. AI doet het zware werk, wij maken hem af. Vaak staat hij er binnen twee weken, voor een vast bedrag.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="met-zijkolom">
      <article class="tekst">
        <Auteur slug="robert" datum={datum} nagekeken="thorgall" />
        <div class="kader kader-oranje in-het-kort">
          <p class="kader-titel">In het kort</p>
          <ul>
            <li>AI bouwt de eerste versie, wij maken hem met de hand af: teksten, feiten, knoppen en de basis voor Google.</li>
            <li>Vanaf € 250 eenmalig, exclusief btw. Een vaste prijs vooraf, geen verplicht abonnement.</li>
            <li>Vaak binnen twee weken online. Het tempo hangt vooral af van wat jij aanlevert.</li>
            <li>De site, het domein en de hosting staan op jouw naam.</li>
            <li>Past bij starters, zzp'ers en kleine bedrijven. Voor webshops en ingewikkelde koppelingen is het niet bedoeld.</li>
          </ul>
        </div>

        <h2 id="wat">Wat een website met AI laten maken bij ons betekent</h2>
        <p>Een website met AI laten maken klinkt als op een knop drukken en klaar. Zo werkt het bij ons niet. AI bouwt de eerste versie: de opbouw, de opmaak, een opzet voor de teksten. Daarna gaan wij er met de hand doorheen. We herschrijven wat te algemeen is, controleren elk feit en zetten de belknop op de plek waar je bezoeker hem zoekt.</p>
        <p>Het resultaat is een complete site die mobielvriendelijk is, snel laadt en goed is ingericht voor Google. Voor een fractie van wat een bureau vraagt, omdat AI ons uren werk scheelt. Die besparing geven we door.</p>
        <p>Het is de snelle route binnen <a href="/website-laten-maken/">website laten maken</a>. Wil je een volledig eigen ontwerp, dan is maatwerk in WordPress de andere route.</p>

        <h2 id="ai-mens">Wat AI doet, en wat wij doen</h2>
        <p>AI is goed in snel en veel. Het is slecht in kloppen en in jou. Daarom verdelen we het werk zo:</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Onderdeel</th><th>AI</th><th>Wij</th></tr></thead>
            <tbody>
              <tr><td><b>Opbouw van de pagina's</b></td><td>Zet een eerste indeling neer</td><td>Kiezen welke pagina's je echt nodig hebt</td></tr>
              <tr><td><b>Ontwerp</b></td><td>Maakt een strakke basis</td><td>Passen kleuren, logo en foto's aan op jouw bedrijf</td></tr>
              <tr><td><b>Teksten</b></td><td>Schrijft een eerste opzet</td><td>Herschrijven tot het klinkt als jij, en schrappen wat iedereen zegt</td></tr>
              <tr><td><b>Feiten en prijzen</b></td><td>Verzint soms iets wat echt lijkt</td><td>Controleren alles met jouw gegevens</td></tr>
              <tr><td><b>Contact</b></td><td>Zet een formulier neer</td><td>Testen of het aankomt, en zetten de belknop goed in beeld</td></tr>
              <tr><td><b>SEO-basis</b></td><td>Doet een voorstel</td><td>Titels, beschrijvingen en koppen per pagina, plus gegevens voor zoekmachines</td></tr>
            </tbody>
          </table>
        </div>
        <p>Dat AI soms iets verzint, is geen bijzaak. Google schrijft in zijn <a href="https://developers.google.com/search/docs/fundamentals/using-gen-ai-content" rel="noopener">richtlijnen voor content met generatieve AI</a> dat zulke modellen geen feiten opzoeken, maar het meest waarschijnlijke volgende woord voorspellen. Google raadt daarom aan om alle AI-teksten op juistheid te controleren voordat je ze publiceert. Dat doen we dus. Welke tools we gebruiken, lees je op <a href="/zo-werken-we-met-ai/">zo werken we met AI</a>.</p>

        <h2 id="zelf">Waarom niet zelf met een AI-websitebouwer?</h2>
        <p>Dat kan. Wix, Squarespace en een handvol nieuwe diensten zetten in tien minuten een site neer. Probeer het gerust. Je ziet dan meteen waar het schuurt.</p>
        <ul>
          <li><b>De teksten zijn van iedereen.</b> Een AI-bouwer kent je bedrijf niet. Hij schrijft "kwaliteit en service staan bij ons voorop", net als bij je concurrent.</li>
          <li><b>De basis voor Google ontbreekt vaak.</b> Paginatitels, koppen, beschrijvingen en de code die zoekmachines vertelt wie je bent, staan er niet of half in.</li>
          <li><b>Je betaalt elke maand.</b> De meeste bouwers werken met een verplicht abonnement. Stop je, dan stopt je site.</li>
          <li><b>Het kost meer tijd dan je denkt.</b> De eerste versie staat er snel. De laatste twintig procent kost avonden.</li>
        </ul>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th></th><th>Zelf met een AI-bouwer</th><th>Website met AI bij ons</th><th>Maatwerk in WordPress</th></tr></thead>
            <tbody>
              <tr><td><b>Prijs</b></td><td>Een abonnement per maand</td><td>Vanaf € 250 eenmalig</td><td>Vanaf € 2.000</td></tr>
              <tr><td><b>Doorlooptijd</b></td><td>Een avond tot een paar weken, naast je werk</td><td>Vaak binnen twee weken</td><td>Zes tot tien weken</td></tr>
              <tr><td><b>Teksten</b></td><td>Algemene AI-tekst, tenzij je ze zelf herschrijft</td><td>Met de hand afgemaakt</td><td>Met de hand, of door onze tekstschrijver</td></tr>
              <tr><td><b>SEO-basis</b></td><td>Zelf instellen</td><td>Ingericht</td><td>Ingericht</td></tr>
              <tr><td><b>Van wie is de site?</b></td><td>Hij leeft bij de bouwer</td><td>Van jou</td><td>Van jou</td></tr>
              <tr><td><b>Past bij</b></td><td>Wie het leuk vindt en tijd heeft</td><td>Starters, zzp'ers, kleine bedrijven</td><td>Mkb met meer diensten of eigen wensen</td></tr>
            </tbody>
          </table>
        </div>
        <p>Wie zelf wil bouwen, vindt in de gids <a href="/kennisbank/gidsen/zelf-website-maken/">zelf een website maken of laten maken</a> een eerlijke vergelijking. En ben je nieuwsgierig naar bouwen met alleen prompts, lees dan de gids over <a href="/kennisbank/gidsen/vibe-coding/">vibe coding</a>.</p>

        <Tussenactie />
        <h2 id="google">Wordt een AI-website gevonden in Google?</h2>
        <p>Ja, als hij goed is. Google beoordeelt een pagina op wat erop staat, niet op hoe hij gemaakt is. Er zit wel een grens aan. Wie met AI in hoog tempo pagina's maakt waar niemand iets aan heeft, kan volgens Google het spambeleid tegen massaal geproduceerde content overtreden. Een site met tien pagina's die echt over jouw bedrijf gaan, heeft daar niets mee te maken.</p>
        <p>Wat wel telt, is wat Google bij elke site wil zien: duidelijke titels en koppen, teksten die de vraag van de bezoeker beantwoorden, een site die snel is op een telefoon, en gegevens die kloppen. Daarom zit de SEO-basis bij elke site in de prijs. Wil je hoger komen bij zoekwoorden met veel concurrentie, dan is <a href="/zoekmachine-optimalisatie/">zoekmachine-optimalisatie</a> de volgende stap.</p>

        <h2 id="werkwijze">Zo werkt het</h2>
        <div class="stap-kop"><Tekening naam="telefoon" maat={48} /><h3>1. Een kort gesprek</h3></div>
        <p>{site.contactpersoon} belt je binnen 15 minuten terug, op werkdagen tussen 8.00 en 17.00 uur. Hij vraagt wat je doet, voor wie, in welke regio en wat de site moet opleveren. Bellen, een offerte, een afspraak? Daarna hoor je de vaste prijs.</p>

        <div class="stap-kop"><Tekening naam="ai" maat={48} /><h3>2. AI zet de eerste versie neer</h3></div>
        <p>Met jouw antwoorden laten we AI de opbouw, het ontwerp en een eerste versie van de teksten maken. Daar gebruiken we tools als Claude, ChatGPT en Gemini voor. Dit deel gaat snel.</p>

        <div class="stap-kop"><Tekening naam="pen" maat={48} /><h3>3. Wij maken hem af</h3></div>
        <p>Nu begint het vakwerk. We herschrijven de teksten tot ze klinken als jouw bedrijf, kloppen je diensten en prijzen, en richten de SEO-basis in. We testen op telefoon en laptop en kijken of het formulier aankomt.</p>

        <div class="stap-kop"><Tekening naam="raket" maat={48} /><h3>4. Jij kijkt mee, daarna gaat hij live</h3></div>
        <p>Je ziet de site voordat hij online gaat en geeft door wat anders moet. Pas als het klopt, zetten we hem live. Een snelle oplevering, maar geen gehaaste.</p>

        <h3>Wat je zelf kunt voorbereiden</h3>
        <p>De grootste vertraging zit bijna altijd in teksten en foto's. Met dit lijstje gaat het een stuk sneller:</p>
        <ul class="vink">
          <li>Je logo als bestand, het liefst als SVG of PNG met een doorzichtige achtergrond. Nog geen logo? Kijk bij <a href="/branding/logo-laten-maken/">logo laten maken</a>.</li>
          <li>Tien tot twintig eigen foto's van je werk, je team of je bus. Liever een goede telefoonfoto dan een stockfoto.</li>
          <li>Een lijstje van je diensten, met de vragen die klanten er altijd over stellen.</li>
          <li>Je domeinnaam, of een paar ideeën. Twijfel je, lees dan de gids <a href="/kennisbank/gidsen/domeinnaam-kiezen/">domeinnaam kiezen</a>.</li>
          <li>Twee sites die je mooi vindt, en één die je vreselijk vindt.</li>
        </ul>

        <h2 id="prijs">Wat je krijgt voor € 250</h2>
        <p>Een eenmalig, vast bedrag, exclusief btw. Geen verrassingen achteraf en geen verplicht abonnement. Wat erin zit:</p>
        <ul class="vink">
          <li>Een professionele website die je bedrijf helder neerzet</li>
          <li>Mobielvriendelijk, getest op telefoon, tablet en laptop</li>
          <li>Een SEO-basis: titels, beschrijvingen, koppen en gegevens voor zoekmachines</li>
          <li>Bellen met één tik en een contactformulier dat aankomt</li>
          <li>Een eenvoudig beheerscherm om zelf teksten en foto's te wijzigen</li>
          <li>De website volledig op jouw naam, net als je domein</li>
        </ul>
        <p>Hoeveel pagina's erin passen en wie de teksten aanlevert, bespreken we vooraf. Heb je meer nodig, dan hoor je de meerprijs voordat we beginnen. Laat je alle teksten door ons schrijven, dan betaal je daarvoor vanaf € 75 per pagina via onze <a href="/tekstschrijver/">tekstschrijver</a>. Eerlijke prijzen betekent ook: niets bijrekenen wat je niet gevraagd hebt.</p>
        <h3>Wat de prijs hoger maakt</h3>
        <p>Drie dingen bepalen waar je uitkomt. Hoeveel pagina's je nodig hebt. Of wij de teksten schrijven of jij ze aanlevert. En of er bijzondere functies in moeten, zoals een afsprakenplanner of een koppeling met je software. Dat laatste past vaak beter bij maatwerk.</p>
        <div class="kader">
          <p class="kader-titel">Rekenvoorbeeld (verzonnen)</p>
          <p>Een fysiotherapeut in Leek wil een site met een homepage, drie behandelpagina's en een contactpagina. Ze heeft een logo en goede foto's, maar geen teksten. De site begint bij € 250. Laat ze de teksten voor vijf pagina's door ons schrijven, dan komt daar vanaf € 75 per pagina bij. Na het eerste gesprek hoort ze de vaste prijs, voordat er iets gebeurt.</p>
        </div>

        <h2 id="voor-wie">Voor wie het past, en voor wie niet</h2>
        <p>De snelle route past bij een zzp'er die eindelijk een fatsoenlijke site wil. Bij een starter die over een maand opent. Bij een vakman die nu alleen een Facebookpagina heeft en merkt dat klanten daar niet op vertrouwen. Of bij een bedrijf met een site van tien jaar oud, waar je liever niemand naartoe stuurt.</p>
        <p>Het past minder goed als je veel diensten hebt die elk een eigen uitgebreide pagina verdienen. Of als je een boekingssysteem, een klantportaal of een koppeling met je software nodig hebt. Dan kom je met maatwerk verder. En webshops bouwen we helemaal niet.</p>
        <div class="kader">
          <p class="kader-titel">Liever geen AI voor jouw site?</p>
          <p>Dat begrijpen we. We zijn een bureau dat AI gebruikt, en bij deze route zit AI er nu eenmaal in. Wil je het anders, zeg het gerust. Bij maatwerk kunnen we soms een andere aanpak kiezen. Lees op <a href="/zo-werken-we-met-ai/">zo werken we met AI</a> wat we wel en niet doen met jouw gegevens.</p>
        </div>

        <h2 id="daarna">Na de oplevering kun je vooruit</h2>
        <p>Een site van € 250 is geen eindpunt. Komen er bezoekers maar te weinig aanvragen, dan kijken we samen naar de opbouw. Wil je hoger in Google, dan is SEO de volgende stap. Werk je vooral in je eigen regio, begin dan met een goed ingericht <a href="/lokale-seo/google-bedrijfsprofiel/">Google Bedrijfsprofiel</a>. En groeit je bedrijf, dan bouwen we verder of stap je over op maatwerk. Zonder gedoe, want alles staat al op jouw naam.</p>
        <p>Hosting regel je zelf. Dat doen we bewust niet, zodat de site echt van jou is. Een domein en eenvoudige hosting kosten samen meestal een paar euro per maand. Wat hosting precies is, staat in het begrip <a href="/kennisbank/wat-is/hosting/">hosting</a>.</p>
      </article>
      <aside class="zijkolom">
        <Inhoud items={hoofdstukken} leestijd={9} />
        <Prijskaart naam="Website met AI" prijs="€ 250" eenmalig punten={['Met de hand afgemaakt', 'Mobielvriendelijk en snel', 'SEO-basis ingericht', 'Geen verplicht abonnement', 'Helemaal van jou']} noot="Vaak binnen twee weken online." />
      </aside>
    </div>
  </section>

  <Bewijs />

  <Faq
    vragen={[
      { v: 'Is een website maken met AI niet gewoon een template?', a: 'Nee. AI zet een eerste versie neer op basis van jouw antwoorden. Daarna herschrijven en controleren wij alles met de hand, zodat de site over jouw bedrijf gaat en niet over een willekeurig bedrijf.' },
      { v: 'Wat kost een website met AI laten maken?', a: 'Bij ons vanaf € 250 eenmalig, exclusief btw. Teksten door onze tekstschrijver kosten vanaf € 75 per pagina. Je hoort de vaste prijs vooraf.' },
      { v: 'Hoe snel staat mijn site online?', a: 'Vaak binnen twee weken. Het tempo hangt vooral af van hoe snel je je logo, foto\'s en antwoorden aanlevert.' },
      { v: 'Zit ik vast aan een abonnement?', a: 'Nee. Je betaalt een eenmalig bedrag. Hosting regel je zelf, op je eigen naam.' },
      { v: 'Kan ik later uitbreiden?', a: 'Ja. Je kunt pagina\'s toevoegen of later overstappen op een maatwerk website. Je teksten en domein neem je gewoon mee.' },
      { v: 'Wordt een AI-website wel gevonden in Google?', a: 'De basis zit erin: titels, koppen, beschrijvingen en gegevens voor zoekmachines. Google beoordeelt een site op inhoud en kwaliteit, niet op hoe hij gemaakt is. Daarom maken we de teksten met de hand af.' },
      { v: 'Bouwen jullie ook een webshop met AI?', a: 'Nee. Webshops bouwen we niet, ook niet met AI. Wil je online producten verkopen met een winkelwagen en betalingen, dan is een gespecialiseerde partij een betere keus.' },
    ]}
  />

  <Verder
    titel="Meer over je website"
    links={[
      { label: 'Pillar', titel: 'Website laten maken', href: '/website-laten-maken/', tekst: 'Beide routes naast elkaar, met prijsindicatie.' },
      { label: 'Gids', titel: 'Website voor zzp\'ers', href: '/kennisbank/gidsen/website-zzp/', tekst: 'Wat er echt op je site moet.' },
      { label: 'Dienst', titel: 'UX- en UI-design', href: '/website-laten-maken/ux-ui-design/', tekst: 'Als bezoekers wel komen maar niet bellen.' },
      { label: 'Gids', titel: 'Wat kost een website?', href: '/kennisbank/gidsen/wat-kost-een-website/', tekst: 'Wat een website in 2026 kost.' },
    ]}
  />

  <Actie titel="Volgende maand online?" tekst={`Vertel ${site.contactpersoon} wat je doet en voor wie. Hij belt je binnen 15 minuten terug en zegt eerlijk of de snelle route bij je past.`} />
</Base>
