  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: { '@type': 'Country', name: 'Niederlande' },
  url: `${site.url}${url}`,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 395, priceSpecification: { '@type': 'UnitPriceSpecification', price: 395, priceCurrency: 'EUR', unitText: 'MONTH', valueAddedTaxIncluded: false } },
