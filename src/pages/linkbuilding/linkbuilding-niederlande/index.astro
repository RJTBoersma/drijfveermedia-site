const url = '/linkbuilding/linkbuilding-niederlande/';
const telefoonInt = '+31 88 11 55 666';
const inhalt = [
  { id: 'warum', titel: 'Warum niederländische Links' },
  { id: 'google', titel: 'Was Google selbst sagt' },
