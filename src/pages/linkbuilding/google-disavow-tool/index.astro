---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/pagina/Hero.astro';
import Bewijs from '../../../components/pagina/Bewijs.astro';
import Faq from '../../../components/pagina/Faq.astro';
import Actie from '../../../components/pagina/Actie.astro';
import Prijskaart from '../../../components/pagina/Prijskaart.astro';
import Verder from '../../../components/pagina/Verder.astro';
import Inhoud from '../../../components/pagina/Inhoud.astro';
import Auteur from '../../../components/pagina/Auteur.astro';
import Tekening from '../../../components/teken/Tekening.astro';
import Scene from '../../../components/scenes/linkbuilding--google-disavow-tool.astro';
import { site } from '../../../data/site';
import Tussenactie from '../../../components/pagina/Tussenactie.astro';

const url = '/linkbuilding/google-disavow-tool/';
const hoofdstukken = [
  { id: 'wat-doet-hij', titel: 'Wat de tool doet' },
  { id: 'geschiedenis', titel: 'Waarom je hem zelden nodig hebt' },
  { id: 'wanneer', titel: 'Wel of niet afwijzen' },
  { id: 'handmatige-actie', titel: 'Handmatige actie of niet?' },
  { id: 'stappenplan', titel: 'Stappenplan' },
  { id: 'heroverweging', titel: 'Verzoek tot heroverweging' },
  { id: 'negatieve-seo', titel: 'Kan een concurrent je schaden?' },
  { id: 'fouten', titel: 'Veelgemaakte fouten' },
  { id: 'hulp', titel: 'Wat wij voor je doen' },
];
const schema = [{
  '@type': 'Service',
  name: 'Hulp bij de Google disavow tool',
  serviceType: 'Linkprofiel beoordelen en links afwijzen',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  url: `${site.url}${url}`,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 85, priceSpecification: { '@type': 'UnitPriceSpecification', price: 85, priceCurrency: 'EUR', unitText: 'HOUR', valueAddedTaxIncluded: false } },
}];
---
<Base
  title="Google disavow tool gebruiken | Drijfveer Media"
  description="Met de Google disavow tool vraag je Google om slechte links te negeren. Wanneer het zin heeft, hoe je het bestand maakt en hulp vanaf € 85 per uur."
  kruimels={[{ naam: 'Linkbuilding', url: '/linkbuilding/' }, { naam: 'Google disavow tool', url }]}
  schema={schema}
>
  <Hero kicker="Gevonden · Linkbuilding" titel="Google disavow tool: alleen gebruiken als het echt moet" prijs="vanaf € 85 per uur" eenmalig>
    <p>Met de disavow tool vraag je Google om bepaalde links naar je site te negeren. Handig na een straf van Google. Gevaarlijk als je hem gebruikt zonder dat het nodig is.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="met-zijkolom">
      <article class="tekst">
        <Auteur slug="robert" datum="2026-10-18" />
        <div class="kader kader-oranje in-het-kort">
          <p class="kader-titel">In het kort</p>
          <p>De Google disavow tool is een onderdeel van Search Console waarmee je links naar je site afwijst. Google telt ze dan niet meer mee. Volgens Google hebben de meeste sites de tool niet nodig. Gebruik hem alleen als je veel kunstmatige links hebt en die tot een handmatige actie hebben geleid, of als die actie eraan komt. Twijfel je, laat dan eerst iemand meekijken. Bij ons kan dat in een consult vanaf € 85 per uur.</p>
        </div>

        <h2 id="wat-doet-hij">Wat de Google disavow tool doet</h2>
        <p>De Google disavow tool hoort bij Search Console. Je uploadt er een tekstbestand met links of hele domeinen die naar je site wijzen. Daarmee zeg je tegen Google: tel deze links niet mee. In het Nederlands heet het links afwijzen.</p>
        <p>De links verdwijnen niet van internet. Ze blijven gewoon staan en je ziet ze ook nog in het rapport Links van Search Console. Google houdt er alleen geen rekening meer mee. Dat gebeurt niet meteen: volgens Google kan het een paar weken duren voordat je lijst is verwerkt. Google verwerkt hem pas als het de pagina's met die links opnieuw bezoekt.</p>
        <p>De tool heeft een eigen pagina. Je opent hem via de helppagina van Google over links afwijzen. Je moet eigenaar zijn van de property in Search Console om een lijst te mogen uploaden.</p>

        <h2 id="geschiedenis">Waarom de meeste sites hem niet nodig hebben</h2>
        <p>De tool kwam er op 16 oktober 2012. In datzelfde jaar begon Google met Penguin, een filter tegen linkspam. Sites met veel gekochte en geruilde links zakten weg. Wie die links niet weg kreeg, kon ze voortaan afwijzen. Google schreef er toen al bij dat de grote meerderheid van de sites de tool helemaal niet hoeft te gebruiken.</p>
        <p>Sindsdien is er veel veranderd. Twee stappen zijn voor jou van belang:</p>
        <ul>
          <li><b>September 2016.</b> Penguin werd onderdeel van het gewone algoritme van Google. Volgens Google straft het sindsdien niet meer de hele site, maar haalt het de waarde van spamlinks weg.</li>
          <li><b>December 2022.</b> Google zette SpamBrain in, een systeem dat met AI spam herkent. Het ziet sites die links kopen en sites die links verkopen, en zet de waarde van die links op nul.</li>
        </ul>
        <p>Wat dat betekent: in de meeste gevallen worden slechte links al genegeerd zonder dat jij iets doet. Ze leveren je niets op, maar trekken je meestal ook niet omlaag. Afwijzen voegt dan weinig toe en kan wel schade doen.</p>

        <h2 id="wanneer">Wanneer je hem wel en niet nodig hebt</h2>
        <p>Google is er zelf duidelijk over. In de meeste gevallen bepaalt Google zonder hulp welke links te vertrouwen zijn. Je gebruikt de tool alleen als twee dingen tegelijk waar zijn: je hebt veel spamlinks of gekochte links, en die hebben geleid tot een handmatige actie van Google, of dat staat op het punt te gebeuren.</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Situatie</th><th>Disavow?</th></tr></thead>
            <tbody>
              <tr><td>Search Console meldt een handmatige actie voor onnatuurlijke links naar je site</td><td><b>Ja</b>, na eerst opruimen</td></tr>
              <tr><td>Jij of een vorig bureau kocht of ruilde op grote schaal links</td><td><b>Waarschijnlijk</b>, na een goede beoordeling</td></tr>
              <tr><td>Je kocht een domein met een verleden en laat het naar je site doorsturen</td><td><b>Kijk eerst</b> wat er naar dat domein linkt</td></tr>
              <tr><td>Je ziet vreemde links van buitenlandse sites die je niet kent</td><td><b>Nee</b>, die worden meestal al genegeerd</td></tr>
              <tr><td>Je posities zakten na een update van Google</td><td><b>Bijna nooit</b>, kijk eerst naar inhoud en techniek</td></tr>
              <tr><td>Een SEO-tool geeft je links een hoge spamscore</td><td><b>Nee</b>, niet op basis van alleen die score</td></tr>
            </tbody>
          </table>
        </div>
        <p>Waarom zo voorzichtig? Wie goede links afwijst, gooit zijn eigen werk weg. Een link van een vakblad of andere relevante websites is precies wat je posities draagt. Wijs je die per ongeluk af, dan zak je. Zo zet je jezelf maanden terug, op advies van een tool.</p>

        <Tussenactie />
        <h2 id="handmatige-actie">Handmatige actie of niet? Zo zie je het</h2>
        <p>Een handmatige actie is een straf die een medewerker van Google met de hand oplegt. Dat gebeurt als een reviewer vaststelt dat je site het spambeleid schendt. Je site staat dan deels of helemaal niet meer in Google.</p>
        <p>Je ziet het in Search Console, in het rapport Handmatige acties. Staat daar een groen vinkje, dan is er geen actie. Staat er "Onnatuurlijke links naar je site", dan heeft Google een patroon van kunstmatige links naar je site gevonden. Pas dan is de disavow tool echt aan de orde.</p>
        <p>Zie je daar niets, maar daalde je verkeer wel? Dan is het bijna altijd iets anders. Een update die naar inhoud kijkt, een technische fout, een concurrent die beter werk levert. Lees in dat geval eerst <a href="/kennisbank/hoe-voorkom-je-een-daling-in-websiteverkeer/">hoe je een daling in websiteverkeer aanpakt</a>.</p>

        <h2 id="stappenplan">Zo maak je een disavow-bestand</h2>
        <div class="stap-kop"><Tekening naam="vergrootglas" maat={48} /><h3>1. Verzamel je inkomende links</h3></div>
        <p>Open in Search Console het rapport Links en kies Exporteren. Google noemt twee manieren: per site via "Sites met de meeste links naar jouw sites", of op datum via "Externe links exporteren" en dan "Nieuwste links". Download ze allebei. Het rapport is een steekproef en de tabellen stoppen bij 1.000 rijen. Een tool zoals SE Ranking, <a href="/kennisbank/wat-is/ahrefs/">Ahrefs</a> of <a href="/kennisbank/wat-is/semrush/">Semrush</a> vindt vaak nog meer. Zet alles in één lijst, per domein.</p>

        <div class="stap-kop"><Tekening naam="scan" maat={48} vertraging={150} /><h3>2. Beoordeel elk domein</h3></div>
        <p>Is het een echte site met echte bezoekers? Past het onderwerp een beetje bij jou? Staat de link in een tekst die ergens over gaat? Drie keer nee is een slechte link. Open verdachte sites voorzichtig, sommige bevatten malware. Vaak zie je met een zoekopdracht als <code>site:domeinnaam.nl</code> al genoeg.</p>
        <p>Is de lijst lang? Begin dan, zoals Google aanraadt, bij de sites met de meeste links naar jou en bij links uit de laatste maanden. Daar zit meestal het probleem.</p>

        <div class="stap-kop"><Tekening naam="mail" maat={48} vertraging={300} /><h3>3. Probeer de links eerst weg te laten halen</h3></div>
        <p>Google vraagt je om eerst zelf de links te laten verwijderen. Mail de eigenaar van de site. Vraag of hij de link weghaalt of er een label als <code>rel="nofollow"</code> aan geeft. Houd bij wie je wanneer mailde. Wie dat aantoonbaar probeert, staat sterker als hij Google later vraagt om een handmatige actie op te heffen. Lukt het niet, dan gaat de link op je lijst.</p>

        <div class="stap-kop"><Tekening naam="pen" maat={48} vertraging={450} /><h3>4. Maak het tekstbestand</h3></div>
        <p>Gebruik Kladblok op Windows, of TextEdit op een Mac met de instelling platte tekst. Geen Word. De regels van Google:</p>
        <ul>
          <li>één URL of één domein per regel;</li>
          <li>een heel domein afwijzen doe je met <code>domain:</code> ervoor, in het Engels, dus niet <code>domein:</code>;</li>
          <li>regels die beginnen met <code>#</code> zijn opmerkingen en worden genegeerd;</li>
          <li>een map zoals <code>voorbeeld.nl/blog/</code> kun je niet afwijzen, alleen losse pagina's of een heel domein;</li>
          <li>een URL is maximaal 2.048 tekens lang;</li>
          <li>het bestand eindigt op .txt, in UTF-8 of 7-bits ASCII, met maximaal 100.000 regels en 2 MB.</li>
        </ul>
        <pre class="code"><code># Spamlinks, eigenaar reageert niet op mail (maart)
domain:linkfarm-voorbeeld.xyz
domain:spamblog-voorbeeld.top
http://forum-voorbeeld.biz/onderwerp?p=12</code></pre>
        <p class="klein muted">Verzonnen voorbeeld. Wijs bij twijfel liever het hele domein af dan losse pagina's. Een naam als disavow.txt mag, maar zet er liever de datum in, zodat je later weet welke versie de laatste is.</p>

        <div class="stap-kop"><Tekening naam="raket" maat={48} vertraging={600} /><h3>5. Uploaden in Search Console</h3></div>
        <p>Open de pagina van de disavow tool en kies je property. Let op: de tool werkt niet met een domeinproperty, alleen met een property op basis van een URL-voorvoegsel. Heb je zowel http als <a href="/kennisbank/wat-is/https/">https</a>, dan upload je per property een lijst. Een lijst voor voorbeeld.nl geldt volgens Google ook voor m.voorbeeld.nl. Bevat je bestand fouten, dan zie je dat direct en blijft de oude lijst staan.</p>
        <p>Belangrijk: een nieuwe upload vervangt de oude lijst helemaal. Begin dus altijd met je vorige bestand en zet de nieuwe regels eronder. Anders tellen eerder afgewezen links ineens weer mee.</p>
        <p>Spijt? Met de knop Afwijzingen annuleren haal je de hele lijst voor die property weg. Ook dat duurt weer een paar weken.</p>

        <h2 id="heroverweging">Een verzoek tot heroverweging schrijven</h2>
        <p>Had je een handmatige actie? Dan is afwijzen niet genoeg. Je vraagt Google daarna om opnieuw naar je site te kijken. Dat doe je in het rapport Handmatige acties, met de knop Beoordeling aanvragen.</p>
        <p>Volgens Google heeft een goed verzoek drie kenmerken. Het beschrijft precies wat er mis was. Het vertelt welke stappen je hebt gezet. En het laat zien wat dat heeft opgeleverd. Een opzet die werkt:</p>
        <ol>
          <li><b>Wat er gebeurde.</b> "Tussen 2021 en 2023 kocht een vorig bureau links op blognetwerken."</li>
          <li><b>Wat je opruimde.</b> "We hebben 140 sites gemaild. Op 52 sites is de link weg. De lijst zit in de bijlage."</li>
          <li><b>Wat je afwees.</b> "De overige 88 domeinen staan in ons disavow-bestand van 18 oktober."</li>
          <li><b>Hoe je het voorkomt.</b> "We kopen geen links meer en controleren ons linkprofiel elk kwartaal."</li>
        </ol>
        <p class="klein muted">Verzonnen voorbeeld. Gebruik je eigen aantallen en wees eerlijk.</p>
        <p>Google mailt je zodra de beoordeling start en als hij klaar is. Volgens Google duurt dat meestal dagen tot weken, en bij verzoeken over links soms langer. Stuur in de tussentijd geen nieuw verzoek.</p>

        <h2 id="negatieve-seo">Kan een concurrent je schaden met slechte links?</h2>
        <p>Die angst horen we vaak. Iemand die honderden spamlinks naar je site laat wijzen, om je te laten zakken. Het heet negatieve SEO. Google schrijft dat het er alles aan doet om te zorgen dat wat anderen doen, geen negatieve invloed heeft op jouw site. En de meeste spamlinks worden al genegeerd.</p>
        <p>Zie je ineens een golf vreemde links, raak dan niet in paniek. Houd je posities en het rapport Handmatige acties in de gaten. Gebeurt er niets, dan hoef je ook niets te doen. Komt er toch een handmatige actie, dan is afwijzen de juiste stap.</p>

        <h2 id="fouten">Veelgemaakte fouten</h2>
        <ul>
          <li><b>Alles afwijzen wat een tool rood kleurt.</b> Daar zitten vaak gewone, goede links tussen.</li>
          <li><b>Je hele linklijst uploaden.</b> Google noemt dat letterlijk geen inspanning te goeder trouw. Een verzoek tot heroverweging wordt dan vaak afgewezen.</li>
          <li><b>De oude lijst overschrijven.</b> Zie hierboven: elke upload vervangt de vorige.</li>
          <li><b>Een oud domein laten doorsturen.</b> Wie een gekocht domein laat doorsturen naar zijn eigen site, neemt ook de slechte links van dat domein mee.</li>
          <li><b>Disavow als oplossing voor elke daling.</b> Een zakkende site heeft meestal een ander probleem dan links.</li>
          <li><b>Niets bijhouden.</b> Zonder lijstje met wie je mailde en wanneer, kun je Google niet laten zien wat je probeerde.</li>
        </ul>

        <h2 id="hulp">Wat wij voor je doen</h2>
        <p>We weten hoe een straf van Google voelt: een van de meer dan 100 eigen sites in ons <a href="/proeflab/">proeflab</a> kreeg ooit een penalty. Juist daarom testen we eerst op eigen sites en blijven we bij klanten ruim binnen de regels.</p>
        <p>In een <a href="/consult/">consult</a> van € 85 per uur kijken we met je mee. We beoordelen je inkomende links, vertellen of afwijzen nodig is en zo ja, welke links. Vaak is ons advies: niet doen. Dat scheelt je werk en risico. Is het wel nodig, dan maken we het bestand, uploaden het en schrijven het verzoek tot heroverweging. Vooraf hoor je hoeveel uur we verwachten.</p>
        <p>Daarna wil je natuurlijk weer goede links. Dat is <a href="/linkbuilding/">linkbuilding</a>, getest in ons proeflab en met stijggarantie. Wil je het helemaal uit handen geven, kijk dan bij <a href="/linkbuilding/linkbuilding-uitbesteden/">linkbuilding uitbesteden</a>.</p>
      </article>
      <aside class="zijkolom">
        <Inhoud items={hoofdstukken} leestijd={11} />
        <Prijskaart naam="Consult linkprofiel" prijs="€ 85" eenheid="per uur" eenmalig punten={['Beoordeling van je inkomende links', 'Advies: wel of niet afwijzen', 'Disavow-bestand gemaakt en geüpload', 'Hulp bij een verzoek tot heroverweging']} />
      </aside>
    </div>
  </section>

  <Bewijs case="conflictbemiddeling" />

  <Faq
    vragen={[
      { v: 'Verwijdert de disavow tool links?', a: 'Nee. De links blijven op internet staan en je ziet ze ook nog in Search Console. Google telt de afgewezen links alleen niet meer mee bij je posities.' },
      { v: 'Hoe lang duurt het voordat Google afgewezen links negeert?', a: 'Volgens Google kan het een paar weken duren. Google verwerkt je lijst pas als het de betreffende pagina\'s opnieuw bezoekt.' },
      { v: 'Waar vind ik de disavow tool?', a: 'De tool heeft een eigen pagina. Je opent hem via de helppagina van Google over links afwijzen. Je hebt een property op basis van een URL-voorvoegsel nodig, want domeinproperty\'s worden niet ondersteund.' },
      { v: 'Kan een concurrent mij schaden met slechte links?', a: 'Dat wordt vaak gevreesd, maar het komt weinig voor. Google negeert de meeste spamlinks al uit zichzelf, zodat ze geen negatieve invloed hebben. Krijg je toch een handmatige actie, dan is afwijzen de juiste stap.' },
      { v: 'Kan ik een disavow ongedaan maken?', a: 'Ja. Upload een nieuwe lijst zonder die links, of trek met Afwijzingen annuleren alle afwijzingen voor de property in. Ook dat duurt weer een paar weken voordat Google het verwerkt.' },
      { v: 'Ga ik stijgen na het afwijzen?', a: 'Niet vanzelf. Afwijzen haalt een rem weg als er een handmatige actie was. Zonder actie verandert er meestal weinig, want Google negeerde die links al. Stijgen doe je met goede inhoud en goede links.' },
    ]}
  />

  <Verder
    titel="Meer over links"
    links={[
      { label: 'Pillar', titel: 'Linkbuilding', href: '/linkbuilding/', tekst: 'Goede links bouwen, met stijggarantie.' },
      { label: 'Gids', titel: 'Wat zijn backlinks?', href: '/kennisbank/gidsen/backlinks/', tekst: 'En hoe kom je eraan als lokaal bedrijf.' },
      { label: 'Gids', titel: 'Google Search Console', href: '/kennisbank/gidsen/google-search-console/', tekst: 'Je site aanmelden en de rapporten lezen.' },
      { label: 'Dienst', titel: 'Consult', href: '/consult/', tekst: 'Een uur sparren, voor € 85.' },
    ]}
  />

  <Actie titel="Twijfel je of je links moet afwijzen?" tekst={`${site.contactpersoon} belt je op werkdagen binnen 15 minuten terug. Vertel wat je ziet in Search Console, dan hoor je of een consult zin heeft.`} knop={{ tekst: 'Neem contact op', href: '/contact/' }} />
</Base>
