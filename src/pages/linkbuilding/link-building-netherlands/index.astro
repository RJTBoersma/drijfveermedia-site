---
// Engelstalige pagina voor buitenlandse bedrijven die in Nederland willen scoren.
// Bewijs, Actie, Prijskaart en Verder hebben vaste Nederlandse tekst; daarom staan hier eigen Engelse blokken.
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/pagina/Hero.astro';
import Faq from '../../../components/pagina/Faq.astro';
import Tekening from '../../../components/teken/Tekening.astro';
import Veer from '../../../components/teken/Veer.astro';
import Plaatje from '../../../components/teken/Plaatje.astro';
import Scene from '../../../components/scenes/linkbuilding--link-building-netherlands.astro';
import { site } from '../../../data/site';
import Tussenactie from '../../../components/pagina/Tussenactie.astro';

const url = '/linkbuilding/link-building-netherlands/';
const telefoonInt = '+31 88 11 55 666';
const schema = [{
  '@type': 'Service',
  name: 'Link building Netherlands',
  serviceType: 'Link building for the Dutch market',
  description: 'Dutch backlinks from relevant Dutch websites for foreign companies that want to rank on google.nl.',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  availableLanguage: ['en', 'nl'],
  url: `${site.url}${url}`,
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 75, priceSpecification: { '@type': 'UnitPriceSpecification', price: 75, priceCurrency: 'EUR', unitCode: 'HUR', unitText: 'per hour', valueAddedTaxIncluded: false } },
}];
const verder = [
  { label: 'In English', titel: 'Working with Drijfveer Media', href: '/en/', tekst: 'Who we are and how we work with clients abroad.', teken: 'team' },
  { label: 'Auf Deutsch', titel: 'Linkbuilding Niederlande', href: '/linkbuilding/linkbuilding-niederlande/', tekst: 'This page in German.', teken: 'ketting' },
  { label: 'In Dutch', titel: 'Linkbuilding', href: '/linkbuilding/', tekst: 'Our full link building page, in Dutch.', teken: 'ketting' },
];
---
<Base
  lang="en"
  alternatief={[{ lang: 'de', url: '/linkbuilding/linkbuilding-niederlande/' }, { lang: 'x-default', url: '/linkbuilding/link-building-netherlands/' }]}
  title="Link building Netherlands: Dutch backlinks | Drijfveer Media"
  description="Link building Netherlands for foreign companies: Dutch backlinks from real Dutch sites in your niche. €75 an hour, cancel monthly, with a rise guarantee."
  kruimels={[{ naam: 'Linkbuilding', url: '/linkbuilding/' }, { naam: 'Link building Netherlands', url }]}
  schema={schema}
>
  <div lang="en">
    <Hero kicker="Found · Link building" titel="Link building Netherlands: Dutch backlinks for foreign companies" knop={{ tekst: 'Email us', href: `mailto:${site.email}` }} bel={false}>
      <p>You sell in the Netherlands, but Dutch customers don't find you in Google. We build links from Dutch sites in your niche, so your Dutch pages climb on google.nl.</p>
      <p class="taal klein">Deutsch? <a href="/linkbuilding/linkbuilding-niederlande/">Linkbuilding Niederlande</a></p>
      <Scene slot="beeld" />
    </Hero>

    <section class="wrap sectie" data-aida="interest">
      <div class="met-zijkolom">
        <article class="tekst">
          <div class="kader kader-oranje in-het-kort">
            <p class="kader-titel">In short</p>
            <p>Link building Netherlands means getting links from Dutch websites to your Dutch pages, so you rank on google.nl. Drijfveer Media is a Dutch agency based in Assen. Our linkbuilder Johan Zwartenberg picks every site by hand and does the outreach in Dutch. It costs €75 an hour, excluding VAT, and an hour usually brings three to five links. You can cancel any month, with one month's notice, and every link is in your monthly report.</p>
          </div>

          <h2>Why Dutch backlinks beat links from abroad</h2>
          <p>Dutch customers search in Dutch, on google.nl. The sites that rank there almost always have links from other Dutch sites. Trade media, regional news sites, associations, blogs that people in the Netherlands actually read.</p>
          <p>A link from a Dutch site about your topic tells Google two things. This company matters. And it matters here. Links from your home market still count for your overall authority, but they rarely lift you past a Dutch competitor with a solid Dutch link profile.</p>
          <p>There is a second reason. A link on a Dutch site with real readers brings traffic of its own. Those visitors are Dutch, they read about your topic and they are already interested. That is worth something even if Google changed its mind tomorrow.</p>
          <p>One thing before we start. Links point to a page. If your Dutch page is a quick machine translation, no link will save it. We check that first. If needed, our copywriters rewrite it in natural Dutch.</p>

          <h2>What Google says about local signals</h2>
          <p>You don't have to take our word for it. In its documentation on multi-regional sites, Google lists the signals it uses to work out which country a page is meant for. Among them: a country domain such as .nl, hreflang tags, and "links from other local sites". Local addresses, phone numbers, language and currency count too.</p>
          <p>Three more points from the same guidance are worth knowing:</p>
          <ul>
            <li><b>Google reads the visible text to decide the language.</b> Not the lang attribute in your code, and not the URL. A Dutch page needs Dutch content, including the navigation.</li>
            <li><b>Avoid automatic redirects based on IP address.</b> Google mostly crawls from the US and may never see your Dutch version. Offer a language switch instead.</li>
            <li><b>Half-translated pages confuse.</b> Translating only the menu and footer while the main text stays English does not make a Dutch page.</li>
          </ul>

          <h2>Your Dutch setup: domain, folder or subdomain</h2>
          <p>Before we build links, your Dutch pages need a clear home. Google describes the options like this:</p>
          <div class="tabel-scroll">
            <table>
              <thead><tr><th>Setup</th><th>Example</th><th>Plus</th><th>Minus</th></tr></thead>
              <tbody>
                <tr><td><b>Dutch domain</b></td><td>yourbrand.nl</td><td>Clear country signal for users and Google</td><td>A separate site to run, links start from zero</td></tr>
                <tr><td><b>Subfolder</b></td><td>yourbrand.com/nl/</td><td>Easy to set up, shares the strength of your main domain</td><td>The URL alone does not show the country</td></tr>
                <tr><td><b>Subdomain</b></td><td>nl.yourbrand.com</td><td>Easy to set up, can run on another server</td><td>Users may not know if "nl" means language or country</td></tr>
                <tr><td><b>URL parameter</b></td><td>yourbrand.com?loc=nl</td><td>None worth mentioning</td><td>Google advises against it</td></tr>
              </tbody>
            </table>
          </div>
          <p>For most foreign companies a subfolder is the easiest start. Whatever you choose, connect the language versions with hreflang. We tell you honestly if your setup needs work first. That is often a small job, but it decides how much every link is worth.</p>

          <h2>How we build links in the Netherlands</h2>
          <div class="stap-kop"><Tekening naam="vergrootglas" maat={48} /><h3>1. We check the Dutch market</h3></div>
          <p>Who ranks on google.nl for the terms you want? Which links got them there? That tells us what you need to compete, and where the quickest gains are.</p>
          <div class="stap-kop"><Tekening naam="pen" maat={48} vertraging={150} /><h3>2. We start from Dutch keywords</h3></div>
          <p>Dutch people searching for solar panels type "zonnepanelen", not "solar panels". A software buyer may search in English, a plumber's customer rarely does. We map the words your Dutch customers really use, and link to the pages that answer them.</p>
          <div class="stap-kop"><Tekening naam="ketting" maat={48} vertraging={300} /><h3>3. We pick every site by hand</h3></div>
          <p>Real Dutch sites with real readers in your niche. We look at the topic, the traffic and how a site links out. A high Domain Rating alone means little if the site exists only to sell links.</p>
          <div class="stap-kop"><Tekening naam="mail" maat={48} vertraging={450} /><h3>4. We do the outreach in Dutch</h3></div>
          <p>Our linkbuilder Johan Zwartenberg contacts editors and site owners the way a Dutch company would. The articles are written by Dutch writers, for Dutch readers. Your link sits in a text that is worth reading.</p>
          <div class="stap-kop"><Tekening naam="grafiek" maat={48} vertraging={600} /><h3>5. You get a report you understand</h3></div>
          <p>Every month you see each link, the page it is on, the anchor text and how your positions moved. No dashboard full of jargon. If something does not work, we tell you.</p>

          <h2>What your monthly report looks like</h2>
          <p>A report you need help to read misses the point. Ours is short. Every link, where it is and where it points. Below is an example for a made-up German maker of heat pumps.</p>
          <div class="tabel-scroll">
            <table>
              <thead><tr><th>Dutch site</th><th>Page</th><th>Anchor text</th><th>Links to</th><th>Paid?</th></tr></thead>
              <tbody>
                <tr><td>Dutch trade magazine for installers</td><td>Article on heat pumps in older homes</td><td>warmtepomp voor een jaren 30-woning</td><td>/nl/warmtepomp/</td><td>No</td></tr>
                <tr><td>Dutch dealer of your products</td><td>Brand overview</td><td>your brand name</td><td>/nl/</td><td>No</td></tr>
                <tr><td>Dutch sustainability blog</td><td>Buyer's guide</td><td>stille warmtepomp</td><td>/nl/stille-warmtepomp/</td><td>Yes, marked sponsored</td></tr>
              </tbody>
            </table>
          </div>
          <p>Below the table you see your positions, for example "warmtepomp kopen: from 23 to 12", and what we plan for next month. You also see what did not work, such as an editor who said no. <span class="muted">(Made-up example.)</span></p>

          <Tussenactie />
          <h2>Where good Dutch links come from</h2>
          <p>Not every Dutch site is worth a link. These are the sources we look at first, and what to expect from them.</p>
          <div class="tabel-scroll">
            <table>
              <thead><tr><th>Source</th><th>Why it helps</th><th>Watch out for</th></tr></thead>
              <tbody>
                <tr><td><b>Dutch trade media</b></td><td>Readers in your industry, a strong topical match</td><td>Editors want real news or expertise, not a sales pitch</td></tr>
                <tr><td><b>Industry associations</b></td><td>Member lists and partner pages carry trust</td><td>Often only open to members or partners</td></tr>
                <tr><td><b>Dutch dealers and suppliers</b></td><td>A natural link for anyone selling through partners</td><td>Ask your Dutch partners first, it costs little</td></tr>
                <tr><td><b>Regional news sites</b></td><td>Local relevance, real visitors</td><td>Only works with a local angle, such as a branch or event</td></tr>
                <tr><td><b>Dutch blogs in your niche</b></td><td>Engaged readers who click through</td><td>Many blogs sell posts to anyone. We check who else they link to</td></tr>
                <tr><td><b>Dutch business directories</b></td><td>Basic local presence</td><td>Weak links. Google names low quality directories as link spam</td></tr>
              </tbody>
            </table>
          </div>

          <h2>Common mistakes foreign companies make</h2>
          <ul>
            <li><b>Building links to an English page.</b> Dutch customers land on text they did not search for, and Google sees a mismatch.</li>
            <li><b>Buying Dutch articles on non-Dutch sites.</b> A Dutch text on a site that is otherwise English or German is a typical sign of a link network.</li>
            <li><b>English anchor texts on Dutch sites.</b> A Dutch editor would never write them. Neither should you.</li>
            <li><b>Packages of fifty links in one week.</b> Google's spam policies name automated and paid link schemes. Since 2022 its SpamBrain system strips the value from such links.</li>
            <li><b>Forgetting the page itself.</b> The best link cannot lift a thin page with three lines of translated copy.</li>
          </ul>

          <h2>When it is too early for links</h2>
          <p>We would rather say this before you pay than after three months. Wait with link building if one of these is true:</p>
          <ul>
            <li>You have no Dutch pages yet, or only machine translations.</li>
            <li>You cannot deliver or offer service in the Netherlands yet.</li>
            <li>You want to test the Dutch market within a few weeks. Ads give you that answer faster.</li>
          </ul>
          <p>In each case we tell you what to fix first. Often that is a few good Dutch pages, which our copywriters can write.</p>

          <h2>What we will not do</h2>
          <p>No link farms, no private blog networks, no comment spam, no hundreds of thin guest posts. Since 2011 we have built a test lab of more than 100 lead generation sites of our own. Years ago we took too many risks there, and one of our own sites was penalised by Google. Since then we test new techniques on our own sites first, and with clients we stay well within Google's rules.</p>

          <div class="kader">
            <p class="kader-titel">Reading Dutch link offers: a short glossary</p>
            <p>Comparing agencies? Most Dutch bureaus, as agencies are called here, write their offers in Dutch only. These are the words you will see most.</p>
            <dl class="woorden">
              <dt>linkbuilding uitbesteden</dt><dd>Outsourcing link building. The phrase on almost every Dutch agency site.</dd>
              <dt>linkbuildingstrategie</dt><dd>Link building strategy. Ask what is in it: target pages, anchor texts, timing.</dd>
              <dt>relevante backlinks</dt><dd>Backlinks from sites about your topic. The only kind worth paying for.</dd>
              <dt>redactionele plaatsingen</dt><dd>Editorial placements: an article on a Dutch site with your link in the text.</dd>
              <dt>transparante werkwijze</dt><dd>A transparent way of working. Ask if you will see every URL.</dd>
              <dt>volledige uitvoering</dt><dd>Full execution, from strategy to published link.</dd>
              <dt>aantoonbare resultaten</dt><dd>Demonstrable results. Ask how they are measured.</dd>
              <dt>sterke SEO-basis</dt><dd>A strong SEO foundation. Links work best on a site that is technically sound.</dd>
              <dt>gesponsord</dt><dd>Sponsored. A paid placement that should carry a rel="sponsored" tag, according to Google.</dd>
            </dl>
          </div>

          <h2>What it costs</h2>
          <p>Link building for the Dutch market costs €75 an hour, excluding VAT. An hour usually brings three to five links. The hours cover the market check, the Dutch keyword map, hand-picked placements, outreach and the monthly report. You agree on a number of hours per month up front. How many you need depends on your niche and how competitive it is. Before we start, you get a proposal with the hours we suggest and why.</p>
          <p>Why by the hour and not by the link? Whoever is paid per link wants to deliver as many links as possible. Getting lots of links is not hard. Getting good ones is, and quantity nearly always costs quality. One good link is worth more than a hundred bad ones, and bad links can harm your site.</p>
          <p>You cancel per month, with one month's notice, by email. Only a different agreement made in writing overrides that. We also give a rise guarantee. At the start we set a measurable goal together, with a date, such as a top 10 position for your five most important Dutch keywords. If we miss it and it is down to us, we work a month for free. The condition: you do what is needed on your side, such as giving us a Dutch page worth linking to.</p>
          <p>Need Dutch pages first? Our copywriters write them from €75 per page. We tell you before we start which pages need it, so there are no surprises later.</p>

          <Tussenactie />
          <h2>Working with a Dutch agency from abroad</h2>
          <p>Our clients come from all over the Netherlands, and we have also worked for companies abroad. In practice the distance changes little. We work by email and phone, in English. Our office hours are 8:00 to 17:00 Dutch time, on working days. You get one contact person, {site.contactpersoon}, and one linkbuilder who knows your account. Reports and proposals come in plain English, the links and articles in Dutch.</p>
        </article>
        <aside class="zijkolom">
          <div class="card prijs-en">
            <p class="kicker">Link building Netherlands</p>
            <p class="bedrag">€75<small> per hour</small></p>
            <p class="muted klein">Excluding VAT. Hours per month, cancel monthly.</p>
            <ul class="vink">
              <li>Dutch market and competitor check</li>
              <li>Hand-picked Dutch sites in your niche</li>
              <li>Outreach and articles in Dutch</li>
              <li>Monthly report in plain English</li>
            </ul>
            <a class="btn" href={`mailto:${site.email}`}>Ask for a proposal</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="wrap sectie" data-aida="desire">
      <Veer />
      <h2>How do you know we deliver what we promise?</h2>
      <div class="raster">
        <div class="card"><Tekening naam="schild" /><h3>Rise guarantee</h3><p>At the start we agree on a goal and a date. If we miss it and it is down to us, we work a month for free.</p></div>
        <div class="card"><Tekening naam="kalender" vertraging={150} /><h3>Cancel monthly</h3><p>One month's notice, by email. You stay only as long as it pays off.</p></div>
        <div class="card"><Tekening naam="kolf" vertraging={300} /><h3>Tested in our own lab</h3><p>Since 2011 we have built more than 100 sites of our own. Every technique is tested there before it touches your site.</p></div>
        <div class="card"><Tekening naam="telefoon" vertraging={450} /><h3>An answer within 15 minutes</h3><p>On Dutch working days between 8:00 and 17:00 CET, we get back to you within a quarter of an hour.</p></div>
      </div>
      <a class="card case-en" href="/cases/#dakraamconcurrent">
        <span class="getal">+32%</span>
        <span class="wat"><b>Dakraam Concurrent</b>, an official VELUX installation partner, got a new website, then link building, then SEO. Result: 32% more organic traffic and number one in Google for "dakraam plaatsen".</span>
        <span class="meer">Read the case (in Dutch)</span>
      </a>
      <p class="muted klein namen">Brands we have worked for include Kärcher, bol.com and Nyenrode.</p>
    </section>

    <Faq
      titel="Frequently asked questions"
      vragen={[
        { v: 'Do I need a Dutch website to rank in the Netherlands?', a: 'You need Dutch pages, not a separate company. A Dutch section on your current domain works fine, for example yoursite.com/nl/, as long as the pages are written for Dutch readers and marked with hreflang.' },
        { v: 'How long before I see results?', a: 'A new link usually counts after a few weeks. Clear rises often show after three to six months. Highly competitive markets take longer. You see the progress in every monthly report.' },
        { v: 'Can you also write the Dutch content?', a: 'Yes. Our copywriters write Dutch web pages from €75 per page. A good Dutch page makes every link you build more effective.' },
        { v: 'Why not buy links on a marketplace myself?', a: 'You can. But you will need to judge Dutch sites and write Dutch articles, and many sites on marketplaces exist mainly to sell links. We pick sites the way a Dutch reader would.' },
        { v: 'Will I see every link?', a: 'Yes. Every link is in your monthly report, with the site, the page and the anchor text. No secret lists.' },
        { v: 'Do Dutch backlinks also help in Belgium?', a: 'Partly. Flemish customers also speak Dutch, but they search on google.be and sometimes use other words. Tell us if Belgium matters to you, and we will say honestly what we expect.' },
        { v: 'How many Dutch backlinks do I get per month?', a: 'That depends on the hours you agree on. One hour of Johan\'s time usually brings three to five links. We charge by the hour, not by the link, on purpose: nobody gains from giving you links you do not need. One good link is worth more than a hundred bad ones.' },
        { v: 'Do the links stay if I cancel?', a: 'The links sit on other people\'s sites, such as Dutch trade media. We do not remove them when you stop. Whether they stay is up to the owner of that site.' },
        { v: 'Is there a minimum contract?', a: 'No. You cancel per month, with one month\'s notice, by email. Only a different agreement made in writing overrides that.' },
      ]}
    />

    <section class="wrap sectie">
      <h2>Related pages</h2>
      <div class="raster">
        {verder.map((l) => (
          <a class="card" href={l.href}>
            <Plaatje href={l.href} onderwerp={l.teken} />
            <span class="kicker">{l.label}</span>
            <h3>{l.titel}</h3>
            <p>{l.tekst}</p>
            <span class="meer">Read more</span>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap sectie" data-aida="action">
      <div class="card actie-en">
        <img class="gezicht" src="/img/team/thorgall-klein.webp" width="88" height="88" alt={`${site.contactpersoon} of Drijfveer Media`} loading="lazy" decoding="async" />
        <div>
          <h2>Want Dutch customers to find you?</h2>
          <p class="muted">Send {site.contactpersoon} your website and the Dutch terms you want to rank for. You will hear from us within 15 minutes on Dutch working days.</p>
        </div>
        <div class="acties">
          <a class="btn" href={`mailto:${site.email}`}>Email {site.email}</a>
          <span class="klein">Or call <a class="tel" href={site.telefoonLink}>{telefoonInt}</a></span>
          <span class="klein"><a href="/contact/">Address and route</a></span>
        </div>
      </div>
    </section>
  </div>
</Base>
<style>
  .taal { margin-top: 10px; color: var(--muted); }
  .woorden { margin: 12px 0 0; display: grid; grid-template-columns: minmax(0, 200px) minmax(0, 1fr); gap: 8px 18px; }
  .woorden dt { font-weight: 800; font-style: italic; }
  .woorden dd { margin: 0; color: var(--muted); }
  @media (max-width: 640px) { .woorden { grid-template-columns: minmax(0, 1fr); gap: 2px; } .woorden dd { margin-bottom: 10px; } }
  .prijs-en { padding: 24px; }
  .prijs-en .bedrag { font-size: var(--step-3); font-weight: 900; letter-spacing: -0.03em; line-height: 1; margin: 8px 0 6px; }
  .prijs-en .bedrag span, .prijs-en .bedrag small { font-size: 1rem; font-weight: 600; letter-spacing: 0; }
  .prijs-en .bedrag span { color: var(--muted); }
  .prijs-en .vink { margin-top: 18px; }
  .prijs-en .btn { width: 100%; }
  .raster .card :global(.tekening) { margin-bottom: 4px; }
  .case-en { margin-top: 16px; padding: 20px 24px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 8px 24px; align-items: center; }
  .case-en .getal { font-size: var(--step-2); font-weight: 900; color: var(--orange-tekst); letter-spacing: -0.03em; }
  .case-en .meer { font-weight: 800; color: var(--navy); }
  .namen { margin-top: 14px; }
  .actie-en { padding: 28px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 20px 32px; align-items: center; }
  .actie-en h2 { font-size: var(--step-2); }
  .actie-en p { margin: 8px 0 0; }
  .gezicht { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }
  .acties { display: grid; gap: 8px; justify-items: start; }
  .tel { font-weight: 800; color: var(--ink); text-decoration: none; white-space: nowrap; }
  @media (max-width: 800px) { .actie-en, .case-en { grid-template-columns: minmax(0, 1fr); } }
</style>
