---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/pagina/Hero.astro';
import Bewijs from '../../../components/pagina/Bewijs.astro';
import Faq from '../../../components/pagina/Faq.astro';
import Actie from '../../../components/pagina/Actie.astro';
import Prijskaart from '../../../components/pagina/Prijskaart.astro';
import Verder from '../../../components/pagina/Verder.astro';
import Inhoud from '../../../components/pagina/Inhoud.astro';
import Auteur from '../../../components/pagina/Auteur.astro';
import Tekening from '../../../components/teken/Tekening.astro';
import Scene from '../../../components/scenes/lokale-seo--reviews.astro';
import ReviewKaart from '../../../components/tool/ReviewKaart.astro';
import WieDoetHet from '../../../components/pagina/WieDoetHet.astro';
import { site } from '../../../data/site';
import Tussenactie from '../../../components/pagina/Tussenactie.astro';

const url = '/lokale-seo/reviews/';
const datum = '2026-10-18';
const hoofdstukken = [
  { id: 'waarom', titel: 'Waarom reviews meer doen dan je denkt' },
  { id: 'wat-wij-doen', titel: 'Wat wij doen, en wat het kost' },
  { id: 'regels', titel: 'Wat wel en niet mag van Google' },
  { id: 'verzamelen', titel: 'Reviews verzamelen in vier stappen' },
  { id: 'routine', titel: 'Een routine per branche' },
  { id: 'reageren', titel: 'Reageren op reviews' },
  { id: 'eigen-site', titel: 'Reviews op je eigen website' },
];
const schema = [{
  '@type': 'Service',
  name: 'Reviews verzamelen en reviewbeheer',
  serviceType: 'Lokale SEO',
  description: 'Reviewlink, QR-code, voorbeeldteksten en reacties op reviews, als onderdeel van lokale SEO.',
  provider: { '@id': `${site.url}/#organisatie` },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  url: `${site.url}${url}`,
  dateModified: '2026-10-19',
  citation: ['https://searchlab.nl/kosten/wat-kost-seo-uitbesteden', 'https://www.kiyoh.com/'],
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: 295, priceSpecification: { '@type': 'UnitPriceSpecification', price: 295, priceCurrency: 'EUR', unitText: 'MONTH', valueAddedTaxIncluded: false } },
}];
---
<Base
  title="Reviews verzamelen uitbesteden: meer Google-reviews"
  description="Reviews verzamelen: wij maken je reviewlink en QR-code, zetten een reviewroutine op en reageren op reviews. Volgens de regels van Google, vanaf € 295 per maand."
  kruimels={[{ naam: 'Lokale SEO', url: '/lokale-seo/' }, { naam: 'Reviews verzamelen', url }]}
  schema={schema}
>
  <Hero kicker="Gevonden · Lokale SEO" titel="Reviews verzamelen met een vaste routine die Google toestaat" prijs="vanaf € 295 per maand">
    <p>Voor bedrijven met tevreden klanten en te weinig reviews. Wij maken je reviewlink en QR-code, schrijven de berichten in jouw toon en reageren op elke review. Als onderdeel van lokale SEO, binnen de regels van Google.</p>
    <Scene slot="beeld" />
  </Hero>

  <section class="wrap sectie" data-aida="interest">
    <div class="met-zijkolom">
      <article class="tekst">
        <Auteur slug="robert" datum={datum} />
        <div class="kader kader-oranje in-het-kort">
          <p class="kader-titel">In het kort</p>
          <ul>
            <li>Reviews verzamelen helpt twee keer: klanten vertrouwen je sneller, en Google telt reviews mee voor je plek op de kaart.</li>
            <li>Het werkt met een vaste routine: iedere klant vragen, op het goede moment, met een link of QR-code.</li>
            <li>Belonen, alleen tevreden klanten vragen of medewerkers een quotum geven mag niet. Google kan je profiel dan beperken.</li>
            <li>Wij regelen het als onderdeel van lokale SEO, vanaf € 295 per maand.</li>
          </ul>
        </div>

        <h2 id="waarom">Waarom reviews meer doen dan je denkt</h2>
        <p>Wie meer Google-reviews heeft, wint op twee manieren. Klanten lezen ze voordat ze bellen. En Google gebruikt ze om te bepalen wie bovenaan de kaart staat. Google schrijft zelf in zijn helpcentrum dat meer reviews en positieve beoordelingen je positie in de lokale resultaten kunnen verbeteren. Reviews tellen dus mee voor je lokale vindbaarheid.</p>
        <p>Een profiel met recente reviews zorgt ook dat mensen eerder doorklikken naar je website of meteen bellen. Een profiel met drie reviews uit 2021 voelt als een zaak waar het licht uit is.</p>
        <p>Je hoeft trouwens niet bang te zijn voor één minder goede beoordeling. Google zegt het zelf: een mix van positieve en negatieve feedback voelt vaak betrouwbaarder. Een rij van alleen maar vijf sterren maakt mensen juist wantrouwig.</p>

        <h2 id="wat-wij-doen">Reviews verzamelen uitbesteden: wat wij doen</h2>
        <p>Reviewbeheer is bij ons onderdeel van <a href="/lokale-seo/">lokale SEO</a>, vanaf € 295 per maand. Je krijgt:</p>
        <ul class="vink">
          <li>je reviewlink en een drukklare QR-code voor balie, factuur of bedankkaartje;</li>
          <li>voorbeeldberichten in jouw toon, voor WhatsApp, mail en sms;</li>
          <li>een vast moment in je werkwijze om iedere klant te vragen;</li>
          <li>een reactie op elke nieuwe review, bij negatieve reviews eerst als concept voor jou;</li>
          <li>een controle van je bedrijfsgegevens in je profiel, zodat een nieuwe klant je ook echt kan bereiken;</li>
          <li>een maandoverzicht: hoeveel nieuwe reviews, je gemiddelde en wat klanten vaak noemen.</li>
        </ul>
        <h3>Zo pakken we het aan</h3>
        <ol class="stappen">
          <li><b>We bellen je op werkdagen binnen 15 minuten terug</b> en vragen hoe je nu met klanten omgaat: waar je ze ziet, hoe je factureert, wie de klus afrondt.</li>
          <li><b>We kiezen het moment en het kanaal</b> dat past in je werkdag, zoals in de tabel verderop.</li>
          <li><b>We maken het materiaal</b>: link, QR-code en berichten die klinken als jij.</li>
          <li><b>We houden het bij</b>: elke maand reacties, het overzicht en bijsturen waar het stokt.</li>
        </ol>
        <p>Wat er niet in zit: we schrijven geen reviews en kopen ze niet, en je hebt geen abonnement op een reviewplatform nodig. Reviewbeheer los afnemen kan niet. Alleen je profiel goed laten inrichten, met een reviewlink en QR-code erbij, kan wel eenmalig, vanaf € 249. Zie <a href="/lokale-seo/google-bedrijfsprofiel/">Google Bedrijfsprofiel laten optimaliseren</a>.</p>
        <h3>Zelf doen, een platform of uitbesteden?</h3>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Keuze</th><th>Kosten</th><th>Waar de reviews komen</th><th>Past bij</th></tr></thead>
            <tbody>
              <tr><td>Zelf doen, met de kaartenmaker verderop</td><td>Gratis, plus je eigen tijd</td><td>Op Google</td><td>Wie een vaste routine kan volhouden</td></tr>
              <tr><td>Een reviewplatform, zoals Kiyoh</td><td>Verschilt per platform</td><td>Op het platform, en als sterren bij advertenties en Google Shopping</td><td>Webwinkels en adverteerders</td></tr>
              <tr><td>Reviewbeheer bij een bureau</td><td>Meestal € 100 tot € 300 per maand</td><td>Op Google</td><td>Wie alleen het reviewdeel wil uitbesteden</td></tr>
              <tr><td>Lokale SEO bij ons</td><td>Vanaf € 295 per maand</td><td>Op Google, Bing en Apple</td><td>Wie reviews, profiel en plek op de kaart in één hand wil</td></tr>
            </tbody>
          </table>
        </div>
        <p class="klein muted">Bureauprijs volgens het prijsoverzicht van Searchlab, platform volgens de site van Kiyoh, bronnen onderaan. Bij ons zit het reviewdeel in lokale SEO, samen met je profielen, je vermeldingen en de maandelijkse meting.</p>
        <h3>Wanneer het geen zin heeft</h3>
        <ul>
          <li><b>Je hebt maar een paar klanten per jaar.</b> Vraag ze dan zelf, persoonlijk. Daar heb je geen routine voor nodig.</li>
          <li><b>Je wilt volgende week vijftig reviews.</b> Dat kan niet binnen de regels van Google, en een plotselinge piek valt op.</li>
          <li><b>Je klanten zoeken niet in de buurt.</b> Dan helpen reviews wel bij vertrouwen, maar weinig bij je plek op de kaart.</li>
        </ul>

        <h2 id="regels">Wat wel en niet mag van Google</h2>
        <p>Voordat je begint met reviews verzamelen: Google is streng. Reviews moeten over een echte ervaring gaan. Dit mag niet, volgens het beleid van Google voor bijdragen aan Maps:</p>
        <ul>
          <li><b>Belonen.</b> Geen korting, geen gratis product, geen kans op een prijs in ruil voor een review. Ook niet om een negatieve review te laten aanpassen.</li>
          <li><b>Alleen de tevreden klanten vragen.</b> Selectief vragen om positieve reviews is verboden, net als negatieve reviews ontmoedigen. Vraag het iedereen.</li>
          <li><b>Druk zetten.</b> Een klant mag niet het gevoel krijgen dat hij ter plekke moet schrijven.</li>
          <li><b>Voorzeggen.</b> Je mag niet vragen om bepaalde woorden of de naam van een medewerker.</li>
          <li><b>Een quotum voor je personeel.</b> Medewerkers een vast aantal reviews per maand laten halen, staat Google niet toe.</li>
          <li><b>Zelf schrijven, laten schrijven of kopen.</b> Ook niet door familie, personeel of bevriende ondernemers.</li>
        </ul>
        <p>Wat gebeurt er als je het toch doet? Google verwijdert de reviews. Daarnaast kan Google beperkingen op je hele profiel zetten. Volgens Google kan je profiel dan een tijd geen nieuwe reviews krijgen, kunnen bestaande reviews tijdelijk verdwijnen en kan er een waarschuwing op je profiel komen dat er nepreviews zijn weggehaald. Die waarschuwing ziet elke klant. Het risico is het nooit waard.</p>
        <p>Wat wel mag: iedere klant vragen om een eerlijke review over zijn eigen ervaring. Moedig klanten gerust aan om te schrijven wat ze ervan vonden. Daar bouw je het hele systeem op.</p>

        <Tussenactie />
        <h2 id="verzamelen">Reviews verzamelen in vier stappen</h2>
        <div class="stap-kop"><Tekening naam="ketting" maat={48} /><h3>1. Maak een reviewlink en een QR-code</h3></div>
        <p>In je Google Bedrijfsprofiel zit een knop om reviews te vragen. Daar haal je een korte link op en een QR-code. Een klant hoeft de code alleen met zijn telefoon te scannen en zit meteen in het venster om een review te schrijven. Geen zoeken naar je bedrijfsnaam, geen uitleg nodig. Het moet zo laagdrempelig mogelijk zijn. Elke extra stap kost je reviews. Waar de knop precies zit, staat in de gids <a href="/kennisbank/gidsen/google-reviews/">Google-reviews</a>.</p>

        <div class="stap-kop"><Tekening naam="kalender" maat={48} vertraging={150} /><h3>2. Vraag het op het juiste moment</h3></div>
        <p>Het beste moment is vlak na de oplevering of de afspraak. De ervaring is dan vers. Twee weken later is de klant het alweer vergeten. Maak er een vaste stap van, net als de factuur.</p>

        <div class="stap-kop"><Tekening naam="mail" maat={48} vertraging={300} /><h3>3. Vraag het persoonlijk</h3></div>
        <p>Een kort persoonlijk bericht werkt beter dan een automatische mail van een systeem. Bijvoorbeeld via WhatsApp of mail:</p>
        <div class="kader">
          <p class="kader-titel">Voorbeeldbericht</p>
          <p>"Hoi Anja, bedankt dat we de kozijnen bij je mochten schilderen. Wil je op Google kort vertellen hoe het ging? Het kost je twee minuten: [jouw reviewlink]. Groet, Peter van Schildersbedrijf De Vries."</p>
          <p class="klein muted">Verzonnen voorbeeld. Pas het aan op hoe jij praat.</p>
        </div>

        <div class="stap-kop"><Tekening naam="scan" maat={48} vertraging={450} /><h3>4. Leg de QR-code waar mensen wachten</h3></div>
        <p>Op de balie, in de wachtkamer, op een bedankkaartje bij de oplevering of onder aan de factuur. Zet de link ook in je mailhandtekening, onder je contactgegevens. Geef mensen de ruimte: het kaartje nodigt uit, de klant beslist zelf.</p>
        <p>Klanten hebben een Google-account nodig om een review te plaatsen. Dat kan ook met een gewoon mailadres, ze hoeven geen Gmail te hebben.</p>

        <ReviewKaart />

        <h2 id="routine">Een reviewroutine die past bij jouw bedrijf</h2>
        <p>Reviews verzamelen lukt niet met één actie per jaar. Het lukt met een vast moment in je werk, dat niemand hoeft te onthouden. Hoe dat eruitziet, verschilt per soort bedrijf:</p>
        <div class="tabel-scroll">
          <table>
            <thead><tr><th>Soort bedrijf</th><th>Beste moment</th><th>Kanaal</th></tr></thead>
            <tbody>
              <tr><td>Installateur, schilder, dakdekker</td><td>De dag na de oplevering</td><td>WhatsApp met de reviewlink</td></tr>
              <tr><td>Kapper, schoonheidssalon, fysiotherapeut</td><td>Bij het afrekenen of de laatste afspraak</td><td>QR-code op de balie, daarna een sms</td></tr>
              <tr><td>Restaurant of lunchroom</td><td>Bij de rekening</td><td>QR-code op het bonnetje of de tafel</td></tr>
              <tr><td>Boekhouder, adviseur, zakelijke dienst</td><td>Na een afgerond project of de jaarafsluiting</td><td>Persoonlijke mail</td></tr>
              <tr><td>Garage of fietsenmaker</td><td>Bij het ophalen</td><td>Kaartje met QR-code bij de sleutels</td></tr>
            </tbody>
          </table>
        </div>
        <p>Vraag het iedereen, ook de klant bij wie het minder liep. Dat is niet alleen een regel van Google. Het levert ook de gemengde reviews op die nieuwe klanten vertrouwen.</p>
        <div class="kader">
          <p class="kader-titel">Rekenvoorbeeld</p>
          <p>Een installateur rondt twintig klussen per maand af. Hij vraagt het iedereen, de dag na de oplevering. Stel dat één op de vier klanten echt een review schrijft. Dan heeft hij er vijf per maand bij, zestig per jaar. Wie het alleen af en toe vraagt, haalt er misschien tien.</p>
          <p class="klein muted">Verzonnen voorbeeld met verzonnen cijfers. Hoeveel klanten schrijven, verschilt per branche en per klant.</p>
        </div>
        <p>Een vaste stroom werkt beter dan twintig reviews in één week. Een plotselinge piek valt op, ook bij Google. Ongebruikelijke aantallen of patronen staan in het beleid van Google als signaal van manipulatie.</p>

        <h2 id="reageren">Reageren op reviews, ook op de vervelende</h2>
        <p>Je reacties zijn openbaar. De volgende klant leest ze net zo goed als de review zelf. Op een positieve review reageer je kort en persoonlijk. Noem iets van de klus, bedank, klaar. Geen reclame, de reviewer is al klant.</p>
        <p>Bij negatieve feedback tel je eerst tot tien. Reageer binnen een paar dagen, rustig en zonder de klant aan te vallen. Erken wat er misging, leg uit wat je eraan doet en nodig de klant uit om te bellen. Deel nooit privégegevens in je reactie. Wie zo reageert, bouwt juist aan zijn reputatie.</p>
        <div class="kader">
          <p class="kader-titel">Voorbeeldreactie op een negatieve review</p>
          <p>"Dag Mark, vervelend dat we later waren dan afgesproken. Dat had niet mogen gebeuren, en we hadden je in elk geval moeten bellen. Ik wil het graag rechtzetten. Bel je me op 0592 000 000? Groet, Peter."</p>
          <p class="klein muted">Verzonnen voorbeeld.</p>
        </div>
        <p>Goed om te weten: de klant krijgt een melding als je reageert, en kan zijn review daarna nog aanpassen. Een goede reactie maakt een boze klant soms milder. Staat er een review die niet over een echte ervaring gaat, of die beledigend is? Dan kun je hem in je profiel melden bij Google. Google beslist of hij weg gaat. Uitgebreide stappen staan in de gids <a href="/kennisbank/gidsen/google-reviews/">Google-reviews: reageren, verwijderen en een reviewlink maken</a>.</p>

        <h2 id="eigen-site">Reviews op je eigen website: let op de regels</h2>
        <p>Laat je reviews ook op je eigen site zien? Dan gelden er sinds 28 mei 2022 extra regels, meldt de Autoriteit Consument & Markt (ACM). Een bedrijf dat reviews van consumenten gebruikt, moet:</p>
        <ul>
          <li>maatregelen nemen zodat de reviews komen van mensen die het product of de dienst echt hebben gebruikt of gekocht;</li>
          <li>vertellen welke maatregelen dat zijn;</li>
          <li>uitleggen hoe het met reviews omgaat: waar ze vandaan komen, hoe positieve en negatieve reviews worden behandeld, hoe de gemiddelde score ontstaat en of er een beloning tegenover stond.</li>
        </ul>
        <p>Nepreviews plaatsen of laten plaatsen is altijd verboden. De ACM kan daarvoor boetes opleggen tot € 900.000 per overtreding. Toon je je Google-reviews op je site, zet er dan een korte zin bij waar ze vandaan komen. Zo houd je je aan de regels, en het kost niets.</p>

      </article>
      <aside class="zijkolom">
        <Inhoud items={hoofdstukken} leestijd={9} />
        <Prijskaart naam="Lokale SEO met reviews" prijs="€ 295" eenheid="per maand" punten={['Reviewlink en QR-code', 'Voorbeeldberichten in jouw toon', 'Reactie op elke review', 'Maandoverzicht van je reviews']} />
      </aside>
    </div>
  </section>

  <Bewijs case="willemfikstt" />

  <WieDoetHet wie={[{ slug: 'thorgall', taak: 'Je eerste aanspreekpunt. Hij belt je terug, kijkt hoe je reviews ervoor staan en zet de routine met je op.' }, { slug: 'robert', taak: 'Doet SEO, content en strategie, sinds hij Drijfveer Media in 2011 oprichtte.' }]} />

  <Faq
    vragen={[
      { v: 'Mag ik klanten een kleine beloning geven voor een review?', a: 'Nee. Google verbiedt elke beloning, ook een kleine korting of een kans op een prijs. Zulke reviews worden verwijderd en je profiel kan worden beperkt.' },
      { v: 'Hoeveel Google-reviews heb ik nodig?', a: 'Daar is geen vast getal voor. Kijk naar de bedrijven die nu in het kaartje staan op jouw belangrijkste zoekwoord. Heb je er duidelijk minder, dan is dat je eerste doel. Daarna telt vooral dat er steeds nieuwe bijkomen.' },
      { v: 'Kan ik een negatieve review laten verwijderen?', a: 'Alleen als de review de regels van Google overtreedt, bijvoorbeeld omdat hij beledigend is of niet over een echte ervaring gaat. Dan meld je hem in je profiel. Een kritische review over een echte ervaring blijft staan. Daar reageer je op.' },
      { v: 'Wat kost reviews verzamelen uitbesteden?', a: 'Bij ons zit het in lokale SEO, vanaf € 295 per maand, samen met je profielen, je vermeldingen en een maandelijkse meting van je plek op de kaart. Los afnemen kan niet. Je zegt per maand op, met één maand opzegtermijn.' },
      { v: 'Schrijven jullie reacties op reviews namens mij?', a: 'Ja. Op positieve reviews reageren we kort en persoonlijk. Bij een negatieve review krijg je eerst een concept, zodat jij beslist wat er komt te staan.' },
      { v: 'Moet een klant een Gmail-adres hebben?', a: 'Nee. Een Google-account is wel nodig, maar dat kan ook met een ander mailadres worden aangemaakt.' },
      { v: 'Mag ik mijn medewerkers laten vragen om reviews?', a: 'Ja, vragen mag. Een quotum mag niet: Google staat niet toe dat je medewerkers een bepaald aantal reviews laat verzamelen, of laat vragen om hun naam te noemen.' },
      { v: 'Hoe snel helpen reviews mijn positie op de kaart?', a: 'Dat gaat geleidelijk. Een vaste stroom van nieuwe reviews werkt beter dan twintig in één week. Hoger komen in je regio kost meestal een paar maanden, samen met de rest van de lokale SEO.' },
      { v: 'Moet ik op elke review reageren?', a: 'Op elke negatieve review wel. Op positieve reviews is een korte reactie netjes, maar het hoeft niet altijd. Liever een paar persoonlijke reacties dan overal hetzelfde standaardzinnetje.' },
    ]}
  />

  <Verder
    titel="Meer over lokaal gevonden worden"
    links={[
      { label: 'Pillar', titel: 'Lokale SEO', href: '/lokale-seo/', tekst: 'Gevonden in je regio, vanaf € 295 per maand.' },
      { label: 'Dienst', titel: 'Google Bedrijfsprofiel, Bing en Apple', href: '/lokale-seo/google-bedrijfsprofiel/', tekst: 'Alle drie de kaarten goed ingericht.' },
      { label: 'Gids', titel: 'Google-reviews', href: '/kennisbank/gidsen/google-reviews/', tekst: 'Reageren, verwijderen en een reviewlink maken.' },
    ]}
  />

  <Actie titel="Hoe staan jouw reviews ervoor?" tekst={`${site.contactpersoon} bekijkt je profiel en je reviews, en belt je op werkdagen binnen 15 minuten terug met wat hij ziet. Gratis, en je zit nergens aan vast.`} />
</Base>
<style>
  .stappen li { margin-bottom: 10px; }
</style>
