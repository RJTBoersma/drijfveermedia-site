      { label: 'Drachten', titel: 'Webdesign in Drachten', href: '/webdesign-drachten/', tekst: 'Een website die laat zien wat je maakt.', teken: 'scherm' },
      { label: 'Kaart', titel: 'Lokale SEO', href: '/lokale-seo/', tekst: 'Bovenaan in het kaartje van Google.', teken: 'pin' },
