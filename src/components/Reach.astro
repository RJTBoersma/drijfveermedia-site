---
import { site } from '../data/site';
const { compact = false } = Astro.props;
---
<span class:list={['reach', { compact }]} data-reach>
  <span class="dot" aria-hidden="true"></span>
  <span class="txt"><span class="lbl" data-reach-label>Bel {site.contactpersoon}</span><span class="sep"> · </span><a href={site.telefoonLink} class="tel">{site.telefoon}</a></span>
</span>
<script>
  import { bereikbaarheid } from '../data/kantoortijd';
  // Werkdagen 8.00 tot 17.00 uur, Nederlandse tijd, dicht op feestdagen.
  function status() {
    const b = bereikbaarheid();
    document.querySelectorAll<HTMLElement>('[data-reach]').forEach((el) => {
      el.classList.toggle('open', b.open);
      const label = el.querySelector('[data-reach-label]');
      if (!label) return;
      const dag = b.wanneer.charAt(0).toUpperCase() + b.wanneer.slice(1);
      label.textContent = b.open ? 'Thorgall is nu bereikbaar' : `${dag} vanaf 8.00 uur bereikbaar`;
    });
  }
  status();
  setInterval(status, 60000);
</script>
<style>
  .reach { display: inline-flex; align-items: center; gap: 9px; font-size: 0.95rem; white-space: nowrap; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #9aa9b8; flex: none; }
  .reach.open .dot { background: var(--ok); box-shadow: 0 0 0 4px rgb(31 138 91 / 0.18); }
  .tel { color: var(--ink); font-weight: 700; text-decoration: none; font-variant-numeric: tabular-nums; }
  .reach.compact .lbl, .reach.compact .sep { display: none; }
</style>
