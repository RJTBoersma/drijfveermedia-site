---
import Logo from './Logo.astro';
import Reach from './Reach.astro';
import { perPijler } from '../data/diensten';
const kolommen = [
  { titel: 'Gevonden', uitleg: 'in Google', items: perPijler('Gevonden').filter((d) => d.pillar || ['Technische SEO en SEO-audit', 'Google Bedrijfsprofiel'].includes(d.naam)) },
  { titel: 'Genoemd', uitleg: 'door AI', items: perPijler('Genoemd') },
  { titel: 'Gekozen', uitleg: 'door klanten', items: perPijler('Gekozen').filter((d) => d.pillar || ['Website met AI laten maken', 'Google Ads'].includes(d.naam)) },
  { titel: 'Advies', uitleg: 'en uitbesteden', items: perPijler('Advies') },
];
const pad = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="hoofdmenu" aria-label="Hoofdmenu">
      <ul>
        <li class="has-mega">
          <details class="mega">
            <summary>Diensten</summary>
            <div class="mega-panel">
              <div class="wrap mega-grid">
                {kolommen.map((k) => (
                  <div>
                    <p class="mega-kop">{k.titel}<span> {k.uitleg}</span></p>
                    <ul>
                      {k.items.map((d) => (
                        <li><a href={d.url}><strong>{d.naam}</strong><span>{d.kort}</span></a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </details>
        </li>
        <li><a href="/prijzen/" aria-current={pad.startsWith('/prijzen') ? 'page' : undefined}>Prijzen</a></li>
        <li><a href="/cases/" aria-current={pad.startsWith('/cases') ? 'page' : undefined}>Cases</a></li>
        <li><a href="/kennisbank/" aria-current={pad.startsWith('/kennisbank') ? 'page' : undefined}>Kennisbank</a></li>
        <li><a href="/over-ons/" aria-current={pad.startsWith('/over-ons') ? 'page' : undefined}>Over ons</a></li>
        <li><a href="/contact/" aria-current={pad.startsWith('/contact') ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>
    <div class="acties">
      <Reach />
      <a class="btn btn-sm" href="/gratis-website-analyse/">Gratis scan</a>
    </div>
    <details class="mobiel">
      <summary aria-label="Menu openen"><span></span><span></span><span></span></summary>
      <div class="mobiel-panel">
        {kolommen.map((k) => (
          <div>
            <p class="mega-kop">{k.titel}<span> {k.uitleg}</span></p>
            <ul>{k.items.map((d) => <li><a href={d.url}>{d.naam}</a></li>)}</ul>
          </div>
        ))}
        <ul class="los">
          <li><a href="/prijzen/">Prijzen</a></li>
          <li><a href="/cases/">Cases</a></li>
          <li><a href="/kennisbank/">Kennisbank</a></li>
          <li><a href="/over-ons/">Over ons</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
        <Reach />
      </div>
    </details>
  </div>
</header>

<script>
  // Megamenu sluiten bij klik buiten het menu of Escape.
  const mega = document.querySelectorAll<HTMLDetailsElement>('details.mega, details.mobiel');
  document.addEventListener('click', (e) => {
    mega.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') mega.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); padding-top: env(safe-area-inset-top, 0px); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .hoofdmenu { margin-left: auto; }
  .hoofdmenu > ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; align-items: center; }
  .hoofdmenu a, .hoofdmenu summary { white-space: nowrap; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1rem; cursor: pointer; }
  .hoofdmenu a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 3px; text-underline-offset: 8px; }
  .hoofdmenu summary { list-style: none; display: inline-flex; align-items: center; gap: 6px; }
  .hoofdmenu summary::-webkit-details-marker { display: none; }
  .hoofdmenu summary::after { content: ''; width: 7px; height: 7px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  .mega-panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--panel); border-bottom: 1px solid var(--line); box-shadow: 0 24px 40px -30px rgb(16 40 63 / 0.4); }
  .mega-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; padding-block: 28px; }
  .mega-kop { font-weight: 900; font-size: 1.2rem; margin: 0 0 10px; }
  .mega-kop span { font-weight: 500; color: var(--muted); font-size: 1rem; }
  .mega-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .mega-grid a { display: grid; gap: 2px; padding: 8px 10px; margin-left: -10px; border-radius: 8px; text-decoration: none; white-space: normal; line-height: 1.35; }
  .mega-grid a:hover { background: var(--chip); }
  .mega-grid a strong { color: var(--ink); font-weight: 700; }
  .mega-grid a span { color: var(--muted); font-size: 0.92rem; font-weight: 400; }
  .acties { display: flex; align-items: center; gap: 16px; }
  .btn-sm { font-size: 1rem; padding: 0.6em 1em; white-space: nowrap; }
  .mobiel { display: none; margin-left: auto; }
  .mobiel summary { list-style: none; width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; cursor: pointer; border-radius: 10px; }
  .mobiel summary::-webkit-details-marker { display: none; }
  .mobiel summary span { display: block; width: 22px; height: 2px; background: var(--ink); }
  .mobiel-panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--panel); border-bottom: 1px solid var(--line); padding: 20px max(16px, env(safe-area-inset-left, 0px)) 24px; display: grid; gap: 18px; max-height: calc(100dvh - 72px); overflow: auto; }
  .mobiel-panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .mobiel-panel a { color: var(--ink); text-decoration: none; font-weight: 600; }
  .los { border-top: 1px solid var(--line); padding-top: 14px !important; }
  @media (max-width: 1280px) { .acties :global(.reach .lbl), .acties :global(.reach .sep) { display: none; } }
  @media (max-width: 1060px) { .acties :global(.reach) { display: none; } }
  @media (max-width: 900px) {
    .hoofdmenu, .acties { display: none; }
    .mobiel { display: block; }
    .woord { font-size: 1.1rem; }
  }
</style>
