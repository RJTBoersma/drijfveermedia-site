---
// Scène voor /kennisbank/wat-is/entiteiten/: "Jouw bedrijf" als knooppunt, verbonden met een plaats, een persoon, een dienst en een website.
// Op de lijnen staat de relatie. In de volledige versie lopen er stipjes naar het midden en verschijnt het label "Herkend".
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const knopen = [
  { x: 90, y: 70, naam: 'Assen', rel: 'zit in' },
  { x: 390, y: 70, naam: 'Eigenaar', rel: 'van' },
  { x: 90, y: 210, naam: 'Tuinontwerp', rel: 'doet' },
  { x: 390, y: 210, naam: 'Website', rel: 'heeft' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: jouw bedrijf als knooppunt in een kennisnetwerk. Lijnen verbinden het met een plaats, een eigenaar, een dienst en een website, en op elke lijn staat de relatie. Daarna krijgt het bedrijf het label herkend.'}>
  <!-- relaties -->
  <path class="l" d={knopen.map((k) => `M240 140L${k.x} ${k.y}`).join('')} />
  {knopen.map((k) => {
    const mx = (240 + k.x) / 2, my = (140 + k.y) / 2;
    return (
      <g>
        <rect x={mx - 22} y={my - 10} width="44" height="20" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
        <text x={mx} y={my + 4} font-size="10" font-weight="700" text-anchor="middle" class="zacht">{k.rel}</text>
      </g>
    );
  })}

  <!-- knopen rondom -->
  {knopen.map((k) => (
    <g>
      <circle cx={k.x} cy={k.y} r="28" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <text x={k.x} y={k.y + 46} font-size="12" font-weight="800" text-anchor="middle">{k.naam}</text>
    </g>
  ))}
  <path class="o" d="M90 84c-5-5-11-11-11-18a11 11 0 0 1 22 0c0 7-6 13-11 18z" />
  <circle cx="90" cy="66" r="4" fill="#fff" />
  <circle class="l" cx="390" cy="62" r="7" />
  <path class="l" d="M377 85c2-8 7-12 13-12s11 4 13 12" />
  <path class="l" d="M90 226v-16M90 214c-9 0-13-7-13-13 7 0 13 4 13 13zM90 210c0-9 5-13 13-13 0 7-4 13-13 13z" />
  <rect class="l" x="376" y="199" width="28" height="19" rx="3" />
  <path class="l" d="M384 224h12M390 218v6" />

  <!-- het bedrijf in het midden -->
  <circle cx="240" cy="140" r="42" fill="#fff" stroke="#074663" stroke-width="3" />
  <text x="240" y="137" font-size="12" font-weight="900" text-anchor="middle">Jouw</text>
  <text x="240" y="152" font-size="12" font-weight="900" text-anchor="middle">bedrijf</text>

  {!mini && (
    <g>
      <circle class="puls" cx="240" cy="140" r="42" fill="none" stroke="#ff6600" stroke-width="2" />
      {knopen.map((k, i) => (
        <circle class="stip" cx={k.x} cy={k.y} r="4" fill="#ff6600" style={`--dx:${240 - k.x}px;--dy:${140 - k.y}px;animation-delay:${0.4 + i * 0.9}s`} />
      ))}
      <g class="herkend">
        <rect x="196" y="194" width="88" height="24" rx="12" fill="#fff" stroke="#1f8a5b" stroke-width="2" />
        <circle cx="210" cy="206" r="7" fill="#1f8a5b" />
        <path d="M206.5 206l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="222" y="210.5" font-size="11" font-weight="800">Herkend</text>
      </g>
    </g>
  )}
</svg>
<style>
  .puls, .herkend { transform-box: fill-box; transform-origin: center; }
  .stip { opacity: 0; }
  :global(.teken-js) .herkend, :global(.teken-js) .puls { opacity: 0; }
  .in-beeld .puls { animation: kennisbank-wat-is-entiteiten-puls 4s ease-out 1s infinite; }
  .in-beeld .stip { animation: kennisbank-wat-is-entiteiten-stip 3.6s ease-in-out infinite; }
  .in-beeld .herkend { animation: kennisbank-wat-is-entiteiten-herkend 0.6s cubic-bezier(.3,1.6,.5,1) 2.2s forwards; }
  @keyframes kennisbank-wat-is-entiteiten-puls { 0% { opacity: .9; transform: scale(1); } 60%, 100% { opacity: 0; transform: scale(1.45); } }
  @keyframes kennisbank-wat-is-entiteiten-stip {
    0% { opacity: 0; transform: none; }
    10% { opacity: 1; }
    55% { opacity: 1; transform: translate(var(--dx), var(--dy)); }
    65%, 100% { opacity: 0; transform: translate(var(--dx), var(--dy)); }
  }
  @keyframes kennisbank-wat-is-entiteiten-herkend { from { opacity: 0; transform: translateY(8px) scale(.9); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .puls, .in-beeld .stip { animation: none; }
    .in-beeld .herkend { animation: none; opacity: 1; transform: none; }
  }
</style>
