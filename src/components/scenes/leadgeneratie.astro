---
// Scène voor /leadgeneratie/: bezoekers komen binnen via zoeken, AI en social, lopen via de website naar het formulier,
// en rechts telt de teller de aanvragen van deze maand, met het afgesproken doel gehaald.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const bronnen = [
  { y: 50, label: 'Zoeken', van: [120, 67], naar: [180, 126] },
  { y: 120, label: 'AI-antwoord', van: [120, 137], naar: [180, 135] },
  { y: 190, label: 'Social', van: [120, 207], naar: [180, 144] },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: bezoekers komen via zoeken, AI-antwoorden en social media op een website met een formulier. Rechts staan twaalf aanvragen deze maand, het doel van tien is gehaald.'}>
  <!-- bronnen -->
  {bronnen.map((b) => (
    <g>
      <rect x="16" y={b.y} width="104" height="34" rx="17" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <text x="68" y={b.y + 21} text-anchor="middle" font-size="11" font-weight="700">{b.label}</text>
      <path d={`M${b.van[0]} ${b.van[1]}L${b.naar[0]} ${b.naar[1]}`} stroke="#d9e1ea" stroke-width="3" stroke-linecap="round" />
    </g>
  ))}
  <!-- website met formulier -->
  <rect x="180" y="58" width="140" height="154" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M180 78h140" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="193" cy="68" r="3" fill="#d9e1ea" /><circle cx="203" cy="68" r="3" fill="#d9e1ea" /><circle cx="213" cy="68" r="3" fill="#d9e1ea" />
  <rect x="194" y="92" width="96" height="10" rx="5" fill="#10283f" />
  <rect class="v" x="194" y="110" width="112" height="6" rx="3" />
  <rect class="v" x="194" y="122" width="84" height="6" rx="3" />
  <rect x="194" y="138" width="112" height="16" rx="5" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="194" y="160" width="112" height="16" rx="5" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect class="o" x="194" y="184" width="70" height="18" rx="6" />
  <rect x="204" y="191" width="50" height="4" rx="2" fill="#fff" />
  <!-- pijl naar de teller -->
  <path class="a" d="M322 135h22" />
  <path class="a" d="M338 129l6 6-6 6" />
  <!-- teller -->
  <rect x="350" y="52" width="114" height="166" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="364" y="77" font-size="12" font-weight="800">Aanvragen</text>
  <text x="364" y="92" font-size="10" class="zacht">deze maand</text>
  <text x="364" y="142" font-size="38" font-weight="900">12</text>
  <rect class="v" x="364" y="158" width="86" height="10" rx="5" />
  <rect x="364" y="158" width="86" height="10" rx="5" fill="#1a7a50" />
  <path d="M435 154v18" stroke="#10283f" stroke-width="2" />
  <text x="364" y="190" font-size="10" class="zacht">doel: 10</text>
  <circle cx="440" cy="196" r="9" fill="#1a7a50" />
  <path d="M436 196l3 3 5-6" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  {!mini && (
    <g>
      {bronnen.map((b, i) => (
        <circle class="stip" cx={b.van[0]} cy={b.van[1]} r="5" fill="#ff6600" style={`--dx:${b.naar[0] - b.van[0]}px;--dy:${b.naar[1] - b.van[1]}px;--i:${i}`} />
      ))}
      <g class="plus">
        <rect x="404" y="104" width="44" height="22" rx="11" fill="#ff6600" />
        <text x="426" y="119" text-anchor="middle" font-size="12" font-weight="900" style="fill:#fff">+1</text>
      </g>
    </g>
  )}
</svg>
<style>
  .stip { opacity: 0; }
  .plus { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .plus { opacity: 0; }
  .in-beeld .stip { animation: leadgeneratie-stip 3s ease-in-out infinite both; animation-delay: calc(0.4s + var(--i) * 1s); }
  .in-beeld .plus { animation: leadgeneratie-plus 6s ease-out 1.8s infinite both; }
  @keyframes leadgeneratie-stip {
    0% { opacity: 0; transform: translate(0, 0); }
    15% { opacity: 1; }
    70% { opacity: 1; transform: translate(var(--dx), var(--dy)); }
    85%, 100% { opacity: 0; transform: translate(var(--dx), var(--dy)); }
  }
  @keyframes leadgeneratie-plus {
    0%, 10% { opacity: 0; transform: translateY(8px) scale(0.6); }
    18% { opacity: 1; transform: scale(1.1); }
    24%, 70% { opacity: 1; transform: none; }
    85%, 100% { opacity: 0; transform: translateY(-6px); }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .stip, .in-beeld .plus { animation: none; } }
</style>
