---
// Scène voor /kennisbank/wat-is/dofollow/: twee websites linken naar jouw site. De bovenste met een gewone link (doorgetrokken lijn),
// de onderste met rel="nofollow" (stippellijn). Rechts jouw site met een meter voor autoriteit.
// Als hij leeft: over de gewone link rolt een bolletje naar jouw site en de meter loopt op; het bolletje op de stippellijn blijft halverwege hangen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const bronnen = [
  { y: 30, code: '<a href="…">', label: 'gewone link' },
  { y: 150, code: 'rel="nofollow"', label: 'met label' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: twee websites linken naar jouw site. De gewone link geeft waarde door en laat de meter voor autoriteit oplopen. De link met rel nofollow is een stippellijn: daar gaat volgens Google meestal geen waarde overheen.'}>
  {bronnen.map((b) => (
    <g>
      <rect x="24" y={b.y} width="160" height="92" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <circle cx="38" cy={b.y + 13} r="3.5" fill="#d9e1ea" /><circle cx="49" cy={b.y + 13} r="3.5" fill="#d9e1ea" />
      <rect x="38" y={b.y + 26} width="96" height="7" rx="3.5" fill="#10283f" opacity="0.75" />
      <rect x="38" y={b.y + 39} width="130" height="5" rx="2.5" fill="#e8eef4" />
      <rect x="36" y={b.y + 52} width="136" height="22" rx="6" fill="#e8eef4" />
      <text x="44" y={b.y + 67} font-size="11" font-weight="700" font-family="monospace">{b.code}</text>
      <text x="38" y={b.y + 86} font-size="9.5" class="zacht">{b.label}</text>
    </g>
  ))}

  <!-- links -->
  <path d="M184 92C232 92 250 118 296 124" fill="none" stroke="#ff6600" stroke-width="3" stroke-linecap="round" />
  <path d="M288 117l9 7-10 5" fill="none" stroke="#ff6600" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M184 212C232 212 250 172 296 160" fill="none" stroke="#9fb3c5" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 8" />
  <circle cx="241" cy="190" r="11" fill="#fff" stroke="#9fb3c5" stroke-width="2" />
  <path d="M236 185l10 10M246 185l-10 10" stroke="#9fb3c5" stroke-width="2" stroke-linecap="round" />

  <!-- jouw site -->
  <rect x="300" y="64" width="156" height="150" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="300" y="64" width="156" height="24" rx="12" fill="#e8eef4" />
  <rect x="300" y="78" width="156" height="10" fill="#e8eef4" />
  <text x="314" y="81" font-size="10.5" font-weight="800">jouwsite.nl</text>
  <rect x="314" y="100" width="90" height="8" rx="4" fill="#10283f" opacity="0.75" />
  <rect x="314" y="114" width="128" height="5" rx="2.5" fill="#e8eef4" />
  <rect x="314" y="125" width="110" height="5" rx="2.5" fill="#e8eef4" />
  <text x="314" y="156" font-size="10" font-weight="800" class="zacht">Autoriteit</text>
  <rect x="314" y="164" width="128" height="12" rx="6" fill="#e8eef4" />
  <rect x="314" y="164" width="52" height="12" rx="6" fill="#074663" />
  <path class="a" d="M318 196h20M348 196h12" />

  {!mini && (
    <g>
      <rect class="df-meter" x="366" y="164" width="40" height="12" rx="6" fill="#ff6600" />
      <circle class="df-bol" cx="0" cy="0" r="7" fill="#ff6600" />
      <circle class="df-bol-nf" cx="0" cy="0" r="6" fill="#9fb3c5" />
      <g class="df-chip"><rect x="384" y="28" width="72" height="24" rx="12" fill="#1f8a5b" /><text x="420" y="44.5" font-size="11" font-weight="800" text-anchor="middle" style="fill:#fff">+ waarde</text></g>
    </g>
  )}
</svg>
<style>
  .df-bol { offset-path: path('M184 92C232 92 250 118 296 124'); offset-rotate: 0deg; }
  .df-bol-nf { offset-path: path('M184 212C232 212 250 172 296 160'); offset-rotate: 0deg; }
  .df-meter { transform-box: fill-box; transform-origin: left center; }
  .df-chip { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .df-bol, :global(.teken-js) .df-bol-nf, :global(.teken-js) .df-chip { opacity: 0; }
  :global(.teken-js) .df-meter { transform: scaleX(0); }
  .in-beeld .df-bol { animation: kennisbank-wat-is-dofollow-bol 5s ease-in-out 0.4s infinite; }
  .in-beeld .df-bol-nf { animation: kennisbank-wat-is-dofollow-nf 5s ease-in-out 0.9s infinite; }
  .in-beeld .df-meter { animation: kennisbank-wat-is-dofollow-meter 5s ease-out 0.4s infinite; }
  .in-beeld .df-chip { animation: kennisbank-wat-is-dofollow-chip 0.5s cubic-bezier(.3,1.6,.5,1) 2.2s forwards; }
  @keyframes kennisbank-wat-is-dofollow-bol { 0% { offset-distance: 0%; opacity: 0; } 8% { opacity: 1; } 40% { offset-distance: 100%; opacity: 1; } 46%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes kennisbank-wat-is-dofollow-nf { 0% { offset-distance: 0%; opacity: 0; } 8% { opacity: 1; } 34% { offset-distance: 46%; opacity: 1; } 48%, 100% { offset-distance: 46%; opacity: 0; } }
  @keyframes kennisbank-wat-is-dofollow-meter { 0%, 40% { transform: scaleX(0); } 52%, 88% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes kennisbank-wat-is-dofollow-chip { from { opacity: 0; transform: scale(0.5); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .df-bol, .in-beeld .df-bol-nf, .in-beeld .df-meter, .in-beeld .df-chip { animation: none; } }
</style>
