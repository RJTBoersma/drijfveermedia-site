---
// Scène voor /garantie/: een doelbord met een afgesproken doel ernaast. De pijl vliegt erin; lukt het niet, dan komt er een gratis maand bij op de kalender.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const dagen = Array.from({ length: 12 }, (_, i) => ({ x: 314 + (i % 4) * 32, y: 170 + Math.floor(i / 4) * 22 }));
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een doelbord met een pijl in de roos, een kaartje met het afgesproken doel en een kalender met een extra maand gratis.'}>
  <!-- doelbord -->
  <circle class="v" cx="140" cy="150" r="86" />
  <circle class="l" cx="140" cy="150" r="86" />
  <circle cx="140" cy="150" r="62" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <circle class="v" cx="140" cy="150" r="38" />
  <circle class="l" cx="140" cy="150" r="38" />
  <circle class="o" cx="140" cy="150" r="14" />
  <path class="l" d="M104 236l-16 26M176 236l16 26" />
  <!-- afgesproken doel -->
  <rect x="282" y="26" width="178" height="80" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="300" y="50" font-size="12" font-weight="700" class="zacht">Afgesproken doel</text>
  <text x="300" y="72" font-size="16" font-weight="900">20 aanvragen p/m</text>
  <rect x="300" y="84" width="142" height="9" rx="4.5" fill="#e8eef4" />
  <rect x="300" y="84" width="104" height="9" rx="4.5" fill="#074663" />
  <!-- kalender -->
  <rect x="300" y="126" width="140" height="128" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M300 138a12 12 0 0 1 12-12h116a12 12 0 0 1 12 12v16H300z" fill="#074663" />
  <path class="l" d="M326 118v16M414 118v16" />
  <text x="370" y="146" text-anchor="middle" font-size="12" font-weight="800" style="fill:#fff">Maand erbij</text>
  {dagen.map((d) => <rect x={d.x} y={d.y} width="22" height="14" rx="4" fill="#e8eef4" />)}
  {!mini && (
    <g>
      <g class="garantie-ring"><circle cx="140" cy="150" r="14" fill="none" stroke="#ff6600" stroke-width="3" /></g>
      <g class="garantie-pijl">
        <path d="M146 144L236 54" stroke="#10283f" stroke-width="4" stroke-linecap="round" />
        <path d="M236 54l4-18M236 54l18-4M228 62l4-18M228 62l18-4" stroke="#ff6600" stroke-width="3" stroke-linecap="round" />
        <path d="M140 150l14-4-10-10z" fill="#10283f" />
      </g>
      <g class="garantie-gratis">
        <rect x="356" y="200" width="96" height="30" rx="15" fill="#ff6600" />
        <text x="404" y="220" text-anchor="middle" font-size="13" font-weight="900">+1 gratis</text>
      </g>
      <path class="garantie-vink" d="M424 46l6 6 12-13" fill="none" stroke="#1f8a5b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
</svg>
<style>
  .garantie-ring { transform-box: fill-box; transform-origin: center; }
  .garantie-gratis, .garantie-vink { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .garantie-pijl { opacity: 0; transform: translate(120px, -110px); }
  :global(.teken-js) .garantie-gratis { opacity: 0; transform: scale(0.5); }
  :global(.teken-js) .garantie-vink { opacity: 0; }
  .in-beeld .garantie-pijl { animation: garantie-pijl 0.7s cubic-bezier(.5,0,.8,.4) 0.5s forwards; }
  .in-beeld .garantie-vink { animation: garantie-vink 0.4s ease 1.3s forwards; }
  .in-beeld .garantie-ring { animation: garantie-ring 3.5s ease-out 1.3s infinite both; }
  .in-beeld .garantie-gratis { animation: garantie-gratis 6s ease-in-out 1.8s infinite both; }
  @keyframes garantie-pijl { to { opacity: 1; transform: none; } }
  @keyframes garantie-vink { to { opacity: 1; } }
  @keyframes garantie-ring { 0% { transform: scale(1); opacity: 0.9; } 70%, 100% { transform: scale(5); opacity: 0; } }
  @keyframes garantie-gratis { 0% { opacity: 0; transform: scale(0.5); } 10%, 85% { opacity: 1; transform: none; } 100% { opacity: 0; transform: scale(0.9); } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .garantie-pijl, .in-beeld .garantie-vink, .in-beeld .garantie-ring, .in-beeld .garantie-gratis { animation: none; opacity: 1; transform: none; }
  }
</style>
