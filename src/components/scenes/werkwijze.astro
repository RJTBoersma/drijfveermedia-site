---
// Scène voor /werkwijze/: een route met vijf genummerde haltes, van de telefoon die binnen 15 minuten terugbelt tot de vlag bij het resultaat.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const route = 'M40 214H150Q170 214 170 194V160Q170 140 190 140H300Q320 140 320 120V90Q320 70 340 70H436';
const haltes = [
  { x: 76, y: 214, label: 'Bellen', lx: 76, ly: 246 },
  { x: 170, y: 176, label: 'Vragen', lx: 124, ly: 180 },
  { x: 245, y: 140, label: 'Voorleggen', lx: 245, ly: 172 },
  { x: 320, y: 106, label: 'Doel', lx: 284, ly: 110 },
  { x: 396, y: 70, label: 'Beginnen', lx: 396, ly: 102 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een route met vijf haltes. Bellen, vragen, voorleggen, een doel afspreken en beginnen, met een vlag aan het eind.'}>
  <!-- route -->
  <path d={route} fill="none" stroke="#e8eef4" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" />
  <path class="l" d={route} stroke-dasharray="2 8" />
  <!-- telefoon aan het begin -->
  <rect x="22" y="118" width="54" height="74" rx="10" fill="#10283f" />
  <rect x="28" y="128" width="42" height="52" rx="5" fill="#fff" />
  <path d="M40 146c2 8 6 12 14 14l4-4 6 3-1 5c-12 1-26-13-25-25l5-1 3 6z" fill="#074663" />
  <!-- vlag aan het eind -->
  <path class="l" d="M440 72V24" />
  <path class="o" d="M440 26h30l-8 10 8 10h-30z" />
  {!mini && <path class="werkwijze-loper" d={route} pathLength="1" fill="none" stroke="#ff6600" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />}
  <!-- haltes -->
  {haltes.map((h, i) => (
    <g>
      <circle cx={h.x} cy={h.y} r="13" fill="#fff" stroke="#074663" stroke-width="2.5" />
      <text x={h.x} y={h.y + 4.5} text-anchor="middle" font-size="13" font-weight="900">{i + 1}</text>
      <text x={h.lx} y={h.ly} text-anchor="middle" font-size="11" font-weight="700" class="zacht">{h.label}</text>
    </g>
  ))}
  {!mini && (
    <g>
      <g class="werkwijze-chip">
        <rect x="48" y="82" width="78" height="28" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
        <circle cx="64" cy="96" r="7" fill="none" stroke="#1f8a5b" stroke-width="2" />
        <path d="M64 92v4l3 2" fill="none" stroke="#1f8a5b" stroke-width="2" stroke-linecap="round" />
        <text x="76" y="100" font-size="12" font-weight="800">15 min</text>
      </g>
      <g class="werkwijze-golf"><path d="M84 150c4-4 4-10 0-14M92 156c8-8 8-20 0-28" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" /></g>
    </g>
  )}
</svg>
<style>
  .werkwijze-loper { stroke-dasharray: 0.07 0.93; stroke-dashoffset: 0.07; }
  :global(.teken-js) .werkwijze-loper { opacity: 0; }
  :global(.teken-js) .werkwijze-chip { opacity: 0; transform: translateY(8px); }
  .in-beeld .werkwijze-chip { animation: werkwijze-chip 0.5s cubic-bezier(.3,1.6,.5,1) 0.4s forwards; }
  .in-beeld .werkwijze-loper { animation: werkwijze-loper 6s linear 1s infinite both; }
  .in-beeld .werkwijze-golf { animation: werkwijze-golf 1.6s ease-in-out 0.4s 4 both; }
  @keyframes werkwijze-chip { to { opacity: 1; transform: none; } }
  @keyframes werkwijze-loper { 0% { stroke-dashoffset: 0.07; opacity: 0; } 5% { opacity: 1; } 90% { opacity: 1; } 100% { stroke-dashoffset: -0.93; opacity: 0; } }
  @keyframes werkwijze-golf { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .werkwijze-chip, .in-beeld .werkwijze-loper, .in-beeld .werkwijze-golf { animation: none; opacity: 1; transform: none; }
  }
</style>
