---
// Scène voor /kennisbank/wat-is/call-to-action/: een webpagina met een oranje knop boven de vouw, rechts een postvak.
// In de volledige versie tikt een cursor op de knop, de knop veert in en er verschijnt een melding dat de aanvraag binnen is.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een webpagina met een oranje knop "Vraag een offerte aan" boven de vouw. Een cursor klikt op de knop en rechts komt de aanvraag binnen.'}>
  <!-- de pagina -->
  <rect x="24" y="24" width="268" height="222" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="42" cy="40" r="4" fill="#d9e1ea" />
  <circle cx="54" cy="40" r="4" fill="#d9e1ea" />
  <circle cx="66" cy="40" r="4" fill="#d9e1ea" />
  <rect x="44" y="64" width="170" height="12" rx="6" fill="#10283f" />
  <rect x="44" y="84" width="130" height="12" rx="6" fill="#10283f" />
  <rect x="44" y="106" width="200" height="7" rx="3.5" fill="#d9e1ea" />
  <g class="knop">
    <rect x="44" y="124" width="178" height="34" rx="10" fill="#ff6600" />
    <text x="133" y="146" font-size="13" font-weight="800" text-anchor="middle" style="fill:#fff">Vraag een offerte aan</text>
  </g>
  <!-- de vouw -->
  <path d="M24 180h268" stroke="#8aa0b4" stroke-width="1.5" stroke-dasharray="6 5" />
  <text x="284" y="174" font-size="10" font-weight="700" text-anchor="end" class="zacht">vouw</text>
  <rect x="44" y="196" width="190" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="44" y="212" width="160" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="44" y="228" width="120" height="7" rx="3.5" fill="#e8eef4" />

  <!-- het postvak -->
  <path d="M340 168l20-30h68l20 30v52a8 8 0 0 1-8 8h-92a8 8 0 0 1-8-8z" fill="#fff" stroke="#074663" stroke-width="2.5" stroke-linejoin="round" />
  <path class="l" d="M340 168h32l8 14h28l8-14h32" />
  <path class="a" d="M372 112l22 22 22-22M394 92v40" />

  {!mini && (
    <g>
      <circle class="ring" cx="208" cy="148" r="10" fill="none" stroke="#10283f" stroke-width="2" />
      <path class="cursor" d="M208 148v18l5-4.5 3.5 8 3.5-1.5-3.5-8h7z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      <g class="melding">
        <rect x="310" y="40" width="160" height="40" rx="12" fill="#fff" stroke="#1a7a50" stroke-width="2" />
        <circle cx="330" cy="60" r="9" fill="#1a7a50" />
        <path d="M326 60l3 3 5-6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="346" y="64.5" font-size="12" font-weight="800">Aanvraag binnen</text>
      </g>
    </g>
  )}
</svg>
<style>
  .knop, .ring, .melding { transform-box: fill-box; transform-origin: center; }
  .cursor { transform-box: fill-box; transform-origin: 0 0; }
  :global(.teken-js) .melding, :global(.teken-js) .ring { opacity: 0; }
  .in-beeld .cursor { animation: kennisbank-wat-is-call-to-action-cursor 5s ease-in-out 0.3s infinite; }
  .in-beeld .ring { animation: kennisbank-wat-is-call-to-action-ring 5s ease-out 0.3s infinite; }
  .in-beeld .knop { animation: kennisbank-wat-is-call-to-action-knop 5s ease-in-out 0.3s infinite; }
  .in-beeld .melding { animation: kennisbank-wat-is-call-to-action-melding 5s ease-in-out 0.3s infinite; }
  @keyframes kennisbank-wat-is-call-to-action-cursor {
    0% { transform: translate(50px, 60px); opacity: 0; }
    10% { opacity: 1; }
    32% { transform: translate(0, 0); }
    38% { transform: translate(0, 0) scale(.85); }
    44%, 85% { transform: translate(0, 0); opacity: 1; }
    100% { transform: translate(0, 0); opacity: 0; }
  }
  @keyframes kennisbank-wat-is-call-to-action-ring { 0%, 36% { opacity: 0; transform: scale(.4); } 40% { opacity: 1; } 58%, 100% { opacity: 0; transform: scale(2.2); } }
  @keyframes kennisbank-wat-is-call-to-action-knop { 0%, 35% { transform: none; } 39% { transform: scale(.95); } 44%, 100% { transform: none; } }
  @keyframes kennisbank-wat-is-call-to-action-melding { 0%, 44% { opacity: 0; transform: translateY(10px) scale(.9); } 52%, 88% { opacity: 1; transform: none; } 100% { opacity: 0; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .cursor, .in-beeld .ring, .in-beeld .knop, .in-beeld .melding { animation: none; }
  }
</style>
