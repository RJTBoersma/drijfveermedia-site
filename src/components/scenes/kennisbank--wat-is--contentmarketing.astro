---
// Scène voor /kennisbank/wat-is/contentmarketing/: een artikel op jouw website in het midden, met eromheen een nieuwsbrief, een video en een contentkalender.
// Als hij leeft: lezers lopen over de stippellijnen naar het artikel, op de kalender komt een vinkje bij en een teller meldt nieuwe lezers.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een artikel "Wat kost een dakkapel?" op een website, met eromheen een nieuwsbrief, een video en een contentkalender. Lezers komen van alle kanten naar het artikel toe.'}>
  <!-- paden naar het artikel -->
  <path d="M96 76C126 80 136 92 156 100M96 196C126 192 136 176 156 168M384 196C354 192 344 176 324 168" fill="none" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="5 6" stroke-linecap="round" />

  <!-- het artikel -->
  <rect x="156" y="36" width="168" height="196" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="156" y="36" width="168" height="26" rx="12" fill="#e8eef4" />
  <rect x="156" y="50" width="168" height="12" fill="#e8eef4" />
  <circle cx="172" cy="49" r="3.5" fill="#d9e1ea" />
  <circle cx="183" cy="49" r="3.5" fill="#d9e1ea" />
  <text x="172" y="86" font-size="13" font-weight="800">Wat kost een</text>
  <text x="172" y="103" font-size="13" font-weight="800">dakkapel?</text>
  <path class="a" d="M172 112h60" />
  <rect class="v" x="172" y="124" width="136" height="7" rx="3.5" />
  <rect class="v" x="172" y="138" width="120" height="7" rx="3.5" />
  <rect class="v" x="172" y="152" width="130" height="7" rx="3.5" />
  <rect x="172" y="170" width="136" height="44" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
  <path d="M172 184h136M172 198h136M226 170v44" stroke="#d9e1ea" stroke-width="1.5" />
  <text x="180" y="181" font-size="8.5" font-weight="700" class="zacht">Breedte</text>
  <text x="234" y="181" font-size="8.5" font-weight="700" class="zacht">Vanaf</text>

  <!-- nieuwsbrief -->
  <rect x="34" y="52" width="62" height="46" rx="6" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M36 56l29 22 29-22" />
  <text x="65" y="116" font-size="11" font-weight="800" text-anchor="middle">Nieuwsbrief</text>

  <!-- video -->
  <rect x="34" y="174" width="62" height="44" rx="8" fill="#074663" />
  <path d="M58 186v20l17-10z" fill="#fff" />
  <text x="65" y="236" font-size="11" font-weight="800" text-anchor="middle">Video</text>

  <!-- contentkalender -->
  <rect x="356" y="34" width="96" height="88" rx="10" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path d="M356 56h96" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M378 28v12M430 28v12" />
  <rect class="v" x="368" y="66" width="18" height="14" rx="3" />
  <rect class="v" x="395" y="66" width="18" height="14" rx="3" />
  <rect class="v" x="422" y="66" width="18" height="14" rx="3" />
  <rect class="v" x="368" y="90" width="18" height="14" rx="3" />
  <rect class="v" x="395" y="90" width="18" height="14" rx="3" />
  <rect class="v" x="422" y="90" width="18" height="14" rx="3" />
  <path d="M371 73l4 4 7-8M398 73l4 4 7-8M425 73l4 4 7-8" fill="none" stroke="#1a7a50" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  <text x="404" y="140" font-size="11" font-weight="800" text-anchor="middle">Contentkalender</text>

  <!-- lezers -->
  <circle cx="404" cy="196" r="9" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M390 222c0-10 6-15 14-15s14 5 14 15" />

  {!mini && (
    <g>
      <circle class="lezer lezer-1" cx="96" cy="76" r="6" fill="#ff6600" />
      <circle class="lezer lezer-2" cx="96" cy="196" r="6" fill="#ff6600" />
      <circle class="lezer lezer-3" cx="384" cy="196" r="6" fill="#ff6600" />
      <path class="cm-vink" d="M371 97l4 4 7-8" fill="none" stroke="#1a7a50" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      <g class="cm-teller">
        <rect x="236" y="8" width="112" height="28" rx="14" fill="#1a7a50" />
        <text x="292" y="26.5" font-size="12" font-weight="800" text-anchor="middle" style="fill:#fff">+3 lezers</text>
      </g>
    </g>
  )}
</svg>
<style>
  .cm-teller { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .lezer, :global(.teken-js) .cm-vink, :global(.teken-js) .cm-teller { opacity: 0; }
  .in-beeld .lezer-1 { animation: kennisbank-wat-is-contentmarketing-links-boven 5s ease-in-out 0.4s infinite; }
  .in-beeld .lezer-2 { animation: kennisbank-wat-is-contentmarketing-links-onder 5s ease-in-out 1.2s infinite; }
  .in-beeld .lezer-3 { animation: kennisbank-wat-is-contentmarketing-rechts 5s ease-in-out 2s infinite; }
  .in-beeld .cm-vink { animation: kennisbank-wat-is-contentmarketing-vink 0.5s ease-out 1.6s forwards; }
  .in-beeld .cm-teller { animation: kennisbank-wat-is-contentmarketing-teller 5s ease-in-out 2.4s infinite; }
  @keyframes kennisbank-wat-is-contentmarketing-links-boven { 0% { opacity: 0; transform: none; } 10% { opacity: 1; } 60% { opacity: 1; transform: translate(60px, 24px); } 70%, 100% { opacity: 0; transform: translate(60px, 24px); } }
  @keyframes kennisbank-wat-is-contentmarketing-links-onder { 0% { opacity: 0; transform: none; } 10% { opacity: 1; } 60% { opacity: 1; transform: translate(60px, -28px); } 70%, 100% { opacity: 0; transform: translate(60px, -28px); } }
  @keyframes kennisbank-wat-is-contentmarketing-rechts { 0% { opacity: 0; transform: none; } 10% { opacity: 1; } 60% { opacity: 1; transform: translate(-60px, -28px); } 70%, 100% { opacity: 0; transform: translate(-60px, -28px); } }
  @keyframes kennisbank-wat-is-contentmarketing-vink { to { opacity: 1; } }
  @keyframes kennisbank-wat-is-contentmarketing-teller { 0%, 20% { opacity: 0; transform: translateY(6px) scale(.9); } 30%, 80% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .lezer, .in-beeld .cm-vink, .in-beeld .cm-teller { animation: none; } }
</style>
