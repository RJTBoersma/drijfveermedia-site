---
// Scène voor /website-laten-maken/website-met-ai/: een opdracht in een chatvenster wordt een website, die we daarna met de hand afmaken.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: een korte opdracht in een chatvenster wordt een complete website. Een pen zet er een vinkje bij: met de hand afgemaakt, vanaf 250 euro.'} aria-hidden={mini ? 'true' : undefined}>
  <!-- Chatvenster -->
  <rect x="12" y="44" width="172" height="168" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="36" y="60" width="136" height="44" rx="10" fill="#074663" />
  <text x="48" y="78" font-size="11" font-weight="700" style="fill:#fff">Maak een site voor</text>
  <text x="48" y="94" font-size="11" font-weight="700" style="fill:#fff">mijn hoveniersbedrijf</text>
  <circle class="v" cx="34" cy="128" r="11" />
  <path class="o" d="M34 120l2 5.5 5.5 2-5.5 2-2 5.5-2-5.5-5.5-2 5.5-2z" />
  <rect class="v" x="52" y="120" width="110" height="8" rx="4" />
  <rect class="v" x="52" y="134" width="82" height="8" rx="4" />
  <rect x="24" y="178" width="148" height="22" rx="11" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
  <circle cx="158" cy="189" r="7" fill="#ff6600" />
  <!-- Pijl naar de site -->
  <path class="a" d="M190 128c16 0 18-10 34-10" />
  <path class="a" d="M218 112l7 6-7 6" />
  <!-- De website -->
  <rect x="232" y="26" width="236" height="196" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M232 52h236" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="248" cy="39" r="4" fill="#d9e1ea" /><circle cx="260" cy="39" r="4" fill="#d9e1ea" /><circle cx="272" cy="39" r="4" fill="#d9e1ea" />
  <g>
    <rect x="248" y="64" width="52" height="8" rx="4" fill="#074663" />
    <rect class="v" x="390" y="64" width="62" height="8" rx="4" />
  </g>
  <g>
    <rect x="248" y="86" width="120" height="12" rx="4" fill="#10283f" />
    <rect x="248" y="104" width="90" height="12" rx="4" fill="#10283f" />
    <rect x="248" y="124" width="104" height="7" rx="3.5" fill="#d9e1ea" />
  </g>
  <g>
    <rect x="248" y="142" width="74" height="22" rx="7" fill="#ff6600" />
    <text x="258" y="157" font-size="10.5" font-weight="800" style="fill:#fff">Offerte</text>
  </g>
  <g>
    <rect class="v" x="380" y="86" width="74" height="78" rx="9" />
    <circle cx="414" cy="118" r="18" fill="#fff" stroke="#074663" stroke-width="2.5" />
    <path class="l" d="M414 136v18M402 154h24" />
    <circle class="o" cx="442" cy="98" r="6" />
  </g>
  <g>
    <rect class="v" x="248" y="178" width="62" height="30" rx="6" /><rect class="v" x="318" y="178" width="62" height="30" rx="6" /><rect class="v" x="388" y="178" width="64" height="30" rx="6" />
  </g>
  <!-- Afgemaakt met de hand -->
  <rect x="292" y="228" width="184" height="34" rx="11" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="312" cy="245" r="10" fill="#1f8a5b" />
  <path d="M307 245l4 4 7-8" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  <text x="328" y="249" font-size="11" font-weight="800">Met de hand afgemaakt</text>
  <rect x="24" y="226" width="92" height="32" rx="10" fill="#fff4ec" stroke="#ffd6b8" />
  <text x="38" y="247" font-size="13" font-weight="900">€ 250</text>
  {!mini && (
    <g>
      <rect class="website-laten-maken--website-met-ai-veeg" x="234" y="54" width="232" height="24" fill="#ff6600" />
      <circle class="website-laten-maken--website-met-ai-ring" cx="312" cy="245" r="10" fill="none" stroke="#1f8a5b" stroke-width="2.5" />
      <g class="website-laten-maken--website-met-ai-typen">
        <circle cx="62" cy="152" r="3.5" fill="#8aa0b4" /><circle cx="74" cy="152" r="3.5" fill="#8aa0b4" /><circle cx="86" cy="152" r="3.5" fill="#8aa0b4" />
      </g>
      <path class="website-laten-maken--website-met-ai-ster" d="M216 40l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" fill="#ff6600" />
      <path class="website-laten-maken--website-met-ai-ster" style="animation-delay:1.9s" d="M466 16l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="#ff6600" />
      <g class="website-laten-maken--website-met-ai-pen">
        <path d="M0 0l22-22 7 7-22 22h-7z" fill="#fff" stroke="#074663" stroke-width="2.5" stroke-linejoin="round" />
        <path d="M17 -17l7 7" stroke="#074663" stroke-width="2.5" />
      </g>
    </g>
  )}
</svg>
<style>
  :global(.teken-js) .website-laten-maken--website-met-ai-pen, :global(.teken-js) .website-laten-maken--website-met-ai-veeg { opacity: 0; }
  .website-laten-maken--website-met-ai-veeg { opacity: 0; }
  .in-beeld .website-laten-maken--website-met-ai-veeg { animation: website-laten-maken--website-met-ai-veeg 2.2s ease-in-out 0.4s forwards; }
  .website-laten-maken--website-met-ai-pen { transform: translate(196px, 258px); }
  .in-beeld .website-laten-maken--website-met-ai-pen { animation: website-laten-maken--website-met-ai-pen 1.4s ease-in-out 2.4s forwards; }
  .website-laten-maken--website-met-ai-ring { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .in-beeld .website-laten-maken--website-met-ai-ring { animation: website-laten-maken--website-met-ai-ring 4s ease-out 3.4s infinite; }
  .in-beeld .website-laten-maken--website-met-ai-typen circle { animation: website-laten-maken--website-met-ai-typen 1.2s ease-in-out infinite; }
  .in-beeld .website-laten-maken--website-met-ai-typen circle:nth-child(2) { animation-delay: 0.2s; }
  .in-beeld .website-laten-maken--website-met-ai-typen circle:nth-child(3) { animation-delay: 0.4s; }
  .website-laten-maken--website-met-ai-ster { transform-box: fill-box; transform-origin: center; }
  .in-beeld .website-laten-maken--website-met-ai-ster { animation: website-laten-maken--website-met-ai-ster 3.8s ease-in-out infinite; }
  @keyframes website-laten-maken--website-met-ai-veeg { 0% { opacity: 0; transform: translateY(0); } 10% { opacity: 0.16; } 85% { opacity: 0.16; transform: translateY(142px); } 100% { opacity: 0; transform: translateY(142px); } }
  @keyframes website-laten-maken--website-met-ai-pen { 0% { opacity: 0; transform: translate(330px, 230px); } 25% { opacity: 1; } 60% { opacity: 1; transform: translate(318px, 250px); } 100% { opacity: 0; transform: translate(340px, 236px); } }
  @keyframes website-laten-maken--website-met-ai-ring { 0% { opacity: 0.9; transform: scale(1); } 60%, 100% { opacity: 0; transform: scale(2); } }
  @keyframes website-laten-maken--website-met-ai-typen { 0%, 100% { opacity: 0.3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }
  @keyframes website-laten-maken--website-met-ai-ster { 0%, 100% { opacity: 0.25; transform: scale(0.7) rotate(0deg); } 50% { opacity: 1; transform: scale(1.1) rotate(20deg); } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .website-laten-maken--website-met-ai-veeg, .in-beeld .website-laten-maken--website-met-ai-pen, .in-beeld .website-laten-maken--website-met-ai-ring, .in-beeld .website-laten-maken--website-met-ai-typen circle, .in-beeld .website-laten-maken--website-met-ai-ster { animation: none; }
  }
</style>
