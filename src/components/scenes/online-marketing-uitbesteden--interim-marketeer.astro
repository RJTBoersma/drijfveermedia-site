---
// Scène voor /online-marketing-uitbesteden/interim-marketeer/: in het marketingteam is een plek leeg door verlof. De interim-marketeer schuift aan en de taken van de week worden afgevinkt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const taken = ['Campagne live', 'Nieuwsbrief', 'Website-update', 'Maandrapport'];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: in een marketingteam is een plek leeg door verlof. Een interim-marketeer schuift aan en de taken van de week worden een voor een afgevinkt.'}>
  <!-- het team -->
  <rect x="18" y="28" width="276" height="146" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="38" y="56" font-size="13" font-weight="800">Jouw marketingteam</text>
  <circle cx="78" cy="98" r="22" fill="#074663" />
  <circle cx="78" cy="91" r="7" fill="#fff" /><path d="M66 110c0-10 24-10 24 0z" fill="#fff" />
  <rect class="v" x="56" y="132" width="44" height="8" rx="4" />
  <circle cx="156" cy="98" r="22" fill="#074663" />
  <circle cx="156" cy="91" r="7" fill="#fff" /><path d="M144 110c0-10 24-10 24 0z" fill="#fff" />
  <rect class="v" x="134" y="132" width="44" height="8" rx="4" />
  <circle cx="234" cy="98" r="22" fill="none" stroke="#b9c8d6" stroke-width="2" stroke-dasharray="5 5" />
  <text x="234" y="139" text-anchor="middle" font-size="10" class="zacht">Met verlof</text>
  <!-- prijs -->
  <rect x="18" y="194" width="276" height="50" rx="12" fill="#e8eef4" />
  <text x="38" y="225" font-size="15" font-weight="900">€ 95 per uur</text>
  <text x="150" y="224" font-size="11" class="zacht">Op afroep inzetbaar</text>
  <!-- de taken van de week -->
  <rect x="312" y="28" width="150" height="216" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="328" y="56" font-size="13" font-weight="800">Deze week</text>
  {taken.map((t, i) => (
    <g>
      <rect x="328" y={76 + i * 40} width="18" height="18" rx="5" fill="#fff" stroke="#b9c8d6" stroke-width="2" />
      <text x="354" y={90 + i * 40} font-size="11">{t}</text>
    </g>
  ))}
  {!mini && (
    <g>
      <g class="aanschuiven">
        <circle cx="234" cy="98" r="22" fill="#074663" stroke="#ff6600" stroke-width="3" />
        <circle cx="234" cy="91" r="7" fill="#fff" /><path d="M222 110c0-10 24-10 24 0z" fill="#fff" />
      </g>
      <rect class="label" x="198" y="128" width="72" height="16" rx="8" fill="#ff6600" />
      <text class="label" x="234" y="140" text-anchor="middle" font-size="10" font-weight="800" style="fill:#fff">Interim</text>
      {taken.map((_, i) => (
        <g class="vink" style={`--i:${i}`}>
          <rect x="328" y={76 + i * 40} width="18" height="18" rx="5" fill="#1a7a50" />
          <path d={`M332 ${85 + i * 40}l3 3 7-7`} stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
    </g>
  )}
</svg>
<style>
  .aanschuiven, .vink, .label { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .aanschuiven, :global(.teken-js) .label { opacity: 0; transform: translateY(70px); transition: opacity 0.6s ease 0.4s, transform 1s cubic-bezier(.3,1.3,.5,1) 0.4s; }
  :global(.teken-js) .in-beeld .aanschuiven, :global(.teken-js) .in-beeld .label { opacity: 1; transform: none; }
  :global(.teken-js) .vink { opacity: 0; }
  .in-beeld .vink { animation: online-marketing-uitbesteden--interim-marketeer-vink 6s ease-out calc(1.4s + var(--i) * 0.9s) infinite both; }
  @keyframes online-marketing-uitbesteden--interim-marketeer-vink {
    0% { opacity: 0; transform: scale(0.4); }
    6%, 70% { opacity: 1; transform: none; }
    80%, 100% { opacity: 0; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .vink { animation: none; }
    .aanschuiven, .label { transition: none; }
  }
</style>
