---
// Scène voor /branding/logo-laten-maken/: een logo op de tekentafel, opgebouwd met hulplijnen en ankerpunten, en rechts dezelfde vorm groot, klein en als icoon. Elk formaat krijgt een vinkje.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const blad = 'M0 -63C46 -27 46 23 0 63C-46 23 -46 -27 0 -63z';
const maten = [
  { y: 92, schaal: 0.55 },
  { y: 164, schaal: 0.3 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: een logo wordt op de tekentafel opgebouwd met hulplijnen en ankerpunten. Rechts staat hetzelfde logo groot, klein en als icoontje in een browsertabblad, elk met een vinkje.'} aria-hidden={mini ? 'true' : undefined}>
  <!-- tekentafel -->
  <rect x="30" y="30" width="270" height="210" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="46" y="52" font-size="11" font-weight="700" class="zacht">logo.svg</text>
  <circle cx="165" cy="135" r="80" fill="none" stroke="#e8eef4" stroke-width="2" stroke-dasharray="5 5" />
  <path d="M165 46v178M50 135h230" stroke="#e8eef4" stroke-width="2" />
  <g transform="translate(165 135) scale(1.2)">
    <path d={blad} fill="#074663" />
    <path d="M0 -38v80" stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none" />
    <circle cx="20" cy="38" r="7" fill="#ff6600" />
  </g>
  <!-- formaten -->
  <rect x="320" y="30" width="140" height="210" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  {maten.map((m) => (
    <g transform={`translate(372 ${m.y}) scale(${m.schaal})`}>
      <path d={blad} fill="#074663" />
      <path d="M0 -38v80" stroke="#fff" stroke-width={3 / m.schaal * 0.6} stroke-linecap="round" fill="none" />
      <circle cx="20" cy="38" r="7" fill="#ff6600" />
    </g>
  ))}
  <rect x="336" y="200" width="96" height="26" rx="7" fill="#e8eef4" />
  <g transform="translate(350 213) scale(0.15)">
    <path d={blad} fill="#074663" />
    <circle cx="20" cy="38" r="9" fill="#ff6600" />
  </g>
  <rect x="362" y="210" width="56" height="6" rx="3" fill="#8aa0b4" />
  {!mini && (
    <g>
      <g transform="translate(165 135) scale(1.2)">
        <path class="branding-logo-omtrek" d={blad} fill="none" stroke="#ff6600" stroke-width="2" pathLength="1" />
      </g>
      <g class="branding-logo-ankers">
        <path d="M110 103L165 59L220 103M110 167L165 211L220 167" fill="none" stroke="#ff6600" stroke-width="1.5" />
        <rect x="160" y="54" width="10" height="10" fill="#fff" stroke="#10283f" stroke-width="2" />
        <rect x="160" y="206" width="10" height="10" fill="#fff" stroke="#10283f" stroke-width="2" />
        <circle cx="110" cy="103" r="4" fill="#ff6600" /><circle cx="220" cy="103" r="4" fill="#ff6600" />
        <circle cx="110" cy="167" r="4" fill="#ff6600" /><circle cx="220" cy="167" r="4" fill="#ff6600" />
      </g>
      <g class="branding-logo-cursor">
        <path transform="translate(222 104)" d="M0 0l6 18 4-7 7-4z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      </g>
      {[92, 164, 213].map((y, i) => (
        <g class="branding-logo-vink" style={`--i:${i}`}>
          <circle cx="438" cy={y} r="10" fill="#1f8a5b" />
          <path d={`M433 ${y}l4 4 7-8`} stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
    </g>
  )}
</svg>
<style>
  .branding-logo-omtrek { stroke-dasharray: 1; }
  :global(.teken-js) .branding-logo-omtrek { stroke-dashoffset: 1; }
  :global(.teken-js) .branding-logo-ankers, :global(.teken-js) .branding-logo-vink { opacity: 0; }
  .branding-logo-vink { transform-box: fill-box; transform-origin: center; }
  .in-beeld .branding-logo-omtrek { animation: branding-logo-omtrek 1.6s cubic-bezier(.6,.1,.3,1) 0.5s forwards; }
  .in-beeld .branding-logo-ankers { animation: branding-logo-zie 0.5s ease-out 1.8s forwards; }
  .in-beeld .branding-logo-vink { animation: branding-logo-vink 0.45s cubic-bezier(.3,1.6,.5,1) calc(2.3s + var(--i) * 0.45s) forwards; }
  .in-beeld .branding-logo-cursor { animation: branding-logo-cursor 6s ease-in-out 1s infinite; }
  @keyframes branding-logo-omtrek { to { stroke-dashoffset: 0; } }
  @keyframes branding-logo-zie { to { opacity: 1; } }
  @keyframes branding-logo-vink { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes branding-logo-cursor { 0%, 100% { transform: translate(0, 0); } 30% { transform: translate(-55px, -44px); } 55% { transform: translate(-112px, 64px); } 80% { transform: translate(-55px, 108px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .branding-logo-omtrek, .in-beeld .branding-logo-ankers, .in-beeld .branding-logo-vink, .in-beeld .branding-logo-cursor { animation: none; } }
</style>
