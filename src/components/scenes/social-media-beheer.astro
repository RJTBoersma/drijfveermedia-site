---
// Scène voor /social-media-beheer/: links een contentplan voor de week, rechts een telefoon met de feed van jouw bedrijf.
// Een geplande post vliegt van het plan naar de feed, er komt een hartje bij en een klant stelt een vraag.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const dagen = ['ma', 'di', 'wo', 'do', 'vr'];
const xs = [32, 68, 104, 140, 176];
const rijen = [104, 142, 180];
// welke vakjes een geplande post hebben: [kolom, rij]
const gepland = [[0, 0], [2, 0], [4, 0], [1, 1], [3, 1], [0, 2], [2, 2]];
const isGepland = (k: number, r: number) => gepland.some(([a, b]) => a === k && b === r);
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een contentplan met geplande berichten. Een bericht gaat vanuit het plan naar de telefoon met de feed van jouw bedrijf, krijgt een hartje en een klant vraagt wat het kost.'}>
  <!-- contentplan -->
  <rect x="20" y="46" width="200" height="180" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="36" y="72" font-size="13" font-weight="800">Contentplan</text>
  {dagen.map((d, i) => <text x={xs[i] + 14} y="94" text-anchor="middle" font-size="10" class="zacht">{d}</text>)}
  {rijen.map((y, r) => xs.map((x, k) => isGepland(k, r)
    ? <g><rect x={x} y={y} width="28" height="28" rx="6" fill="#fff" stroke="#074663" stroke-width="2" /><rect x={x + 6} y={y + 8} width="16" height="4" rx="2" fill="#074663" /><rect x={x + 6} y={y + 16} width="10" height="4" rx="2" fill="#c9d3dd" /></g>
    : <rect class="v" x={x} y={y} width="28" height="28" rx="6" />))}
  <!-- route van plan naar feed -->
  <path d="M222 120c22-14 42-20 62-20" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="2 7" />
  <!-- telefoon -->
  <rect x="286" y="18" width="128" height="236" rx="18" fill="#10283f" />
  <rect x="294" y="30" width="112" height="212" rx="10" fill="#fff" />
  <circle class="v" cx="308" cy="47" r="8" />
  <text x="321" y="51" font-size="10" font-weight="800">Jouw bedrijf</text>
  <rect class="v" x="300" y="62" width="100" height="78" rx="6" />
  <path class="l" d="M306 132l22-26 16 18 10-10 20 18" />
  <circle class="o" cx="382" cy="82" r="7" />
  <path class="l" d="M312 162c-6-4-8-7-8-10a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 3-2 6-8 10z" />
  <path class="l" d="M330 149h12a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-7l-4 4v-4h-1a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3z" />
  <rect class="v" x="300" y="174" width="92" height="7" rx="3.5" />
  <rect class="v" x="300" y="186" width="68" height="7" rx="3.5" />
  <rect class="v" x="300" y="204" width="100" height="32" rx="6" />
  <!-- vraag van een klant -->
  <path d="M398 196h66a8 8 0 0 1 8 8v16a8 8 0 0 1-8 8h-50l-10 8v-8h-6a8 8 0 0 1-8-8v-16a8 8 0 0 1 8-8z" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="432" y="216" text-anchor="middle" font-size="10" font-weight="700">Wat kost dat?</text>
  {!mini && (
    <g>
      <g class="vinkjes">
        {[[0, 0], [2, 0], [1, 1]].map(([k, r], i) => (
          <g class="vinkje" style={`--i:${i}`}><circle cx={xs[k] + 26} cy={rijen[r] + 2} r="7" fill="#1a7a50" /><path d={`M${xs[k] + 23} ${rijen[r] + 2}l2 2 4-4`} stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
        ))}
      </g>
      <g class="vlieger"><rect x="176" y="104" width="28" height="28" rx="6" fill="#074663" /><rect x="182" y="112" width="16" height="4" rx="2" fill="#fff" /><rect x="182" y="120" width="10" height="4" rx="2" fill="#ff6600" /></g>
      <g class="hartje">
        <path d="M312 162c-6-4-8-7-8-10a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 3-2 6-8 10z" fill="#ff6600" />
        <text x="322" y="146" font-size="10" font-weight="800" style="fill:#ff6600">+1</text>
      </g>
    </g>
  )}
</svg>
<style>
  .vinkje { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .vinkje { opacity: 0; transform: scale(0.4); transition: opacity 0.4s ease, transform 0.4s cubic-bezier(.3,1.7,.5,1); transition-delay: calc(0.5s + var(--i) * 0.4s); }
  :global(.teken-js) .in-beeld .vinkje { opacity: 1; transform: none; }
  .vlieger { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .hartje { transform-box: fill-box; transform-origin: 50% 80%; }
  :global(.teken-js) .hartje { opacity: 0; }
  .in-beeld .vlieger { animation: social-media-beheer-vlieg 6s ease-in-out 1.6s infinite both; }
  .in-beeld .hartje { animation: social-media-beheer-hart 6s ease-out 1.6s infinite both; }
  @keyframes social-media-beheer-vlieg {
    0% { opacity: 0; transform: translate(0, 0); }
    8% { opacity: 1; transform: translate(0, 0); }
    45% { opacity: 1; transform: translate(160px, -30px) scale(1.3); }
    55%, 100% { opacity: 0; transform: translate(160px, -30px) scale(1.3); }
  }
  @keyframes social-media-beheer-hart {
    0%, 55% { opacity: 0; transform: scale(0.4); }
    62% { opacity: 1; transform: scale(1.25); }
    68%, 90% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .vlieger, .in-beeld .hartje { animation: none; } }
</style>
