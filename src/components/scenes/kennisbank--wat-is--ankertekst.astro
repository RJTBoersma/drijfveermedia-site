---
// Scène voor /kennisbank/wat-is/ankertekst/: in een tekst staat een onderstreepte link, een lijn wijst naar de pagina erachter.
// Onderin een balk met een natuurlijke mix van ankerteksten. In de volledige versie klikt een cursor op de link en licht de pagina op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: in een tekst staat de link "loodgieter Groningen". Een lijn wijst naar de pagina waar de link heen gaat. Onderin een balk met een natuurlijke mix van linkteksten: vooral merknaam en adres, een klein deel zoekwoord.'}>
  <!-- de tekst met de link -->
  <rect x="20" y="34" width="240" height="150" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="36" y="54" width="190" height="8" rx="4" fill="#d9e1ea" />
  <rect x="36" y="72" width="204" height="8" rx="4" fill="#d9e1ea" />
  <rect class="v" x="30" y="88" width="180" height="22" rx="5" />
  <text x="38" y="104" font-size="13" font-weight="800" style="fill:#074663">loodgieter Groningen</text>
  <path d="M38 108h162" stroke="#074663" stroke-width="2" stroke-linecap="round" />
  <rect x="36" y="122" width="196" height="8" rx="4" fill="#d9e1ea" />
  <rect x="36" y="140" width="170" height="8" rx="4" fill="#d9e1ea" />
  <rect x="36" y="158" width="120" height="8" rx="4" fill="#d9e1ea" />

  <!-- de verwijzing -->
  <path class="a" d="M212 94C238 66 264 64 294 86" stroke-dasharray="5 6" />
  <path class="a" d="M284 78l11 9-13 4" />

  <!-- de pagina waar de link heen gaat -->
  <rect x="300" y="40" width="160" height="140" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="316" cy="54" r="3.5" fill="#d9e1ea" />
  <circle cx="327" cy="54" r="3.5" fill="#d9e1ea" />
  <circle cx="338" cy="54" r="3.5" fill="#d9e1ea" />
  <path class="l" d="M316 66h128" />
  <text x="316" y="92" font-size="13" font-weight="900">Loodgieter</text>
  <rect x="316" y="102" width="112" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="316" y="116" width="96" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="316" y="130" width="120" height="7" rx="3.5" fill="#d9e1ea" />
  <rect class="o" x="316" y="150" width="62" height="18" rx="6" />

  <!-- de mix -->
  <text x="20" y="206" font-size="11" font-weight="800" class="zacht">Een natuurlijke mix</text>
  <rect x="20" y="214" width="150" height="24" rx="6" fill="#074663" />
  <rect x="174" y="214" width="100" height="24" rx="6" fill="#8aa0b4" />
  <rect x="278" y="214" width="96" height="24" rx="6" fill="#d9e1ea" />
  <rect x="378" y="214" width="82" height="24" rx="6" fill="#ff6600" />
  <text x="32" y="230" font-size="11" font-weight="800" style="fill:#fff">Merknaam</text>
  <text x="186" y="230" font-size="11" font-weight="800" style="fill:#fff">Adres</text>
  <text x="290" y="230" font-size="11" font-weight="800">klik hier</text>
  <text x="388" y="230" font-size="11" font-weight="800" style="fill:#fff">zoekwoord</text>

  {!mini && (
    <g>
      <rect class="oplicht" x="295" y="35" width="170" height="150" rx="15" fill="none" stroke="#ff6600" stroke-width="2.5" />
      <circle class="ring" cx="150" cy="104" r="10" fill="none" stroke="#ff6600" stroke-width="2" />
      <path class="cursor" d="M150 104v18l5-4.5 3.5 8 3.5-1.5-3.5-8h7z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
    </g>
  )}
</svg>
<style>
  .cursor, .ring { transform-box: fill-box; transform-origin: center; }
  .cursor { transform-origin: 0 0; }
  :global(.teken-js) .oplicht { opacity: 0; }
  :global(.teken-js) .ring { opacity: 0; }
  .in-beeld .cursor { animation: kennisbank-wat-is-ankertekst-cursor 5s ease-in-out 0.3s infinite; }
  .in-beeld .ring { animation: kennisbank-wat-is-ankertekst-ring 5s ease-out 0.3s infinite; }
  .in-beeld .oplicht { animation: kennisbank-wat-is-ankertekst-oplicht 5s ease-in-out 0.3s infinite; }
  @keyframes kennisbank-wat-is-ankertekst-cursor {
    0% { transform: translate(40px, 50px); opacity: 0; }
    10% { opacity: 1; }
    35% { transform: translate(0, 0); }
    40% { transform: translate(0, 0) scale(.85); }
    45%, 85% { transform: translate(0, 0); opacity: 1; }
    100% { transform: translate(0, 0); opacity: 0; }
  }
  @keyframes kennisbank-wat-is-ankertekst-ring {
    0%, 38% { opacity: 0; transform: scale(.4); }
    42% { opacity: 1; }
    60%, 100% { opacity: 0; transform: scale(2.2); }
  }
  @keyframes kennisbank-wat-is-ankertekst-oplicht {
    0%, 44% { opacity: 0; }
    54%, 86% { opacity: 1; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .cursor, .in-beeld .ring, .in-beeld .oplicht { animation: none; }
  }
</style>
