---
// Scène voor /seo-emmen/: een zoekresultaat voor "loodgieter Emmen" met kaartje en lijst. In de volledige versie klimt "Jouw bedrijf" van plek 4 naar plek 1.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const rijen = [148, 174, 200, 226];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: zoekresultaten voor loodgieter Emmen, met een kaartje van de stad. Jouw bedrijf klimt van de vierde naar de eerste plek.'}>
  <rect x="40" y="16" width="400" height="240" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <!-- zoekveld -->
  <rect x="62" y="34" width="356" height="34" rx="17" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle class="l" cx="84" cy="50" r="7" />
  <path class="l" d="M89 55l6 6" />
  <text x="104" y="56" font-size="14" font-weight="700">loodgieter Emmen</text>
  <!-- kaartje -->
  <rect x="62" y="80" width="356" height="54" rx="8" fill="#e9eef3" />
  <path d="M62 116c60-14 110 10 170-4s110-20 186-6" stroke="#fff" stroke-width="8" fill="none" />
  <path d="M190 80c8 20-6 36 6 54" stroke="#fff" stroke-width="6" fill="none" />
  <rect x="318" y="88" width="56" height="22" rx="5" fill="#d7e6d8" />
  <g fill="#8aa0b4">
    <path d="M118 100c0-6 4-10 9-10s9 4 9 10c0 7-9 15-9 15s-9-8-9-15z" />
    <path d="M226 96c0-6 4-10 9-10s9 4 9 10c0 7-9 15-9 15s-9-8-9-15z" />
    <path d="M380 106c0-6 4-10 9-10s9 4 9 10c0 7-9 15-9 15s-9-8-9-15z" />
  </g>
  <path d="M284 98c0-8 6-13 12-13s12 5 12 13c0 9-12 19-12 19s-12-10-12-19z" fill="#ff6600" />
  <circle cx="296" cy="98" r="4.5" fill="#fff" />
  <!-- resultaten -->
  {rijen.map((y, i) => (
    <g>
      <text x="70" y={y + 13} font-size="12" font-weight="800" class="zacht">{i + 1}</text>
      <circle cx="96" cy={y + 9} r="7" fill="#e8eef4" />
      <rect x="110" y={y + 2} width={[150, 128, 170, 140][i]} height="7" rx="3" fill="#10283f" opacity="0.8" />
      <rect x="110" y={y + 13} width={[220, 190, 205, 176][i]} height="5" rx="2.5" fill="#d9e1ea" />
    </g>
  ))}

  {!mini && (
    <g>
      <!-- knipperende cursor in het zoekveld -->
      <rect class="knipper" x="236" y="44" width="2" height="16" fill="#10283f" />
      <!-- ring rond de oranje speld -->
      <circle class="ring" cx="296" cy="117" r="9" fill="none" stroke="#ff6600" stroke-width="2" />
      <!-- jouw bedrijf klimt naar plek 1 -->
      <g class="stijger">
        <rect x="58" y="142" width="364" height="26" rx="8" fill="#fff4ec" stroke="#ff6600" stroke-width="2" />
        <text x="70" y="160" font-size="12" font-weight="900" fill="#ff6600" style="fill:#ff6600">1</text>
        <circle cx="96" cy="155" r="7" fill="#ff6600" />
        <text x="110" y="159.5" font-size="12.5" font-weight="800">Jouw bedrijf</text>
        <text x="196" y="159.5" font-size="11" class="zacht">Emmen · nu open</text>
        <rect x="364" y="147" width="48" height="16" rx="8" fill="#074663" />
        <text x="388" y="158.5" text-anchor="middle" font-size="9.5" font-weight="800" style="fill:#fff">Bellen</text>
      </g>
      <g class="label">
        <rect x="352" y="2" width="96" height="26" rx="13" fill="#1f8a5b" />
        <text x="400" y="19.5" text-anchor="middle" font-size="12" font-weight="800" style="fill:#fff">+3 plekken</text>
      </g>
    </g>
  )}
</svg>
<style>
  .ring, .label { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .stijger { transform: translateY(78px); opacity: 0; }
  :global(.teken-js) .label, :global(.teken-js) .ring { opacity: 0; }
  .in-beeld .stijger { animation: seo-emmen-klim 1.6s cubic-bezier(.5,0,.2,1) 0.6s forwards; }
  .in-beeld .label { animation: seo-emmen-label 0.6s cubic-bezier(.3,1.6,.5,1) 2.3s forwards; }
  .in-beeld .ring { animation: seo-emmen-ring 3.2s ease-out 1.2s infinite; }
  .in-beeld .knipper { animation: seo-emmen-knipper 1.1s steps(1) infinite; }
  @keyframes seo-emmen-klim { 0% { transform: translateY(78px); opacity: 0; } 15% { opacity: 1; } 100% { transform: none; opacity: 1; } }
  @keyframes seo-emmen-label { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }
  @keyframes seo-emmen-ring { 0% { opacity: 0.9; transform: scale(0.6); } 70%, 100% { opacity: 0; transform: scale(2.2); } }
  @keyframes seo-emmen-knipper { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .stijger, .in-beeld .label, .in-beeld .ring, .in-beeld .knipper { animation: none; opacity: 1; transform: none; } }
</style>
