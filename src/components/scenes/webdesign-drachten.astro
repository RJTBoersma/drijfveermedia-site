---
// Scène voor /webdesign-drachten/: een werkplaats op een bedrijventerrein stuurt zijn werk over een lopende band naar een website met recente projecten. Er komt een aanvraag binnen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een werkplaats op een bedrijventerrein. Over een lopende band gaat het werk naar een website met recente projecten, en er komt een nieuwe aanvraag binnen.'}>
  <!-- grond -->
  <path class="l" d="M16 222H464" />
  <!-- schoorsteen achter het dak -->
  <rect x="146" y="74" width="14" height="40" rx="2" fill="#d9e1ea" stroke="#074663" stroke-width="2" />
  <!-- werkplaats met sheddak -->
  <path class="v" d="M30 222V130L65 108V130L100 108V130L135 108V130L170 108V222Z" />
  <path class="l" d="M30 222V130L65 108V130L100 108V130L135 108V130L170 108V222Z" />
  <rect x="40" y="142" width="22" height="16" rx="2" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="72" y="142" width="22" height="16" rx="2" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="104" y="142" width="22" height="16" rx="2" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="136" y="142" width="22" height="16" rx="2" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="44" y="172" width="66" height="18" rx="4" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
  <text x="77" y="185" text-anchor="middle" font-size="10" font-weight="800">Jouw bedrijf</text>
  <rect x="124" y="180" width="32" height="42" rx="2" fill="#074663" />
  <!-- lopende band -->
  <path class="l" d="M168 196H300A5 5 0 0 1 300 206H168A5 5 0 0 1 168 196Z" />
  <circle cx="180" cy="201" r="2.5" fill="#074663" />
  <circle cx="210" cy="201" r="2.5" fill="#074663" />
  <circle cx="240" cy="201" r="2.5" fill="#074663" />
  <circle cx="270" cy="201" r="2.5" fill="#074663" />
  <path class="l" d="M186 206V222M290 206V222" />
  <path class="a" d="M305 201C318 201 320 182 320 160" />
  <!-- laptop met de website -->
  <rect x="300" y="40" width="160" height="112" rx="8" fill="#10283f" />
  <rect x="308" y="48" width="144" height="96" rx="4" fill="#fff" />
  <rect x="288" y="152" width="184" height="8" rx="4" fill="#c9d3dd" />
  <text x="316" y="64" font-size="11" font-weight="800">Recente projecten</text>
  <rect x="316" y="72" width="38" height="30" rx="4" fill="#e8eef4" />
  <rect x="361" y="72" width="38" height="30" rx="4" fill="#e8eef4" />
  <rect x="406" y="72" width="38" height="30" rx="4" fill="#e8eef4" />
  <path class="l" d="M322 96l8-10 6 6 6-8 8 12" style="stroke-width:1.5" />
  <circle cx="380" cy="86" r="7" fill="none" stroke="#074663" stroke-width="1.5" />
  <path class="l" d="M412 96h26M412 90h18M412 84h22" style="stroke-width:1.5" />
  <rect x="316" y="108" width="30" height="4" rx="2" fill="#d9e1ea" />
  <rect x="361" y="108" width="30" height="4" rx="2" fill="#d9e1ea" />
  <rect x="406" y="108" width="30" height="4" rx="2" fill="#d9e1ea" />
  <rect class="o" x="316" y="122" width="62" height="15" rx="7.5" />
  <text x="347" y="133" text-anchor="middle" font-size="9" font-weight="800" style="fill:#fff">Offerte</text>
  {!mini && (
    <g>
      <g class="wdd-doos wdd-doos-1"><rect x="166" y="182" width="16" height="13" rx="2" fill="#ff6600" /></g>
      <g class="wdd-doos wdd-doos-2"><rect x="166" y="182" width="16" height="13" rx="2" fill="#074663" /></g>
      <g class="wdd-doos wdd-doos-3"><rect x="166" y="182" width="16" height="13" rx="2" fill="#8aa0b4" /></g>
      <path class="wdd-rook" d="M153 70c-6-8 6-12 0-20" fill="none" stroke="#d9e1ea" stroke-width="3" stroke-linecap="round" />
      <g class="wdd-cursor" transform="translate(368 128)">
        <path d="M0 0l0 16 4.5-4 3 7 3-1.4-3-6.8 6-.4z" fill="#10283f" stroke="#fff" stroke-width="1.2" />
      </g>
      <g class="wdd-melding">
        <rect x="344" y="172" width="126" height="30" rx="9" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
        <circle cx="361" cy="187" r="8" fill="#1f8a5b" />
        <path d="M357 187l3 3 5-6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="375" y="191" font-size="11" font-weight="800">Nieuwe aanvraag</text>
      </g>
    </g>
  )}
</svg>
<style>
  .wdd-doos { transform-box: view-box; }
  .wdd-cursor { transform: translate(368px, 128px); }
  :global(.teken-js) .wdd-doos, :global(.teken-js) .wdd-melding { opacity: 0; }
  :global(.teken-js) .wdd-cursor { transform: translate(430px, 92px); opacity: 0; }
  .in-beeld .wdd-doos { animation: webdesign-drachten-band 4.5s linear infinite; }
  .in-beeld .wdd-doos-2 { animation-delay: -1.5s; }
  .in-beeld .wdd-doos-3 { animation-delay: -3s; }
  .in-beeld .wdd-rook { animation: webdesign-drachten-rook 3.2s ease-in-out infinite; }
  .in-beeld .wdd-cursor { animation: webdesign-drachten-cursor 6s ease-in-out 0.8s infinite both; }
  .in-beeld .wdd-melding { animation: webdesign-drachten-melding 6s ease-in-out 0.8s infinite both; }
  @keyframes webdesign-drachten-band {
    0% { transform: translateX(0); opacity: 0; }
    10%, 82% { opacity: 1; }
    100% { transform: translateX(124px); opacity: 0; }
  }
  @keyframes webdesign-drachten-rook {
    0%, 100% { transform: translateY(0); opacity: 0.2; }
    50% { transform: translateY(-6px); opacity: 1; }
  }
  @keyframes webdesign-drachten-cursor {
    0% { transform: translate(430px, 92px); opacity: 0; }
    10% { opacity: 1; }
    35% { transform: translate(368px, 128px); }
    40% { transform: translate(368px, 128px) scale(0.85); }
    45%, 85% { transform: translate(368px, 128px); opacity: 1; }
    100% { transform: translate(368px, 128px); opacity: 0; }
  }
  @keyframes webdesign-drachten-melding {
    0%, 42% { opacity: 0; transform: translateY(8px); }
    50%, 88% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .wdd-doos, .in-beeld .wdd-rook, .in-beeld .wdd-cursor, .in-beeld .wdd-melding { animation: none; }
  }
</style>
