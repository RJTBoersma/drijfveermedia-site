---
// Scène voor /kennisbank/gidsen/wat-is-branding/: doelgroep, USP en waarden komen samen in het hoofd van een klant. Daar ontstaat het beeld van jouw merk.
// Als hij leeft: drie lijnen tekenen zich van de kaartjes naar het hoofd, het merkteken verschijnt in de gedachtewolk en een hartje klopt rustig.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const kaarten = [
  { y: 34, label: 'Doelgroep' },
  { y: 108, label: 'USP' },
  { y: 182, label: 'Waarden' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: drie kaartjes met doelgroep, USP en waarden. Lijnen lopen naar het hoofd van een klant, met daarboven een gedachtewolk waarin jouw merk en een hartje verschijnen.'}>
  <!-- drie bouwstenen -->
  {kaarten.map((k) => (
    <g>
      <rect x="26" y={k.y} width="150" height="54" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <circle cx="52" cy={k.y + 27} r="14" class="v" />
      <text x="76" y={k.y + 32} font-size="14" font-weight="800">{k.label}</text>
    </g>
  ))}
  <!-- iconen in de kaartjes -->
  <path class="l" d="M46 58a6 6 0 1 1 12 0a6 6 0 1 1-12 0M44 72c2-5 5-7 8-7s6 2 8 7" />
  <path d="M52 125l3.2 6.4 7 1-5.1 5 1.2 7-6.3-3.3-6.3 3.3 1.2-7-5.1-5 7-1z" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
  <path class="l" d="M52 216c-7-5-10-9-10-13a5 5 0 0 1 10-1a5 5 0 0 1 10 1c0 4-3 8-10 13z" />

  <!-- hoofd van de klant, kijkt naar links -->
  <path d="M410 252v-34c16-10 26-28 26-50c0-36-28-62-64-62c-34 0-60 26-60 58c0 5 1 10 2 14l-14 22c-2 4 0 7 4 7h10v16c0 8 6 13 14 13h18v16z" fill="#e8eef4" stroke="#074663" stroke-width="2.5" stroke-linejoin="round" />
  <circle cx="350" cy="152" r="3.5" fill="#074663" />
  <!-- gedachtewolk -->
  <circle cx="356" cy="98" r="5" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="344" cy="84" r="7" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="236" y="14" width="184" height="60" rx="30" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="276" cy="44" r="20" fill="#074663" />
  <text x="274" y="52" text-anchor="middle" font-size="22" font-weight="900" style="fill:#fff">J</text>
  <circle cx="284" cy="51" r="3.5" fill="#ff6600" />
  <rect x="306" y="34" width="52" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="306" y="48" width="36" height="7" rx="3.5" fill="#d9e1ea" />

  {!mini && (
    <g>
      <g fill="none" stroke="#8aa0b4" stroke-width="2" stroke-linecap="round" stroke-dasharray="1">
        <path class="wib-lijn" style="--i:0" d="M178 61C240 66 270 110 300 140" pathLength="1" />
        <path class="wib-lijn" style="--i:1" d="M178 135C230 135 268 150 300 158" pathLength="1" />
        <path class="wib-lijn" style="--i:2" d="M178 209C236 206 272 190 302 176" pathLength="1" />
      </g>
      <g class="wib-hart"><path d="M394 56c-9-6-13-11-13-16a6.5 6.5 0 0 1 13-1.5a6.5 6.5 0 0 1 13 1.5c0 5-4 10-13 16z" fill="#ff6600" /></g>
      <circle class="wib-ring" cx="276" cy="44" r="20" fill="none" stroke="#ff6600" stroke-width="2.5" />
    </g>
  )}
</svg>
<style>
  .wib-lijn { stroke-dasharray: 1; }
  .wib-hart, .wib-ring { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .wib-lijn { stroke-dashoffset: 1; }
  :global(.teken-js) .wib-hart, :global(.teken-js) .wib-ring { opacity: 0; }
  .in-beeld .wib-lijn { animation: kennisbank-gidsen-wat-is-branding-lijn 0.8s cubic-bezier(.6,.1,.3,1) calc(0.4s + var(--i) * 0.3s) forwards; }
  .in-beeld .wib-ring { animation: kennisbank-gidsen-wat-is-branding-ring 1.2s ease-out 1.6s forwards; }
  .in-beeld .wib-hart { animation: kennisbank-gidsen-wat-is-branding-hart 4s ease-in-out 2s infinite both; }
  @keyframes kennisbank-gidsen-wat-is-branding-lijn { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-gidsen-wat-is-branding-ring { 0% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.6); } }
  @keyframes kennisbank-gidsen-wat-is-branding-hart { 0% { opacity: 0; transform: scale(0.4); } 12% { opacity: 1; transform: scale(1.15); } 20%, 34% { opacity: 1; transform: scale(1); } 42% { transform: scale(1.12); } 50%, 85% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0.8); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .wib-lijn, .in-beeld .wib-ring, .in-beeld .wib-hart { animation: none; } }
</style>
