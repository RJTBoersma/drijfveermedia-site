---
// Scène voor /kennisbank/gidsen/seo-teksten-schrijven/: een pagina met heldere koppen wordt geschreven; AI levert een eerste opzet en een checklist laat zien wat de mens controleert.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een pagina met een titel, koppen en alinea\'s wordt met een pen geschreven. Links een AI-ballon met een eerste opzet, rechts een checklist die stap voor stap wordt afgevinkt.'}>
  <!-- AI-ballon -->
  <rect x="20" y="58" width="118" height="62" rx="12" fill="#e8eef4" />
  <path d="M120 120l14 16-2-16z" fill="#e8eef4" />
  <path d="M38 70l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" fill="#ff6600" />
  <text x="52" y="82" font-size="11" font-weight="800">AI: opzet</text>
  <rect x="32" y="94" width="92" height="6" rx="3" fill="#c9d3dd" />
  <rect x="32" y="106" width="64" height="6" rx="3" fill="#c9d3dd" />

  <!-- de pagina -->
  <rect x="150" y="22" width="196" height="232" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="170" y="42" width="140" height="13" rx="4" fill="#10283f" />
  <rect x="170" y="68" width="156" height="6" rx="3" fill="#d9e1ea" />
  <rect x="170" y="80" width="144" height="6" rx="3" fill="#d9e1ea" />
  <rect x="170" y="92" width="120" height="6" rx="3" fill="#d9e1ea" />
  <rect x="170" y="112" width="104" height="9" rx="3" fill="#074663" />
  <rect x="170" y="130" width="156" height="6" rx="3" fill="#d9e1ea" />
  <rect x="170" y="142" width="136" height="6" rx="3" fill="#d9e1ea" />
  <rect x="170" y="162" width="92" height="9" rx="3" fill="#074663" />
  <rect x="170" y="180" width="150" height="6" rx="3" fill="#d9e1ea" />
  <rect x="170" y="192" width="70" height="6" rx="3" fill="#d9e1ea" />
  <rect x="170" y="222" width="64" height="16" rx="8" fill="#ff6600" />

  <!-- checklist -->
  <rect x="356" y="62" width="114" height="132" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="368" y="82" font-size="11" font-weight="800">Nagelopen</text>
  <circle cx="370" cy="102" r="6" fill="none" stroke="#d9e1ea" stroke-width="2" />
  <text x="382" y="106" font-size="10">Zoekwoord</text>
  <circle cx="370" cy="126" r="6" fill="none" stroke="#d9e1ea" stroke-width="2" />
  <text x="382" y="130" font-size="10">Vraag beantwoord</text>
  <circle cx="370" cy="150" r="6" fill="none" stroke="#d9e1ea" stroke-width="2" />
  <text x="382" y="154" font-size="10">Eigen voorbeeld</text>
  <circle cx="370" cy="174" r="6" fill="none" stroke="#d9e1ea" stroke-width="2" />
  <text x="382" y="178" font-size="10">Hardop gelezen</text>

  <!-- pen -->
  <g transform="translate(250 198)">
    <g class="pen">
      <path d="M0 0l4-14 40-40 10 10-40 40z" fill="#074663" />
      <path class="o" d="M0 0l4-14 10 10z" />
    </g>
  </g>

  {!mini && (
    <g>
      <path class="regel" d="M243 195H322" fill="none" stroke="#d9e1ea" stroke-width="6" stroke-linecap="round" pathLength="1" />
      <path class="pijl" d="M140 92C150 92 152 86 162 84" fill="none" stroke="#ff6600" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 4" />
      <g class="vink vink-1"><circle cx="370" cy="102" r="6" fill="#1a7a50" /><path d="M367 102l2 2 4-4.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="vink vink-2"><circle cx="370" cy="126" r="6" fill="#1a7a50" /><path d="M367 126l2 2 4-4.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="vink vink-3"><circle cx="370" cy="150" r="6" fill="#1a7a50" /><path d="M367 150l2 2 4-4.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="vink vink-4"><circle cx="370" cy="174" r="6" fill="#1a7a50" /><path d="M367 174l2 2 4-4.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></g>
    </g>
  )}
</svg>
<style>
  .regel { stroke-dasharray: 1; }
  .pen { transform-box: view-box; }
  .vink { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .regel { stroke-dashoffset: 1; }
  :global(.teken-js) .vink, :global(.teken-js) .pijl { opacity: 0; }
  .in-beeld .pijl { animation: kennisbank--gidsen--seo-teksten-schrijven-toon 0.6s ease 0.4s forwards; }
  .in-beeld .regel { animation: kennisbank--gidsen--seo-teksten-schrijven-trek 1.4s ease-in-out 0.8s forwards; }
  .in-beeld .pen { animation: kennisbank--gidsen--seo-teksten-schrijven-schrijf 5s ease-in-out 0.8s infinite; }
  .in-beeld .vink-1 { animation: kennisbank--gidsen--seo-teksten-schrijven-pop 0.45s cubic-bezier(.3,1.6,.5,1) 1.6s forwards; }
  .in-beeld .vink-2 { animation: kennisbank--gidsen--seo-teksten-schrijven-pop 0.45s cubic-bezier(.3,1.6,.5,1) 2s forwards; }
  .in-beeld .vink-3 { animation: kennisbank--gidsen--seo-teksten-schrijven-pop 0.45s cubic-bezier(.3,1.6,.5,1) 2.4s forwards; }
  .in-beeld .vink-4 { animation: kennisbank--gidsen--seo-teksten-schrijven-pop 0.45s cubic-bezier(.3,1.6,.5,1) 2.8s forwards; }
  @keyframes kennisbank--gidsen--seo-teksten-schrijven-toon { to { opacity: 1; } }
  @keyframes kennisbank--gidsen--seo-teksten-schrijven-trek { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank--gidsen--seo-teksten-schrijven-pop { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank--gidsen--seo-teksten-schrijven-schrijf { 0%, 100% { transform: translate(-8px, 0); } 25% { transform: translate(14px, -2px); } 50% { transform: translate(40px, 0); } 75% { transform: translate(20px, -2px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .pijl, .in-beeld .regel, .in-beeld .pen, .in-beeld .vink-1, .in-beeld .vink-2, .in-beeld .vink-3, .in-beeld .vink-4 { animation: none; } }
</style>
