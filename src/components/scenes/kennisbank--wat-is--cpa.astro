---
// Scène voor /kennisbank/wat-is/cpa/: links een bonnetje van een campagne (€ 800 kosten, 16 aanvragen, CPA € 50),
// rechts een meetlat van € 0 tot de maximale CPA van € 180, met de huidige CPA laag in de lat en de ruimte erboven.
// Als hij leeft: er vallen telkens aanvragen (envelopjes) op het bonnetje, de balk loopt op tot € 50 en de ruimte licht op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een campagne kost 800 euro en levert 16 aanvragen op, dus een CPA van 50 euro. Een meetlat ernaast loopt tot het maximum van 180 euro per aanvraag, zodat er 130 euro ruimte over is.'}>
  <!-- bonnetje -->
  <path d="M24 26h224v198l-14 10-14-10-14 10-14-10-14 10-14-10-14 10-14-10-14 10-14-10-14 10-14-10-14 10-14-10-14 10-14-10V26z" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-linejoin="round" />
  <text x="46" y="54" font-size="12" font-weight="800" class="zacht">Campagne oktober</text>
  <text x="46" y="88" font-size="13" font-weight="700">Kosten</text>
  <text x="230" y="88" font-size="13" font-weight="800" text-anchor="end">€ 800</text>
  <text x="46" y="118" font-size="13" font-weight="700">Aanvragen</text>
  <rect x="160" y="105" width="20" height="14" rx="2" fill="#fff" stroke="#074663" stroke-width="2" />
  <path d="M160 106l10 7 10-7" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
  <text x="230" y="118" font-size="13" font-weight="800" text-anchor="end">÷ 16</text>
  <path d="M46 136h184" stroke="#10283f" stroke-width="2" stroke-dasharray="4 4" />
  <text x="46" y="174" font-size="13" font-weight="800">CPA</text>
  <text x="230" y="178" font-size="30" font-weight="800" text-anchor="end">€ 50</text>
  <text x="230" y="200" font-size="11" font-weight="700" text-anchor="end" class="zacht">per aanvraag</text>

  <!-- meetlat -->
  <rect x="276" y="26" width="180" height="218" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="300" y="60" width="34" height="160" rx="8" fill="#e8eef4" />
  <rect x="300" y="176" width="34" height="44" rx="8" fill="#074663" />
  <path d="M292 60h50" stroke="#ff6600" stroke-width="3" stroke-dasharray="6 4" stroke-linecap="round" />
  <text x="350" y="56" font-size="12" font-weight="800">max € 180</text>
  <text x="350" y="194" font-size="12" font-weight="800">nu € 50</text>
  <path d="M346 70v96" stroke="#1f8a5b" stroke-width="2" />
  <path d="M342 70h8M342 166h8" stroke="#1f8a5b" stroke-width="2" stroke-linecap="round" />
  <text x="358" y="114" font-size="11" font-weight="700" class="zacht">ruimte</text>
  <text x="358" y="130" font-size="13" font-weight="800">€ 130</text>
  <text x="317" y="236" font-size="10" font-weight="700" text-anchor="middle" class="zacht">€ 0</text>

  {!mini && (
    <g>
      <rect class="cpa-vul" x="300" y="176" width="34" height="44" rx="8" fill="#ff6600" />
      <g class="cpa-post cpa-p1"><rect x="160" y="70" width="20" height="14" rx="2" fill="#ffd2b0" stroke="#ff6600" stroke-width="2" /><path d="M160 71l10 7 10-7" fill="none" stroke="#ff6600" stroke-width="2" stroke-linejoin="round" /></g>
      <g class="cpa-post cpa-p2"><rect x="160" y="70" width="20" height="14" rx="2" fill="#ffd2b0" stroke="#ff6600" stroke-width="2" /><path d="M160 71l10 7 10-7" fill="none" stroke="#ff6600" stroke-width="2" stroke-linejoin="round" /></g>
      <rect class="cpa-ruimte" x="340" y="66" width="80" height="104" rx="8" fill="#1f8a5b" fill-opacity="0.12" />
      <g class="cpa-vink"><circle cx="430" cy="190" r="10" fill="#1f8a5b" /><path d="M425 190l3.5 3.5 6.5-7" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
    </g>
  )}
</svg>
<style>
  .cpa-vul { transform-box: fill-box; transform-origin: center bottom; }
  .cpa-vink { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .cpa-vul { transform: scaleY(0); }
  :global(.teken-js) .cpa-post, :global(.teken-js) .cpa-vink, :global(.teken-js) .cpa-ruimte { opacity: 0; }
  .in-beeld .cpa-vul { animation: kennisbank-wat-is-cpa-vul 1.2s cubic-bezier(.4,0,.2,1) 0.5s forwards; }
  .in-beeld .cpa-vink { animation: kennisbank-wat-is-cpa-pop 0.5s cubic-bezier(.3,1.6,.5,1) 1.7s forwards; }
  .in-beeld .cpa-post { animation: kennisbank-wat-is-cpa-post 4s ease-in 0.8s infinite; }
  .in-beeld .cpa-p2 { animation-delay: 2.8s; }
  .in-beeld .cpa-ruimte { animation: kennisbank-wat-is-cpa-ruimte 4s ease-in-out 2s infinite; }
  @keyframes kennisbank-wat-is-cpa-vul { to { transform: none; } }
  @keyframes kennisbank-wat-is-cpa-pop { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-wat-is-cpa-post { 0% { opacity: 0; transform: translateY(-14px); } 15% { opacity: 1; } 45% { opacity: 1; transform: translateY(35px); } 55%, 100% { opacity: 0; transform: translateY(35px); } }
  @keyframes kennisbank-wat-is-cpa-ruimte { 0%, 100% { opacity: 0; } 40%, 60% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .cpa-vul, .in-beeld .cpa-vink, .in-beeld .cpa-post, .in-beeld .cpa-ruimte { animation: none; } }
</style>
