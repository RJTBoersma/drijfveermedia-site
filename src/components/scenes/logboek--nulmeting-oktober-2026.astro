---
// Scène voor /logboek/nulmeting-oktober-2026/: klikken uit Google (Search Console), juli 2025 tot de nulmeting.
import { getEntry } from 'astro:content';
import Groeilijn from '../beeld/Groeilijn.astro';
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const e = await getEntry('logboek', 'nulmeting-oktober-2026');
const punten = (e?.data.historie ?? []) as [string, number][];
---
<Groeilijn punten={punten} mini={mini} id={mini ? 'nulmeting-mini' : 'nulmeting'} label="Klikken uit Google per maand volgens Search Console, juli 2025 tot september 2026" />
