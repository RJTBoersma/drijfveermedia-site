---
// Scène voor /linkbuilding/: drie passende websites (branchesite, lokale krant, leverancier) linken naar jouw site.
// Over de links lopen signalen naar jouw site, het lijntje in je site stijgt en er verschijnt een melding met posities.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const bronnen = [
  { y: 26, naam: 'Branchesite', d: 'M156 54C212 54 220 106 268 112' },
  { y: 107, naam: 'Lokale krant', d: 'M156 135C204 135 226 134 268 134' },
  { y: 188, naam: 'Leverancier', d: 'M156 216C212 216 220 162 268 156' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een branchesite, een lokale krant en een leverancier linken naar jouw website. Over de links lopen signalen naar je site, de lijn in je site stijgt en er verschijnt een melding: zes posities hoger.'}>
  {bronnen.map((b) => (
    <g>
      <rect x="24" y={b.y} width="132" height="56" rx="9" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <circle cx="37" cy={b.y + 12} r="3" fill="#d9e1ea" />
      <circle cx="47" cy={b.y + 12} r="3" fill="#d9e1ea" />
      <text x="36" y={b.y + 33} font-size="12.5" font-weight="800">{b.naam}</text>
      <rect class="v" x="36" y={b.y + 40} width="78" height="6" rx="3" />
      <path class="a" d={b.d} />
      <circle class="o" cx="156" cy={b.y + 28} r="4.5" />
    </g>
  ))}
  <rect x="268" y="58" width="188" height="150" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M268 84h188" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="282" cy="71" r="4" fill="#d9e1ea" />
  <circle cx="294" cy="71" r="4" fill="#d9e1ea" />
  <circle cx="306" cy="71" r="4" fill="#ff6600" />
  <text x="284" y="110" font-size="16" font-weight="900">Jouw bedrijf</text>
  <rect class="v" x="284" y="120" width="124" height="8" rx="4" />
  <rect class="v" x="284" y="134" width="92" height="8" rx="4" />
  <rect x="284" y="154" width="68" height="22" rx="7" fill="#074663" />
  <path d="M378 192h62M378 192v-40" stroke="#d9e1ea" stroke-width="2" fill="none" stroke-linecap="round" />
  <path d="M380 186l14-6 14 3 14-12 16-11" stroke="#d9e1ea" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="268" cy="112" r="3.5" fill="#074663" />
  <circle cx="268" cy="134" r="3.5" fill="#074663" />
  <circle cx="268" cy="156" r="3.5" fill="#074663" />
  <rect x="292" y="222" width="140" height="28" rx="14" fill="#e8eef4" />
  <text x="362" y="241" text-anchor="middle" font-size="12" font-weight="800">Vertrouwen in Google</text>
  {!mini && (
    <g>
      {bronnen.map((b, i) => (
        <path class="linkbuilding-puls" fill="none" d={b.d} pathLength="1" style={`animation-delay:${1.2 + i * 0.7}s`} />
      ))}
      <path class="linkbuilding-stijg" fill="none" d="M380 186l14-6 14 3 14-12 16-11" pathLength="1" />
      <g class="linkbuilding-melding">
        <rect x="306" y="12" width="152" height="34" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
        <circle cx="326" cy="29" r="10" fill="#1a7a50" />
        <path d="M326 34v-10M321 28l5-5 5 5" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="344" y="34" font-size="12.5" font-weight="800">6 posities hoger</text>
      </g>
    </g>
  )}
</svg>
<style>
  .linkbuilding-puls { fill: none; stroke: #074663; stroke-width: 6; stroke-linecap: round; stroke-dasharray: 0.03 0.97; stroke-dashoffset: 0.03; }
  :global(.teken-js) .linkbuilding-puls { opacity: 0; }
  .in-beeld .linkbuilding-puls { animation: linkbuilding-puls 2.1s ease-in-out infinite; }
  .linkbuilding-stijg { fill: none; stroke: #ff6600; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }
  :global(.teken-js) .linkbuilding-stijg { stroke-dashoffset: 1; }
  .in-beeld .linkbuilding-stijg { animation: linkbuilding-stijg 1.6s cubic-bezier(.6,.1,.3,1) 1.4s forwards; }
  .linkbuilding-melding { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .linkbuilding-melding { opacity: 0; }
  .in-beeld .linkbuilding-melding { animation: linkbuilding-melding 6s ease-in-out 2.6s infinite both; }
  @keyframes linkbuilding-puls {
    0% { stroke-dashoffset: 0.03; opacity: 0; }
    10% { opacity: 1; }
    85% { opacity: 1; }
    100% { stroke-dashoffset: -0.97; opacity: 0; }
  }
  @keyframes linkbuilding-stijg { to { stroke-dashoffset: 0; } }
  @keyframes linkbuilding-melding {
    0% { opacity: 0; transform: translateY(10px) scale(0.9); }
    12%, 82% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .linkbuilding-puls, .in-beeld .linkbuilding-stijg, .in-beeld .linkbuilding-melding { animation: none; }
  }
</style>
