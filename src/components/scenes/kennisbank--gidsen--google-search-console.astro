---
// Scène voor /kennisbank/gidsen/google-search-console/: een dashboard met een URL-inspectiebalk, drie tegels en een grafiek met klikken en vertoningen.
// Als hij leeft: de inspectie meldt dat de URL op Google staat en een meetlijn schuift rustig over de grafiek.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const menu = [62, 84, 106, 128, 150];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: een dashboard met een balk om een URL te inspecteren, tegels voor klikken, vertoningen en positie, en een grafiek die stijgt.'} aria-hidden={mini ? 'true' : undefined}>
  <rect x="30" y="20" width="420" height="230" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M44 20h392a14 14 0 0 1 14 14v12H30V34a14 14 0 0 1 14-14z" fill="#e8eef4" />
  <circle cx="48" cy="33" r="4" fill="#d9e1ea" /><circle cx="60" cy="33" r="4" fill="#d9e1ea" /><circle cx="72" cy="33" r="4" fill="#d9e1ea" />

  <!-- menu -->
  <path d="M110 46v204" stroke="#e8eef4" stroke-width="2" />
  {menu.map((y, i) => <rect x="42" y={y} width={i === 0 ? 56 : 48 - (i % 2) * 10} height="9" rx="4.5" fill={i === 0 ? '#ffd2b0' : '#e8eef4'} />)}

  <!-- inspectiebalk -->
  <rect x="124" y="58" width="314" height="24" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="139" cy="70" r="5" fill="none" stroke="#074663" stroke-width="2" />
  <path d="M142.5 73.5l4 4" stroke="#074663" stroke-width="2" stroke-linecap="round" />
  <text x="154" y="74" font-size="11" class="zacht">jouwbedrijf.nl/diensten/</text>

  <!-- tegels -->
  <rect x="124" y="92" width="98" height="40" rx="8" fill="#074663" />
  <text x="134" y="107" font-size="9.5" style="fill:#fff">Klikken</text>
  <text x="134" y="125" font-size="15" font-weight="900" style="fill:#fff">1.204</text>
  <rect x="230" y="92" width="98" height="40" rx="8" fill="#e8eef4" />
  <text x="240" y="107" font-size="9.5" class="zacht">Vertoningen</text>
  <text x="240" y="125" font-size="15" font-weight="900">38.610</text>
  <rect x="336" y="92" width="102" height="40" rx="8" fill="#e8eef4" />
  <text x="346" y="107" font-size="9.5" class="zacht">Gem. positie</text>
  <text x="346" y="125" font-size="15" font-weight="900">8,4</text>

  <!-- grafiek -->
  <path d="M128 236h310M128 206h310M128 176h310" stroke="#eef2f6" stroke-width="1.5" />
  <path d="M132 216C160 208 176 212 200 200S240 188 262 192S304 172 330 170S380 152 430 146" fill="none" stroke="#074663" stroke-width="2.5" stroke-linecap="round" />
  <path d="M132 230C160 228 180 226 204 222S244 216 266 214S310 202 334 200S384 186 430 176" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />

  {!mini && (
    <g>
      <g class="meetlijn"><path d="M140 142v96" stroke="#10283f" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.5" /><circle cx="140" cy="142" r="3.5" fill="#10283f" /></g>
      <g class="gevonden"><rect x="318" y="61" width="116" height="18" rx="9" fill="#1a7a50" /><path d="M327 70l3 3 6-6" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /><text x="341" y="74" font-size="10" font-weight="800" style="fill:#fff">Staat op Google</text></g>
    </g>
  )}
</svg>
<style>
  .gevonden { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .gevonden { opacity: 0; }
  .in-beeld .gevonden { animation: kennisbank-gidsen-google-search-console-pop 0.5s cubic-bezier(.3,1.6,.5,1) 1s forwards; }
  :global(.teken-js) .meetlijn { opacity: 0; }
  .in-beeld .meetlijn { animation: kennisbank-gidsen-google-search-console-meet 7s ease-in-out 1.6s infinite; }
  @keyframes kennisbank-gidsen-google-search-console-pop { from { opacity: 0; transform: scale(0.5); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-google-search-console-meet { 0% { opacity: 0; transform: translateX(0); } 8% { opacity: 1; } 50% { transform: translateX(280px); } 92% { opacity: 1; } 100% { opacity: 0; transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .gevonden, .in-beeld .meetlijn { animation: none; } }
</style>
