---
// Scène voor /webdesign-hoogeveen/: een kassabon met wat er bij je website inbegrepen is, naast een telefoon met de site die live staat en een plaatsnaambord Hoogeveen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const regels = [
  { y: 66, tekst: 'Ontwerp' },
  { y: 94, tekst: 'Teksten' },
  { y: 122, tekst: 'Contactpagina' },
  { y: 150, tekst: 'Mobiel en snel' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een kassabon met ontwerp, teksten, contactpagina en een mobiele site, totaal vanaf 250 euro. Ernaast een telefoon met de website die live staat, en een plaatsnaambord Hoogeveen.'}>
  <!-- kassabon -->
  <path d="M52 24H208V230 L195 238 L182 230 L169 238 L156 230 L143 238 L130 230 L117 238 L104 230 L91 238 L78 230 L65 238 L52 230Z" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-linejoin="round" />
  <text x="130" y="46" text-anchor="middle" font-size="11" font-weight="800" letter-spacing="1.5" class="zacht">JOUW WEBSITE</text>
  {regels.map((r) => (
    <g>
      <text x="68" y={r.y + 4} font-size="12.5" font-weight="700">{r.tekst}</text>
      <circle cx="186" cy={r.y} r="8" fill="none" stroke="#d9e1ea" stroke-width="2" />
    </g>
  ))}
  <path d="M66 172h128" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="4 4" />
  <text x="68" y="196" font-size="11" class="zacht">Totaal, eenmalig</text>
  <text x="68" y="218" font-size="19" font-weight="900">vanaf € 250</text>
  <!-- telefoon met de site -->
  <rect x="268" y="34" width="104" height="200" rx="18" fill="#10283f" />
  <rect x="276" y="46" width="88" height="176" rx="11" fill="#fff" />
  <rect x="284" y="56" width="30" height="6" rx="3" fill="#074663" />
  <rect x="284" y="78" width="70" height="8" rx="3" fill="#10283f" />
  <rect x="284" y="92" width="58" height="8" rx="3" fill="#10283f" />
  <rect x="284" y="108" width="68" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="284" y="117" width="52" height="5" rx="2.5" fill="#d9e1ea" />
  <rect class="v" x="284" y="132" width="72" height="44" rx="5" />
  <path class="l" d="M292 168l14-16 10 10 8-7 12 13" />
  <circle class="o" cx="342" cy="146" r="5" />
  <rect x="284" y="188" width="72" height="22" rx="7" fill="#ff6600" />
  <text x="320" y="203" text-anchor="middle" font-size="10.5" font-weight="800" style="fill:#fff">Bellen</text>
  <!-- plaatsnaambord -->
  <path d="M432 206v32" stroke="#8aa0b4" stroke-width="4" stroke-linecap="round" />
  <rect x="388" y="176" width="88" height="32" rx="5" fill="#074663" stroke="#fff" stroke-width="2" />
  <text x="432" y="197" text-anchor="middle" font-size="12.5" font-weight="800" style="fill:#fff">Hoogeveen</text>

  {!mini && (
    <g>
      <!-- vinkjes één voor één -->
      {regels.map((r, i) => (
        <g class="vinkje" style={`animation-delay:${0.5 + i * 0.35}s`}>
          <circle cx="186" cy={r.y} r="8" fill="#1f8a5b" />
          <path d={`M182 ${r.y}l3 3 5-6`} fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
      <!-- de site staat live -->
      <g class="live">
        <rect x="330" y="20" width="62" height="24" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
        <circle class="hartslag" cx="345" cy="32" r="4.5" fill="#1f8a5b" />
        <text x="356" y="36.5" font-size="11" font-weight="800">Live</text>
      </g>
    </g>
  )}
</svg>
<style>
  .vinkje, .hartslag, .live { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .vinkje { opacity: 0; transform: scale(0.4); }
  :global(.teken-js) .live { opacity: 0; transform: translateY(6px); }
  .in-beeld .vinkje { animation: webdesign-hoogeveen-vink 0.45s cubic-bezier(.3,1.6,.5,1) forwards; }
  .in-beeld .live { animation: webdesign-hoogeveen-live 0.5s ease 2.2s forwards; }
  .in-beeld .hartslag { animation: webdesign-hoogeveen-hart 3.2s ease-in-out 2.8s infinite; }
  @keyframes webdesign-hoogeveen-vink { to { opacity: 1; transform: none; } }
  @keyframes webdesign-hoogeveen-live { to { opacity: 1; transform: none; } }
  @keyframes webdesign-hoogeveen-hart { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.5); opacity: 0.45; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .vinkje, .in-beeld .live, .in-beeld .hartslag { animation: none; opacity: 1; transform: none; } }
</style>
