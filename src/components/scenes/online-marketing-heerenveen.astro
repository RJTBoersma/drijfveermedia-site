---
// Scène voor /online-marketing-heerenveen/: een scorebord langs het veld. Niet de likes, maar de aanvragen staan erop: vorige maand en deze maand.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een scorebord langs een sportveld. Op het bord staan de aanvragen van vorige maand en deze maand, en het getal van deze maand springt omhoog. Een voorbeeld.'}>
  <!-- veld -->
  <rect x="20" y="206" width="440" height="44" rx="10" fill="#d7e6d8" />
  <path d="M240 208v40" stroke="#fff" stroke-width="2.5" />
  <ellipse cx="240" cy="228" rx="34" ry="12" fill="none" stroke="#fff" stroke-width="2.5" />
  <!-- palen -->
  <path class="l" d="M160 176V210M320 176V210" style="stroke-width:5" />
  <!-- scorebord -->
  <rect x="84" y="26" width="312" height="152" rx="14" fill="#10283f" />
  <text x="240" y="54" text-anchor="middle" font-size="13" font-weight="800" style="fill:#fff">Aanvragen via je website</text>
  <rect x="104" y="68" width="128" height="78" rx="8" fill="#1d3a55" />
  <rect x="248" y="68" width="128" height="78" rx="8" fill="#1d3a55" />
  <text x="168" y="86" text-anchor="middle" font-size="10" font-weight="700" style="fill:#c9d3dd">Vorige maand</text>
  <text x="312" y="86" text-anchor="middle" font-size="10" font-weight="700" style="fill:#c9d3dd">Deze maand</text>
  <text x="168" y="134" text-anchor="middle" font-size="42" font-weight="900" style="fill:#fff">7</text>
  <text x="312" y="134" text-anchor="middle" font-size="42" font-weight="900" style="fill:#ff6600">12</text>
  <g fill="#2b4a63">
    <circle cx="200" cy="162" r="5" /><circle cx="220" cy="162" r="5" /><circle cx="240" cy="162" r="5" /><circle cx="260" cy="162" r="5" /><circle cx="280" cy="162" r="5" />
  </g>
  <text x="380" y="194" text-anchor="end" font-size="10" class="zacht">voorbeeld</text>
  <!-- vlag in de hoek -->
  <path class="l" d="M36 210V170" style="stroke-width:2" />
  <path class="o" d="M37 170l18 6-18 6z" />
  {!mini && (
    <g>
      <g class="omh-oud">
        <rect x="256" y="96" width="112" height="46" rx="6" fill="#1d3a55" />
        <text x="312" y="134" text-anchor="middle" font-size="42" font-weight="900" style="fill:#fff">9</text>
      </g>
      <g class="omh-pijl">
        <circle cx="372" cy="70" r="13" fill="#1a7a50" />
        <path d="M372 77V63M366 69l6-6 6 6" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <g fill="#ff6600">
        <circle class="omh-lamp omh-lamp-1" cx="200" cy="162" r="5" />
        <circle class="omh-lamp omh-lamp-2" cx="220" cy="162" r="5" />
        <circle class="omh-lamp omh-lamp-3" cx="240" cy="162" r="5" />
        <circle class="omh-lamp omh-lamp-4" cx="260" cy="162" r="5" />
        <circle class="omh-lamp omh-lamp-5" cx="280" cy="162" r="5" />
      </g>
    </g>
  )}
</svg>
<style>
  .omh-oud, .omh-lamp { opacity: 0; }
  .omh-pijl { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .omh-oud { opacity: 1; }
  :global(.teken-js) .omh-pijl { opacity: 0; transform: scale(0.4); }
  .in-beeld .omh-oud { animation: online-marketing-heerenveen-weg 0.4s ease 1.4s forwards; }
  .in-beeld .omh-pijl { animation: online-marketing-heerenveen-pijl 0.6s cubic-bezier(.3,1.6,.5,1) 1.7s forwards; }
  .in-beeld .omh-lamp { animation: online-marketing-heerenveen-lamp 4s ease-in-out infinite; }
  .in-beeld .omh-lamp-2 { animation-delay: 0.3s; }
  .in-beeld .omh-lamp-3 { animation-delay: 0.6s; }
  .in-beeld .omh-lamp-4 { animation-delay: 0.9s; }
  .in-beeld .omh-lamp-5 { animation-delay: 1.2s; }
  @keyframes online-marketing-heerenveen-weg { to { opacity: 0; transform: translateY(-10px); } }
  @keyframes online-marketing-heerenveen-pijl { to { opacity: 1; transform: none; } }
  @keyframes online-marketing-heerenveen-lamp { 0%, 100% { opacity: 0; } 20%, 45% { opacity: 1; } 65% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .omh-oud, .in-beeld .omh-pijl, .in-beeld .omh-lamp { animation: none; }
  }
</style>
