---
// Scène voor /kennisbank/gidsen/zelf-website-maken/: een websitebouwer met blokken links en een lege pagina rechts.
// Een blok wordt steeds opnieuw naar de pagina gesleept, terwijl de klok ernaast rustig de uren wegtikt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const blokken = [
  { y: 82, t: 'Kop' },
  { y: 112, t: 'Tekst' },
  { y: 142, t: 'Foto' },
  { y: 172, t: 'Knop' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een websitebouwer waarin blokken naar een pagina worden gesleept, met ernaast een klok die de uren wegtikt.'}>
  <!-- editorvenster -->
  <rect x="20" y="28" width="330" height="214" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M20 52H350" stroke="#e8eef4" stroke-width="2" />
  <circle cx="36" cy="40" r="4" fill="#d9e1ea" />
  <circle cx="49" cy="40" r="4" fill="#d9e1ea" />
  <circle cx="62" cy="40" r="4" fill="#d9e1ea" />
  <rect x="270" y="34" width="66" height="12" rx="6" fill="#ff6600" />
  <text x="303" y="43.5" font-size="8.5" font-weight="800" text-anchor="middle" style="fill:#fff">Publiceren</text>
  <!-- zijbalk met blokken -->
  <path d="M106 52V242" stroke="#e8eef4" stroke-width="2" />
  <text x="32" y="70" font-size="9" font-weight="800" class="zacht">Blokken</text>
  {blokken.map((b) => (
    <g>
      <rect x="32" y={b.y} width="62" height="22" rx="6" fill="#e8eef4" />
      <text x="42" y={b.y + 14.5} font-size="10" font-weight="700">{b.t}</text>
    </g>
  ))}
  <!-- pagina in opbouw -->
  <rect x="126" y="68" width="206" height="160" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
  <rect x="142" y="82" width="110" height="11" rx="5" fill="#10283f" />
  <rect x="142" y="100" width="160" height="6" rx="3" fill="#d9e1ea" />
  <rect x="142" y="111" width="132" height="6" rx="3" fill="#d9e1ea" />
  <rect class="v" x="142" y="126" width="174" height="56" rx="6" />
  <path class="l" d="M156 172l22-24 16 14 12-10 22 20" />
  <rect x="142" y="192" width="174" height="24" rx="6" fill="none" stroke="#9fb3c4" stroke-width="1.5" stroke-dasharray="5 4" />

  <!-- klok -->
  <circle cx="412" cy="112" r="44" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path d="M412 74v6M412 144v6M374 112h6M444 112h6" stroke="#074663" stroke-width="2.5" stroke-linecap="round" />
  <path d="M412 112V90" stroke="#10283f" stroke-width="3" stroke-linecap="round" />
  <g class={mini ? undefined : 'wijzer'}>
    <path d="M412 112l20 10" stroke="#ff6600" stroke-width="3" stroke-linecap="round" />
  </g>
  <circle cx="412" cy="112" r="4" fill="#10283f" />
  <text x="412" y="184" font-size="11" font-weight="800" text-anchor="middle">Jouw uren</text>
  <text x="412" y="200" font-size="9.5" font-weight="700" text-anchor="middle" class="zacht">20 tot 40 uur</text>

  {!mini && (
    <g class="sleep">
      <rect x="32" y="172" width="62" height="22" rx="6" fill="#fff" stroke="#ff6600" stroke-width="2" />
      <text x="42" y="186.5" font-size="10" font-weight="700">Knop</text>
      <path d="M86 186l0 18 4.5-4.5 3.6 8 3.6-1.8-3.6-8h6.3z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
    </g>
  )}
</svg>
<style>
  .wijzer { transform-box: view-box; transform-origin: 412px 112px; }
  :global(.teken-js) .sleep { opacity: 0; }
  .in-beeld .sleep { animation: kennisbank-gidsen-zelf-website-maken-sleep 4.5s cubic-bezier(.5,0,.3,1) 0.4s infinite; }
  .in-beeld .wijzer { animation: kennisbank-gidsen-zelf-website-maken-klok 6s linear 0.4s infinite; }
  @keyframes kennisbank-gidsen-zelf-website-maken-sleep {
    0% { opacity: 0; transform: none; }
    10% { opacity: 1; transform: none; }
    60% { opacity: 1; transform: translate(166px, 20px); }
    80% { opacity: 1; transform: translate(166px, 20px); }
    100% { opacity: 0; transform: translate(166px, 20px); }
  }
  @keyframes kennisbank-gidsen-zelf-website-maken-klok { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .sleep { animation: none; opacity: 1; transform: translate(166px, 20px); }
    .in-beeld .wijzer { animation: none; }
  }
</style>
