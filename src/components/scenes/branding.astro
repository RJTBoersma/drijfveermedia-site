---
// Scène voor /branding/: één merkteken in het midden, met lijnen naar alles waarop het terugkomt: visitekaartje, telefoon, bedrijfsbus en de vaste kleuren.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: het logo van jouw bedrijf in het midden, met lijnen naar een visitekaartje, een telefoon, een bedrijfsbus en de vaste huiskleuren. Overal staat hetzelfde merk.'} aria-hidden={mini ? 'true' : undefined}>
  {!mini && (
    <g class="branding-lijnen" fill="none" stroke="#8aa0b4" stroke-width="2" stroke-linecap="round">
      <path class="branding-lijn" style="--i:0" d="M204 112L168 92" pathLength="1" />
      <path class="branding-lijn" style="--i:1" d="M284 124L366 104" pathLength="1" />
      <path class="branding-lijn" style="--i:2" d="M206 162L172 184" pathLength="1" />
      <path class="branding-lijn" style="--i:3" d="M272 168L318 210" pathLength="1" />
    </g>
  )}
  <!-- het merk in het midden -->
  <circle cx="240" cy="135" r="44" fill="#074663" />
  <text x="236" y="152" text-anchor="middle" font-size="48" font-weight="900" style="fill:#fff">J</text>
  <circle cx="258" cy="150" r="5" fill="#ff6600" />
  <text x="240" y="200" text-anchor="middle" font-size="14" font-weight="800">Jouw bedrijf</text>
  <!-- visitekaartje -->
  <rect x="36" y="34" width="132" height="78" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="60" cy="60" r="12" fill="#074663" />
  <text x="58" y="66" text-anchor="middle" font-size="15" font-weight="900" style="fill:#fff">J</text>
  <rect x="80" y="54" width="62" height="6" rx="3" fill="#10283f" />
  <rect x="80" y="66" width="44" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="48" y="92" width="96" height="5" rx="2.5" fill="#d9e1ea" />
  <!-- telefoon -->
  <rect x="372" y="36" width="76" height="140" rx="14" fill="#10283f" />
  <rect x="378" y="44" width="64" height="124" rx="9" fill="#fff" />
  <circle cx="410" cy="76" r="14" fill="#074663" />
  <text x="408" y="83" text-anchor="middle" font-size="17" font-weight="900" style="fill:#fff">J</text>
  <rect x="388" y="100" width="44" height="6" rx="3" fill="#10283f" />
  <rect x="388" y="112" width="36" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="388" y="136" width="44" height="16" rx="5" fill="#ff6600" />
  <!-- bedrijfsbus -->
  <path d="M30 188a8 8 0 0 1 8-8h104l22 18v28a6 6 0 0 1-6 6H36a6 6 0 0 1-6-6z" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M144 186h6l14 14h-20z" fill="#e8eef4" />
  <circle cx="72" cy="206" r="13" fill="#074663" />
  <text x="70" y="213" text-anchor="middle" font-size="16" font-weight="900" style="fill:#fff">J</text>
  <rect x="92" y="200" width="40" height="6" rx="3" fill="#10283f" />
  <rect x="92" y="211" width="28" height="4" rx="2" fill="#d9e1ea" />
  <circle cx="62" cy="234" r="11" fill="#10283f" /><circle cx="62" cy="234" r="4" fill="#fff" />
  <circle cx="142" cy="234" r="11" fill="#10283f" /><circle cx="142" cy="234" r="4" fill="#fff" />
  <!-- huiskleuren en letter -->
  <rect x="316" y="206" width="148" height="44" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="338" cy="228" r="11" fill="#074663" />
  <circle cx="364" cy="228" r="11" fill="#10283f" />
  <circle cx="390" cy="228" r="11" fill="#ff6600" />
  <circle cx="416" cy="228" r="11" fill="#e8eef4" stroke="#d9e1ea" />
  <text x="434" y="235" font-size="19" font-weight="800">Aa</text>
  {!mini && <circle class="branding-ring" cx="240" cy="135" r="44" fill="none" stroke="#ff6600" stroke-width="2.5" />}
</svg>
<style>
  .branding-lijn { stroke-dasharray: 1; }
  :global(.teken-js) .branding-lijn { stroke-dashoffset: 1; }
  :global(.teken-js) .branding-ring { opacity: 0; }
  .branding-ring { transform-box: fill-box; transform-origin: center; }
  .in-beeld .branding-lijn { animation: branding-lijn 0.7s cubic-bezier(.6,.1,.3,1) calc(0.5s + var(--i) * 0.3s) forwards; }
  .in-beeld .branding-ring { animation: branding-ring 3.6s ease-out 1.9s infinite; }
  @keyframes branding-lijn { to { stroke-dashoffset: 0; } }
  @keyframes branding-ring { 0% { opacity: 0.9; transform: scale(1); } 70%, 100% { opacity: 0; transform: scale(1.45); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .branding-lijn, .in-beeld .branding-ring { animation: none; } }
</style>
