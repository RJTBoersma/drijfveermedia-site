---
// Scène voor /kennisbank/wat-is/redirect/: een bezoeker komt bij een oude, verhuisde pagina aan en een pijl met 301 stuurt hem door naar de nieuwe pagina.
// Als hij leeft: de pijl tekent zichzelf, het label 301 verschijnt en een bezoeker loopt steeds opnieuw van de oude naar de nieuwe pagina.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een bezoeker komt bij een oude pagina die verhuisd is. Een pijl met 301 stuurt hem automatisch door naar de nieuwe pagina.'}>
  <!-- oude pagina -->
  <rect x="24" y="88" width="150" height="150" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="6 5" />
  <path d="M25 112v-12a11 11 0 0 1 11-11h126a11 11 0 0 1 11 11v12z" fill="#e8eef4" />
  <text x="38" y="105" font-size="11" class="zacht">/tuinen.html</text>
  <rect x="40" y="128" width="96" height="8" rx="4" fill="#e8eef4" />
  <rect x="40" y="144" width="118" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="40" y="158" width="82" height="7" rx="3.5" fill="#e8eef4" />
  <rect class="v" x="40" y="180" width="118" height="40" rx="8" />
  <path d="M90 192l18 16M108 192l-18 16" stroke="#9fb0c0" stroke-width="3" stroke-linecap="round" />

  <!-- nieuwe pagina -->
  <rect x="306" y="88" width="150" height="150" rx="12" fill="#fff" stroke="#074663" stroke-width="2" />
  <path d="M307 112v-12a11 11 0 0 1 11-11h126a11 11 0 0 1 11 11v12z" fill="#e8eef4" />
  <text x="320" y="105" font-size="11" font-weight="800">/tuinaanleg/</text>
  <rect x="322" y="128" width="96" height="8" rx="4" fill="#10283f" opacity="0.75" />
  <rect x="322" y="144" width="118" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="322" y="158" width="90" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="322" y="180" width="118" height="40" rx="8" fill="#e8eef4" />
  <path class="l" d="M336 212l16-18 12 12 10-8 18 14" />
  <circle cx="440" cy="92" r="13" fill="#1f8a5b" />
  <path d="M434 92l4 4 8-9" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />

  <!-- pijl -->
  <path class="a" d="M150 76C200 22 280 22 330 76" stroke-width="4" />
  <path class="a" d="M314 73L330 76L328 60" stroke-width="4" />
  <rect x="212" y="20" width="56" height="28" rx="14" fill="#ff6600" />
  <text x="240" y="39" font-size="14" font-weight="800" text-anchor="middle" style="fill:#fff">301</text>

  {!mini && (
    <g>
      <g class="loper">
        <circle cx="150" cy="76" r="9" fill="#074663" />
        <circle cx="150" cy="76" r="3" fill="#fff" />
      </g>
      <rect class="gloed" x="300" y="82" width="162" height="162" rx="16" fill="none" stroke="#ff6600" stroke-width="2" />
    </g>
  )}
</svg>
<style>
  :global(.teken-js) .loper, :global(.teken-js) .gloed { opacity: 0; }
  .in-beeld .loper { animation: kennisbank--wat-is--redirect-loop 3.6s ease-in-out 0.6s infinite; }
  .in-beeld .gloed { animation: kennisbank--wat-is--redirect-gloed 3.6s ease-in-out 0.6s infinite; }
  @keyframes kennisbank--wat-is--redirect-loop {
    0% { transform: translate(0, 0); opacity: 0; }
    8% { opacity: 1; }
    15% { transform: translate(42px, -30px); }
    30% { transform: translate(90px, -40px); }
    45% { transform: translate(138px, -30px); }
    60% { transform: translate(180px, 0); opacity: 1; }
    75%, 100% { transform: translate(180px, 0); opacity: 0; }
  }
  @keyframes kennisbank--wat-is--redirect-gloed { 0%, 55% { opacity: 0; } 70% { opacity: 0.9; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .loper, .in-beeld .gloed { animation: none; } }
</style>
