---
// Scène voor /kennisbank/gidsen/wat-is-google-ads/: een zoekresultatenpagina met bovenaan een gesponsorde advertentie,
// rechts de veiling waarin drie adverteerders bieden. Als hij leeft: een cursor klikt op de advertentie, er valt een munt
// (je betaalt per klik) en bij de veiling verschijnt wie de eerste plek wint.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const biedingen = [
  { y: 84, label: 'Jij', breed: 78, kleur: '#ff6600' },
  { y: 112, label: 'B', breed: 62, kleur: '#074663' },
  { y: 140, label: 'C', breed: 42, kleur: '#8aa0b4' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een zoekopdracht naar een loodgieter in Assen. Bovenaan staat een gesponsorde advertentie, rechts een veiling waarin drie adverteerders bieden. Een cursor klikt op de advertentie en er valt een munt: je betaalt per klik.'}>
  <!-- zoekresultaten -->
  <rect x="20" y="24" width="290" height="222" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="36" cy="40" r="3.5" fill="#d9e1ea" /><circle cx="48" cy="40" r="3.5" fill="#d9e1ea" /><circle cx="60" cy="40" r="3.5" fill="#d9e1ea" />
  <rect x="36" y="54" width="258" height="30" rx="15" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="54" cy="68" r="6" fill="none" stroke="#074663" stroke-width="2" />
  <path d="M58.5 72.5l4 4" stroke="#074663" stroke-width="2" stroke-linecap="round" />
  <text x="70" y="73" font-size="12" font-weight="700">loodgieter assen</text>

  <!-- de advertentie -->
  <rect x="36" y="96" width="258" height="64" rx="10" fill="#fff4ec" stroke="#ffd6b8" stroke-width="2" />
  <rect x="48" y="106" width="76" height="17" rx="8.5" fill="#074663" />
  <text x="86" y="118" font-size="9.5" font-weight="800" text-anchor="middle" style="fill:#fff">Gesponsord</text>
  <text x="48" y="140" font-size="12" font-weight="800" style="fill:#074663">Loodgieter nodig in Assen?</text>
  <rect x="48" y="148" width="176" height="6" rx="3" fill="#ffd2b0" />

  <!-- gewone resultaten -->
  <rect x="48" y="174" width="150" height="8" rx="4" fill="#8aa0b4" />
  <rect x="48" y="187" width="214" height="6" rx="3" fill="#d9e1ea" />
  <rect x="48" y="203" width="128" height="8" rx="4" fill="#8aa0b4" />
  <rect x="48" y="216" width="196" height="6" rx="3" fill="#d9e1ea" />
  <rect x="48" y="230" width="90" height="6" rx="3" fill="#d9e1ea" />

  <!-- de veiling -->
  <rect x="326" y="34" width="138" height="140" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="340" y="58" font-size="12" font-weight="800">De veiling</text>
  {biedingen.map((b) => (
    <g>
      <text x="340" y={b.y + 10} font-size="10.5" font-weight="700">{b.label}</text>
      <rect x="364" y={b.y} width="86" height="12" rx="6" fill="#e8eef4" />
      <rect x="364" y={b.y} width={b.breed} height="12" rx="6" fill={b.kleur} />
    </g>
  ))}
  <text x="340" y="166" font-size="9.5" class="zacht">bod × kwaliteit</text>

  <!-- betalen per klik -->
  <rect x="326" y="188" width="138" height="58" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="350" cy="217" r="13" fill="#fff4ec" stroke="#ff6600" stroke-width="2" />
  <text x="350" y="222" font-size="13" font-weight="900" text-anchor="middle" style="fill:#ff6600">€</text>
  <text x="372" y="213" font-size="11" font-weight="800">Betalen</text>
  <text x="372" y="228" font-size="11" font-weight="800">per klik</text>

  {!mini && (
    <g>
      <g class="eerste">
        <rect x="404" y="45" width="50" height="18" rx="9" fill="#1f8a5b" />
        <text x="429" y="58" font-size="9.5" font-weight="800" text-anchor="middle" style="fill:#fff">1e plek</text>
      </g>
      <circle class="rimpel" cx="214" cy="132" r="6" fill="none" stroke="#ff6600" stroke-width="2" />
      <g class="munt">
        <circle cx="250" cy="120" r="10" fill="#ff6600" />
        <text x="250" y="124.5" font-size="12" font-weight="900" text-anchor="middle" style="fill:#fff">€</text>
      </g>
      <g class="cursor">
        <path d="M214 132l0 22 6-6 5 10 4-2-5-10 9 0z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .eerste, .munt, .rimpel, .cursor { transform-box: fill-box; transform-origin: center; }
  .cursor { transform-origin: 0 0; }
  :global(.teken-js) .eerste, :global(.teken-js) .munt, :global(.teken-js) .rimpel, :global(.teken-js) .cursor { opacity: 0; }
  .in-beeld .eerste { animation: kennisbank-gidsen-wat-is-google-ads-eerste 0.5s cubic-bezier(.3,1.6,.5,1) 1.1s forwards; }
  .in-beeld .cursor { animation: kennisbank-gidsen-wat-is-google-ads-cursor 6s ease-in-out 0.6s infinite both; }
  .in-beeld .rimpel { animation: kennisbank-gidsen-wat-is-google-ads-rimpel 6s ease-out 0.6s infinite both; }
  .in-beeld .munt { animation: kennisbank-gidsen-wat-is-google-ads-munt 6s ease-out 0.6s infinite both; }
  @keyframes kennisbank-gidsen-wat-is-google-ads-eerste { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-wat-is-google-ads-cursor {
    0% { opacity: 0; transform: translate(70px, 80px); }
    12% { opacity: 1; }
    40% { opacity: 1; transform: translate(0, 0); }
    45% { transform: translate(0, 0) scale(0.85); }
    50%, 75% { opacity: 1; transform: translate(0, 0); }
    90%, 100% { opacity: 0; transform: translate(0, 0); }
  }
  @keyframes kennisbank-gidsen-wat-is-google-ads-rimpel {
    0%, 44% { opacity: 0; transform: scale(0.5); }
    48% { opacity: 1; }
    65%, 100% { opacity: 0; transform: scale(3); }
  }
  @keyframes kennisbank-gidsen-wat-is-google-ads-munt {
    0%, 46% { opacity: 0; transform: translateY(10px) scale(0.6); }
    54% { opacity: 1; transform: translateY(-4px) scale(1); }
    72% { opacity: 1; transform: translateY(-14px); }
    85%, 100% { opacity: 0; transform: translateY(-22px); }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .eerste, .in-beeld .cursor, .in-beeld .rimpel, .in-beeld .munt { animation: none; } }
</style>
