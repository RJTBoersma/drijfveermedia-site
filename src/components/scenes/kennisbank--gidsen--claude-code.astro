---
// Scène voor /kennisbank/gidsen/claude-code/: links een bestandenlijst van een project, in het midden een donker terminalvenster
// met een opdracht in gewone taal, rechts een git-tak met commits die uitloopt op een pull request.
// In de volledige versie krijgen de bestanden een vinkje, verschijnen de commits en springt het pull request-label op; de cursor knippert.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const bestanden = [
  { y: 92, t: 'formulier.js' },
  { y: 120, t: 'prijs.js' },
  { y: 148, t: 'test/prijs' },
];
const commits = [{ y: 196 }, { y: 150 }, { y: 104 }];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een terminalvenster met de opdracht om een fout in een formulier op te lossen. Links worden de aangepaste bestanden afgevinkt, rechts groeit een git-tak met commits die eindigt in een pull request.'}>
  <!-- bestandenlijst -->
  <rect x="22" y="56" width="110" height="128" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text class="zacht" x="34" y="74" font-size="9.5" font-weight="700">project</text>
  {bestanden.map((b) => (
    <g>
      <rect x="34" y={b.y - 9} width="12" height="14" rx="2" fill="#e8eef4" stroke="#d9e1ea" />
      <text x="52" y={b.y + 2} font-size="9.5" font-weight="700">{b.t}</text>
    </g>
  ))}

  <!-- terminal -->
  <rect x="148" y="34" width="210" height="196" rx="12" fill="#10283f" />
  <circle cx="164" cy="50" r="4" fill="#2c4660" /><circle cx="176" cy="50" r="4" fill="#2c4660" /><circle cx="188" cy="50" r="4" fill="#2c4660" />
  <text x="162" y="80" font-size="10.5" font-weight="700" style="fill:#8fd3b0">$ claude</text>
  <text x="162" y="102" font-size="10" font-weight="700" style="fill:#fff">&gt; los de fout in het</text>
  <text x="162" y="116" font-size="10" font-weight="700" style="fill:#fff">  formulier op</text>
  <rect x="162" y="134" width="120" height="5" rx="2.5" fill="#2c4660" />
  <rect x="162" y="146" width="160" height="5" rx="2.5" fill="#2c4660" />
  <rect x="162" y="158" width="96" height="5" rx="2.5" fill="#2c4660" />
  <rect x="162" y="184" width="182" height="30" rx="8" fill="#17344f" stroke="#2c4660" />
  <text x="172" y="203" font-size="9.5" font-weight="700" style="fill:#ffd2b0">Wijziging toestaan? Ja / Nee</text>

  <!-- git-tak -->
  <path d="M398 222V82" stroke="#074663" stroke-width="3" stroke-linecap="round" />
  <path class="a" d="M398 196c26-6 30-30 30-46" />
  {commits.map((c) => <circle cx="398" cy={c.y} r="7" fill="#fff" stroke="#074663" stroke-width="3" />)}
  <rect x="366" y="44" width="98" height="26" rx="13" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="380" y="61" font-size="10" font-weight="800">Pull request</text>

  {mini ? (
    <g>
      {commits.map((c) => <circle cx="398" cy={c.y} r="4" fill="#074663" />)}
    </g>
  ) : (
    <g>
      {bestanden.map((b, i) => (
        <g class={`vink v${i}`}>
          <circle cx="120" cy={b.y - 2} r="7" fill="#1a7a50" />
          <path d={`M116.5 ${b.y - 2}l2.5 2.5 4.5-5`} fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
      {commits.map((c, i) => <circle class={`commit c${i}`} cx="398" cy={c.y} r="4" fill="#ff6600" />)}
      <g class="pr">
        <rect x="366" y="44" width="98" height="26" rx="13" fill="#fff" stroke="#1a7a50" stroke-width="2" />
        <circle cx="381" cy="57" r="6" fill="#1a7a50" />
        <path d="M378.5 57l2 2 3.5-4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <text x="392" y="61" font-size="10" font-weight="800">PR klaar</text>
      </g>
      <rect class="cursor" x="252" y="107" width="6" height="11" rx="1" fill="#ff6600" />
      <rect class="vul" x="162" y="134" width="120" height="5" rx="2.5" fill="#8fd3b0" />
    </g>
  )}
</svg>
<style>
  .vink, .commit, .pr { transform-box: fill-box; transform-origin: center; }
  .vul { transform-box: fill-box; transform-origin: left center; }
  :global(.teken-js) .vink, :global(.teken-js) .commit, :global(.teken-js) .pr { opacity: 0; transform: scale(.4); }
  :global(.teken-js) .vul { transform: scaleX(0); }
  .in-beeld .v0 { animation: kennisbank-gidsen-claude-code-pop 0.5s cubic-bezier(.3,1.7,.5,1) 0.9s forwards; }
  .in-beeld .v1 { animation: kennisbank-gidsen-claude-code-pop 0.5s cubic-bezier(.3,1.7,.5,1) 1.4s forwards; }
  .in-beeld .v2 { animation: kennisbank-gidsen-claude-code-pop 0.5s cubic-bezier(.3,1.7,.5,1) 1.9s forwards; }
  .in-beeld .c0 { animation: kennisbank-gidsen-claude-code-pop 0.4s ease 2.3s forwards; }
  .in-beeld .c1 { animation: kennisbank-gidsen-claude-code-pop 0.4s ease 2.6s forwards; }
  .in-beeld .c2 { animation: kennisbank-gidsen-claude-code-pop 0.4s ease 2.9s forwards; }
  .in-beeld .pr { animation: kennisbank-gidsen-claude-code-pop 0.6s cubic-bezier(.3,1.6,.5,1) 3.3s forwards; }
  .in-beeld .cursor { animation: kennisbank-gidsen-claude-code-knipper 1.1s steps(1) 0s infinite; }
  .in-beeld .vul { animation: kennisbank-gidsen-claude-code-vul 5s ease-in-out 0.6s infinite; }
  @keyframes kennisbank-gidsen-claude-code-pop { to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-claude-code-knipper { 0% { opacity: 1; } 50% { opacity: 0; } }
  @keyframes kennisbank-gidsen-claude-code-vul { 0% { transform: scaleX(0); opacity: 1; } 65% { transform: none; opacity: 1; } 90%, 100% { transform: none; opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .vink, .in-beeld .commit, .in-beeld .pr, .in-beeld .cursor, .in-beeld .vul { animation: none; opacity: 1; transform: none; }
  }
</style>
