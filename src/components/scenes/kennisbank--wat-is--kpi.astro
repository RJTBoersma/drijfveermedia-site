---
// Scène voor /kennisbank/wat-is/kpi/: een eenvoudig dashboard. Links een meter met het hoofdgetal (12 van de 15 aanvragen),
// met een oranje streepje bij de streefwaarde. Rechts drie tegels met voorlopers: conversieratio, kosten per aanvraag, klikken uit Google.
// Als hij leeft: het lijntje in de onderste tegel tekent zich, er komt telkens "+1 aanvraag" binnen en het streefstreepje licht op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een dashboard. Een meter toont 12 van de 15 aanvragen deze maand, met een oranje streepje bij de streefwaarde. Ernaast drie tegels: conversieratio 2,1 procent, kosten per aanvraag 48 euro en een stijgend lijntje voor klikken uit Google.'}>
  <rect x="20" y="18" width="440" height="234" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="40" cy="38" r="4" fill="#d9e1ea" /><circle cx="52" cy="38" r="4" fill="#d9e1ea" /><circle cx="64" cy="38" r="4" fill="#d9e1ea" />
  <text x="84" y="42" font-size="12" font-weight="800" class="zacht">Dashboard · deze maand</text>
  <path d="M20 54h440" stroke="#e8eef4" stroke-width="2" />

  <!-- meter -->
  <path d="M60 176A70 70 0 0 1 200 176" fill="none" stroke="#e8eef4" stroke-width="16" stroke-linecap="round" />
  <path d="M60 176A70 70 0 0 1 151.6 109.4" fill="none" stroke="#074663" stroke-width="16" stroke-linecap="round" />
  <path d="M171 135L188 118" stroke="#ff6600" stroke-width="4" stroke-linecap="round" />
  <text x="194" y="112" font-size="11" font-weight="800">15</text>
  <text x="130" y="168" font-size="32" font-weight="800" text-anchor="middle">12</text>
  <text x="130" y="190" font-size="11" font-weight="700" text-anchor="middle" class="zacht">van de 15</text>
  <text x="130" y="224" font-size="12" font-weight="800" text-anchor="middle">Aanvragen</text>

  <!-- tegels met voorlopers -->
  <rect x="246" y="70" width="194" height="48" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="260" y="90" font-size="11" font-weight="700" class="zacht">Conversieratio</text>
  <text x="260" y="108" font-size="15" font-weight="800">2,1%</text>
  <path d="M416 102l8-10 8 10" fill="none" stroke="#1a7a50" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

  <rect x="246" y="126" width="194" height="48" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="260" y="146" font-size="11" font-weight="700" class="zacht">Kosten per aanvraag</text>
  <text x="260" y="164" font-size="15" font-weight="800">€ 48</text>
  <path d="M416 150l8 10 8-10" fill="none" stroke="#1a7a50" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

  <rect x="246" y="182" width="194" height="52" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="260" y="200" font-size="11" font-weight="700" class="zacht">Klikken uit Google</text>
  <path d="M260 224h166" stroke="#e8eef4" stroke-width="2" />
  <path d="M260 222l24-6 22 3 24-9 22 2 24-10 30-8" fill="none" stroke="#d9e1ea" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

  {!mini && (
    <g>
      <path class="kpi-lijn" d="M260 222l24-6 22 3 24-9 22 2 24-10 30-8" fill="none" stroke="#074663" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
      <circle class="kpi-punt" cx="426" cy="194" r="4" fill="#ff6600" />
      <path class="kpi-streef" d="M171 135L188 118" stroke="#ff6600" stroke-width="10" stroke-linecap="round" opacity="0.25" />
      <g class="kpi-plus">
        <rect x="88" y="62" width="84" height="24" rx="12" fill="#1a7a50" />
        <text x="130" y="78.5" font-size="11" font-weight="800" text-anchor="middle" style="fill:#fff">+1 aanvraag</text>
      </g>
    </g>
  )}
</svg>
<style>
  .kpi-lijn { stroke-dasharray: 1; }
  .kpi-punt, .kpi-streef { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .kpi-lijn { stroke-dashoffset: 1; }
  :global(.teken-js) .kpi-punt, :global(.teken-js) .kpi-plus, :global(.teken-js) .kpi-streef { opacity: 0; }
  .in-beeld .kpi-lijn { animation: kennisbank-wat-is-kpi-lijn 1.6s cubic-bezier(.6,.1,.3,1) 0.4s forwards; }
  .in-beeld .kpi-punt { animation: kennisbank-wat-is-kpi-pop 0.4s ease-out 2s forwards; }
  .in-beeld .kpi-plus { animation: kennisbank-wat-is-kpi-plus 5s ease-in-out 1.2s infinite; }
  .in-beeld .kpi-streef { animation: kennisbank-wat-is-kpi-streef 5s ease-in-out 1.2s infinite; }
  @keyframes kennisbank-wat-is-kpi-lijn { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-wat-is-kpi-pop { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-wat-is-kpi-plus { 0% { opacity: 0; transform: translateY(14px); } 15%, 60% { opacity: 1; transform: none; } 80%, 100% { opacity: 0; transform: translateY(-6px); } }
  @keyframes kennisbank-wat-is-kpi-streef { 0%, 40% { opacity: 0; } 55%, 75% { opacity: 0.35; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .kpi-lijn, .in-beeld .kpi-punt, .in-beeld .kpi-plus, .in-beeld .kpi-streef { animation: none; } }
</style>
