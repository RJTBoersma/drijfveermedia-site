---
// Scène voor /kennisbank/gidsen/tone-of-voice/: twee tekstballonnen met dezelfde boodschap, een met u en een met je, boven een schuif van formeel naar informeel.
// Als hij leeft: de schuifknop gaat rustig heen en weer en de ballon die past bij de stand licht op. Een geluidsgolfje laat zien dat er gesproken wordt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: twee tekstballonnen met dezelfde boodschap. De linker spreekt de lezer aan met u, de rechter met je. Daaronder een schuif van formeel naar informeel, waarvan de knop heen en weer gaat.'}>
  <!-- ballon formeel -->
  <path d="M30 40a12 12 0 0 1 12-12h170a12 12 0 0 1 12 12v86a12 12 0 0 1-12 12H90l-22 20v-20H42a12 12 0 0 1-12-12z" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="48" y="46" width="34" height="26" rx="8" fill="#074663" />
  <text x="65" y="64" text-anchor="middle" font-size="14" font-weight="800" style="fill:#fff">u</text>
  <rect x="94" y="52" width="110" height="8" rx="4" fill="#10283f" />
  <rect x="48" y="86" width="158" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="48" y="100" width="140" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="48" y="114" width="96" height="7" rx="3.5" fill="#d9e1ea" />

  <!-- ballon informeel -->
  <path d="M256 40a12 12 0 0 1 12-12h170a12 12 0 0 1 12 12v86a12 12 0 0 1-12 12h-26v20l-22-20H268a12 12 0 0 1-12-12z" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="274" y="46" width="34" height="26" rx="8" fill="#ff6600" />
  <text x="291" y="64" text-anchor="middle" font-size="14" font-weight="800" style="fill:#fff">je</text>
  <rect x="320" y="52" width="92" height="8" rx="4" fill="#10283f" />
  <rect x="274" y="86" width="150" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="274" y="100" width="118" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="274" y="114" width="70" height="7" rx="3.5" fill="#ffd2b0" />

  <!-- schuif -->
  <rect x="70" y="204" width="340" height="10" rx="5" fill="#e8eef4" stroke="#d9e1ea" />
  <circle cx="280" cy="209" r="14" fill="#fff" stroke="#074663" stroke-width="3" />
  <text x="70" y="242" font-size="13" font-weight="800">Formeel</text>
  <text x="410" y="242" text-anchor="end" font-size="13" font-weight="800">Informeel</text>

  {!mini && (
    <g>
      <g class="tv-knop"><circle cx="280" cy="209" r="14" fill="#fff" stroke="#ff6600" stroke-width="3" /><circle cx="280" cy="209" r="4" fill="#ff6600" /></g>
      <path class="tv-ballon tv-links" d="M30 40a12 12 0 0 1 12-12h170a12 12 0 0 1 12 12v86a12 12 0 0 1-12 12H90l-22 20v-20H42a12 12 0 0 1-12-12z" fill="none" stroke="#074663" stroke-width="2.5" />
      <path class="tv-ballon tv-rechts" d="M256 40a12 12 0 0 1 12-12h170a12 12 0 0 1 12 12v86a12 12 0 0 1-12 12h-26v20l-22-20H268a12 12 0 0 1-12-12z" fill="none" stroke="#ff6600" stroke-width="2.5" />
      <g class="tv-golf" fill="none" stroke="#8aa0b4" stroke-width="2.5" stroke-linecap="round">
        <path d="M232 168v12M240 162v24M248 166v16" />
      </g>
    </g>
  )}
</svg>
<style>
  .tv-knop { transform-box: view-box; }
  :global(.teken-js) .tv-ballon, :global(.teken-js) .tv-golf { opacity: 0; }
  .in-beeld .tv-knop { animation: kennisbank-gidsen-tone-of-voice-knop 7s ease-in-out 0.6s infinite; }
  .in-beeld .tv-links { animation: kennisbank-gidsen-tone-of-voice-links 7s ease-in-out 0.6s infinite; }
  .in-beeld .tv-rechts { animation: kennisbank-gidsen-tone-of-voice-rechts 7s ease-in-out 0.6s infinite; }
  .in-beeld .tv-golf { animation: kennisbank-gidsen-tone-of-voice-golf 1.6s ease-in-out 0.8s infinite; }
  @keyframes kennisbank-gidsen-tone-of-voice-knop { 0%, 100% { transform: translateX(0); } 40%, 50% { transform: translateX(-150px); } 85%, 95% { transform: translateX(80px); } }
  @keyframes kennisbank-gidsen-tone-of-voice-links { 0%, 25% { opacity: 0; } 40%, 52% { opacity: 1; } 65%, 100% { opacity: 0; } }
  @keyframes kennisbank-gidsen-tone-of-voice-rechts { 0%, 70% { opacity: 0; } 85%, 95% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes kennisbank-gidsen-tone-of-voice-golf { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .tv-knop, .in-beeld .tv-links, .in-beeld .tv-rechts, .in-beeld .tv-golf { animation: none; } }
</style>
