---
// Scène voor /webdesign-zwolle/: dezelfde website op een scherm, een tablet en een telefoon, voor een getekend stukje Zwolle met de Peperbus. In de volledige versie licht de belknop om de beurt op elk apparaat op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: dezelfde website op een groot scherm, een tablet en een telefoon, met daarachter de Peperbus van Zwolle. De belknop licht op elk apparaat op.'}>
  <!-- stukje Zwolle op de achtergrond -->
  <g fill="#e3ebf2">
    <path d="M42 214V112h32v102z" />
    <path d="M48 112V84h20v28z" />
    <path d="M46 84c0-12 5-16 12-24 7 8 12 12 12 24z" />
    <path d="M58 62V40" stroke="#e3ebf2" stroke-width="3" stroke-linecap="round" />
    <path d="M74 214v-46l16-16 16 16v46z" />
    <path d="M14 214v-34l12-12 12 12v34z" />
  </g>
  <path d="M10 214h460" stroke="#d9e1ea" stroke-width="2" />
  <text x="58" y="236" text-anchor="middle" font-size="11" font-weight="700" class="zacht">Zwolle</text>
  <!-- groot scherm -->
  <rect x="112" y="52" width="196" height="132" rx="9" fill="#10283f" />
  <rect x="120" y="60" width="180" height="114" rx="4" fill="#fff" />
  <path d="M196 184h28l4 22h-36z" fill="#c9d3dd" />
  <rect x="178" y="204" width="64" height="8" rx="4" fill="#c9d3dd" />
  <rect x="130" y="68" width="34" height="6" rx="3" fill="#074663" />
  <rect x="130" y="88" width="96" height="9" rx="3" fill="#10283f" />
  <rect x="130" y="103" width="80" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="130" y="112" width="66" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="130" y="128" width="56" height="18" rx="6" fill="#ff6600" />
  <rect class="v" x="236" y="86" width="54" height="60" rx="5" />
  <!-- tablet -->
  <rect x="320" y="94" width="88" height="120" rx="11" fill="#10283f" />
  <rect x="327" y="102" width="74" height="102" rx="5" fill="#fff" />
  <rect x="334" y="109" width="22" height="5" rx="2.5" fill="#074663" />
  <rect x="334" y="122" width="58" height="7" rx="3" fill="#10283f" />
  <rect x="334" y="134" width="50" height="4" rx="2" fill="#d9e1ea" />
  <rect class="v" x="334" y="144" width="60" height="26" rx="4" />
  <rect x="334" y="178" width="42" height="15" rx="5" fill="#ff6600" />
  <!-- telefoon -->
  <rect x="420" y="130" width="48" height="84" rx="10" fill="#10283f" />
  <rect x="425" y="137" width="38" height="70" rx="5" fill="#fff" />
  <rect x="430" y="143" width="14" height="4" rx="2" fill="#074663" />
  <rect x="430" y="153" width="28" height="5" rx="2.5" fill="#10283f" />
  <rect class="v" x="430" y="163" width="28" height="16" rx="3" />
  <rect x="430" y="186" width="28" height="12" rx="4" fill="#ff6600" />

  {!mini && (
    <g>
      <!-- de belknop licht om de beurt op -->
      <g fill="none" stroke="#ff6600" stroke-width="2.5">
        <rect class="gloed g1" x="126" y="124" width="64" height="26" rx="9" />
        <rect class="gloed g2" x="330" y="174" width="50" height="23" rx="8" />
        <rect class="gloed g3" x="426" y="182" width="36" height="20" rx="7" />
      </g>
      <!-- vinkjes: werkt op elk scherm -->
      <g class="check v1"><circle cx="300" cy="52" r="10" fill="#1a7a50" /><path d="M295 52l3.5 3.5 6-7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="check v2"><circle cx="402" cy="94" r="10" fill="#1a7a50" /><path d="M397 94l3.5 3.5 6-7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="check v3"><circle cx="462" cy="130" r="10" fill="#1a7a50" /><path d="M457 130l3.5 3.5 6-7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></g>
    </g>
  )}
</svg>
<style>
  .gloed, .check { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .gloed, :global(.teken-js) .check { opacity: 0; }
  :global(.teken-js) .check { transform: scale(0.4); }
  .in-beeld .gloed { animation: webdesign-zwolle-gloed 6s ease-in-out infinite; }
  .in-beeld .g1 { animation-delay: 1s; }
  .in-beeld .g2 { animation-delay: 3s; }
  .in-beeld .g3 { animation-delay: 5s; }
  .in-beeld .check { animation: webdesign-zwolle-vink 0.5s cubic-bezier(.3,1.6,.5,1) forwards; }
  .in-beeld .v1 { animation-delay: 0.5s; }
  .in-beeld .v2 { animation-delay: 0.85s; }
  .in-beeld .v3 { animation-delay: 1.2s; }
  @keyframes webdesign-zwolle-gloed { 0%, 100% { opacity: 0; transform: scale(0.92); } 12%, 28% { opacity: 1; transform: scale(1.08); } 40% { opacity: 0; transform: scale(1.15); } }
  @keyframes webdesign-zwolle-vink { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .gloed, .in-beeld .check { animation: none; opacity: 1; transform: none; } }
</style>
