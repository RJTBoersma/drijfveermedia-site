---
// Scène voor /linkbuilding/linkbuilding-niederlande/ (Duitse pagina): links van Nederlandse sites gaan over de grens naar een Duitse website, waarvan de zichtbaarheid in Nederland stijgt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const nl = [40, 108, 176];
const lijnen = ['M292 65C250 65 240 95 200 95', 'M292 133C250 133 240 107 200 107', 'M292 201C246 201 244 119 200 119'];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Zeichnung: Links von niederländischen Websites führen über die Grenze zu Ihrer deutschen Website, deren Sichtbarkeit in den Niederlanden steigt.'} aria-hidden={mini ? 'true' : undefined}>
  <path d="M240 40V250" stroke="#8aa0b4" stroke-width="2" stroke-dasharray="2 6" stroke-linecap="round" />
  <text x="218" y="30" font-size="11" font-weight="800" class="zacht">DE</text>
  <text x="248" y="30" font-size="11" font-weight="800" class="zacht">NL</text>

  <rect x="24" y="48" width="176" height="118" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M36 49h152a11 11 0 0 1 11 11v10H25V60a11 11 0 0 1 11-11z" fill="#e8eef4" />
  <circle cx="38" cy="59" r="3" fill="#d9e1ea" /><circle cx="48" cy="59" r="3" fill="#d9e1ea" />
  <text x="38" y="96" font-size="12" font-weight="800">Ihre Website</text>
  <text x="38" y="112" font-size="9" class="zacht">ihrefirma.de/nl/</text>
  <rect x="38" y="124" width="120" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="38" y="138" width="92" height="7" rx="3.5" fill="#e8eef4" />

  {nl.map((y) => (
    <g>
      <rect x="292" y={y} width="164" height="50" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <rect x="302" y={y + 10} width="36" height="30" rx="6" fill="#074663" />
      <text x="308" y={y + 30} font-size="13" font-weight="800" style="fill:#fff">.nl</text>
      <rect x="348" y={y + 14} width="88" height="6" rx="3" fill="#d9e1ea" />
      <rect x="348" y={y + 28} width="60" height="6" rx="3" fill="#e8eef4" />
    </g>
  ))}
  {lijnen.map((d) => <path d={d} fill="none" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="4 5" />)}

  <path d="M30 246h170" stroke="#d9e1ea" stroke-width="3" stroke-linecap="round" />
  <rect x="40" y="228" width="22" height="18" rx="4" fill="#d9e1ea" />
  <rect x="72" y="214" width="22" height="32" rx="4" fill="#d9e1ea" />
  <rect x="104" y="196" width="22" height="50" rx="4" fill="#d9e1ea" />
  <text x="40" y="262" font-size="10" class="zacht">Sichtbarkeit in NL</text>

  {!mini && (
    <g>
      {lijnen.map((d, i) => <path class="link" d={d} fill="none" stroke="#ff6600" stroke-width="3" stroke-linecap="round" stroke-dasharray="1" pathLength="1" style={`--i:${i}`} />)}
      <rect class="groei" x="104" y="196" width="22" height="50" rx="4" fill="#ff6600" />
      <g class="platz">
        <rect x="142" y="190" width="80" height="28" rx="14" fill="#fff" stroke="#d9e1ea" />
        <circle cx="157" cy="204" r="8" fill="#1f8a5b" />
        <path d="M153 204l3 3 5-5.5" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="170" y="208" font-size="11" font-weight="800">Platz 1</text>
      </g>
    </g>
  )}
</svg>
<style>
  .link { stroke-dashoffset: 0; }
  :global(.teken-js) .link { stroke-dashoffset: 1; }
  .groei { transform-box: fill-box; transform-origin: center bottom; }
  :global(.teken-js) .groei { transform: scaleY(0); }
  :global(.teken-js) .platz { opacity: 0; }
  .in-beeld .link { animation: linkbuilding--linkbuilding-niederlande-link 0.9s cubic-bezier(.6,.1,.3,1) calc(0.4s + var(--i) * 0.35s) forwards; }
  .in-beeld .groei { animation: linkbuilding--linkbuilding-niederlande-groei 1.2s cubic-bezier(.3,1.3,.5,1) 1.7s forwards; }
  .in-beeld .platz { animation: linkbuilding--linkbuilding-niederlande-platz 5s ease-in-out 2.6s infinite both; }
  @keyframes linkbuilding--linkbuilding-niederlande-link { to { stroke-dashoffset: 0; } }
  @keyframes linkbuilding--linkbuilding-niederlande-groei { to { transform: none; } }
  @keyframes linkbuilding--linkbuilding-niederlande-platz { 0% { opacity: 0; transform: translateY(6px); } 15%, 50% { opacity: 1; transform: none; } 65% { opacity: 1; transform: translateY(-4px); } 80% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .link, .in-beeld .groei, .in-beeld .platz { animation: none; } }
</style>
