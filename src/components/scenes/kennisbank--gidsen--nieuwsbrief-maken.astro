---
// Scène voor /kennisbank/gidsen/nieuwsbrief-maken/: links een inschrijfformulier, rechts de nieuwsbrief die eruit voortkomt, met daartussen een stippellijn.
// Als hij leeft: er komt een nieuwe abonnee bij, een envelop vliegt steeds opnieuw van formulier naar nieuwsbrief en de balk met kliks loopt vol.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: links een inschrijfformulier met een knop om je aan te melden, rechts een nieuwsbrief met kop, foto, tekst en knop. Een envelop vliegt van het formulier naar de nieuwsbrief en een balk met kliks loopt vol.'}>
  <!-- inschrijfformulier -->
  <rect x="24" y="62" width="160" height="150" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path class="l" d="M44 86h44l-22 14z M44 86v24h44V86" />
  <rect x="98" y="88" width="66" height="8" rx="4" fill="#10283f" />
  <rect x="98" y="102" width="44" height="6" rx="3" fill="#d9e1ea" />
  <rect x="40" y="126" width="128" height="26" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="50" y="136" width="70" height="6" rx="3" fill="#d9e1ea" />
  <rect x="40" y="164" width="128" height="30" rx="9" fill="#ff6600" />
  <text x="104" y="184" text-anchor="middle" font-size="13" font-weight="800" style="fill:#fff">Aanmelden</text>

  <!-- route -->
  <path d="M190 137C214 110 230 110 256 120" fill="none" stroke="#8aa0b4" stroke-width="2" stroke-dasharray="5 6" stroke-linecap="round" />

  <!-- nieuwsbrief -->
  <rect x="262" y="22" width="196" height="228" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M262 34a12 12 0 0 1 12-12h172a12 12 0 0 1 12 12v18H262z" fill="#074663" />
  <circle cx="284" cy="37" r="8" fill="#fff" />
  <rect x="300" y="33" width="60" height="7" rx="3.5" fill="#fff" opacity=".6" />
  <rect x="278" y="64" width="164" height="58" rx="8" class="v" />
  <circle cx="300" cy="84" r="8" fill="#fff" />
  <path class="l" d="M290 114l30-22 22 16 18-12 30 18" />
  <rect x="278" y="134" width="140" height="10" rx="5" fill="#10283f" />
  <rect x="278" y="152" width="164" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="278" y="166" width="150" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="278" y="180" width="110" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="278" y="200" width="84" height="22" rx="7" fill="#ff6600" />
  <rect x="374" y="208" width="68" height="8" rx="4" fill="#e8eef4" />

  {!mini && (
    <g>
      <rect class="nb-balk" x="374" y="208" width="68" height="8" rx="4" fill="#1a7a50" />
      <g class="nb-envelop">
        <rect x="190" y="124" width="30" height="22" rx="3" fill="#fff" stroke="#074663" stroke-width="2" />
        <path d="M190 126l15 11 15-11" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
      </g>
      <g class="nb-plus">
        <rect x="128" y="40" width="48" height="28" rx="14" fill="#074663" />
        <text x="152" y="59" text-anchor="middle" font-size="13" font-weight="800" style="fill:#fff">+1</text>
      </g>
    </g>
  )}
</svg>
<style>
  .nb-balk { transform-box: fill-box; transform-origin: left center; }
  .nb-plus { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .nb-balk { transform: scaleX(0); }
  :global(.teken-js) .nb-plus, :global(.teken-js) .nb-envelop { opacity: 0; }
  .in-beeld .nb-plus { animation: kennisbank-gidsen-nieuwsbrief-maken-plus 0.5s cubic-bezier(.3,1.7,.5,1) 0.5s forwards; }
  .in-beeld .nb-envelop { animation: kennisbank-gidsen-nieuwsbrief-maken-envelop 4.5s ease-in-out 1s infinite; }
  .in-beeld .nb-balk { animation: kennisbank-gidsen-nieuwsbrief-maken-balk 1.6s ease-out 2.2s forwards; }
  @keyframes kennisbank-gidsen-nieuwsbrief-maken-plus { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-nieuwsbrief-maken-envelop { 0% { opacity: 0; transform: translate(0, 0); } 10% { opacity: 1; } 35% { transform: translate(24px, -22px); } 60% { opacity: 1; transform: translate(52px, -16px); } 72%, 100% { opacity: 0; transform: translate(62px, -14px); } }
  @keyframes kennisbank-gidsen-nieuwsbrief-maken-balk { from { transform: scaleX(0); } to { transform: scaleX(0.75); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .nb-plus, .in-beeld .nb-envelop, .in-beeld .nb-balk { animation: none; } }
</style>
