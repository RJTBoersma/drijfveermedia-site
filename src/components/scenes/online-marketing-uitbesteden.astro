---
// Scène voor /online-marketing-uitbesteden/: één aanspreekpunt in het midden, met lijnen naar zes kanalen. Om de beurt gaat er werk naartoe.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const tegels = [
  { x: 22, y: 34, label: 'SEO', lx: 122, ly: 56 },
  { x: 22, y: 113, label: 'Google Ads', lx: 122, ly: 135 },
  { x: 22, y: 192, label: 'Website', lx: 122, ly: 214 },
  { x: 358, y: 34, label: 'Teksten', lx: 358, ly: 56 },
  { x: 358, y: 113, label: 'E-mail', lx: 358, ly: 135 },
  { x: 358, y: 192, label: 'Social media', lx: 358, ly: 214 },
];
const cx = 240, cy = 128;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: één aanspreekpunt in het midden, verbonden met SEO, Google Ads, website, teksten, e-mail en social media. Om de beurt gaat er werk naar een van de kanalen.'}>
  {tegels.map((t) => (
    <path d={`M${t.lx} ${t.ly}L${cx} ${cy}`} stroke="#d9e1ea" stroke-width="2.5" stroke-linecap="round" />
  ))}
  {tegels.map((t) => (
    <g>
      <rect x={t.x} y={t.y} width="100" height="44" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <text x={t.x + 50} y={t.y + 27} text-anchor="middle" font-size="12" font-weight="800">{t.label}</text>
    </g>
  ))}
  {!mini && (
    <g>
      {tegels.map((t, i) => (
        <circle class="puls" cx={cx} cy={cy} r="5" fill="#ff6600" style={`--i:${i};--dx:${t.lx - cx}px;--dy:${t.ly - cy}px`} />
      ))}
    </g>
  )}
  <circle cx={cx} cy={cy} r="48" fill="#074663" />
  <circle cx={cx} cy={cy - 12} r="11" fill="#fff" />
  <path d={`M${cx - 20} ${cy + 22}c0-14 40-14 40 0z`} fill="#fff" />
  <rect x={cx - 66} y="196" width="132" height="28" rx="14" fill="#e8eef4" />
  <text x={cx} y="214" text-anchor="middle" font-size="11" font-weight="800">Eén aanspreekpunt</text>
  <rect x={cx - 74} y="234" width="148" height="24" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle class="o" cx={cx - 58} cy="246" r="4" />
  <text x={cx + 6} y="250" text-anchor="middle" font-size="10" class="zacht">Maandelijks opzegbaar</text>
  {!mini && (
    <g>
      {tegels.map((t, i) => (
        <rect class="licht" x={t.x} y={t.y} width="100" height="44" rx="10" fill="none" stroke="#ff6600" stroke-width="2.5" style={`--i:${i}`} />
      ))}
    </g>
  )}
</svg>
<style>
  .licht, .puls { opacity: 0; }
  .in-beeld .puls { animation: online-marketing-uitbesteden-puls 6s ease-in-out calc(0.4s + var(--i) * 1s) infinite both; }
  .in-beeld .licht { animation: online-marketing-uitbesteden-licht 6s ease-out calc(0.4s + var(--i) * 1s) infinite both; }
  @keyframes online-marketing-uitbesteden-puls {
    0% { opacity: 0; transform: translate(0, 0); }
    3% { opacity: 1; }
    13% { opacity: 1; transform: translate(var(--dx), var(--dy)); }
    16%, 100% { opacity: 0; transform: translate(var(--dx), var(--dy)); }
  }
  @keyframes online-marketing-uitbesteden-licht {
    0%, 12% { opacity: 0; }
    15%, 26% { opacity: 1; }
    34%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .puls, .in-beeld .licht { animation: none; }
  }
</style>
