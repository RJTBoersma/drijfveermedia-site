---
// Scène voor /webdesign-stadskanaal/: het lint van huizen langs het kanaal, met de watertoren. Een boot vaart rustig heen en weer, en op jouw bedrijf valt een pin: gevonden.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const huizen = [28, 74, 120, 166, 306, 352];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een lint van huizen langs het kanaal in Stadskanaal, met de watertoren. Een boot vaart over het kanaal en op jouw bedrijf valt een pin met de melding gevonden.'}>
  <!-- noordkant: het lint -->
  {huizen.map((x) => (
    <g>
      <path class="v" d={`M${x} 170v-24l17-14 17 14v24z`} />
      <path class="l" d={`M${x} 170v-24l17-14 17 14v24zM${x + 12} 152h10v10h-10z`} />
    </g>
  ))}
  <!-- jouw bedrijf -->
  <rect class="v" x="212" y="124" width="80" height="46" />
  <path class="l" d="M212 170v-46h80v46" />
  <rect x="216" y="106" width="72" height="18" rx="4" fill="#10283f" />
  <text x="252" y="119" text-anchor="middle" font-size="9.5" font-weight="800" style="fill:#fff">Jouw bedrijf</text>
  <rect x="222" y="136" width="26" height="16" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <rect x="260" y="142" width="20" height="28" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <!-- watertoren -->
  <rect class="v" x="413" y="88" width="14" height="82" />
  <path class="l" d="M413 170V88h14v82" />
  <rect class="v" x="402" y="62" width="36" height="28" rx="8" />
  <rect class="l" x="402" y="62" width="36" height="28" rx="8" />
  <path class="l" d="M406 62l14-10 14 10" />
  <!-- kanaal -->
  <path class="l" d="M16 170h448" />
  <rect class="v" x="16" y="172" width="448" height="40" />
  <path d="M40 186c8-4 16-4 24 0s16 4 24 0M180 198c8-4 16-4 24 0s16 4 24 0M330 188c8-4 16-4 24 0s16 4 24 0" stroke="#c9d6e2" stroke-width="2" fill="none" stroke-linecap="round" />
  <path class="l" d="M16 214h448" />
  <!-- zuidkant: hier staat veel minder -->
  <path class="v" d="M196 240v-16l12-10 12 10v16z" />
  <path class="l" d="M196 240v-16l12-10 12 10v16z" />
  <circle class="v" cx="96" cy="228" r="10" /><circle class="l" cx="96" cy="228" r="10" /><path class="l" d="M96 238v8" />
  <circle class="v" cx="338" cy="228" r="10" /><circle class="l" cx="338" cy="228" r="10" /><path class="l" d="M338 238v8" />
  <!-- boot -->
  <g class="boot">
    <path d="M52 196h60l-9 11H61z" fill="#074663" />
    <rect x="90" y="185" width="15" height="11" fill="#fff" stroke="#074663" stroke-width="2" />
    <path class="a" d="M66 196v-12" />
  </g>
  {!mini && (
    <g>
      <g transform="translate(252 74)">
        <g class="pin">
          <path class="o" d="M-12 0c0-8 5-13 12-13s12 5 12 13c0 9-12 20-12 20s-12-11-12-20z" />
          <circle cy="0" r="4.5" fill="#fff" />
        </g>
      </g>
      <g transform="translate(278 40)">
        <g class="melding">
          <rect width="100" height="30" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
          <circle cx="16" cy="15" r="6" fill="#1a7a50" />
          <text x="28" y="20" font-size="12" font-weight="800">Gevonden</text>
        </g>
      </g>
    </g>
  )}
</svg>
<style>
  .pin { transform-box: fill-box; transform-origin: 50% 100%; }
  .melding { transform-box: fill-box; transform-origin: left center; }
  [data-leeft].in-beeld .boot { animation: webdesign-stadskanaal-boot 8s ease-in-out 0.6s infinite alternate; }
  :global(.teken-js) .pin, :global(.teken-js) .melding { opacity: 0; }
  .in-beeld .pin { animation: webdesign-stadskanaal-pin 0.8s cubic-bezier(.3,1.5,.5,1) 1s both; }
  .in-beeld .melding { animation: webdesign-stadskanaal-melding 0.5s ease-out 1.8s both; }
  @keyframes webdesign-stadskanaal-boot { to { transform: translateX(250px); } }
  @keyframes webdesign-stadskanaal-pin { from { opacity: 0; transform: translateY(-36px); } to { opacity: 1; transform: none; } }
  @keyframes webdesign-stadskanaal-melding { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { [data-leeft].in-beeld .boot, .in-beeld .pin, .in-beeld .melding { animation: none; } }
</style>
