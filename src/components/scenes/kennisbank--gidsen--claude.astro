---
// Scène voor /kennisbank/gidsen/claude/: een stapel documenten gaat een chatvenster in, rechts een takenlijst die wordt afgevinkt,
// onderin een klein codevenster. In de volledige versie vinken de taken zich af en loopt er een cursor in de code.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const taken = [
  { y: 92, t: 'Offerte samenvatten' },
  { y: 124, t: 'Antwoord op klantmail' },
  { y: 156, t: 'Tekst dienstpagina' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een AI-assistent leest een stapel documenten en werkt een takenlijst af, met daaronder een venster met code.'}>
  <!-- stapel documenten -->
  <rect x="34" y="62" width="88" height="112" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" transform="rotate(-6 78 118)" />
  <rect x="40" y="58" width="88" height="112" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" transform="rotate(4 84 114)" />
  <rect x="38" y="60" width="88" height="112" rx="8" fill="#fff" stroke="#074663" stroke-width="2" />
  <rect x="50" y="74" width="50" height="7" rx="3.5" fill="#074663" />
  <rect x="50" y="90" width="64" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="50" y="101" width="58" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="50" y="112" width="64" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="50" y="123" width="40" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="48" y="140" width="70" height="20" rx="4" fill="#e8eef4" />
  <text x="54" y="154" font-size="9" font-weight="800">120 pagina's</text>
  <path class="a" d="M132 116h34m-8-7l8 7-8 7" />

  <!-- takenvenster -->
  <rect x="176" y="40" width="270" height="148" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="192" cy="56" r="4" fill="#d9e1ea" /><circle cx="204" cy="56" r="4" fill="#d9e1ea" /><circle cx="216" cy="56" r="4" fill="#d9e1ea" />
  <text x="236" y="60" font-size="10.5" font-weight="800" class="zacht">Vandaag gedaan</text>
  <path d="M176 70H446" stroke="#e8eef4" stroke-width="2" />
  {taken.map((t) => (
    <g>
      <rect x="196" y={t.y - 11} width="22" height="22" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <text x="230" y={t.y + 4} font-size="11.5" font-weight="700">{t.t}</text>
    </g>
  ))}

  <!-- codevenster -->
  <rect x="236" y="198" width="210" height="56" rx="10" fill="#10283f" />
  <text x="250" y="222" font-size="10.5" font-weight="700" style="fill:#8fd3b0">&gt; maak de contactpagina</text>
  <rect x="250" y="232" width="92" height="5" rx="2.5" fill="#2c4660" />
  <rect x="348" y="232" width="52" height="5" rx="2.5" fill="#2c4660" />

  {!mini && (
    <g>
      {taken.map((t, i) => (
        <g class={`vink v${i}`}>
          <rect x="196" y={t.y - 11} width="22" height="22" rx="6" fill="#1a7a50" />
          <path d={`M201 ${t.y}l4 4 8-9`} fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
      <rect class="cursor" x="408" y="213" width="7" height="12" rx="1" fill="#ff6600" />
      <rect class="vul" x="250" y="232" width="150" height="5" rx="2.5" fill="#8fd3b0" />
    </g>
  )}
</svg>
<style>
  .vink { transform-box: fill-box; transform-origin: center; }
  .vul { transform-box: fill-box; transform-origin: left center; }
  :global(.teken-js) .vink { opacity: 0; transform: scale(.4); }
  :global(.teken-js) .vul { transform: scaleX(0); }
  .in-beeld .v0 { animation: kennisbank-gidsen-claude-vink 0.5s cubic-bezier(.3,1.7,.5,1) 0.8s forwards; }
  .in-beeld .v1 { animation: kennisbank-gidsen-claude-vink 0.5s cubic-bezier(.3,1.7,.5,1) 1.5s forwards; }
  .in-beeld .v2 { animation: kennisbank-gidsen-claude-vink 0.5s cubic-bezier(.3,1.7,.5,1) 2.2s forwards; }
  .in-beeld .cursor { animation: kennisbank-gidsen-claude-knipper 1.1s steps(1) 0s infinite; }
  .in-beeld .vul { animation: kennisbank-gidsen-claude-vul 4.5s ease-in-out 1s infinite; }
  @keyframes kennisbank-gidsen-claude-vink { to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-claude-knipper { 0% { opacity: 1; } 50% { opacity: 0; } }
  @keyframes kennisbank-gidsen-claude-vul { 0% { transform: scaleX(0); opacity: 1; } 70% { transform: scaleX(1); opacity: 1; } 90%, 100% { transform: scaleX(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .cursor, .in-beeld .vul { animation: none; }
    .in-beeld .v0, .in-beeld .v1, .in-beeld .v2 { animation: none; opacity: 1; transform: none; }
  }
</style>
