---
// Scène voor /kennisbank/gidsen/google-ads-check/: een klembord met de checklist voor je Google Ads-account,
// rechts het budget van deze maand met een deel dat weglekt en de kosten per aanvraag die dalen.
// Als hij leeft: de vinkjes verschijnen een voor een, het open punt knippert en een vergrootglas loopt rustig de lijst langs.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const punten = [
  { label: 'Conversies gemeten', ok: true },
  { label: 'Zoektermen bekeken', ok: true },
  { label: 'Uitsluitingen', ok: false },
  { label: 'Locatie klopt', ok: true },
  { label: 'Landingspagina', ok: true },
  { label: 'Biedstrategie', ok: true },
];
const rij = (i: number) => 84 + i * 26;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een klembord met de Google Ads-check. Vijf punten krijgen een vinkje, bij uitsluitingen staat een waarschuwing. Rechts het budget van deze maand, waarvan een deel weglekt, en de kosten per aanvraag die dalen.'}>
  <!-- klembord -->
  <rect x="36" y="30" width="226" height="218" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="117" y="20" width="64" height="20" rx="6" fill="#074663" />
  <text x="56" y="66" font-size="13" font-weight="800">Google Ads-check</text>
  {punten.map((p, i) => (
    <g>
      <rect x="56" y={rij(i)} width="16" height="16" rx="4" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <text x="82" y={rij(i) + 12} font-size="11" font-weight="700">{p.label}</text>
      {!p.ok && <circle cx="64" cy={rij(i) + 8} r="4" fill="#ff6600" />}
    </g>
  ))}

  <!-- budget -->
  <rect x="280" y="40" width="180" height="120" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="296" y="66" font-size="11.5" font-weight="800">Budget deze maand</text>
  <rect x="296" y="80" width="148" height="18" rx="9" fill="#ff6600" />
  <rect x="296" y="80" width="108" height="18" rx="9" fill="#1f8a5b" />
  <rect x="396" y="80" width="10" height="18" fill="#1f8a5b" />
  <circle cx="302" cy="120" r="5" fill="#1f8a5b" />
  <text x="314" y="124" font-size="10.5">levert aanvragen op</text>
  <circle cx="302" cy="142" r="5" fill="#ff6600" />
  <text x="314" y="146" font-size="10.5">lekt weg</text>

  <!-- kosten per aanvraag -->
  <rect x="280" y="174" width="180" height="72" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="296" y="196" font-size="11.5" font-weight="800">Kosten per aanvraag</text>
  <path d="M298 214l26 6 24-2 26 12 26 6 30-2" fill="none" stroke="#074663" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M440 230l8 6-10 3" fill="none" stroke="#074663" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

  {!mini && (
    <g>
      {punten.map((p, i) => p.ok && (
        <path class="vink" style={`--i:${i}`} d={`M59 ${rij(i) + 8}l4 4 7-8`} fill="none" stroke="#1f8a5b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      ))}
      <circle class="let-op" cx="64" cy={rij(2) + 8} r="8" fill="none" stroke="#ff6600" stroke-width="2" />
      <g class="loep">
        <circle cx="226" cy="96" r="15" fill="#fff" fill-opacity="0.35" stroke="#10283f" stroke-width="3" />
        <path d="M237 107l10 10" stroke="#10283f" stroke-width="5" stroke-linecap="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .vink, .let-op { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .vink, :global(.teken-js) .let-op, :global(.teken-js) .loep { opacity: 0; }
  .in-beeld .vink { animation: kennisbank-gidsen-google-ads-check-vink 0.4s cubic-bezier(.3,1.6,.5,1) calc(0.5s + var(--i) * 0.3s) forwards; }
  .in-beeld .let-op { animation: kennisbank-gidsen-google-ads-check-let-op 2.4s ease-in-out 2.4s infinite both; }
  .in-beeld .loep { animation: kennisbank-gidsen-google-ads-check-loep 7s ease-in-out 0.8s infinite both; }
  @keyframes kennisbank-gidsen-google-ads-check-vink { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-google-ads-check-let-op { 0% { opacity: 0; transform: scale(0.6); } 40% { opacity: 1; } 100% { opacity: 0; transform: scale(1.8); } }
  @keyframes kennisbank-gidsen-google-ads-check-loep {
    0% { opacity: 0; transform: translateY(0); }
    10% { opacity: 1; }
    50% { transform: translateY(124px); }
    90% { opacity: 1; }
    100% { opacity: 0; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .vink, .in-beeld .let-op, .in-beeld .loep { animation: none; } }
</style>
