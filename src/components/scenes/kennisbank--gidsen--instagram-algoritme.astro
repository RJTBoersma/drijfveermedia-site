---
// Scène voor /kennisbank/gidsen/instagram-algoritme/: een telefoon met een bericht, en rechts de feed van een volger waarin berichten op volgorde staan.
// Als hij leeft: het bericht wordt bewaard, gedeeld en krijgt reacties; die signalen gaan naar de feed en jouw bericht schuift van plek drie naar plek een.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const hart = (x: number, y: number) => `M${x} ${y + 4}c0-5 7-5 7 0c0-5 7-5 7 0c0 5-7 9-7 9s-7-4-7-9z`;
const bubbel = (x: number, y: number) => `M${x + 3} ${y}h9a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-6l-4 3v-3a3 3 0 0 1-2-3v-6a3 3 0 0 1 3-3z`;
const vliegtuig = (x: number, y: number) => `M${x} ${y + 6}l15-6-5 14-3-6z`;
const bladwijzer = (x: number, y: number) => `M${x} ${y}h11v14l-5.5-4-5.5 4z`;
const signalen = [
  { d: hart(66, 196), fill: '#ff6600' },
  { d: bubbel(92, 195), fill: '#074663' },
  { d: vliegtuig(118, 196), fill: '#074663' },
  { d: bladwijzer(146, 195), fill: '#ff6600' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een telefoon met een bericht dat wordt bewaard, gedeeld en geliket. Die signalen gaan naar de feed van een volger, waar het bericht van plek drie naar plek een schuift.'}>
  <!-- telefoon -->
  <rect x="44" y="18" width="134" height="236" rx="20" fill="#10283f" />
  <rect x="52" y="30" width="118" height="212" rx="12" fill="#fff" />
  <circle class="v" cx="68" cy="48" r="8" />
  <text x="82" y="52" font-size="10" font-weight="800">Jouw bedrijf</text>
  <rect class="v" x="58" y="64" width="106" height="118" rx="6" />
  <path class="l" d="M64 172l26-30 18 20 12-12 38 26" />
  <circle class="o" cx="142" cy="90" r="8" />
  <path d={hart(66, 196)} fill="none" stroke="#074663" stroke-width="1.8" stroke-linejoin="round" />
  <path d={bubbel(92, 195)} fill="none" stroke="#074663" stroke-width="1.8" stroke-linejoin="round" />
  <path d={vliegtuig(118, 196)} fill="none" stroke="#074663" stroke-width="1.8" stroke-linejoin="round" />
  <path d={bladwijzer(146, 195)} fill="none" stroke="#074663" stroke-width="1.8" stroke-linejoin="round" />
  <rect x="62" y="220" width="84" height="6" rx="3" fill="#d9e1ea" />

  <!-- route naar de feed -->
  <path d="M182 136c24 0 38-10 58-10" fill="none" stroke="#c9d3dd" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="2 7" />

  <!-- de feed van een volger -->
  <rect x="244" y="30" width="212" height="210" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="260" y="54" font-size="12" font-weight="800">Feed van een volger</text>
  <g class="rij rij-1">
    <rect x="258" y="68" width="184" height="44" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <circle class="v" cx="278" cy="90" r="10" />
    <rect x="296" y="82" width="90" height="7" rx="3.5" fill="#c9d3dd" />
    <rect x="296" y="95" width="60" height="7" rx="3.5" fill="#e8eef4" />
  </g>
  <g class="rij rij-2">
    <rect x="258" y="122" width="184" height="44" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <circle class="v" cx="278" cy="144" r="10" />
    <rect x="296" y="136" width="110" height="7" rx="3.5" fill="#c9d3dd" />
    <rect x="296" y="149" width="70" height="7" rx="3.5" fill="#e8eef4" />
  </g>
  <g class="rij rij-jij">
    <rect x="258" y="176" width="184" height="44" rx="10" fill="#fff4ec" stroke="#ff6600" stroke-width="2" />
    <circle cx="278" cy="198" r="10" fill="#074663" />
    <text x="296" y="196" font-size="11" font-weight="800">Jouw bericht</text>
    <rect x="296" y="203" width="80" height="7" rx="3.5" fill="#ffd2b0" />
  </g>

  {!mini && (
    <g>
      {signalen.map((s, i) => <path class="signaal" style={`--i:${i}`} d={s.d} fill={s.fill} />)}
      <g class="een">
        <circle cx="434" cy="178" r="13" fill="#ff6600" stroke="#fff" stroke-width="2" />
        <text x="434" y="183" font-size="12" font-weight="900" text-anchor="middle" style="fill:#fff">1</text>
      </g>
    </g>
  )}
</svg>
<style>
  .signaal, .een { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .signaal { opacity: 0; }
  :global(.teken-js) .een { opacity: 0; }
  .in-beeld .signaal { animation: kennisbank-gidsen-instagram-algoritme-signaal 6s ease-in-out calc(0.4s + var(--i) * 0.35s) infinite both; }
  .in-beeld .rij-jij { animation: kennisbank-gidsen-instagram-algoritme-omhoog 1s cubic-bezier(.5,.1,.25,1) 2s forwards; }
  .in-beeld .rij-1, .in-beeld .rij-2 { animation: kennisbank-gidsen-instagram-algoritme-omlaag 1s cubic-bezier(.5,.1,.25,1) 2s forwards; }
  .in-beeld .een { animation: kennisbank-gidsen-instagram-algoritme-een 0.5s cubic-bezier(.3,1.6,.5,1) 3s forwards; }
  @keyframes kennisbank-gidsen-instagram-algoritme-signaal {
    0% { opacity: 0; transform: none; }
    8% { opacity: 1; transform: scale(1.25); }
    16% { opacity: 1; transform: scale(1); }
    40% { opacity: 1; transform: translate(150px, -60px) scale(0.8); }
    48%, 100% { opacity: 0; transform: translate(170px, -64px) scale(0.6); }
  }
  @keyframes kennisbank-gidsen-instagram-algoritme-omhoog { to { transform: translateY(-108px); } }
  @keyframes kennisbank-gidsen-instagram-algoritme-omlaag { to { transform: translateY(54px); } }
  @keyframes kennisbank-gidsen-instagram-algoritme-een { from { opacity: 0; transform: translateY(-108px) scale(0.3); } to { opacity: 1; transform: translateY(-108px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .signaal, .in-beeld .rij-jij, .in-beeld .rij-1, .in-beeld .rij-2, .in-beeld .een { animation: none; } }
</style>
