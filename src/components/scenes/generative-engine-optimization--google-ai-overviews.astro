---
// Scène voor /generative-engine-optimization/google-ai-overviews/: een zoekresultatenpagina met bovenaan een AI-overzicht.
// De samenvatting schrijft zichzelf, en rechts licht jouw site op als bron waar de bezoeker op klikt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const regels = [
  { y: 104, w: 220 },
  { y: 120, w: 236 },
  { y: 136, w: 196 },
  { y: 152, w: 150 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: een Google-zoekresultaat met bovenaan een AI-overzicht. De samenvatting verschijnt regel voor regel en jouw site licht op als bron, waarna iemand erop klikt.'} aria-hidden={mini ? 'true' : undefined}>
  <!-- Browser -->
  <rect x="16" y="16" width="448" height="238" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="36" y="30" width="250" height="26" rx="13" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="52" cy="43" r="5" fill="none" stroke="#074663" stroke-width="2" />
  <path d="M56 47l4 4" stroke="#074663" stroke-width="2" stroke-linecap="round" />
  <text x="68" y="47" font-size="11" font-weight="600">wat kost een dakkapel</text>

  <!-- AI-overzicht -->
  <rect x="36" y="68" width="408" height="112" rx="12" fill="#f4f7fa" stroke="#d9e1ea" stroke-width="1.5" />
  <path d="M54 76l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" fill="#ff6600" />
  <text x="68" y="89" font-size="11" font-weight="800">AI-overzicht</text>
  {regels.map((r) => <rect class="v" x="52" y={r.y} width={r.w} height="8" rx="4" />)}
  <rect x="316" y="84" width="116" height="26" rx="8" fill="#fff" stroke="#ff6600" stroke-width="1.5" />
  <text x="326" y="101" font-size="10" font-weight="800">jouwsite.nl</text>
  <rect x="316" y="116" width="116" height="26" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
  <rect class="v" x="326" y="125" width="70" height="8" rx="4" />
  <rect x="316" y="148" width="116" height="26" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
  <rect class="v" x="326" y="157" width="84" height="8" rx="4" />

  <!-- Gewone resultaten -->
  <rect x="36" y="194" width="150" height="9" rx="4.5" fill="#074663" opacity="0.6" />
  <rect class="v" x="36" y="208" width="260" height="7" rx="3.5" />
  <rect x="36" y="226" width="130" height="9" rx="4.5" fill="#074663" opacity="0.6" />
  <rect class="v" x="36" y="240" width="220" height="7" rx="3.5" />

  {!mini && (
    <g>
      {regels.map((r, i) => <rect class="regel" style={`--i:${i}`} x="52" y={r.y} width={r.w} height="8" rx="4" fill="#10283f" opacity="0.75" />)}
      <path class="vonk" d="M54 76l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" fill="#ff6600" />
      <rect class="gloed" x="313" y="81" width="122" height="32" rx="10" fill="none" stroke="#ff6600" stroke-width="3" />
      <g class="muis">
        <path d="M0 0l0 18 5-4 3.5 7 3-1.5-3.5-7 6.5 0z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .regel { transform-box: fill-box; transform-origin: left center; }
  .vonk { transform-box: fill-box; transform-origin: center; }
  .muis { transform: translate(250px, 230px); }
  :global(.teken-js) .regel { transform: scaleX(0); }
  :global(.teken-js) .gloed { opacity: 0; }
  .in-beeld .regel { animation: generative-engine-optimization--google-ai-overviews-schrijf 0.6s ease-out forwards; animation-delay: calc(0.5s + var(--i) * 0.35s); }
  .in-beeld .vonk { animation: generative-engine-optimization--google-ai-overviews-vonk 3s ease-in-out infinite; }
  .in-beeld .gloed { animation: generative-engine-optimization--google-ai-overviews-gloed 6s ease-in-out 1.6s infinite; }
  .in-beeld .muis { animation: generative-engine-optimization--google-ai-overviews-muis 6s ease-in-out 1.6s infinite; }
  @keyframes generative-engine-optimization--google-ai-overviews-schrijf { to { transform: none; } }
  @keyframes generative-engine-optimization--google-ai-overviews-vonk { 0%, 100% { transform: scale(1) rotate(0); } 50% { transform: scale(1.35) rotate(45deg); } }
  @keyframes generative-engine-optimization--google-ai-overviews-gloed { 0%, 25% { opacity: 0; } 40%, 80% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes generative-engine-optimization--google-ai-overviews-muis {
    0% { transform: translate(250px, 230px); }
    35% { transform: translate(372px, 100px); }
    40% { transform: translate(372px, 100px) scale(0.85); }
    45%, 80% { transform: translate(372px, 100px); }
    100% { transform: translate(250px, 230px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .regel, .in-beeld .vonk, .in-beeld .gloed, .in-beeld .muis { animation: none; }
  }
</style>
