---
// Scène voor /kennisbank/gidsen/vibe-coding/: een prompt in gewone taal wordt code, en de code wordt een website.
// De coderegels schrijven zichzelf, één regel krijgt een waarschuwing, en de cursor in het promptveld knippert rustig.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const code = [
  { y: 120, x: 40, w: 96 },
  { y: 136, x: 52, w: 120 },
  { y: 152, x: 52, w: 84 },
  { y: 168, x: 64, w: 104 },
  { y: 200, x: 52, w: 92 },
  { y: 216, x: 40, w: 60 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een opdracht in gewone taal verandert in code en daarna in een website. Eén regel code krijgt een waarschuwing.'}>
  <!-- prompt -->
  <rect x="22" y="22" width="436" height="44" rx="22" fill="#fff" stroke="#074663" stroke-width="2" />
  <path d="M44 38l2.4 5.6 5.6 2.4-5.6 2.4-2.4 5.6-2.4-5.6-5.6-2.4 5.6-2.4z" fill="#ff6600" />
  <text x="62" y="49" font-size="11.5" font-weight="700">Maak een website voor Bakkerij De Vries (voorbeeld)</text>
  <rect class={mini ? undefined : 'knipper'} x="438" y="36" width="2.5" height="16" rx="1" fill="#10283f" />

  <!-- code -->
  <rect x="22" y="86" width="190" height="162" rx="12" fill="#10283f" />
  <text x="36" y="106" font-size="9.5" font-weight="700" style="fill:#9fb3c4">index.html</text>
  {code.map((c, i) => (
    <rect class={mini ? undefined : `regel regel${i}`} x={c.x} y={c.y} width={c.w} height="6" rx="3" fill={i % 2 ? '#5f87a6' : '#9fb3c4'} />
  ))}
  <rect x="34" y="181" width="168" height="14" rx="4" fill="#ff6600" fill-opacity="0.2" stroke="#ff6600" stroke-width="1.2" />
  <rect class={mini ? undefined : 'regel regel6'} x="52" y="185" width="110" height="6" rx="3" fill="#ffb98a" />
  <g class={mini ? undefined : 'let-op'}>
    <path d="M192 177l9 16h-18z" fill="#ff6600" stroke="#10283f" stroke-width="1.5" stroke-linejoin="round" />
    <path d="M192 183v5" stroke="#fff" stroke-width="2" stroke-linecap="round" />
    <circle cx="192" cy="190.5" r="1.1" fill="#fff" />
  </g>

  <!-- pijl -->
  <path class="a" d="M222 166h30" />
  <path class="a" d="M246 159l7 7-7 7" />

  <!-- website -->
  <g class={mini ? undefined : 'site'}>
    <rect x="264" y="86" width="194" height="162" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <path d="M264 106H458" stroke="#e8eef4" stroke-width="2" />
    <circle cx="278" cy="96" r="3.5" fill="#d9e1ea" />
    <circle cx="290" cy="96" r="3.5" fill="#d9e1ea" />
    <text x="280" y="128" font-size="12" font-weight="800">Bakkerij De Vries</text>
    <rect x="280" y="138" width="120" height="6" rx="3" fill="#d9e1ea" />
    <rect x="280" y="149" width="96" height="6" rx="3" fill="#d9e1ea" />
    <rect class="v" x="280" y="164" width="162" height="50" rx="8" />
    <path class="l" d="M300 204c0-14 10-22 22-22s22 8 22 22z" />
    <path class="l" d="M356 204c0-10 8-16 16-16s16 6 16 16z" />
    <rect x="280" y="222" width="64" height="16" rx="6" fill="#ff6600" />
  </g>
</svg>
<style>
  .regel, .site, .let-op { transform-box: fill-box; }
  .regel { transform-origin: left center; }
  .let-op { transform-origin: center; }
  :global(.teken-js) .regel { transform: scaleX(0); }
  :global(.teken-js) .site { opacity: 0; }
  :global(.teken-js) .let-op { opacity: 0; }
  .in-beeld .regel0 { animation: kennisbank-gidsen-vibe-coding-regel 0.35s ease-out 0.3s forwards; }
  .in-beeld .regel1 { animation: kennisbank-gidsen-vibe-coding-regel 0.35s ease-out 0.55s forwards; }
  .in-beeld .regel2 { animation: kennisbank-gidsen-vibe-coding-regel 0.35s ease-out 0.8s forwards; }
  .in-beeld .regel3 { animation: kennisbank-gidsen-vibe-coding-regel 0.35s ease-out 1.05s forwards; }
  .in-beeld .regel6 { animation: kennisbank-gidsen-vibe-coding-regel 0.35s ease-out 1.3s forwards; }
  .in-beeld .regel4 { animation: kennisbank-gidsen-vibe-coding-regel 0.35s ease-out 1.55s forwards; }
  .in-beeld .regel5 { animation: kennisbank-gidsen-vibe-coding-regel 0.35s ease-out 1.8s forwards; }
  .in-beeld .site { animation: kennisbank-gidsen-vibe-coding-site 0.8s ease-out 2.1s forwards; }
  .in-beeld .let-op { animation: kennisbank-gidsen-vibe-coding-let-op 3s ease-in-out 2.6s infinite; }
  .in-beeld .knipper { animation: kennisbank-gidsen-vibe-coding-knipper 1.1s steps(1) infinite; }
  @keyframes kennisbank-gidsen-vibe-coding-regel { to { transform: none; } }
  @keyframes kennisbank-gidsen-vibe-coding-site { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-vibe-coding-let-op { 0%, 100% { opacity: 1; transform: none; } 50% { opacity: 1; transform: scale(1.18); } }
  @keyframes kennisbank-gidsen-vibe-coding-knipper { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .regel0, .in-beeld .regel1, .in-beeld .regel2, .in-beeld .regel3, .in-beeld .regel4, .in-beeld .regel5, .in-beeld .regel6 { animation: none; transform: none; }
    .in-beeld .site, .in-beeld .let-op { animation: none; opacity: 1; transform: none; }
    .in-beeld .knipper { animation: none; }
  }
</style>
