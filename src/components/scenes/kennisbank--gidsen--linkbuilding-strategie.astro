---
// Scène voor /kennisbank/gidsen/linkbuilding-strategie/: een prikbord met in het midden jouw site en eromheen vier kaartjes
// (branchesite, lokale krant, leverancier, vakblog), verbonden met touwtjes. Eén verbinding is nog gebroken.
// Als hij leeft: de gebroken verbinding wordt hersteld en krijgt een vinkje, een punaise valt op een nieuw kaartje
// en over de touwtjes loopt rustig een signaal naar jouw site.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const kaarten = [
  { x: 52, y: 40, t: 'Branchesite' },
  { x: 330, y: 40, t: 'Lokale krant' },
  { x: 52, y: 182, t: 'Leverancier' },
  { x: 330, y: 182, t: 'Vakblog' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: een prikbord met jouw website in het midden, verbonden met touwtjes aan een branchesite, een lokale krant, een leverancier en een vakblog. Eén verbinding wordt hersteld.'} aria-hidden={mini ? 'true' : undefined}>
  <!-- prikbord -->
  <rect x="24" y="16" width="432" height="238" rx="14" fill="#f6efe6" stroke="#e3d6c4" stroke-width="2" />
  <rect x="34" y="26" width="412" height="218" rx="8" fill="none" stroke="#efe4d4" stroke-width="2" />

  <!-- touwtjes -->
  <path d="M150 64L196 118" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
  <path d="M330 64L284 118" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
  <path d="M150 206L196 160" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
  <path class="breuk" d="M330 206L312 188M298 174L284 160" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="4 5" />

  <!-- jouw site -->
  <rect x="182" y="102" width="116" height="72" rx="10" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path d="M182 112a10 10 0 0 1 10-10h96a10 10 0 0 1 10 10v6H182z" fill="#074663" />
  <text x="240" y="140" font-size="12" font-weight="900" text-anchor="middle">Jouw site</text>
  <rect x="200" y="150" width="80" height="8" rx="4" fill="#e8eef4" />
  <circle cx="240" cy="98" r="6" fill="#ff6600" stroke="#fff" stroke-width="2" />

  {kaarten.map((k, i) => (
    <g>
      <rect x={k.x} y={k.y} width="98" height="48" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" transform={`rotate(${i % 2 ? 2 : -2} ${k.x + 49} ${k.y + 24})`} />
      <text x={k.x + 49} y={k.y + 22} font-size="10.5" font-weight="800" text-anchor="middle">{k.t}</text>
      <rect x={k.x + 18} y={k.y + 30} width="62" height="6" rx="3" fill="#e8eef4" />
      <circle cx={k.x + 49} cy={k.y + 2} r="5" fill="#074663" stroke="#fff" stroke-width="2" />
    </g>
  ))}

  <!-- nieuw kaartje -->
  <rect x="196" y="204" width="88" height="36" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="5 4" />
  <text x="240" y="226" font-size="9.5" text-anchor="middle" class="zacht">Volgende link</text>

  {!mini && (
    <g>
      <path class="hersteld" d="M330 206L284 160" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" pathLength="1" />
      <g class="vinkje"><circle cx="307" cy="183" r="10" fill="#1f8a5b" /><path d="M302 183l3.5 3.5 6-7" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="punaise"><circle cx="240" cy="206" r="6" fill="#ff6600" stroke="#fff" stroke-width="2" /></g>
      <circle class="signaal" cx="150" cy="64" r="4.5" fill="#074663" />
    </g>
  )}
</svg>
<style>
  .hersteld { stroke-dasharray: 1; }
  :global(.teken-js) .hersteld { stroke-dashoffset: 1; }
  .in-beeld .hersteld { animation: kennisbank-gidsen-linkbuilding-strategie-lijn 1s cubic-bezier(.6,.1,.3,1) 0.8s forwards; }
  .vinkje { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .vinkje { opacity: 0; }
  .in-beeld .vinkje { animation: kennisbank-gidsen-linkbuilding-strategie-pop 0.45s cubic-bezier(.3,1.6,.5,1) 1.8s forwards; }
  :global(.teken-js) .punaise { opacity: 0; }
  .in-beeld .punaise { animation: kennisbank-gidsen-linkbuilding-strategie-val 0.6s cubic-bezier(.5,0,.6,1.4) 2.3s forwards; }
  :global(.teken-js) .signaal { opacity: 0; }
  .in-beeld .signaal { animation: kennisbank-gidsen-linkbuilding-strategie-signaal 4s ease-in-out 2.8s infinite; }
  @keyframes kennisbank-gidsen-linkbuilding-strategie-lijn { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-gidsen-linkbuilding-strategie-pop { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-linkbuilding-strategie-val { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-linkbuilding-strategie-signaal { 0% { opacity: 0; transform: translate(0, 0); } 15% { opacity: 1; } 70% { opacity: 1; transform: translate(46px, 54px); } 100% { opacity: 0; transform: translate(46px, 54px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .hersteld, .in-beeld .vinkje, .in-beeld .punaise, .in-beeld .signaal { animation: none; } }
</style>
