---
// Scène voor /kennisbank/gidsen/persona-maken/: uitspraken uit klantinterviews (tekstwolkjes) worden een personakaart met naam, doel, frustratie en gedrag.
// Als hij leeft: een punaise prikt de kaart vast, de regels op de kaart vullen zich en de wolkjes lichten om de beurt rustig op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const rijen = [
  { y: 138, t: 'Doel', w: 150 },
  { y: 172, t: 'Frustratie', w: 118 },
  { y: 206, t: 'Gedrag', w: 136 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: uitspraken uit klantgesprekken worden een personakaart van Ans, 63, met haar doel, frustratie en gedrag.'}>
  <!-- tekstwolkjes uit interviews -->
  <g class="wolk w1">
    <rect x="18" y="46" width="160" height="40" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <path d="M150 85l14 12-2-13" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-linejoin="round" />
    <text x="98" y="71" font-size="12" font-weight="800" text-anchor="middle">"Komt hij op tijd?"</text>
  </g>
  <g class="wolk w2">
    <rect x="18" y="114" width="160" height="40" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <path d="M150 153l14 12-2-13" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-linejoin="round" />
    <text x="98" y="139" font-size="12" font-weight="800" text-anchor="middle">"Graag een vaste prijs"</text>
  </g>
  <g class="wolk w3">
    <rect x="18" y="182" width="160" height="40" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <path d="M150 221l14 12-2-13" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-linejoin="round" />
    <text x="98" y="207" font-size="12" font-weight="800" text-anchor="middle">"Ik bel liever"</text>
  </g>
  <path class="a" d="M184 134h22M198 126l8 8-8 8" />

  <!-- personakaart -->
  <rect x="216" y="28" width="244" height="214" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle class="v" cx="262" cy="82" r="30" />
  <circle cx="262" cy="74" r="11" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M242 104c3-12 11-18 20-18s17 6 20 18" />
  <text x="306" y="76" font-size="17" font-weight="900">Ans, 63</text>
  <text x="306" y="96" font-size="11" class="zacht">Verzonnen voorbeeld</text>
  {rijen.map((r) => (
    <g>
      <text x="236" y={r.y} font-size="11" font-weight="800" class="zacht">{r.t}</text>
      <rect class="v" x="236" y={r.y + 7} width="204" height="9" rx="4.5" />
      <rect x="236" y={r.y + 7} width={r.w} height="9" rx="4.5" fill="#074663" />
    </g>
  ))}
  <circle cx="338" cy="30" r="7" fill="#ff6600" />

  {!mini && (
    <g>
      {rijen.map((r, i) => (
        <rect class="vul" style={`animation-delay:${0.9 + i * 0.3}s`} x="236" y={r.y + 7} width={r.w} height="9" rx="4.5" fill="#074663" />
      ))}
      <g class="punaise">
        <circle cx="338" cy="30" r="9" fill="#ff6600" stroke="#fff" stroke-width="2.5" />
        <circle cx="335" cy="27" r="2.5" fill="#fff" opacity="0.7" />
      </g>
    </g>
  )}
</svg>
<style>
  .vul { transform-box: fill-box; transform-origin: 0 50%; }
  :global(.teken-js) .vul { transform: scaleX(0); }
  :global(.teken-js) .punaise { opacity: 0; }
  .in-beeld .vul { animation: kennisbank-gidsen-persona-maken-vul 0.9s cubic-bezier(.6,.1,.3,1) forwards; }
  .in-beeld .punaise { animation: kennisbank-gidsen-persona-maken-prik 0.5s cubic-bezier(.3,1.6,.5,1) 0.4s forwards; }
  .in-beeld .wolk { animation: kennisbank-gidsen-persona-maken-licht 6s ease-in-out 1.8s infinite; }
  .in-beeld .w2 { animation-delay: 3.8s; }
  .in-beeld .w3 { animation-delay: 5.8s; }
  @keyframes kennisbank-gidsen-persona-maken-vul { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes kennisbank-gidsen-persona-maken-prik { from { opacity: 0; transform: translateY(-18px); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-persona-maken-licht { 0%, 30%, 100% { transform: none; } 12% { transform: translateX(6px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .vul, .in-beeld .punaise, .in-beeld .wolk { animation: none; } }
</style>
