---
// Scène voor /kennisbank/gidsen/google-gemini/: een telefoon met een AI-assistent die put uit mail, documenten, kaarten en zoeken.
// In het antwoord staat een kaartje met jouw bedrijf. In de volledige versie stromen gegevens naar de telefoon en pulseert de pin.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een telefoon met een AI-assistent die gegevens haalt uit mail, documenten, kaarten en zoeken, en jouw bedrijf op de kaart toont.'}>
  <!-- verbindingen naar de telefoon -->
  <path d="M118 74H170M110 190H170M310 74H362M310 190H370" fill="none" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round" />

  <!-- links: mail en documenten -->
  <rect x="58" y="54" width="60" height="40" rx="6" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M60 58l28 20 28-20" />
  <text x="88" y="112" text-anchor="middle" font-size="10.5" font-weight="700" class="zacht">Mail</text>
  <rect x="66" y="160" width="44" height="58" rx="6" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M76 176h24M76 188h24M76 200h16" />
  <text x="88" y="236" text-anchor="middle" font-size="10.5" font-weight="700" class="zacht">Documenten</text>

  <!-- rechts: kaarten en zoeken -->
  <circle cx="392" cy="74" r="30" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path class="o" d="M380 70c0-7 5-12 12-12s12 5 12 12c0 9-12 20-12 20s-12-11-12-20z" />
  <circle cx="392" cy="70" r="4.5" fill="#fff" />
  <text x="392" y="122" text-anchor="middle" font-size="10.5" font-weight="700" class="zacht">Kaarten</text>
  <circle cx="400" cy="190" r="30" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <circle class="l" cx="396" cy="186" r="10" />
  <path class="l" d="M403 193l9 9" />
  <text x="400" y="238" text-anchor="middle" font-size="10.5" font-weight="700" class="zacht">Zoeken</text>

  <!-- de telefoon -->
  <rect x="170" y="14" width="140" height="242" rx="22" fill="#10283f" />
  <rect x="178" y="30" width="124" height="210" rx="14" fill="#fff" />
  <rect x="222" y="20" width="36" height="5" rx="2.5" fill="#2c4660" />
  <rect x="200" y="42" width="94" height="34" rx="10" fill="#074663" />
  <text x="208" y="56" font-size="9.5" font-weight="700" style="fill:#fff">Loodgieter in</text>
  <text x="208" y="69" font-size="9.5" font-weight="700" style="fill:#fff">Assen, nu open?</text>
  <rect x="186" y="86" width="100" height="6" rx="3" fill="#d9e1ea" />
  <rect x="186" y="98" width="78" height="6" rx="3" fill="#d9e1ea" />
  <!-- kaartje in het antwoord -->
  <rect x="186" y="112" width="108" height="86" rx="8" fill="#e9eef3" />
  <path d="M186 160c26-10 46 6 70-4s28-6 38-2" fill="none" stroke="#fff" stroke-width="7" />
  <path d="M226 112c4 26-4 52 6 86" fill="none" stroke="#fff" stroke-width="5" />
  <path class="o" d="M248 140c0-7 5-12 12-12s12 5 12 12c0 9-12 20-12 20s-12-11-12-20z" />
  <circle cx="260" cy="140" r="4.5" fill="#fff" />
  <rect x="192" y="172" width="96" height="20" rx="6" fill="#fff" />
  <text x="199" y="185.5" font-size="9.5" font-weight="800">Jouw bedrijf</text>
  <circle cx="278" cy="182" r="4" fill="#1a7a50" />
  <rect x="186" y="208" width="108" height="20" rx="10" fill="#e8eef4" />
  <rect x="194" y="215.5" width="54" height="5" rx="2.5" fill="#c4d0dc" />

  {!mini && (
    <g>
      <circle class="ring" cx="260" cy="158" r="10" fill="none" stroke="#ff6600" stroke-width="2" />
      <circle class="data d1" cx="118" cy="74" r="3.5" fill="#ff6600" />
      <circle class="data d2" cx="110" cy="190" r="3.5" fill="#ff6600" />
      <circle class="data d3" cx="362" cy="74" r="3.5" fill="#ff6600" />
      <circle class="data d4" cx="370" cy="190" r="3.5" fill="#ff6600" />
      <g class="open">
        <rect x="230" y="198" width="66" height="22" rx="11" fill="#fff" stroke="#1a7a50" stroke-width="2" />
        <text x="242" y="213" font-size="9.5" font-weight="800">Nu open</text>
      </g>
    </g>
  )}
</svg>
<style>
  .ring, .data, .open { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .ring, :global(.teken-js) .data { opacity: 0; }
  :global(.teken-js) .open { opacity: 0; transform: translateY(8px); }
  .in-beeld .ring { animation: kennisbank-gidsen-google-gemini-ring 3s ease-out 1.2s infinite; }
  .in-beeld .d1 { animation: kennisbank-gidsen-google-gemini-rechts 3.2s ease-in-out 0.3s infinite; }
  .in-beeld .d2 { animation: kennisbank-gidsen-google-gemini-rechts2 3.2s ease-in-out 1.1s infinite; }
  .in-beeld .d3 { animation: kennisbank-gidsen-google-gemini-links 3.2s ease-in-out 0.7s infinite; }
  .in-beeld .d4 { animation: kennisbank-gidsen-google-gemini-links2 3.2s ease-in-out 1.5s infinite; }
  .in-beeld .open { animation: kennisbank-gidsen-google-gemini-open 0.6s cubic-bezier(.3,1.6,.5,1) 2s forwards; }
  @keyframes kennisbank-gidsen-google-gemini-ring { 0% { opacity: .9; transform: scale(.4); } 70%, 100% { opacity: 0; transform: scale(2.2); } }
  @keyframes kennisbank-gidsen-google-gemini-rechts { 0% { opacity: 0; transform: none; } 15% { opacity: 1; } 60% { opacity: 1; transform: translateX(52px); } 75%, 100% { opacity: 0; transform: translateX(52px); } }
  @keyframes kennisbank-gidsen-google-gemini-rechts2 { 0% { opacity: 0; transform: none; } 15% { opacity: 1; } 60% { opacity: 1; transform: translateX(60px); } 75%, 100% { opacity: 0; transform: translateX(60px); } }
  @keyframes kennisbank-gidsen-google-gemini-links { 0% { opacity: 0; transform: none; } 15% { opacity: 1; } 60% { opacity: 1; transform: translateX(-52px); } 75%, 100% { opacity: 0; transform: translateX(-52px); } }
  @keyframes kennisbank-gidsen-google-gemini-links2 { 0% { opacity: 0; transform: none; } 15% { opacity: 1; } 60% { opacity: 1; transform: translateX(-60px); } 75%, 100% { opacity: 0; transform: translateX(-60px); } }
  @keyframes kennisbank-gidsen-google-gemini-open { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .ring, .in-beeld .d1, .in-beeld .d2, .in-beeld .d3, .in-beeld .d4 { animation: none; }
    .in-beeld .open { animation: none; opacity: 1; transform: none; }
  }
</style>
