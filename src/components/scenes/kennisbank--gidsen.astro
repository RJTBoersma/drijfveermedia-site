---
// Scène voor /kennisbank/gidsen/: een kaartenbak met gidsen in vier vakken, met tabbladen per onderwerp.
// Als hij leeft: één gids schuift omhoog uit de bak en een vergrootglas zweeft rustig langs de tabbladen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const vakken = [
  { x: 52, kleur: '#074663' },
  { x: 152, kleur: '#4f7d96' },
  { x: 252, kleur: '#ff6600' },
  { x: 352, kleur: '#9fb0c0' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een kaartenbak vol gidsen in vier vakken, waaruit één gids omhoog schuift terwijl een vergrootglas langs de tabbladen gaat.'}>
  <!-- kaarten per vak -->
  {vakken.map((v) => (
    <g>
      <rect x={v.x + 4} y="86" width="80" height="100" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <rect x={v.x} y="100" width="80" height="100" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <path d={`M${v.x + 10} 100v-10a6 6 0 0 1 6-6h24a6 6 0 0 1 6 6v10`} fill={v.kleur} />
      <rect x={v.x + 12} y="118" width="50" height="6" rx="3" fill="#e8eef4" />
      <rect x={v.x + 12} y="130" width="40" height="6" rx="3" fill="#e8eef4" />
    </g>
  ))}

  <!-- bak -->
  <path d="M30 150h420l-14 92a10 10 0 0 1-10 8H54a10 10 0 0 1-10-8z" fill="#e8eef4" stroke="#074663" stroke-width="2.5" stroke-linejoin="round" />
  <path d="M30 150h420" stroke="#074663" stroke-width="2.5" stroke-linecap="round" />
  <rect x="210" y="186" width="60" height="22" rx="11" fill="#fff" stroke="#074663" stroke-width="2" />
  <path d="M226 197h28" stroke="#074663" stroke-width="2.5" stroke-linecap="round" />

  {!mini && (
    <g>
      <g class="eruit">
        <rect x="252" y="100" width="80" height="100" rx="8" fill="#fff" stroke="#074663" stroke-width="2" />
        <path d="M262 100v-10a6 6 0 0 1 6-6h24a6 6 0 0 1 6 6v10" fill="#ff6600" />
        <rect x="264" y="118" width="54" height="7" rx="3.5" fill="#10283f" />
        <rect x="264" y="132" width="46" height="6" rx="3" fill="#e8eef4" />
        <rect x="264" y="144" width="50" height="6" rx="3" fill="#e8eef4" />
        <path d="M266 162l5 5 9-10" fill="none" stroke="#1f8a5b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <g class="glas">
        <circle cx="96" cy="58" r="20" fill="#ffffff" fill-opacity="0.6" stroke="#10283f" stroke-width="3" />
        <path d="M110 72l14 14" stroke="#10283f" stroke-width="4" stroke-linecap="round" />
        <path d="M86 52a11 11 0 0 1 9-6" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
      </g>
    </g>
  )}
</svg>
<style>
  :global(.teken-js) .eruit { opacity: 0; }
  .in-beeld .eruit { animation: kennisbank-gidsen-eruit 0.9s cubic-bezier(.3,1.3,.5,1) 0.5s forwards; }
  :global(.teken-js) .glas { opacity: 0; }
  .in-beeld .glas { animation: kennisbank-gidsen-glas 8s ease-in-out 1.2s infinite; }
  @keyframes kennisbank-gidsen-eruit { from { opacity: 1; transform: translateY(0); } to { opacity: 1; transform: translateY(-62px); } }
  @keyframes kennisbank-gidsen-glas { 0%, 100% { opacity: 1; transform: translateX(0); } 50% { opacity: 1; transform: translateX(290px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .eruit, .in-beeld .glas { animation: none; } }
</style>
