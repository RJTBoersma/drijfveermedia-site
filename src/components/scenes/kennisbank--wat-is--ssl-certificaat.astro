---
// Scène voor /kennisbank/wat-is/ssl-certificaat/: een browser met https en een slotje praat met een server
// door een afgeschermde tunnel. Onder de tunnel ligt het certificaat met een zegel.
// Als hij leeft: het slotje klikt dicht, een dichte envelop reist steeds opnieuw door de tunnel
// en het zegel van het certificaat krijgt een vinkje.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een browser met https en een slotje stuurt een dichte envelop door een beveiligde tunnel naar de server. Daaronder ligt het certificaat met een zegel.'}>
  <!-- browser -->
  <rect x="14" y="52" width="162" height="140" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M15 76v-12a11 11 0 0 1 11-11h138a11 11 0 0 1 11 11v12z" fill="#e8eef4" />
  <circle cx="28" cy="64" r="3.5" fill="#d9e1ea" /><circle cx="40" cy="64" r="3.5" fill="#d9e1ea" /><circle cx="52" cy="64" r="3.5" fill="#d9e1ea" />
  <rect x="24" y="86" width="142" height="24" rx="12" fill="#fff" stroke="#074663" stroke-width="2" />
  <rect x="34" y="96" width="12" height="9" rx="2" fill="#1f8a5b" />
  <path class="ssl-beugel" d="M36.5 96v-3a3.5 3.5 0 0 1 7 0v3" fill="none" stroke="#1f8a5b" stroke-width="2.2" stroke-linecap="round" />
  <text x="52" y="102" font-size="10" font-weight="800">https://bedrijf.nl</text>
  <rect x="24" y="124" width="70" height="8" rx="4" fill="#e8eef4" />
  <rect x="24" y="140" width="128" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="24" y="154" width="104" height="7" rx="3.5" fill="#e8eef4" />
  <rect class="v" x="24" y="168" width="64" height="14" rx="7" />

  <!-- tunnel -->
  <rect x="180" y="106" width="150" height="40" rx="20" fill="#e8eef4" />
  <path class="l" d="M196 106h118M196 146h118" />
  <path d="M204 126h102" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="4 8" stroke-linecap="round" />

  <!-- server -->
  <rect x="334" y="70" width="132" height="34" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="334" y="110" width="132" height="34" rx="8" fill="#fff" stroke="#074663" stroke-width="2" />
  <rect x="334" y="150" width="132" height="34" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect class="v" x="348" y="82" width="60" height="10" rx="5" />
  <rect class="v" x="348" y="122" width="60" height="10" rx="5" />
  <rect class="v" x="348" y="162" width="60" height="10" rx="5" />
  <circle cx="446" cy="87" r="5" fill="#1f8a5b" /><circle cx="446" cy="127" r="5" fill="#1f8a5b" /><circle cx="446" cy="167" r="5" fill="#1f8a5b" />

  <!-- certificaat -->
  <rect x="196" y="172" width="150" height="86" rx="10" fill="#fff" stroke="#074663" stroke-width="2" />
  <text x="210" y="194" font-size="11.5" font-weight="800">Certificaat</text>
  <text x="210" y="211" font-size="9.5" class="zacht">bedrijf.nl</text>
  <rect x="210" y="221" width="70" height="6" rx="3" fill="#e8eef4" />
  <rect x="210" y="234" width="54" height="6" rx="3" fill="#e8eef4" />
  <path d="M310 228l-8 22 10-5 6 9 4-24z" fill="#ff6600" opacity="0.7" />
  <circle class="o" cx="314" cy="216" r="16" />
  <circle cx="314" cy="216" r="10" fill="none" stroke="#fff" stroke-width="2" />

  {!mini && (
    <g>
      <g class="ssl-envelop">
        <rect x="190" y="116" width="30" height="20" rx="3" fill="#fff" stroke="#074663" stroke-width="2" />
        <path d="M191 117l14 10 14-10" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
        <circle cx="219" cy="134" r="6" fill="#1f8a5b" />
      </g>
      <g class="ssl-vink"><circle cx="314" cy="216" r="10" fill="#1f8a5b" /><path d="M309 216l3.5 3.5 6.5-7" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
    </g>
  )}
</svg>
<style>
  .ssl-vink { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) [data-leeft] .ssl-beugel { transform: translateY(-3px); }
  :global(.teken-js) .ssl-envelop, :global(.teken-js) .ssl-vink { opacity: 0; }
  .in-beeld .ssl-beugel { animation: kennisbank--wat-is--ssl-certificaat-dicht 0.5s ease-in 0.4s forwards; }
  .in-beeld .ssl-envelop { animation: kennisbank--wat-is--ssl-certificaat-envelop 4.5s ease-in-out 1s infinite; }
  .in-beeld .ssl-vink { animation: kennisbank--wat-is--ssl-certificaat-vink 0.5s cubic-bezier(.3,1.6,.5,1) 0.9s forwards; }
  @keyframes kennisbank--wat-is--ssl-certificaat-dicht { to { transform: none; } }
  @keyframes kennisbank--wat-is--ssl-certificaat-envelop { 0% { opacity: 0; transform: translateX(0); } 10% { opacity: 1; } 75% { opacity: 1; transform: translateX(98px); } 85%, 100% { opacity: 0; transform: translateX(104px); } }
  @keyframes kennisbank--wat-is--ssl-certificaat-vink { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .ssl-beugel, .in-beeld .ssl-envelop, .in-beeld .ssl-vink { animation: none; } }
</style>
