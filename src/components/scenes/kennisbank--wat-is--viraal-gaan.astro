---
// Scène voor /kennisbank/wat-is/viraal-gaan/: één telefoon met een video wordt gedeeld naar drie telefoons, die elk weer drie mensen bereiken. Rechts telt een teller de views.
// Als hij leeft: deelbolletjes schieten van de eerste telefoon naar de volgende drie, daarna lichten de negen nieuwe kijkers één voor één op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const tak = [66, 146, 226];
const knopen = tak.flatMap((y) => [y - 26, y, y + 26]);
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: één telefoon met een video wordt gedeeld met drie mensen, die het elk weer met drie anderen delen. Een teller rechts laat het aantal views zien.'}>
  {tak.map((y) => <path d={`M100 143C140 143 150 ${y} 186 ${y}`} fill="none" stroke="#d9e1ea" stroke-width="2.5" />)}
  {tak.map((y) => [y - 26, y, y + 26].map((n) => <path d={`M224 ${y}C258 ${y} 262 ${n} 291 ${n}`} fill="none" stroke="#d9e1ea" stroke-width="2" />))}

  <rect x="36" y="88" width="64" height="110" rx="10" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <rect class="v" x="43" y="98" width="50" height="78" rx="4" />
  <path d="M61 124l17 13-17 13Z" fill="#074663" />
  <circle cx="68" cy="188" r="3" fill="#d9e1ea" />
  <g>
    <rect x="40" y="208" width="56" height="22" rx="11" fill="#ff6600" />
    <text x="68" y="223" font-size="11" font-weight="800" text-anchor="middle" style="fill:#fff">delen</text>
  </g>

  {tak.map((y) => (
    <g>
      <rect x="186" y={y - 30} width="38" height="60" rx="7" fill="#fff" stroke="#074663" stroke-width="2" />
      <rect class="v" x="191" y={y - 23} width="28" height="40" rx="3" />
      <path d={`M201 ${y - 9}l9 6-9 6Z`} fill="#074663" />
    </g>
  ))}

  {knopen.map((n) => <circle cx="300" cy={n} r="9" fill="#e8eef4" stroke="#074663" stroke-width="2" />)}

  <rect x="344" y="112" width="124" height="62" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="360" y="136" font-size="11" class="zacht">views</text>
  <text x="360" y="160" font-size="20" font-weight="900">48.210</text>
  <path class="a" d="M444 158l8-10 6 5 6-12" />
  <circle class="v" cx="360" cy="40" r="5" /><circle class="v" cx="392" cy="62" r="4" /><circle class="v" cx="430" cy="34" r="5" />
  <circle class="v" cx="372" cy="214" r="4" /><circle class="v" cx="412" cy="236" r="5" /><circle class="v" cx="446" cy="206" r="4" />

  {!mini && (
    <g>
      <circle class="viraal-deel viraal-deel-1" cx="100" cy="143" r="5" fill="#ff6600" />
      <circle class="viraal-deel viraal-deel-2" cx="100" cy="143" r="5" fill="#ff6600" />
      <circle class="viraal-deel viraal-deel-3" cx="100" cy="143" r="5" fill="#ff6600" />
      {knopen.map((n, i) => <circle class="viraal-knoop" cx="300" cy={n} r="9" fill="#ff6600" style={`animation-delay:${(1.6 + i * 0.22).toFixed(2)}s`} />)}
      <g class="viraal-plus">
        <rect x="402" y="80" width="66" height="24" rx="12" fill="#1f8a5b" />
        <text x="435" y="96.5" font-size="12" font-weight="800" text-anchor="middle" style="fill:#fff">+9 shares</text>
      </g>
    </g>
  )}
</svg>
<style>
  .viraal-deel, .viraal-knoop, .viraal-plus { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .viraal-deel, :global(.teken-js) .viraal-knoop, :global(.teken-js) .viraal-plus { opacity: 0; }
  .in-beeld .viraal-deel-1 { animation: kennisbank-wat-is-viraal-gaan-d1 6s ease-in-out 0.4s infinite; }
  .in-beeld .viraal-deel-2 { animation: kennisbank-wat-is-viraal-gaan-d2 6s ease-in-out 0.4s infinite; }
  .in-beeld .viraal-deel-3 { animation: kennisbank-wat-is-viraal-gaan-d3 6s ease-in-out 0.4s infinite; }
  .in-beeld .viraal-knoop { animation: kennisbank-wat-is-viraal-gaan-knoop 6s ease-out infinite; }
  .in-beeld .viraal-plus { animation: kennisbank-wat-is-viraal-gaan-plus 6s ease-out 0.4s infinite; }
  @keyframes kennisbank-wat-is-viraal-gaan-d1 { 0% { opacity: 0; transform: translate(0, 0); } 5% { opacity: 1; } 20% { opacity: 1; transform: translate(86px, -77px); } 26%, 100% { opacity: 0; transform: translate(86px, -77px); } }
  @keyframes kennisbank-wat-is-viraal-gaan-d2 { 0% { opacity: 0; transform: translate(0, 0); } 5% { opacity: 1; } 20% { opacity: 1; transform: translate(86px, 3px); } 26%, 100% { opacity: 0; transform: translate(86px, 3px); } }
  @keyframes kennisbank-wat-is-viraal-gaan-d3 { 0% { opacity: 0; transform: translate(0, 0); } 5% { opacity: 1; } 20% { opacity: 1; transform: translate(86px, 83px); } 26%, 100% { opacity: 0; transform: translate(86px, 83px); } }
  @keyframes kennisbank-wat-is-viraal-gaan-knoop { 0% { opacity: 0; transform: scale(0.3); } 8% { opacity: 1; transform: scale(1.15); } 12%, 55% { opacity: 1; transform: none; } 65%, 100% { opacity: 0; } }
  @keyframes kennisbank-wat-is-viraal-gaan-plus { 0%, 55% { opacity: 0; transform: translateY(6px); } 62%, 85% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .viraal-deel, .in-beeld .viraal-knoop, .in-beeld .viraal-plus { animation: none; } }
</style>
