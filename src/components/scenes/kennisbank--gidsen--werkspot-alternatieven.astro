---
// Scène voor /kennisbank/gidsen/werkspot-alternatieven/: links een klusplatform waar vier vakmensen betalen om op één klus
// te reageren, rechts jouw eigen bedrijf waar een klant rechtstreeks belt.
// Als hij leeft: de munten onder de vakmensen vallen weg, en rechts gaat de telefoon rustig over.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const vakmensen = [50, 92, 134, 176];
const persoon = (cx: number, cy: number) =>
  `M${cx} ${cy - 7}a4.5 4.5 0 1 1 0 .1zM${cx - 8} ${cy + 9}c1.5-5 4.5-7 8-7s6.5 2 8 7`;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: links een klusplatform waar vier vakmensen elk betalen om op dezelfde klus te reageren. Rechts jouw eigen bedrijf, waar een klant rechtstreeks belt zonder leadkosten.'}>
  <!-- klusplatform -->
  <rect x="20" y="34" width="200" height="206" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="36" y="58" font-size="12" font-weight="800">Klusplatform</text>
  <rect x="34" y="70" width="172" height="48" rx="8" fill="#f4f7fa" stroke="#d9e1ea" stroke-width="2" />
  <text x="46" y="90" font-size="11" font-weight="800">Schilderwerk, 3 kamers</text>
  <rect class="v" x="46" y="100" width="112" height="6" rx="3" />
  {vakmensen.map((x) => (
    <g>
      <path d={`M${x} 118v14`} stroke="#d9e1ea" stroke-width="2" />
      <circle cx={x} cy="150" r="15" fill="#e8eef4" />
      <path d={persoon(x, 150)} fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" />
      <circle cx={x} cy="190" r="9" fill="#ff6600" />
      <text x={x} y="194" font-size="10" font-weight="900" text-anchor="middle" style="fill:#fff">€</text>
    </g>
  ))}
  <text x="120" y="226" font-size="10.5" text-anchor="middle" class="zacht">4 betalen, 1 krijgt de klus</text>

  <!-- pijl -->
  <path class="l" d="M228 137h22" />
  <path class="l" d="M244 131l6 6-6 6" />

  <!-- jouw bedrijf -->
  <rect x="260" y="34" width="200" height="206" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="276" y="58" font-size="12" font-weight="800">Jouw bedrijf</text>
  <g class="toestel">
    <rect x="318" y="70" width="84" height="148" rx="14" fill="#10283f" />
    <rect x="325" y="82" width="70" height="124" rx="8" fill="#fff" />
    <circle cx="360" cy="116" r="16" fill="#e8eef4" />
    <path d={persoon(360, 116)} fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" />
    <text x="360" y="150" font-size="10.5" font-weight="800" text-anchor="middle">Klant belt</text>
    <circle cx="346" cy="182" r="10" fill="#d9e1ea" />
    <circle cx="374" cy="182" r="10" fill="#1f8a5b" />
    <path d="M370 178c0 5 3 8 8 8l1.5-2-2.5-1.5-1.5 1c-1.5-.7-2.8-2-3.5-3.5l1-1.5-1.5-2.5z" fill="#fff" />
  </g>
  <text x="360" y="234" font-size="10.5" text-anchor="middle" class="zacht">rechtstreeks, geen leadkosten</text>

  {!mini && (
    <g>
      {vakmensen.map((x, i) => (
        <g class="weg" style={`--i:${i}`}>
          <circle cx={x} cy="190" r="9" fill="#fff" />
          <circle cx={x} cy="190" r="8" fill="none" stroke="#d9e1ea" stroke-width="1.5" stroke-dasharray="3 3" />
        </g>
      ))}
      <g class="ring">
        <path d="M412 96a22 22 0 0 1 0 30" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
        <path d="M420 88a32 32 0 0 1 0 46" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
        <path d="M308 96a22 22 0 0 0 0 30" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
        <path d="M300 88a32 32 0 0 0 0 46" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .toestel { transform-box: fill-box; transform-origin: 50% 90%; }
  :global(.teken-js) .weg, :global(.teken-js) .ring { opacity: 0; }
  .in-beeld .weg { animation: kennisbank-gidsen-werkspot-alternatieven-weg 5s ease-in-out infinite both; animation-delay: calc(0.5s + var(--i) * 0.4s); }
  .in-beeld .ring { animation: kennisbank-gidsen-werkspot-alternatieven-ring 4s ease-in-out 1s infinite both; }
  .in-beeld .toestel { animation: kennisbank-gidsen-werkspot-alternatieven-tril 4s ease-in-out 1s infinite both; }
  @keyframes kennisbank-gidsen-werkspot-alternatieven-weg { 0%, 10% { opacity: 0; } 25%, 70% { opacity: 1; } 85%, 100% { opacity: 0; } }
  @keyframes kennisbank-gidsen-werkspot-alternatieven-ring { 0%, 100% { opacity: 0; } 15%, 45% { opacity: 1; } 60% { opacity: 0; } }
  @keyframes kennisbank-gidsen-werkspot-alternatieven-tril {
    0%, 55%, 100% { transform: rotate(0); }
    8% { transform: rotate(-3deg); } 16% { transform: rotate(3deg); } 24% { transform: rotate(-3deg); } 32% { transform: rotate(3deg); } 40% { transform: rotate(0); }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .weg, .in-beeld .ring, .in-beeld .toestel { animation: none; } }
</style>
