---
// Scène voor /kennisbank/wat-is/alt-tekst/: een foto van een huis met een nieuw dak, de alt-tekst eronder en een luidspreker ernaast.
// Als hij leeft: een scanlijn leest de foto, de alt-tekst wordt onderstreept en de luidspreker zendt rustig geluidsgolven uit, zoals een schermlezer.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een foto van een huis met een nieuw pannendak, de alt-tekst eronder en een luidspreker die de tekst voorleest.'}>
  <rect x="40" y="26" width="236" height="156" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect class="v" x="52" y="38" width="212" height="132" rx="6" />
  <circle cx="226" cy="68" r="13" fill="#fff" />
  <path d="M52 158h212v6a6 6 0 0 1-6 6H58a6 6 0 0 1-6-6z" fill="#cfdbe6" />
  <rect x="104" y="104" width="104" height="56" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path class="o" d="M94 108L156 64L218 108Z" />
  <path d="M110 96L156 63M128 102L156 82M184 100L156 80" stroke="#fff" stroke-width="2" opacity="0.45" />
  <rect x="120" y="118" width="22" height="18" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <rect x="170" y="118" width="22" height="18" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <rect x="148" y="132" width="18" height="28" fill="#074663" />

  <rect x="40" y="198" width="300" height="38" rx="10" fill="#10283f" />
  <text x="56" y="222" font-size="12.5" font-family="ui-monospace, monospace" style="fill:#ffb47f">alt=</text>
  <text x="92" y="222" font-size="12.5" font-family="ui-monospace, monospace" style="fill:#fff">"Nieuw pannendak in Assen"</text>

  <path d="M352 112h18l22-20v76l-22-20h-18z" fill="#074663" stroke="#074663" stroke-width="3" stroke-linejoin="round" />
  <path class="a" d="M404 112c8 8 8 28 0 36" />

  {!mini && (
    <g>
      <rect class="alt-scan" x="52" y="38" width="4" height="132" rx="2" fill="#ff6600" opacity="0.7" />
      <path class="alt-streep" d="M92 228h196" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" pathLength="1" />
      <path class="alt-golf alt-golf1" d="M416 100c14 14 14 46 0 60" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
      <path class="alt-golf alt-golf2" d="M428 88c20 20 20 64 0 84" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" />
    </g>
  )}
</svg>
<style>
  .alt-streep { stroke-dasharray: 1; }
  :global(.teken-js) .alt-streep { stroke-dashoffset: 1; }
  :global(.teken-js) .alt-scan, :global(.teken-js) .alt-golf { opacity: 0; }
  .in-beeld .alt-scan { animation: kennisbank-wat-is-alt-tekst-scan 1.6s ease-in-out 0.4s both; }
  .in-beeld .alt-streep { animation: kennisbank-wat-is-alt-tekst-streep 1s ease-out 1.8s forwards; }
  .in-beeld .alt-golf { animation: kennisbank-wat-is-alt-tekst-golf 3s ease-out 2.4s infinite; }
  .in-beeld .alt-golf2 { animation-delay: 2.9s; }
  @keyframes kennisbank-wat-is-alt-tekst-scan { 0% { opacity: 0; transform: translateX(0); } 10%, 85% { opacity: 0.7; } 100% { opacity: 0; transform: translateX(206px); } }
  @keyframes kennisbank-wat-is-alt-tekst-streep { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-wat-is-alt-tekst-golf { 0% { opacity: 0; } 25% { opacity: 1; } 70%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .alt-scan, .in-beeld .alt-streep, .in-beeld .alt-golf { animation: none; } }
</style>
