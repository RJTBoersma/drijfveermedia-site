---
// Scène voor /kennisbank/gidsen/wat-is-chatgpt/: een chatvenster met een vraag en een antwoord in opbouw,
// rechts een kaartje "volgende woord" met kansbalkjes: zo voorspelt een taalmodel woord voor woord.
// In de volledige versie lopen de kansbalkjes vol, verschijnt het antwoord regel voor regel en knippert de cursor.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const kansen = [
  { y: 112, w: 78, t: 'chatbot', p: '62%' },
  { y: 140, w: 28, t: 'programma', p: '21%' },
  { y: 168, w: 12, t: 'robot', p: '9%' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een chatvenster waarin iemand vraagt wat ChatGPT is. Het antwoord verschijnt woord voor woord, en een kaartje ernaast laat zien hoe het taalmodel het meest waarschijnlijke volgende woord kiest.'}>
  <!-- chatvenster -->
  <rect x="26" y="28" width="272" height="214" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="44" cy="46" r="4" fill="#d9e1ea" /><circle cx="56" cy="46" r="4" fill="#d9e1ea" /><circle cx="68" cy="46" r="4" fill="#d9e1ea" />
  <path d="M26 60H298" stroke="#e8eef4" stroke-width="2" />

  <!-- vraag van de gebruiker -->
  <rect x="132" y="74" width="150" height="30" rx="12" fill="#074663" />
  <text x="146" y="94" font-size="12" font-weight="800" style="fill:#fff">Wat is ChatGPT?</text>

  <!-- antwoord -->
  <circle cx="50" cy="128" r="11" fill="#e8eef4" />
  <path class="l" d="M45 128h10M50 123v10" />
  <text x="70" y="132" font-size="11.5" font-weight="700">Een</text>
  <rect class="v" x="98" y="123" width="62" height="12" rx="6" />
  <rect x="70" y="148" width="190" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="70" y="164" width="160" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="70" y="180" width="120" height="7" rx="3.5" fill="#e8eef4" />

  <!-- invoerveld -->
  <rect x="42" y="206" width="240" height="24" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text class="zacht" x="56" y="222" font-size="10">Stel een vraag</text>
  <circle cx="268" cy="218" r="8" fill="#ff6600" />
  <path d="M268 222v-8m-3 3l3-3 3 3" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />

  <!-- kaartje volgende woord -->
  <rect x="312" y="70" width="146" height="128" rx="12" fill="#fff" stroke="#074663" stroke-width="2" />
  <text x="326" y="92" font-size="10.5" font-weight="800">Volgende woord?</text>
  {kansen.map((k) => (
    <g>
      <text x="326" y={k.y - 3} font-size="10" font-weight="700">{k.t}</text>
      <text class="zacht" x="444" y={k.y - 3} font-size="9.5" text-anchor="end">{k.p}</text>
      <rect x="326" y={k.y + 2} width="118" height="7" rx="3.5" fill="#e8eef4" />
    </g>
  ))}
  <path class="a" d="M306 128c-40 0-60-6-138 0" stroke-dasharray="3 5" />

  {mini ? (
    <g>
      {kansen.map((k, i) => <rect x="326" y={k.y + 2} width={k.w * 1.18} height="7" rx="3.5" fill={i === 0 ? '#ff6600' : '#074663'} />)}
      <text x="102" y="133" font-size="11" font-weight="800" style="fill:#074663">chatbot</text>
    </g>
  ) : (
    <g>
      {kansen.map((k, i) => <rect class={`kans k${i}`} x="326" y={k.y + 2} width={k.w * 1.18} height="7" rx="3.5" fill={i === 0 ? '#ff6600' : '#074663'} />)}
      <text class="woord" x="102" y="133" font-size="11" font-weight="800" style="fill:#074663">chatbot</text>
      <rect class="regel r0" x="70" y="148" width="190" height="7" rx="3.5" fill="#074663" />
      <rect class="regel r1" x="70" y="164" width="160" height="7" rx="3.5" fill="#074663" />
      <rect class="regel r2" x="70" y="180" width="120" height="7" rx="3.5" fill="#074663" />
      <rect class="cursor" x="196" y="177" width="6" height="13" rx="1" fill="#ff6600" />
    </g>
  )}
</svg>
<style>
  .kans, .regel { transform-box: fill-box; transform-origin: left center; }
  :global(.teken-js) .kans, :global(.teken-js) .regel { transform: scaleX(0); }
  :global(.teken-js) .woord { opacity: 0; }
  .in-beeld .k0 { animation: kennisbank-gidsen-wat-is-chatgpt-groei 0.8s cubic-bezier(.6,.1,.3,1) 0.4s forwards; }
  .in-beeld .k1 { animation: kennisbank-gidsen-wat-is-chatgpt-groei 0.8s cubic-bezier(.6,.1,.3,1) 0.55s forwards; }
  .in-beeld .k2 { animation: kennisbank-gidsen-wat-is-chatgpt-groei 0.8s cubic-bezier(.6,.1,.3,1) 0.7s forwards; }
  .in-beeld .woord { animation: kennisbank-gidsen-wat-is-chatgpt-op 0.4s ease 1.4s forwards; }
  .in-beeld .r0 { animation: kennisbank-gidsen-wat-is-chatgpt-typ 6s ease-in-out 1.8s infinite; }
  .in-beeld .r1 { animation: kennisbank-gidsen-wat-is-chatgpt-typ 6s ease-in-out 2.4s infinite; }
  .in-beeld .r2 { animation: kennisbank-gidsen-wat-is-chatgpt-typ 6s ease-in-out 3s infinite; }
  .in-beeld .cursor { animation: kennisbank-gidsen-wat-is-chatgpt-knipper 1.1s steps(1) 0s infinite; }
  @keyframes kennisbank-gidsen-wat-is-chatgpt-groei { to { transform: none; } }
  @keyframes kennisbank-gidsen-wat-is-chatgpt-op { to { opacity: 1; } }
  @keyframes kennisbank-gidsen-wat-is-chatgpt-typ { 0% { transform: scaleX(0); opacity: 1; } 20%, 80% { transform: none; opacity: 1; } 95%, 100% { transform: none; opacity: 0; } }
  @keyframes kennisbank-gidsen-wat-is-chatgpt-knipper { 0% { opacity: 1; } 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .k0, .in-beeld .k1, .in-beeld .k2, .in-beeld .r0, .in-beeld .r1, .in-beeld .r2, .in-beeld .cursor, .in-beeld .woord { animation: none; transform: none; opacity: 1; }
  }
</style>
