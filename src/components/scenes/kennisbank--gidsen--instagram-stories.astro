---
// Scène voor /kennisbank/gidsen/instagram-stories/: een verticale story op een telefoon met een poll-sticker, en rechts een profiel met highlights.
// Als hij leeft: de balkjes bovenin lopen een voor een vol, de poll vult zich met stemmen en de story verschijnt als nieuwe highlight.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const segX = (i: number) => 58 + i * 28;
const highlights = [
  { x: 254, label: 'Werk' },
  { x: 306, label: 'Team' },
  { x: 358, label: 'Tips' },
  { x: 410, label: 'Prijzen' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een verticale story op een telefoon met een poll-sticker die vraagt welke tegel je kiest. Rechts een profiel met highlights over werk, team, tips en prijzen. De story wordt een nieuwe highlight.'}>
  <!-- telefoon met story -->
  <rect x="44" y="14" width="136" height="242" rx="20" fill="#10283f" />
  <rect x="52" y="24" width="120" height="222" rx="12" fill="#e8eef4" />
  <!-- tegelpatroon als achtergrondfoto -->
  <g stroke="#fff" stroke-width="2">
    <path d="M52 92h120M52 132h120M52 172h120M52 212h120" />
    <path d="M82 72v174M112 72v174M142 72v174" />
  </g>
  {[0, 1, 2, 3].map((i) => <rect x={segX(i)} y="32" width="24" height="4" rx="2" fill="#fff" opacity=".7" />)}
  <rect x={segX(0)} y="32" width="24" height="4" rx="2" fill="#074663" />
  <circle cx="66" cy="52" r="8" fill="#fff" stroke="#ff6600" stroke-width="2" />
  <text x="80" y="56" font-size="10" font-weight="800">Jouw bedrijf</text>
  <text x="158" y="56" font-size="9" text-anchor="end" class="zacht">2 u</text>
  <!-- poll -->
  <rect x="62" y="112" width="100" height="84" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="112" y="132" font-size="11" font-weight="800" text-anchor="middle">Welke tegel?</text>
  <rect class="v" x="72" y="142" width="80" height="20" rx="10" />
  <rect class="v" x="72" y="168" width="80" height="20" rx="10" />
  <text x="80" y="156" font-size="10" font-weight="800">Grijs</text>
  <text x="80" y="182" font-size="10" font-weight="800">Wit</text>
  <!-- berichtveld -->
  <rect x="60" y="220" width="104" height="18" rx="9" fill="none" stroke="#fff" stroke-width="2" />

  <!-- 24 uur -->
  <g>
    <rect x="190" y="30" width="78" height="26" rx="13" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <circle cx="205" cy="43" r="6" fill="none" stroke="#074663" stroke-width="2" />
    <path d="M205 40v3l2 2" fill="none" stroke="#074663" stroke-width="1.6" stroke-linecap="round" />
    <text x="216" y="47" font-size="11" font-weight="800">24 uur</text>
  </g>

  <!-- profiel met highlights -->
  <rect x="226" y="80" width="230" height="150" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="256" cy="112" r="16" fill="#074663" />
  <text x="282" y="110" font-size="12" font-weight="800">Jouw bedrijf</text>
  <rect x="282" y="118" width="110" height="6" rx="3" fill="#d9e1ea" />
  <text x="240" y="152" font-size="10" class="zacht">Highlights</text>
  {highlights.map((h) => (
    <g>
      <circle cx={h.x} cy="182" r="18" fill="#fff" stroke="#c9d3dd" stroke-width="2" />
      <circle cx={h.x} cy="182" r="13" fill="#e8eef4" />
      <text x={h.x} y="218" font-size="10" text-anchor="middle">{h.label}</text>
    </g>
  ))}

  {!mini && (
    <g>
      {[1, 2, 3].map((i) => <rect class={`seg seg-${i}`} x={segX(i)} y="32" width="24" height="4" rx="2" fill="#074663" />)}
      <rect class="stem stem-a" x="72" y="142" width="50" height="20" rx="10" fill="#ffd2b0" />
      <rect class="stem stem-b" x="72" y="168" width="30" height="20" rx="10" fill="#d9e1ea" />
      <text class="pct" x="146" y="156" font-size="10" font-weight="800" text-anchor="end">62%</text>
      <text class="pct" x="146" y="182" font-size="10" font-weight="800" text-anchor="end">38%</text>
      <text class="pct" x="80" y="156" font-size="10" font-weight="800">Grijs</text>
      <text class="pct" x="80" y="182" font-size="10" font-weight="800">Wit</text>
      <circle class="nieuw" cx="254" cy="182" r="18" fill="none" stroke="#ff6600" stroke-width="2.5" />
    </g>
  )}
</svg>
<style>
  .seg, .stem { transform-box: fill-box; transform-origin: left center; }
  .nieuw { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .seg { transform: scaleX(0); }
  :global(.teken-js) .stem { transform: scaleX(0); }
  :global(.teken-js) .pct, :global(.teken-js) .nieuw { opacity: 0; }
  .in-beeld .seg-1 { animation: kennisbank-gidsen-instagram-stories-seg1 6s linear 0.4s infinite; }
  .in-beeld .seg-2 { animation: kennisbank-gidsen-instagram-stories-seg2 6s linear 0.4s infinite; }
  .in-beeld .seg-3 { animation: kennisbank-gidsen-instagram-stories-seg3 6s linear 0.4s infinite; }
  .in-beeld .stem { animation: kennisbank-gidsen-instagram-stories-stem 1.2s cubic-bezier(.5,.1,.25,1) 1s forwards; }
  .in-beeld .pct { animation: kennisbank-gidsen-instagram-stories-op 0.4s ease-out 1.9s forwards; }
  .in-beeld .nieuw { animation: kennisbank-gidsen-instagram-stories-nieuw 0.6s cubic-bezier(.3,1.6,.5,1) 2.6s forwards; }
  @keyframes kennisbank-gidsen-instagram-stories-seg1 { 0% { transform: scaleX(0); } 33%, 96% { transform: none; } 100% { transform: scaleX(0); } }
  @keyframes kennisbank-gidsen-instagram-stories-seg2 { 0%, 33% { transform: scaleX(0); } 66%, 96% { transform: none; } 100% { transform: scaleX(0); } }
  @keyframes kennisbank-gidsen-instagram-stories-seg3 { 0%, 66% { transform: scaleX(0); } 96% { transform: none; } 100% { transform: scaleX(0); } }
  @keyframes kennisbank-gidsen-instagram-stories-stem { to { transform: none; } }
  @keyframes kennisbank-gidsen-instagram-stories-op { to { opacity: 1; } }
  @keyframes kennisbank-gidsen-instagram-stories-nieuw { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .seg, .in-beeld .stem, .in-beeld .pct, .in-beeld .nieuw { animation: none; } }
</style>
