---
// Scène voor /kennisbank/gidsen/kleuren-in-marketing/: drie kleurstalen met wat ze oproepen (vertrouwen, rust, actie) naast een rustige webpagina met één oranje knop.
// Als hij leeft: de stalen schuiven een voor een open, een cursor gaat naar de oranje knop en klikt, en de knop zendt rustig ringen uit.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const stalen = [
  { y: 34, kleur: '#074663', label: 'Vertrouwen' },
  { y: 104, kleur: '#1f8a5b', label: 'Rust' },
  { y: 174, kleur: '#ff6600', label: 'Actie' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: drie kleurstalen. Blauw staat voor vertrouwen, groen voor rust en oranje voor actie. Ernaast een rustige webpagina in blauw en grijs met één oranje knop, waar een cursor op klikt.'}>
  <!-- kleurstalen -->
  {stalen.map((s) => (
    <g>
      <rect x="26" y={s.y} width="170" height="58" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <rect x="36" y={s.y + 10} width="38" height="38" rx="8" fill={s.kleur} />
      <text x="88" y={s.y + 35} font-size="14" font-weight="800">{s.label}</text>
    </g>
  ))}

  <!-- webpagina -->
  <rect x="226" y="22" width="232" height="226" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M226 34a12 12 0 0 1 12-12h208a12 12 0 0 1 12 12v12H226z" fill="#e8eef4" />
  <circle cx="242" cy="34" r="4" fill="#fff" /><circle cx="256" cy="34" r="4" fill="#fff" /><circle cx="270" cy="34" r="4" fill="#fff" />
  <rect x="246" y="66" width="34" height="34" rx="8" fill="#074663" />
  <rect x="292" y="70" width="120" height="10" rx="5" fill="#10283f" />
  <rect x="292" y="88" width="84" height="8" rx="4" fill="#d9e1ea" />
  <rect x="246" y="118" width="190" height="8" rx="4" fill="#d9e1ea" />
  <rect x="246" y="134" width="168" height="8" rx="4" fill="#d9e1ea" />
  <rect x="246" y="150" width="120" height="8" rx="4" fill="#d9e1ea" />
  <rect x="246" y="180" width="112" height="36" rx="10" fill="#ff6600" />
  <rect x="266" y="194" width="72" height="8" rx="4" fill="#fff" />
  <rect x="370" y="180" width="70" height="36" rx="10" fill="none" stroke="#d9e1ea" stroke-width="2" />

  {!mini && (
    <g>
      <rect class="km-ring" x="246" y="180" width="112" height="36" rx="10" fill="none" stroke="#ff6600" stroke-width="2.5" />
      {stalen.map((s, i) => <rect class="km-staal" style={`--i:${i}`} x="36" y={s.y + 10} width="38" height="38" rx="8" fill="none" stroke={s.kleur} stroke-width="2.5" />)}
      <g class="km-cursor">
        <path d="M330 206l0 30 8-8 6 13 6-3-6-12 11-1z" fill="#fff" stroke="#10283f" stroke-width="2" stroke-linejoin="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .km-ring, .km-staal, .km-cursor { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .km-ring, :global(.teken-js) .km-staal { opacity: 0; }
  :global(.teken-js) .km-cursor { opacity: 0; }
  .in-beeld .km-staal { animation: kennisbank-gidsen-kleuren-in-marketing-staal 0.9s ease-out calc(0.4s + var(--i) * 0.35s) both; }
  .in-beeld .km-cursor { animation: kennisbank-gidsen-kleuren-in-marketing-cursor 1.2s cubic-bezier(.4,0,.2,1) 1.4s forwards; transform-origin: 0 0; }
  .in-beeld .km-ring { animation: kennisbank-gidsen-kleuren-in-marketing-ring 3s ease-out 2.6s infinite; }
  @keyframes kennisbank-gidsen-kleuren-in-marketing-staal { 0% { opacity: 0; transform: scale(1); } 40% { opacity: 1; transform: scale(1.3); } 100% { opacity: 0; transform: scale(1.5); } }
  @keyframes kennisbank-gidsen-kleuren-in-marketing-cursor { 0% { opacity: 0; transform: translate(80px, 30px); } 30% { opacity: 1; } 80% { transform: none; } 90% { transform: scale(0.85); } 100% { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-kleuren-in-marketing-ring { 0% { opacity: 0.9; transform: scale(1); } 70%, 100% { opacity: 0; transform: scale(1.18, 1.5); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .km-staal, .in-beeld .km-cursor, .in-beeld .km-ring { animation: none; } }
</style>
