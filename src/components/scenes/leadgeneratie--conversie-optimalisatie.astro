---
// Scène voor /leadgeneratie/conversie-optimalisatie/: een website met een offerteformulier. De warmste plek is de knop,
// een cursor klikt erop, er komt een aanvraag binnen, en rechts staat het aantal aanvragen voor en na.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een website met een offerteformulier. Een bezoeker klikt op de knop, er komt een aanvraag binnen en het aantal aanvragen stijgt van 1,2 naar 2,4 procent.'}>
  <!-- browservenster -->
  <rect x="24" y="28" width="300" height="214" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M24 54h300" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="42" cy="41" r="4" fill="#d9e1ea" /><circle cx="56" cy="41" r="4" fill="#d9e1ea" /><circle cx="70" cy="41" r="4" fill="#d9e1ea" />
  <rect class="v" x="92" y="35" width="176" height="12" rx="6" />
  <!-- kop en tekst -->
  <rect x="48" y="70" width="150" height="12" rx="6" fill="#10283f" />
  <rect class="v" x="48" y="90" width="200" height="8" rx="4" />
  <rect class="v" x="48" y="104" width="168" height="8" rx="4" />
  <!-- warmte: hier kijken en klikken bezoekers -->
  <circle cx="118" cy="207" r="34" fill="#ff6600" opacity=".10" />
  <circle cx="118" cy="207" r="20" fill="#ff6600" opacity=".12" />
  <circle cx="98" cy="137" r="20" fill="#ff6600" opacity=".08" />
  <!-- formulier -->
  <rect x="48" y="126" width="120" height="22" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="176" y="126" width="124" height="22" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="48" y="156" width="252" height="22" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect class="o" x="48" y="192" width="140" height="30" rx="8" />
  <text x="118" y="211" text-anchor="middle" font-size="12" font-weight="800" style="fill:#fff">Offerte aanvragen</text>
  <circle cx="208" cy="207" r="8" fill="#1f8a5b" />
  <path d="M204 207l3 3 5-6" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  <text x="222" y="211" font-size="10" class="zacht">Gratis en vrijblijvend</text>
  <!-- grafiekje: aanvragen voor en na -->
  <rect x="344" y="58" width="116" height="168" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="360" y="82" font-size="12" font-weight="800">Aanvragen</text>
  <path d="M360 196h84" stroke="#d9e1ea" stroke-width="2" />
  <rect x="370" y="166" width="26" height="30" rx="4" fill="#c9d3dd" />
  <rect x="410" y="126" width="26" height="70" rx="4" fill="#074663" />
  <text x="383" y="158" text-anchor="middle" font-size="11" font-weight="800">1,2%</text>
  <text x="423" y="118" text-anchor="middle" font-size="11" font-weight="800">2,4%</text>
  <text x="383" y="212" text-anchor="middle" font-size="10" class="zacht">voor</text>
  <text x="423" y="212" text-anchor="middle" font-size="10" class="zacht">na</text>
  <path class="a" d="M390 145c4-8 8-13 13-17" />
  <path class="a" d="M396 127l7 1-1 7" />
  {!mini && (
    <g>
      <circle class="rimpel" cx="122" cy="206" r="12" fill="none" stroke="#ff6600" stroke-width="3" />
      <g class="cursor"><path d="M0 0v20l5-5 4 9 4-2-4-8h7z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" /></g>
      <g class="melding">
        <rect x="186" y="62" width="128" height="30" rx="9" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
        <circle cx="202" cy="77" r="7" fill="#1f8a5b" />
        <path d="M199 77l2 2 4-5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="214" y="81" font-size="11" font-weight="800">Nieuwe aanvraag</text>
      </g>
    </g>
  )}
</svg>
<style>
  .cursor { transform: translate(260px, 96px); }
  .rimpel { transform-box: fill-box; transform-origin: center; opacity: 0; }
  :global(.teken-js) .cursor, :global(.teken-js) .melding { opacity: 0; }
  .in-beeld .cursor { animation: leadgeneratie--conversie-optimalisatie-cursor 5s ease-in-out 0.6s infinite both; }
  .in-beeld .rimpel { animation: leadgeneratie--conversie-optimalisatie-rimpel 5s ease-out 0.6s infinite both; }
  .in-beeld .melding { animation: leadgeneratie--conversie-optimalisatie-melding 5s ease-in-out 0.6s infinite both; }
  @keyframes leadgeneratie--conversie-optimalisatie-cursor {
    0% { opacity: 0; transform: translate(260px, 96px); }
    10% { opacity: 1; }
    42% { transform: translate(120px, 202px); }
    46% { transform: translate(120px, 202px) scale(0.85); }
    50% { transform: translate(120px, 202px); }
    85% { opacity: 1; transform: translate(120px, 202px); }
    100% { opacity: 0; transform: translate(120px, 202px); }
  }
  @keyframes leadgeneratie--conversie-optimalisatie-rimpel {
    0%, 45% { opacity: 0; transform: scale(0.6); }
    48% { opacity: 0.9; transform: scale(0.8); }
    70%, 100% { opacity: 0; transform: scale(2.6); }
  }
  @keyframes leadgeneratie--conversie-optimalisatie-melding {
    0%, 50% { opacity: 0; transform: translateY(8px); }
    58%, 88% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .cursor, .in-beeld .rimpel, .in-beeld .melding { animation: none; } }
</style>
