---
// Scène voor /kennisbank/gidsen/google-ad-grants/: een gesponsorde zoekadvertentie van een goed doel, eronder het maandelijkse
// advertentietegoed, rechts de klikfrequentie die boven de verplichte 5% blijft.
// Als hij leeft: het hartje in de advertentie klopt rustig, de balk van deze maand groeit boven de 5%-lijn en er verschijnt een vinkje.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const hart = (cx: number, cy: number, s = 1) =>
  `M${cx} ${cy + 7 * s}c-6-4.5-10-8-10-12.5a5 5 0 0 1 10-1.5a5 5 0 0 1 10 1.5c0 4.5-4 8-10 12.5z`;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een gesponsorde zoekadvertentie van een dierenopvang die vrijwilligers zoekt, eronder een tegoed van 10.000 dollar per maand. Rechts een grafiek waarin de klikfrequentie boven de verplichte 5 procent blijft.'}>
  <!-- zoekresultaat -->
  <rect x="20" y="30" width="272" height="136" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="34" y="44" width="244" height="28" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="50" cy="58" r="5.5" fill="none" stroke="#074663" stroke-width="2" />
  <path d="M54 62l3.5 3.5" stroke="#074663" stroke-width="2" stroke-linecap="round" />
  <text x="64" y="62.5" font-size="11" font-weight="700">vrijwilligerswerk dieren assen</text>
  <rect x="34" y="82" width="244" height="72" rx="10" fill="#fff4ec" stroke="#ffd6b8" stroke-width="2" />
  <rect x="46" y="92" width="76" height="17" rx="8.5" fill="#074663" />
  <text x="84" y="104" font-size="9.5" font-weight="800" text-anchor="middle" style="fill:#fff">Gesponsord</text>
  <text x="46" y="128" font-size="12" font-weight="800" style="fill:#074663">Word vrijwilliger bij ons</text>
  <rect x="46" y="137" width="150" height="6" rx="3" fill="#ffd2b0" />
  <path d={hart(254, 112)} fill="#fff" stroke="#ff6600" stroke-width="2" stroke-linejoin="round" />

  <!-- tegoed -->
  <rect x="20" y="180" width="272" height="66" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="38" y="202" width="34" height="28" rx="4" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <rect x="34" y="194" width="42" height="10" rx="3" fill="#fff" stroke="#074663" stroke-width="2" />
  <path d="M55 194v36" stroke="#ff6600" stroke-width="3" />
  <path d="M55 194c-6-10-14-8-12-2s8 2 12 2c4 0 10 4 12-2s-6-8-12 2z" fill="none" stroke="#ff6600" stroke-width="2" stroke-linejoin="round" />
  <text x="92" y="206" font-size="10.5" class="zacht">advertentietegoed per maand</text>
  <text x="92" y="232" font-size="22" font-weight="900">$ 10.000</text>

  <!-- klikfrequentie -->
  <rect x="306" y="30" width="154" height="216" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="322" y="56" font-size="11.5" font-weight="800">Klikfrequentie</text>
  <path d="M326 222h118" stroke="#d9e1ea" stroke-width="2" />
  <path d="M326 150h118" stroke="#ff6600" stroke-width="2" stroke-dasharray="5 4" />
  <text x="326" y="143" font-size="9.5" font-weight="700" style="fill:#ff6600">minimaal 5%</text>
  <rect x="340" y="134" width="34" height="88" rx="5" fill="#c9d6e2" />
  <rect x="392" y="112" width="34" height="110" rx="5" fill="#074663" />
  <text x="357" y="238" font-size="9.5" text-anchor="middle" class="zacht">vorige</text>
  <text x="409" y="238" font-size="9.5" text-anchor="middle" class="zacht">deze maand</text>

  {!mini && (
    <g>
      <path class="klop" d={hart(254, 112)} fill="#ff6600" />
      <rect class="groei" x="392" y="112" width="34" height="110" rx="5" fill="#1f8a5b" />
      <g class="gehaald">
        <circle cx="409" cy="92" r="11" fill="#1f8a5b" />
        <path d="M404 92l3.5 3.5 6.5-7" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .klop, .gehaald { transform-box: fill-box; transform-origin: center; }
  .groei { transform-box: fill-box; transform-origin: 50% 100%; }
  :global(.teken-js) .klop, :global(.teken-js) .groei, :global(.teken-js) .gehaald { opacity: 0; }
  .in-beeld .klop { animation: kennisbank-gidsen-google-ad-grants-klop 3.2s ease-in-out 0.8s infinite both; }
  .in-beeld .groei { animation: kennisbank-gidsen-google-ad-grants-groei 1.3s cubic-bezier(.5,0,.3,1) 0.5s forwards; }
  .in-beeld .gehaald { animation: kennisbank-gidsen-google-ad-grants-gehaald 0.5s cubic-bezier(.3,1.6,.5,1) 1.9s forwards; }
  @keyframes kennisbank-gidsen-google-ad-grants-klop { 0%, 100% { opacity: 1; transform: scale(1); } 12% { transform: scale(1.22); } 24% { transform: scale(1); } 36% { transform: scale(1.14); } 50% { transform: scale(1); } }
  @keyframes kennisbank-gidsen-google-ad-grants-groei { from { opacity: 1; transform: scaleY(0); } to { opacity: 1; transform: scaleY(1); } }
  @keyframes kennisbank-gidsen-google-ad-grants-gehaald { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .klop, .in-beeld .groei, .in-beeld .gehaald { animation: none; } }
</style>
