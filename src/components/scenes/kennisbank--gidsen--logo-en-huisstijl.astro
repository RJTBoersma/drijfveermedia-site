---
// Scène voor /kennisbank/gidsen/logo-en-huisstijl/: een weegschaal met links een laptop met een logomaker (zelf maken) en rechts een tekenvel met een vectorlogo (laten maken).
// Als hij leeft: op de laptop wisselen sjabloonvormen elkaar af, op het tekenvel tekent een lijn het logo na en verschijnt een vinkje bij het bronbestand.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const blad = 'M364 58C384 70 386 92 364 106C342 92 344 70 364 58z';
const ankers = [[364, 58], [364, 106], [381, 82], [347, 82]];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een weegschaal. Links staat een laptop met een logomaker waarop steeds andere sjabloonvormen verschijnen. Rechts ligt een tekenvel met een logo als vectorbestand, dat een vinkje krijgt.'}>
  <!-- weegschaal -->
  <rect x="190" y="238" width="100" height="12" rx="6" fill="#10283f" />
  <rect x="234" y="152" width="12" height="88" rx="3" fill="#074663" />
  <rect x="96" y="146" width="288" height="10" rx="5" fill="#074663" />
  <circle cx="240" cy="151" r="9" fill="#fff" stroke="#074663" stroke-width="3" />
  <rect x="106" y="128" width="8" height="20" fill="#074663" />
  <rect x="366" y="128" width="8" height="20" fill="#074663" />
  <rect x="40" y="122" width="140" height="8" rx="4" fill="#10283f" />
  <rect x="300" y="122" width="140" height="8" rx="4" fill="#10283f" />

  <!-- links: laptop met logomaker -->
  <rect x="62" y="44" width="96" height="72" rx="6" fill="#10283f" />
  <rect x="68" y="50" width="84" height="60" rx="3" fill="#fff" />
  <circle cx="110" cy="74" r="14" class="v" />
  <rect x="88" y="95" width="44" height="6" rx="3" fill="#d9e1ea" />
  <path d="M52 116h116l-6 6H58z" fill="#c9d3dd" />

  <!-- rechts: tekenvel met vectorlogo -->
  <rect x="318" y="38" width="92" height="82" rx="4" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d={blad} fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <path d="M347 82h34M364 58v48" stroke="#8aa0b4" stroke-width="1" stroke-dasharray="3 3" />
  {ankers.map(([x, y]) => <rect x={x - 3} y={y - 3} width="6" height="6" fill="#fff" stroke="#074663" stroke-width="1.5" />)}
  <rect x="392" y="98" width="40" height="18" rx="5" fill="#074663" />
  <text x="412" y="111" text-anchor="middle" font-size="10.5" font-weight="800" style="fill:#fff">SVG</text>
  <g transform="rotate(35 428 58)">
    <rect x="422" y="26" width="12" height="52" rx="2" fill="#ffd2b0" stroke="#10283f" stroke-width="1.5" />
    <path d="M422 78l6 12 6-12z" fill="#fff" stroke="#10283f" stroke-width="1.5" stroke-linejoin="round" />
  </g>

  <text x="110" y="196" text-anchor="middle" font-size="15" font-weight="800">Zelf</text>
  <text x="370" y="196" text-anchor="middle" font-size="15" font-weight="800">Laten maken</text>

  {!mini && (
    <g>
      <g class="lh-vorm" style="--i:0"><rect x="98" y="62" width="24" height="24" rx="4" fill="#ff6600" /></g>
      <g class="lh-vorm lh-later" style="--i:1"><path d="M110 60l14 26H96z" fill="#074663" /></g>
      <g class="lh-vorm lh-later" style="--i:2"><circle cx="110" cy="74" r="13" fill="none" stroke="#ff6600" stroke-width="4" /></g>
      <path class="lh-lijn" d={blad} fill="none" stroke="#ff6600" stroke-width="3" stroke-linejoin="round" pathLength="1" />
      <g class="lh-vink"><circle cx="436" cy="98" r="11" fill="#1a7a50" /><path d="M431 98l4 4 7-8" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></g>
    </g>
  )}
</svg>
<style>
  .lh-lijn { stroke-dasharray: 1; }
  .lh-later { opacity: 0; }
  .lh-vink, .lh-vorm { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .lh-lijn { stroke-dashoffset: 1; }
  :global(.teken-js) .lh-vink, :global(.teken-js) .lh-vorm { opacity: 0; }
  .in-beeld .lh-vorm { animation: kennisbank-gidsen-logo-en-huisstijl-vorm 6s ease-in-out calc(0.4s + var(--i) * 2s) infinite both; }
  .in-beeld .lh-lijn { animation: kennisbank-gidsen-logo-en-huisstijl-lijn 1.4s cubic-bezier(.6,.1,.3,1) 0.8s forwards; }
  .in-beeld .lh-vink { animation: kennisbank-gidsen-logo-en-huisstijl-vink 0.5s cubic-bezier(.3,1.7,.5,1) 2.3s forwards; }
  @keyframes kennisbank-gidsen-logo-en-huisstijl-vorm { 0% { opacity: 0; transform: scale(0.6); } 6%, 28% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; transform: scale(0.9); } }
  @keyframes kennisbank-gidsen-logo-en-huisstijl-lijn { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-gidsen-logo-en-huisstijl-vink { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .lh-vorm, .in-beeld .lh-lijn, .in-beeld .lh-vink { animation: none; } }
</style>
