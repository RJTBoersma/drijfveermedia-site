---
// Scène voor /kennisbank/gidsen/gastbloggen/: links een mail met een voorstel aan de redactie, rechts de pagina van een vakblad
// met jouw gastartikel. In het artikel staat één link, onderaan een kader "Over de auteur".
// Als hij leeft: de mail schuift naar het vakblad, er verschijnt een vinkje "Geplaatst", de ene link krijgt zijn oranje
// onderstreping en een cursor tikt er rustig, steeds opnieuw, op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een mail met een voorstel gaat naar de redactie van een vakblad. Daar staat jouw gastartikel, met één link en een kader over de auteur.'}>
  <!-- de mail met het voorstel -->
  <g class="mail">
    <rect x="28" y="70" width="150" height="104" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <path d="M28 80l75 46 75-46" fill="none" stroke="#d9e1ea" stroke-width="2" stroke-linejoin="round" />
    <rect x="44" y="134" width="70" height="8" rx="4" fill="#10283f" />
    <rect x="44" y="148" width="112" height="6" rx="3" fill="#e8eef4" />
    <rect x="44" y="160" width="90" height="6" rx="3" fill="#e8eef4" />
    <text x="44" y="62" font-size="10.5" font-weight="800" fill="#10283f">Voorstel aan de redactie</text>
  </g>
  <path d="M186 122h34" stroke="#c9d3dd" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round" />
  <path d="M214 116l8 6-8 6" fill="none" stroke="#c9d3dd" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- het vakblad met jouw gastartikel -->
  <rect x="232" y="24" width="222" height="226" rx="12" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path d="M232 36a12 12 0 0 1 12-12h198a12 12 0 0 1 12 12v12H232z" fill="#074663" />
  <text x="248" y="41" font-size="10.5" font-weight="900" style="fill:#fff">Vakblad</text>
  <rect x="250" y="62" width="150" height="11" rx="4" fill="#10283f" />
  <rect x="250" y="80" width="112" height="11" rx="4" fill="#10283f" />
  <rect x="250" y="104" width="186" height="6" rx="3" fill="#e8eef4" />
  <rect x="250" y="116" width="176" height="6" rx="3" fill="#e8eef4" />
  <rect x="250" y="128" width="60" height="6" rx="3" fill="#e8eef4" />
  <text x="314" y="134" font-size="9" font-weight="800" fill="#074663">jouwbedrijf.nl</text>
  <rect x="384" y="128" width="52" height="6" rx="3" fill="#e8eef4" />
  <rect x="250" y="140" width="182" height="6" rx="3" fill="#e8eef4" />
  <rect x="250" y="152" width="140" height="6" rx="3" fill="#e8eef4" />
  <!-- over de auteur -->
  <rect x="250" y="176" width="186" height="56" rx="8" fill="#f3f6f9" stroke="#d9e1ea" />
  <circle cx="272" cy="204" r="12" fill="#e8eef4" stroke="#c9d3dd" />
  <text x="292" y="196" font-size="9.5" font-weight="800" fill="#10283f">Over de auteur</text>
  <rect x="292" y="204" width="128" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="292" y="214" width="96" height="5" rx="2.5" fill="#d9e1ea" />

  {!mini && (
    <g>
      <g class="vlieg">
        <rect x="120" y="102" width="44" height="30" rx="5" fill="#fff" stroke="#ff6600" stroke-width="2" />
        <path d="M120 106l22 14 22-14" fill="none" stroke="#ff6600" stroke-width="2" stroke-linejoin="round" />
      </g>
      <path class="onderstreep" d="M314 138h68" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" pathLength="1" />
      <g class="geplaatst">
        <rect x="350" y="54" width="92" height="26" rx="13" fill="#fff" stroke="#d9e1ea" />
        <circle cx="365" cy="67" r="7.5" fill="#1f8a5b" />
        <path d="M361.5 67l2.5 2.5 4.5-5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="378" y="71" font-size="10" font-weight="800" fill="#10283f">Geplaatst</text>
      </g>
      <path class="cursor" d="M372 140l0 18 5-5 4 9 4-2-4-9 7 0z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
    </g>
  )}
</svg>
<style>
  :global(.teken-js) .vlieg { opacity: 0; }
  .in-beeld .vlieg { animation: kennisbank-gidsen-gastbloggen-vlieg 1.3s cubic-bezier(.5,.1,.3,1) 0.5s both; }
  .onderstreep { stroke-dasharray: 1; }
  :global(.teken-js) .onderstreep { stroke-dashoffset: 1; }
  .in-beeld .onderstreep { animation: kennisbank-gidsen-gastbloggen-lijn 0.7s ease-out 1.9s forwards; }
  .geplaatst { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .geplaatst { opacity: 0; }
  .in-beeld .geplaatst { animation: kennisbank-gidsen-gastbloggen-pop 0.45s cubic-bezier(.3,1.6,.5,1) 1.7s forwards; }
  :global(.teken-js) .cursor { opacity: 0; }
  .in-beeld .cursor { animation: kennisbank-gidsen-gastbloggen-tik 4s ease-in-out 2.8s infinite both; }
  @keyframes kennisbank-gidsen-gastbloggen-vlieg { 0% { opacity: 1; transform: translate(0, 0); } 85% { opacity: 1; transform: translate(150px, 14px) scale(0.8); } 100% { opacity: 0; transform: translate(170px, 16px) scale(0.6); } }
  @keyframes kennisbank-gidsen-gastbloggen-lijn { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-gidsen-gastbloggen-pop { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-gastbloggen-tik { 0% { opacity: 0; transform: translate(26px, 20px); } 30% { opacity: 1; transform: translate(0, 0); } 45% { transform: translate(0, 0) scale(0.9); } 55%, 80% { opacity: 1; transform: translate(0, 0); } 100% { opacity: 0; transform: translate(0, 0); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .vlieg, .in-beeld .onderstreep, .in-beeld .geplaatst, .in-beeld .cursor { animation: none; } }
</style>
