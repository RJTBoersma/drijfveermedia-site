---
// Scène voor /kennisbank/wat-is/crm/: een pipeline in drie kolommen (Lead, Offerte, Klant) met kaartjes van contacten.
// Als hij leeft: een kaartje schuift van Offerte naar Klant, er valt een nieuwe aanvraag in de kolom Lead en er verschijnt een herinnering.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const kolommen = [
  { x: 24, titel: 'Lead', aantal: '2' },
  { x: 172, titel: 'Offerte', aantal: '2' },
  { x: 320, titel: 'Klant', aantal: '1' },
];
const kaarten = [
  { x: 36, y: 70, naam: 'Dakkapel', w: '€ 6.400' },
  { x: 36, y: 124, naam: 'Kozijnen', w: '€ 3.100' },
  { x: 184, y: 70, naam: 'Badkamer', w: '€ 8.900' },
  { x: 184, y: 124, naam: 'Warmtepomp', w: '€ 4.200' },
  { x: 332, y: 70, naam: 'Dakgoot', w: '€ 5.600' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een pipeline met drie kolommen, Lead, Offerte en Klant. In elke kolom staan kaartjes van contacten met de waarde van de opdracht. Een kaartje schuift van Offerte naar Klant.'}>
  {kolommen.map((k) => (
    <g>
      <rect x={k.x} y="26" width="136" height="220" rx="12" fill="#f3f6f9" stroke="#d9e1ea" stroke-width="2" />
      <text x={k.x + 14} y="52" font-size="13" font-weight="800">{k.titel}</text>
      <rect x={k.x + 100} y="38" width="24" height="20" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
      <text x={k.x + 112} y="52" font-size="11" font-weight="800" text-anchor="middle">{k.aantal}</text>
    </g>
  ))}
  {kaarten.map((c) => (
    <g>
      <rect x={c.x} y={c.y} width="112" height="44" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <circle cx={c.x + 16} cy={c.y + 22} r="9" fill="#e8eef4" stroke="#074663" stroke-width="1.5" />
      <text x={c.x + 32} y={c.y + 19} font-size="11" font-weight="800">{c.naam}</text>
      <text x={c.x + 32} y={c.y + 34} font-size="10" font-weight="700" class="zacht">{c.w}</text>
    </g>
  ))}
  <g><circle cx="430" cy="92" r="8" fill="#1f8a5b" /><path d="M426 92l3 3 5.5-6" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
  <path class="a" d="M161 100h9M166 96l4 4-4 4" />
  <path class="a" d="M309 100h9M314 96l4 4-4 4" />

  {!mini && (
    <g>
      <g class="crm-schuif">
        <rect x="184" y="124" width="112" height="44" rx="8" fill="#fff" stroke="#ff6600" stroke-width="2.5" />
        <circle cx="200" cy="146" r="9" fill="#ffd2b0" stroke="#ff6600" stroke-width="1.5" />
        <text x="216" y="143" font-size="11" font-weight="800">Warmtepomp</text>
        <text x="216" y="158" font-size="10" font-weight="700" class="zacht">€ 4.200</text>
      </g>
      <g class="crm-post">
        <rect x="80" y="182" width="26" height="18" rx="3" fill="#fff" stroke="#074663" stroke-width="2" />
        <path d="M80 183l13 9 13-9" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
      </g>
      <g class="crm-herinner">
        <rect x="180" y="190" width="120" height="30" rx="15" fill="#074663" />
        <text x="240" y="209.5" font-size="11" font-weight="800" text-anchor="middle" style="fill:#fff">Nabellen do 10.00</text>
      </g>
    </g>
  )}
</svg>
<style>
  :global(.teken-js) .crm-schuif, :global(.teken-js) .crm-post, :global(.teken-js) .crm-herinner { opacity: 0; }
  .in-beeld .crm-schuif { animation: kennisbank-wat-is-crm-schuif 6s cubic-bezier(.5,0,.3,1) 0.8s infinite; }
  .in-beeld .crm-post { animation: kennisbank-wat-is-crm-post 6s ease-in 2.2s infinite; }
  .in-beeld .crm-herinner { animation: kennisbank-wat-is-crm-herinner 0.6s ease-out 1.4s forwards; }
  @keyframes kennisbank-wat-is-crm-schuif { 0% { opacity: 0; transform: none; } 10% { opacity: 1; transform: none; } 45%, 80% { opacity: 1; transform: translateX(148px); } 95%, 100% { opacity: 0; transform: translateX(148px); } }
  @keyframes kennisbank-wat-is-crm-post { 0% { opacity: 0; transform: translateY(-40px); } 15% { opacity: 1; } 40%, 70% { opacity: 1; transform: none; } 85%, 100% { opacity: 0; transform: none; } }
  @keyframes kennisbank-wat-is-crm-herinner { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .crm-schuif, .in-beeld .crm-post, .in-beeld .crm-herinner { animation: none; } }
</style>
