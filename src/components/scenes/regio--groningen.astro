---
// Scène voor /regio/groningen/: links de Stad met een hoge kerktoren en trapgevels, rechts de Ommelanden
// met akkers, een schuur en windmolens. Een trein rijdt uit de richting van Assen de stad binnen,
// de wieken draaien en er verschijnt een label: in twintig minuten uit Assen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const molens = [
  { x: 304, y: 116, schaal: 1 },
  { x: 374, y: 100, schaal: 1.15 },
  { x: 440, y: 122, schaal: 0.9 },
];
const dwarsliggers = Array.from({ length: 33 }, (_, i) => 16 + i * 14);
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: links de stad Groningen met een hoge kerktoren en trapgevels, rechts de Ommelanden met akkers en draaiende windmolens. Een trein uit de richting van Assen rijdt de stad binnen.'}>
  <defs>
    <clipPath id="regio-groningen-akker"><rect x="240" y="190" width="228" height="34" /></clipPath>
  </defs>
  <!-- grond: stad links, akkers rechts -->
  <rect x="12" y="190" width="228" height="34" fill="#e8eef4" />
  <rect x="240" y="190" width="228" height="34" fill="#d7e6d8" />
  <g clip-path="url(#regio-groningen-akker)" stroke="#c4d9c6" stroke-width="5">
    {Array.from({ length: 12 }, (_, i) => <path d={`M${236 + i * 22} 226L${256 + i * 22} 188`} />)}
  </g>
  <!-- de Stad -->
  <g>
    <path d="M24 190v-30l16-14 16 14v30z" fill="#fff" />
    <path class="l" d="M24 190v-30l16-14 16 14v30z" />
    <rect class="v" x="34" y="166" width="12" height="10" rx="2" />
    <path d="M58 190v-32h4v-8h5v-8h5v-6h6v6h5v8h5v8h4v32z" fill="#fff" />
    <path class="l" d="M58 190v-32h4v-8h5v-8h5v-6h6v6h5v8h5v8h4v32z" />
    <rect class="v" x="66" y="160" width="7" height="10" rx="2" /><rect class="v" x="77" y="160" width="7" height="10" rx="2" />
    <rect class="v" x="70" y="176" width="10" height="14" rx="2" />
    <!-- kerktoren -->
    <path d="M114 190v-68h28v68zM117 122V96h22v26zM120 96V74h16v22zM123 74V60h10v14z" fill="#fff" />
    <path class="l" d="M114 190v-68h28v68M117 122V96h22v26M120 96V74h16v22M123 74V60h10v14" />
    <path d="M122 60l6-20 6 20z" fill="#074663" />
    <path class="o" d="M128 40v-9l8 3-8 3z" />
    <path class="v" d="M123 160a5 5 0 0 1 10 0v12h-10zM124 106a4 4 0 0 1 8 0v8h-8zM125 82a3 3 0 0 1 6 0v6h-6z" />
    <circle cx="128" cy="138" r="6" fill="#fff" stroke="#074663" stroke-width="2" />
    <path d="M128 134v4l3 2" fill="none" stroke="#074663" stroke-width="1.5" stroke-linecap="round" />
    <path d="M148 190v-30l16-12 16 12v30z" fill="#fff" />
    <path class="l" d="M148 190v-30l16-12 16 12v30z" />
    <rect class="v" x="158" y="166" width="12" height="10" rx="2" />
    <path d="M182 190v-28h4v-7h5v-7h5v-5h6v5h5v7h5v7h4v28z" fill="#fff" />
    <path class="l" d="M182 190v-28h4v-7h5v-7h5v-5h6v5h5v7h5v7h4v28z" />
    <rect class="v" x="193" y="164" width="12" height="10" rx="2" />
    <path d="M216 190v-20l10-8 10 8v20z" fill="#fff" />
    <path class="l" d="M216 190v-20l10-8 10 8v20z" />
  </g>
  <!-- de Ommelanden: schuur en windmolens -->
  <path d="M250 190v-18l20-14 20 14v18z" fill="#fff" />
  <path class="l" d="M250 190v-18l20-14 20 14v18zM264 190v-12h12v12" />
  {molens.map((m, i) => (
    <g transform={`translate(${m.x} ${m.y}) scale(${m.schaal})`}>
      <path d={`M-3 ${(190 - m.y) / m.schaal}L-1.2 0h2.4L3 ${(190 - m.y) / m.schaal}z`} fill="#fff" stroke="#074663" stroke-width="1.5" stroke-linejoin="round" />
      <g class="regio-groningen-wieken" style={`animation-delay:${0.4 + i * 0.5}s`}>
        <g fill="#fff" stroke="#074663" stroke-width="1.5" stroke-linejoin="round">
          <path d="M0 0c-3-10-3-22 0-32c3 10 3 22 0 32z" />
          <path d="M0 0c-3-10-3-22 0-32c3 10 3 22 0 32z" transform="rotate(120)" />
          <path d="M0 0c-3-10-3-22 0-32c3 10 3 22 0 32z" transform="rotate(240)" />
        </g>
        <circle r="3" fill="#074663" />
      </g>
    </g>
  ))}
  <!-- labels -->
  <rect x="24" y="106" width="54" height="22" rx="11" fill="#074663" />
  <text x="51" y="121" text-anchor="middle" font-size="11.5" font-weight="800" style="fill:#fff">Stad</text>
  <rect x="318" y="20" width="110" height="22" rx="11" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
  <text x="373" y="35" text-anchor="middle" font-size="11.5" font-weight="800">Ommelanden</text>
  <!-- spoor en trein -->
  <path d="M12 229H468M12 234H468" stroke="#8aa0b4" stroke-width="2" />
  <path d={dwarsliggers.map((x) => `M${x} 227v9`).join('')} stroke="#c4d0dc" stroke-width="3" />
  <g class="regio-groningen-trein">
    <rect x="118" y="204" width="56" height="22" rx="5" fill="#fff" stroke="#074663" stroke-width="2" />
    <path d="M176 204h46q9 0 11 9l2 13h-59z" fill="#fff" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
    <path d="M122 210h48v7h-48zM180 210h38v7h-38z" fill="#074663" />
    <path d="M222 210h6l2 7h-8z" fill="#10283f" />
    <path d="M118 221h56M176 221h59" stroke="#ff6600" stroke-width="2.5" />
    <g fill="#10283f"><circle cx="130" cy="228" r="3.5" /><circle cx="162" cy="228" r="3.5" /><circle cx="188" cy="228" r="3.5" /><circle cx="222" cy="228" r="3.5" /></g>
  </g>
  <g>
    <rect x="16" y="242" width="74" height="20" rx="4" fill="#074663" />
    <text x="53" y="256" text-anchor="middle" font-size="11" font-weight="800" style="fill:#fff">← Assen</text>
  </g>
  {!mini && (
    <g transform="translate(262 241)">
      <g class="regio-groningen-label">
        <rect width="160" height="24" rx="12" fill="#fff4ec" stroke="#ffd2b0" stroke-width="1.5" />
        <circle cx="14" cy="12" r="6" fill="none" stroke="#ff6600" stroke-width="2" />
        <path d="M14 9v3.5l2.5 1.5" fill="none" stroke="#ff6600" stroke-width="1.6" stroke-linecap="round" />
        <text x="27" y="16.5" font-size="10.5" font-weight="800">20 minuten uit Assen</text>
      </g>
    </g>
  )}
</svg>
<style>
  .regio-groningen-wieken { transform-box: view-box; transform-origin: 0 0; }
  .in-beeld .regio-groningen-wieken { animation: regio-groningen-draai 7s linear infinite; }
  .regio-groningen-trein { transform-box: view-box; }
  :global(.teken-js) .regio-groningen-trein { opacity: 0; transform: translateX(-110px); }
  .in-beeld .regio-groningen-trein { animation: regio-groningen-rijden 2.2s cubic-bezier(.25,.6,.3,1) 0.5s forwards; }
  :global(.teken-js) .regio-groningen-label { opacity: 0; }
  .in-beeld .regio-groningen-label { animation: regio-groningen-op 0.6s cubic-bezier(.3,1.6,.5,1) 2.6s forwards; }
  @keyframes regio-groningen-draai { to { transform: rotate(360deg); } }
  @keyframes regio-groningen-rijden { from { opacity: 0; transform: translateX(-110px); } 25% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes regio-groningen-op { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .regio-groningen-wieken, .in-beeld .regio-groningen-trein, .in-beeld .regio-groningen-label { animation: none; }
  }
</style>
