---
// Scène voor /website-laten-maken/portfolio/: een wand met websites die we maakten, op laptop en telefoon.
// Een oranje kader loopt rustig langs de voorbeelden, een cursor klikt op de knop van de grote site.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: drie websites naast elkaar, van een betonbedrijf, een glaszetter en een dakramenspecialist, met een telefoon ervoor. Een oranje kader loopt langs de sites en een cursor klikt op de knop van de grote site.'}>
  <!-- Grote site: betonbedrijf -->
  <rect x="20" y="34" width="252" height="170" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path class="l" d="M20 56h252" />
  <circle cx="36" cy="45" r="3.5" fill="#d9e1ea" /><circle cx="48" cy="45" r="3.5" fill="#d9e1ea" /><circle cx="60" cy="45" r="3.5" fill="#d9e1ea" />
  <rect x="80" y="40" width="120" height="10" rx="5" fill="#e8eef4" />
  <rect x="22" y="58" width="248" height="88" fill="#10283f" />
  <path d="M190 146c18-22 40-30 80-26v26z" fill="#8aa0b4" />
  <path d="M206 146c12-12 30-16 64-14v14z" fill="#b9c8d6" />
  <rect x="36" y="74" width="120" height="11" rx="4" fill="#fff" />
  <rect x="36" y="92" width="96" height="6" rx="3" fill="#8aa0b4" />
  <rect x="36" y="103" width="108" height="6" rx="3" fill="#8aa0b4" />
  <rect x="36" y="118" width="74" height="18" rx="4" fill="#ff6600" />
  <rect x="36" y="158" width="64" height="34" rx="6" class="v" />
  <rect x="112" y="158" width="64" height="34" rx="6" class="v" />
  <rect x="188" y="158" width="64" height="34" rx="6" class="v" />
  <rect x="20" y="212" width="86" height="20" rx="10" fill="#e8eef4" />
  <text x="31" y="226" font-size="10.5" font-weight="800" fill="#074663">Betonbedrijf</text>

  <!-- Kleine site rechtsboven: glaszetter met formulier -->
  <rect x="292" y="22" width="168" height="106" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path class="l" d="M292 38h168" />
  <circle cx="303" cy="30" r="2.5" fill="#d9e1ea" /><circle cx="312" cy="30" r="2.5" fill="#d9e1ea" /><circle cx="321" cy="30" r="2.5" fill="#d9e1ea" />
  <rect x="294" y="40" width="164" height="86" fill="#074663" />
  <rect x="304" y="50" width="64" height="66" rx="6" fill="#fff" />
  <rect x="310" y="58" width="40" height="5" rx="2.5" fill="#10283f" />
  <rect x="310" y="70" width="22" height="9" rx="2" fill="none" stroke="#b9c8d6" stroke-width="1.5" />
  <rect x="337" y="70" width="25" height="9" rx="2" fill="none" stroke="#b9c8d6" stroke-width="1.5" />
  <rect x="310" y="84" width="52" height="9" rx="2" fill="none" stroke="#b9c8d6" stroke-width="1.5" />
  <rect x="310" y="100" width="52" height="9" rx="3" fill="#ff6600" />
  <rect x="380" y="56" width="68" height="9" rx="3" fill="#fff" />
  <rect x="380" y="70" width="56" height="5" rx="2.5" fill="#8aa0b4" />
  <rect x="380" y="80" width="62" height="5" rx="2.5" fill="#8aa0b4" />
  <rect x="380" y="94" width="50" height="5" rx="2.5" fill="#8aa0b4" />
  <rect x="374" y="134" width="86" height="20" rx="10" fill="#e8eef4" />
  <text x="390" y="148" font-size="10.5" font-weight="800" fill="#074663">Glaszetter</text>

  <!-- Kleine site rechtsonder: dakramen met calculator -->
  <rect x="292" y="162" width="168" height="80" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path class="l" d="M292 178h168" />
  <circle cx="303" cy="170" r="2.5" fill="#d9e1ea" /><circle cx="312" cy="170" r="2.5" fill="#d9e1ea" /><circle cx="321" cy="170" r="2.5" fill="#d9e1ea" />
  <rect x="294" y="180" width="164" height="60" fill="#e8eef4" />
  <path d="M392 232l20-44h30l-20 44z" fill="#fff" stroke="#b9c8d6" stroke-width="1.5" />
  <path d="M414 232l14-32h16l-14 32z" fill="#fff" stroke="#b9c8d6" stroke-width="1.5" />
  <rect x="304" y="188" width="76" height="44" rx="5" fill="#074663" />
  <rect x="312" y="196" width="50" height="6" rx="3" fill="#fff" />
  <rect x="312" y="207" width="38" height="5" rx="2.5" fill="#8aa0b4" />
  <rect x="312" y="218" width="44" height="8" rx="3" fill="#ff6600" />
  <rect x="374" y="248" width="86" height="20" rx="10" fill="#e8eef4" />
  <text x="388" y="262" font-size="10.5" font-weight="800" fill="#074663">Dakramen</text>

  <!-- Telefoon voor de grote site -->
  <rect x="226" y="112" width="62" height="126" rx="12" fill="#10283f" />
  <rect x="231" y="122" width="52" height="108" rx="6" fill="#fff" />
  <rect x="249" y="116" width="16" height="3" rx="1.5" fill="#8aa0b4" />
  <rect x="231" y="122" width="52" height="46" fill="#10283f" />
  <rect x="237" y="132" width="36" height="6" rx="3" fill="#fff" />
  <rect x="237" y="142" width="28" height="4" rx="2" fill="#8aa0b4" />
  <rect x="237" y="153" width="30" height="9" rx="3" fill="#ff6600" />
  <rect x="237" y="176" width="40" height="5" rx="2.5" class="v" />
  <rect x="237" y="186" width="32" height="5" rx="2.5" class="v" />
  <rect x="237" y="200" width="40" height="22" rx="4" class="v" />

  {!mini && (
    <g>
      <rect class="website-laten-maken--portfolio-kader website-laten-maken--portfolio-k1" x="14" y="28" width="264" height="182" rx="16" />
      <rect class="website-laten-maken--portfolio-kader website-laten-maken--portfolio-k2" x="286" y="16" width="180" height="118" rx="14" />
      <rect class="website-laten-maken--portfolio-kader website-laten-maken--portfolio-k3" x="286" y="156" width="180" height="92" rx="14" />
      <g class="website-laten-maken--portfolio-cursor">
        <path d="M0 0l7 19 3-8 8-3z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      </g>
      <circle class="website-laten-maken--portfolio-ring" cx="73" cy="127" r="12" fill="none" stroke="#ff6600" stroke-width="3" />
      <g class="website-laten-maken--portfolio-melding">
        <rect x="104" y="238" width="118" height="26" rx="10" fill="#fff" stroke="#d9e1ea" />
        <circle cx="120" cy="251" r="8" fill="#1f8a5b" />
        <path d="M116 251l3 3 6-6" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="134" y="255" font-size="11" font-weight="800">Live bekijken</text>
      </g>
    </g>
  )}
</svg>
<style>
  .website-laten-maken--portfolio-kader { fill: none; stroke: #ff6600; stroke-width: 3; opacity: 0; }
  .website-laten-maken--portfolio-cursor { transform: translate(200px, 200px); }
  .website-laten-maken--portfolio-ring { opacity: 0; transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .website-laten-maken--portfolio-cursor, :global(.teken-js) .website-laten-maken--portfolio-melding { opacity: 0; }
  .in-beeld .website-laten-maken--portfolio-k1 { animation: website-laten-maken--portfolio-kader 7.5s ease-in-out 0.4s infinite both; }
  .in-beeld .website-laten-maken--portfolio-k2 { animation: website-laten-maken--portfolio-kader 7.5s ease-in-out 2.9s infinite both; }
  .in-beeld .website-laten-maken--portfolio-k3 { animation: website-laten-maken--portfolio-kader 7.5s ease-in-out 5.4s infinite both; }
  .in-beeld .website-laten-maken--portfolio-cursor { animation: website-laten-maken--portfolio-cursor 7.5s ease-in-out 0.4s infinite both; }
  .in-beeld .website-laten-maken--portfolio-ring { animation: website-laten-maken--portfolio-ring 7.5s ease-out 0.4s infinite both; }
  .in-beeld .website-laten-maken--portfolio-melding { animation: website-laten-maken--portfolio-melding 7.5s ease-in-out 0.4s infinite both; }
  @keyframes website-laten-maken--portfolio-kader { 0% { opacity: 0; } 6%, 30% { opacity: 1; } 36%, 100% { opacity: 0; } }
  @keyframes website-laten-maken--portfolio-cursor {
    0% { opacity: 0; transform: translate(200px, 200px); }
    6% { opacity: 1; transform: translate(190px, 190px); }
    18%, 26% { opacity: 1; transform: translate(70px, 124px); }
    34% { opacity: 0; transform: translate(110px, 170px); }
    100% { opacity: 0; transform: translate(200px, 200px); }
  }
  @keyframes website-laten-maken--portfolio-ring { 0%, 18% { opacity: 0; transform: scale(0.3); } 21% { opacity: 1; } 30%, 100% { opacity: 0; transform: scale(1.8); } }
  @keyframes website-laten-maken--portfolio-melding { 0%, 22% { opacity: 0; transform: translateY(8px); } 28%, 58% { opacity: 1; transform: none; } 66%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .website-laten-maken--portfolio-kader, .in-beeld .website-laten-maken--portfolio-cursor, .in-beeld .website-laten-maken--portfolio-ring, .in-beeld .website-laten-maken--portfolio-melding { animation: none; }
  }
</style>
