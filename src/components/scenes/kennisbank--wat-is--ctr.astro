---
// Scène voor /kennisbank/wat-is/ctr/: honderd vertoningen als honderd stipjes, waarvan er vijf oranje zijn: dat zijn de klikken.
// Rechts de som: 5 klikken gedeeld door 100 vertoningen is een CTR van 5%. Als hij leeft: de klikken lichten één voor één op en de uitkomst verschijnt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const klikken = [13, 37, 52, 76, 91];
const stippen = Array.from({ length: 100 }, (_, i) => ({ i, x: 44 + (i % 10) * 22, y: 50 + Math.floor(i / 10) * 19 }));
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: honderd stipjes staan voor honderd vertoningen. Vijf ervan zijn oranje: vijf mensen klikten. Vijf klikken gedeeld door honderd vertoningen is een CTR van vijf procent.'}>
  <rect x="22" y="24" width="244" height="222" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="40" y="42" font-size="11" font-weight="800" class="zacht">100 vertoningen</text>
  {stippen.map((s) => (
    <circle cx={s.x} cy={s.y + 6} r="6" fill={klikken.includes(s.i) ? '#ff6600' : '#e8eef4'} />
  ))}

  <rect x="286" y="54" width="172" height="160" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="372" y="82" font-size="12" font-weight="800" text-anchor="middle" class="zacht">CTR</text>
  <circle cx="314" cy="108" r="6" fill="#ff6600" />
  <text x="328" y="112" font-size="12" font-weight="700">5 klikken</text>
  <path d="M308 124h128" stroke="#10283f" stroke-width="2" />
  <circle cx="314" cy="142" r="6" fill="#e8eef4" stroke="#d9e1ea" />
  <text x="328" y="146" font-size="12" font-weight="700">100 vertoningen</text>
  <rect x="318" y="162" width="108" height="38" rx="10" fill="#fff4ec" />
  <text x="372" y="188" font-size="22" font-weight="800" text-anchor="middle">= 5%</text>
  <path class="a" d="M270 134h12M277 129l5 5-5 5" />

  {!mini && (
    <g>
      {klikken.map((k, n) => {
        const s = stippen[k];
        return <circle class="ctr-golf" cx={s.x} cy={s.y + 6} r="6" fill="none" stroke="#ff6600" stroke-width="2.5" style={`animation-delay:${0.5 + n * 0.7}s`} />;
      })}
      <g class="ctr-uitkomst"><rect x="314" y="158" width="116" height="46" rx="12" fill="none" stroke="#ff6600" stroke-width="2.5" /></g>
      <g class="ctr-chip"><rect x="330" y="222" width="84" height="24" rx="12" fill="#1f8a5b" /><text x="372" y="238.5" font-size="11.5" font-weight="800" text-anchor="middle" style="fill:#fff">5 van 100</text></g>
    </g>
  )}
</svg>
<style>
  .ctr-golf, .ctr-uitkomst, .ctr-chip { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .ctr-golf, :global(.teken-js) .ctr-uitkomst, :global(.teken-js) .ctr-chip { opacity: 0; }
  .in-beeld .ctr-golf { animation: kennisbank--wat-is--ctr-golf 4.2s ease-out infinite; }
  .in-beeld .ctr-uitkomst { animation: kennisbank--wat-is--ctr-uitkomst 4.2s ease-in-out 0.5s infinite; }
  .in-beeld .ctr-chip { animation: kennisbank--wat-is--ctr-chip 0.5s cubic-bezier(.3,1.5,.5,1) 1.2s forwards; }
  @keyframes kennisbank--wat-is--ctr-golf { 0% { opacity: 0; transform: scale(1); } 6% { opacity: 1; } 30%, 100% { opacity: 0; transform: scale(2.6); } }
  @keyframes kennisbank--wat-is--ctr-uitkomst { 0%, 70% { opacity: 0; transform: scale(1.1); } 78%, 92% { opacity: 1; transform: none; } 100% { opacity: 0; transform: none; } }
  @keyframes kennisbank--wat-is--ctr-chip { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .ctr-golf, .in-beeld .ctr-uitkomst, .in-beeld .ctr-chip { animation: none; } }
</style>
