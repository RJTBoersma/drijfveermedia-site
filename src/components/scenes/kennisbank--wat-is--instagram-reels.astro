---
// Scène voor /kennisbank/wat-is/instagram-reels/: een staande telefoon met een reel van een vakman, met ondertiteling en knoppen aan de zijkant. Links de hook in de eerste seconden, rechts formaat, geluid en nieuwe kijkers.
// Als hij leeft: de voortgangsbalk bovenin loopt steeds opnieuw vol, een hartje springt op, een muzieknoot zweeft omhoog en er komt een nieuwe volger bij.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const chips = [
  { y: 58, tekst: 'Eigen geluid', icoon: 'noot' },
  { y: 112, tekst: '9:16 staand', icoon: 'kader' },
  { y: 166, tekst: 'Nieuwe kijkers', icoon: 'pijl' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een staande telefoon speelt een reel van een vakman af, met ondertiteling in beeld en knoppen om te liken, te reageren en te delen. Links staat de hook in de eerste seconden, rechts het staande formaat, eigen geluid en nieuwe kijkers.'}>
  <rect x="24" y="62" width="130" height="86" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="38" y="86" font-size="12" font-weight="800">De hook</text>
  <text x="38" y="103" font-size="11" class="zacht">eerste 3 seconden</text>
  <rect x="38" y="118" width="102" height="10" rx="5" fill="#e8eef4" />
  <rect x="38" y="118" width="26" height="10" rx="5" fill="#ff6600" />
  <g>
    <rect x="24" y="166" width="130" height="32" rx="16" fill="#fff" stroke="#1a7a50" stroke-width="2" />
    <circle cx="42" cy="182" r="8" fill="#1a7a50" />
    <path d="M38 182l3 3 5-6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="96" y="186.5" font-size="11.5" font-weight="800" text-anchor="middle">Ondertiteld</text>
  </g>

  <rect x="176" y="18" width="128" height="234" rx="20" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <rect x="185" y="30" width="110" height="210" rx="12" fill="#e8eef4" />
  <rect x="193" y="40" width="94" height="4" rx="2" fill="#fff" />
  <rect x="193" y="40" width="38" height="4" rx="2" fill="#ff6600" />
  <path d="M196 92h46v30h-46z" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M219 92v30M196 107h46" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="243" cy="128" r="16" fill="#074663" />
  <path d="M212 182a30 30 0 0 1 60 0v10h-60z" fill="#074663" />
  <path d="M261 150l10-26" stroke="#ff6600" stroke-width="4" stroke-linecap="round" />
  <rect x="266" y="112" width="14" height="10" rx="2" fill="#ff6600" transform="rotate(20 273 117)" />
  <rect x="192" y="198" width="80" height="18" rx="5" fill="#fff" />
  <text x="232" y="211" font-size="9.5" font-weight="800" text-anchor="middle">Zo plak je af</text>
  <text x="193" y="231" font-size="9" font-weight="700">@jouwbedrijf</text>
  <path d="M284 146c-3-4-9-2-8 3 1 3 8 8 8 8s7-5 8-8c1-5-5-7-8-3z" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
  <path d="M277 170h14v9h-8l-4 4v-4h-2z" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />
  <path d="M278 200l12-6-2 12-3-4z" fill="none" stroke="#074663" stroke-width="2" stroke-linejoin="round" />

  {chips.map((c) => (
    <g>
      <rect x="326" y={c.y} width="134" height="34" rx="17" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      {c.icoon === 'noot' && <path d={`M342 ${c.y + 24}a4 4 0 1 1 0-1V${c.y + 9}l10-2v13`} fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" />}
      {c.icoon === 'kader' && <rect x="339" y={c.y + 7} width="11" height="20" rx="2" fill="none" stroke="#074663" stroke-width="2" />}
      {c.icoon === 'pijl' && <path d={`M337 ${c.y + 24}l7-8 5 4 7-9M351 ${c.y + 11}h5v5`} fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />}
      <text x="364" y={c.y + 21.5} font-size="12" font-weight="700">{c.tekst}</text>
    </g>
  ))}

  {!mini && (
    <g>
      <rect class="reels-balk" x="193" y="40" width="94" height="4" rx="2" fill="#ff6600" />
      <path class="reels-hart" d="M284 146c-3-4-9-2-8 3 1 3 8 8 8 8s7-5 8-8c1-5-5-7-8-3z" fill="#ff6600" />
      <path class="reels-noot" d="M300 96a4 4 0 1 1 0-1V82l9-2v12" fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" />
      <g class="reels-volger">
        <rect x="350" y="214" width="96" height="26" rx="13" fill="#1a7a50" />
        <text x="398" y="231.5" font-size="12" font-weight="800" text-anchor="middle" style="fill:#fff">+1 volger</text>
      </g>
    </g>
  )}
</svg>
<style>
  .reels-balk { transform-box: fill-box; transform-origin: left center; }
  .reels-hart, .reels-volger, .reels-noot { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .reels-balk { transform: scaleX(0); }
  :global(.teken-js) .reels-hart, :global(.teken-js) .reels-volger, :global(.teken-js) .reels-noot { opacity: 0; }
  .in-beeld .reels-balk { animation: kennisbank-wat-is-instagram-reels-balk 5s linear 0.3s infinite; }
  .in-beeld .reels-hart { animation: kennisbank-wat-is-instagram-reels-hart 5s ease-out 0.3s infinite; }
  .in-beeld .reels-noot { animation: kennisbank-wat-is-instagram-reels-noot 4s ease-in-out 0.8s infinite; }
  .in-beeld .reels-volger { animation: kennisbank-wat-is-instagram-reels-volger 5s ease-out 0.3s infinite; }
  @keyframes kennisbank-wat-is-instagram-reels-balk { 0% { transform: scaleX(0); } 92% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }
  @keyframes kennisbank-wat-is-instagram-reels-hart { 0%, 30% { opacity: 0; transform: scale(0.4); } 36% { opacity: 1; transform: scale(1.3); } 42%, 80% { opacity: 1; transform: none; } 90%, 100% { opacity: 0; } }
  @keyframes kennisbank-wat-is-instagram-reels-noot { 0% { opacity: 0; transform: translate(0, 8px); } 20% { opacity: 1; } 80% { opacity: 1; transform: translate(6px, -22px); } 100% { opacity: 0; transform: translate(8px, -28px); } }
  @keyframes kennisbank-wat-is-instagram-reels-volger { 0%, 50% { opacity: 0; transform: translateY(6px); } 58%, 86% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .reels-balk, .in-beeld .reels-hart, .in-beeld .reels-noot, .in-beeld .reels-volger { animation: none; } }
</style>
