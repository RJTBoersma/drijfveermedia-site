---
// Scène voor /kennisbank/gidsen/google-analytics-4/: een website met een belknop, een tag in het midden en een overzicht met aanvragen.
// Als hij leeft: de cursor klikt op de knop, een signaal reist via de tag naar het overzicht en de laatste balk groeit een stukje.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const balken = [
  { x: 330, h: 34 }, { x: 352, h: 48 }, { x: 374, h: 40 }, { x: 396, h: 62 }, { x: 418, h: 76 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: iemand klikt op de belknop van een website, een tag geeft dat door en in het overzicht groeit het aantal aanvragen.'}>
  <!-- website -->
  <rect x="24" y="44" width="150" height="186" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M36 44h126a12 12 0 0 1 12 12v8H24v-8a12 12 0 0 1 12-12z" fill="#e8eef4" />
  <circle cx="38" cy="54" r="3.5" fill="#d9e1ea" /><circle cx="49" cy="54" r="3.5" fill="#d9e1ea" /><circle cx="60" cy="54" r="3.5" fill="#d9e1ea" />
  <rect x="40" y="80" width="96" height="10" rx="5" fill="#10283f" />
  <rect x="40" y="100" width="118" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="40" y="114" width="104" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="40" y="128" width="112" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="40" y="170" width="112" height="30" rx="9" fill="#ff6600" />
  <path d="M56 180l4 1 1.6 4.4-2.2 1.8c1.4 2.8 3.2 4.6 6 6l1.8-2.2 4.4 1.6 1 4c-.8 1.4-2.2 2.2-3.6 2.2-8.4 0-15.4-7-15.4-15.4 0-1.4.8-2.8 2.4-3.4z" fill="#fff" />
  <text x="80" y="190" font-size="12" font-weight="800" style="fill:#fff">Bel ons</text>

  <!-- verbinding -->
  <path d="M152 185C178 185 172 132 198 132" fill="none" stroke="#d9e1ea" stroke-width="2.5" stroke-dasharray="5 5" />
  <path d="M290 132C302 132 300 118 314 118" fill="none" stroke="#d9e1ea" stroke-width="2.5" stroke-dasharray="5 5" />

  <!-- tag -->
  <rect x="198" y="102" width="92" height="60" rx="10" fill="#074663" />
  <path d="M212 118h18l6 6-6 6h-18z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" />
  <circle cx="230" cy="124" r="2" fill="#ff6600" />
  <text x="242" y="128" font-size="11" font-weight="800" style="fill:#fff">Tag</text>
  <text x="212" y="150" font-size="9.5" style="fill:#cfe0ec">telefoonklik</text>

  <!-- overzicht -->
  <rect x="314" y="34" width="146" height="202" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="326" y="48" width="122" height="52" rx="8" fill="#e8eef4" />
  <text x="336" y="66" font-size="10" class="zacht">Aanvragen</text>
  <text x="336" y="90" font-size="20" font-weight="900">24</text>
  <path d="M404 86l10-10 8 6 14-14" fill="none" stroke="#1f8a5b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="326" y="114" width="70" height="7" rx="3.5" fill="#d9e1ea" />
  <path d="M326 222h122" stroke="#d9e1ea" stroke-width="2" />
  {balken.map((b, i) => (
    <rect x={b.x} y={220 - b.h} width="14" height={b.h} rx="3" fill={i === balken.length - 1 ? '#ff6600' : '#074663'} />
  ))}

  {!mini && (
    <g>
      <g class="cursor">
        <path d="M120 196l0 22 6-5 4 9 4-2-4-9 8-1z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      </g>
      <circle class="signaal" r="6" fill="#ff6600" stroke="#fff" stroke-width="2" style="offset-path: path('M152 185C178 185 172 132 198 132L290 132C302 132 300 118 314 118');" />
      <rect class="erbij" x="418" y="128" width="14" height="14" rx="3" fill="#ffb27a" />
      <g class="plus"><rect x="388" y="40" width="54" height="20" rx="10" fill="#1f8a5b" /><text x="400" y="54" font-size="10.5" font-weight="800" style="fill:#fff">+1 klik</text></g>
    </g>
  )}
</svg>
<style>
  .erbij { transform-box: fill-box; transform-origin: bottom; }
  :global(.teken-js) .erbij { opacity: 0; }
  .in-beeld .erbij { animation: kennisbank-gidsen-google-analytics-4-groei 5s cubic-bezier(.3,1.3,.5,1) 0.6s infinite; }
  .cursor { transform-box: fill-box; transform-origin: top left; }
  .in-beeld .cursor { animation: kennisbank-gidsen-google-analytics-4-klik 5s ease-in-out 0.6s infinite; }
  :global(.teken-js) .signaal { opacity: 0; }
  .in-beeld .signaal { animation: kennisbank-gidsen-google-analytics-4-reis 5s ease-in-out 0.6s infinite; }
  :global(.teken-js) .plus { opacity: 0; }
  .in-beeld .plus { animation: kennisbank-gidsen-google-analytics-4-plus 5s ease-in-out 0.6s infinite; }
  @keyframes kennisbank-gidsen-google-analytics-4-groei { 0%, 52% { opacity: 0; transform: scaleY(0); } 60%, 88% { opacity: 1; transform: scaleY(1); } 96%, 100% { opacity: 0; transform: scaleY(1); } }
  @keyframes kennisbank-gidsen-google-analytics-4-klik { 0%, 6% { transform: none; } 9% { transform: scale(0.85); } 13%, 100% { transform: none; } }
  @keyframes kennisbank-gidsen-google-analytics-4-reis { 0%, 10% { offset-distance: 0%; opacity: 0; } 14% { opacity: 1; } 52% { offset-distance: 100%; opacity: 1; } 58%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes kennisbank-gidsen-google-analytics-4-plus { 0%, 52% { opacity: 0; transform: translateY(6px); } 58%, 85% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .erbij, .in-beeld .cursor, .in-beeld .signaal, .in-beeld .plus { animation: none; } }
</style>
