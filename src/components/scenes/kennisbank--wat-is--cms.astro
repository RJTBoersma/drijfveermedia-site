---
// Scène voor /kennisbank/wat-is/cms/: links de beheeromgeving van een CMS met een editor, rechts de website die bezoekers zien.
// Als hij leeft: een cursor klikt op Bijwerken, er verschijnt een melding, en op de website licht de aangepaste regel op.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const menu = [62, 82, 102, 122, 142];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: links de beheeromgeving van een CMS waarin iemand de openingstijden aanpast en op Bijwerken klikt, rechts de website waar de nieuwe tekst meteen verschijnt.'}>
  <!-- beheeromgeving -->
  <rect x="14" y="28" width="240" height="214" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M26 29h40v212H26a11 11 0 0 1-11-11V40a11 11 0 0 1 11-11z" fill="#10283f" />
  {menu.map((y, i) => (
    <rect x="26" y={y} width={i === 1 ? 30 : 26} height="7" rx="3.5" fill={i === 1 ? '#ff6600' : '#fff'} opacity={i === 1 ? 1 : 0.35} />
  ))}
  <text x="80" y="50" font-size="10" class="zacht">Pagina bewerken</text>
  <rect x="80" y="58" width="160" height="24" rx="6" fill="#fff" stroke="#074663" stroke-width="2" />
  <text x="90" y="74" font-size="11" font-weight="800">Openingstijden</text>
  <rect x="80" y="94" width="150" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="80" y="107" width="120" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="80" y="120" width="136" height="12" rx="4" fill="#fff" stroke="#ff6600" stroke-width="1.5" />
  <text x="85" y="129.5" font-size="8.5" font-weight="800">Za 9.00 tot 14.00 uur</text>
  <rect class="v" x="80" y="144" width="74" height="52" rx="6" />
  <path class="l" d="M86 190l16-16 12 10 10-8 22 14" />
  <circle class="o" cx="138" cy="158" r="6" />
  <rect x="164" y="146" width="66" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="164" y="160" width="50" height="7" rx="3.5" fill="#e8eef4" />
  <rect x="160" y="208" width="80" height="24" rx="12" fill="#ff6600" />
  <text x="200" y="224" font-size="10.5" font-weight="800" text-anchor="middle" style="fill:#fff">Bijwerken</text>

  <!-- pijl -->
  <path class="a" d="M262 138h20M274 130l8 8-8 8" />

  <!-- website -->
  <rect x="292" y="52" width="174" height="176" rx="12" fill="#fff" stroke="#074663" stroke-width="2" />
  <path d="M293 76v-12a11 11 0 0 1 11-11h150a11 11 0 0 1 11 11v12z" fill="#e8eef4" />
  <circle cx="306" cy="64" r="3.5" fill="#d9e1ea" /><circle cx="318" cy="64" r="3.5" fill="#d9e1ea" /><circle cx="330" cy="64" r="3.5" fill="#d9e1ea" />
  <rect class="v" x="304" y="86" width="150" height="44" rx="6" />
  <text x="304" y="150" font-size="12" font-weight="800">Openingstijden</text>
  <rect x="304" y="160" width="128" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="304" y="173" width="104" height="7" rx="3.5" fill="#d9e1ea" />
  <text x="304" y="195" font-size="9.5" class="zacht">Za 9.00 tot 14.00 uur</text>
  <rect x="304" y="206" width="70" height="12" rx="6" fill="#074663" opacity="0.85" />

  {!mini && (
    <g>
      <rect class="cms-gloed" x="298" y="184" width="150" height="16" rx="6" fill="#ff6600" fill-opacity="0.18" />
      <g class="cms-cursor">
        <path d="M0 0l0 18 5-4.5 3.5 8 3.2-1.4-3.4-7.8 6.7-.5z" fill="#10283f" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" transform="translate(206 218)" />
      </g>
      <g class="cms-melding">
        <rect x="100" y="6" width="120" height="26" rx="13" fill="#1f8a5b" />
        <text x="160" y="23.5" font-size="11" font-weight="800" text-anchor="middle" style="fill:#fff">Bijgewerkt</text>
      </g>
    </g>
  )}
</svg>
<style>
  .cms-melding { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .cms-cursor, :global(.teken-js) .cms-melding, :global(.teken-js) .cms-gloed { opacity: 0; }
  .in-beeld .cms-cursor { animation: kennisbank--wat-is--cms-cursor 5s ease-in-out 0.5s infinite; }
  .in-beeld .cms-melding { animation: kennisbank--wat-is--cms-melding 5s ease-out 0.5s infinite; }
  .in-beeld .cms-gloed { animation: kennisbank--wat-is--cms-gloed 5s ease-in-out 0.5s infinite; }
  @keyframes kennisbank--wat-is--cms-cursor {
    0% { opacity: 0; transform: translate(-60px, -70px); }
    10% { opacity: 1; }
    32% { transform: translate(0, 0); }
    36% { transform: translate(0, 0) scale(0.9); }
    40% { transform: translate(0, 0); }
    80% { opacity: 1; transform: translate(0, 0); }
    92%, 100% { opacity: 0; transform: translate(0, 0); }
  }
  @keyframes kennisbank--wat-is--cms-melding { 0%, 38% { opacity: 0; transform: translateY(6px); } 46%, 84% { opacity: 1; transform: none; } 94%, 100% { opacity: 0; } }
  @keyframes kennisbank--wat-is--cms-gloed { 0%, 42% { opacity: 0; } 52%, 80% { opacity: 1; } 94%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .cms-cursor, .in-beeld .cms-melding, .in-beeld .cms-gloed { animation: none; } }
</style>
