---
// Scène voor /online-adverteren/adverteren-in-chatgpt/: een chatgesprek met onder het antwoord een gesponsord kaartje. Een cursor klikt erop en er komt een bezoeker binnen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een chatgesprek met een AI-assistent. Onder het antwoord staat een advertentie met het label gesponsord. Een cursor klikt erop en er komt een nieuwe bezoeker binnen.'}>
  <!-- chatvenster -->
  <rect x="40" y="18" width="400" height="236" rx="16" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path class="l" d="M40 50h400" style="stroke:#d9e1ea" />
  <circle cx="62" cy="34" r="5" fill="#d9e1ea" /><circle cx="78" cy="34" r="5" fill="#d9e1ea" /><circle cx="94" cy="34" r="5" fill="#d9e1ea" />
  <!-- vraag van de gebruiker -->
  <rect x="214" y="64" width="206" height="32" rx="14" fill="#074663" />
  <text x="228" y="85" font-size="12.5" font-weight="700" style="fill:#fff">Tuinset voor een klein balkon?</text>
  <!-- antwoord -->
  <circle class="v" cx="72" cy="118" r="12" />
  <path class="l" d="M66 118l4 4 8-8" />
  <rect class="v" x="94" y="108" width="250" height="8" rx="4" />
  <rect class="v" x="94" y="124" width="300" height="8" rx="4" />
  <rect class="v" x="94" y="140" width="190" height="8" rx="4" />
  <!-- gesponsord kaartje -->
  <rect x="94" y="164" width="300" height="74" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="108" y="176" width="78" height="18" rx="9" fill="#e8eef4" />
  <text x="147" y="189" text-anchor="middle" font-size="10.5" font-weight="700" class="zacht">Gesponsord</text>
  <text x="108" y="214" font-size="13" font-weight="800">Tuin &amp; Co (voorbeeld)</text>
  <rect class="v" x="108" y="222" width="150" height="7" rx="3.5" />
  <rect class="o" x="318" y="206" width="62" height="24" rx="8" />
  <text x="349" y="222" text-anchor="middle" font-size="11.5" font-weight="800">Bekijk</text>
  {!mini && (
    <g>
      <rect class="omlijn" x="90" y="160" width="308" height="82" rx="15" fill="none" stroke="#ff6600" stroke-width="3" pathLength="1" />
      <g class="cursor">
        <path d="M0 0l0 22 6-6 5 11 4-2-5-11 8 0z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      </g>
      <circle class="tik" cx="352" cy="220" r="10" fill="none" stroke="#ff6600" stroke-width="3" />
      <g class="melding">
        <rect x="316" y="104" width="140" height="36" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
        <circle cx="334" cy="122" r="8" fill="#1f8a5b" />
        <path d="M330 122l3 3 5-6" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="348" y="127" font-size="12" font-weight="800">Nieuwe bezoeker</text>
      </g>
    </g>
  )}
</svg>
<style>
  .omlijn { stroke-dasharray: 1; }
  :global(.teken-js) .omlijn { stroke-dashoffset: 1; }
  .in-beeld .omlijn { animation: online-adverteren--adverteren-in-chatgpt-omlijn 1.2s cubic-bezier(.6,.1,.3,1) 0.4s forwards; }
  .cursor { transform: translate(370px, 236px); }
  :global(.teken-js) .cursor { opacity: 0; }
  .in-beeld .cursor { animation: online-adverteren--adverteren-in-chatgpt-cursor 6s ease-in-out 1.4s infinite both; }
  .tik { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .in-beeld .tik { animation: online-adverteren--adverteren-in-chatgpt-tik 6s ease-out 1.4s infinite; }
  :global(.teken-js) .melding { opacity: 0; }
  .in-beeld .melding { animation: online-adverteren--adverteren-in-chatgpt-melding 6s ease-in-out 1.4s infinite both; }
  @keyframes online-adverteren--adverteren-in-chatgpt-omlijn { to { stroke-dashoffset: 0; } }
  @keyframes online-adverteren--adverteren-in-chatgpt-cursor {
    0% { opacity: 0; transform: translate(430px, 258px); }
    12% { opacity: 1; }
    35% { transform: translate(348px, 214px); }
    40% { transform: translate(348px, 214px) scale(0.9); }
    45%, 80% { opacity: 1; transform: translate(348px, 214px); }
    100% { opacity: 0; transform: translate(348px, 214px); }
  }
  @keyframes online-adverteren--adverteren-in-chatgpt-tik { 0%, 38% { opacity: 0; transform: scale(0.5); } 42% { opacity: 1; } 60%, 100% { opacity: 0; transform: scale(2.4); } }
  @keyframes online-adverteren--adverteren-in-chatgpt-melding { 0%, 45% { opacity: 0; transform: translateY(8px); } 55%, 88% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .omlijn, .in-beeld .cursor, .in-beeld .tik, .in-beeld .melding { animation: none; } }
</style>
