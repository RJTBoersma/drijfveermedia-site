---
// Scène voor /kennisbank/gidsen/google-bedrijfsprofiel/: een postkaart met verificatiecode, een stappenlijstje en een telefoon
// met het bedrijfsprofiel op de kaart. Als hij leeft: de stappen worden afgevinkt, het profiel krijgt een groen vinkje en de pin zendt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een postkaart met verificatiecode en een telefoon met een bedrijfsprofiel op de kaart. De stappen aanmaken, verifiëren en optimaliseren worden een voor een afgevinkt.'}>
  <!-- stappenlijst -->
  <rect x="34" y="26" width="196" height="106" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="58" cy="54" r="10" fill="#1a7a50" />
  <path d="M53 54l4 4 7-8" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  <text x="78" y="59" font-size="14" font-weight="700">Aanmaken</text>
  <circle cx="58" cy="82" r="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="78" y="87" font-size="14" font-weight="700">Verifiëren</text>
  <circle cx="58" cy="110" r="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="78" y="115" font-size="14" font-weight="700">Optimaliseren</text>

  <!-- postkaart met code -->
  <g transform="rotate(-4 132 200)">
    <rect x="44" y="152" width="176" height="92" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
    <rect x="184" y="162" width="24" height="28" rx="3" fill="#fff4ec" stroke="#ff6600" stroke-width="1.5" stroke-dasharray="3 2" />
    <text x="60" y="180" font-size="11" class="zacht">Je verificatiecode</text>
    <text x="60" y="214" font-size="26" font-weight="900" letter-spacing="4">48215</text>
    <path d="M60 230h96" stroke="#d9e1ea" stroke-width="3" stroke-linecap="round" />
  </g>
  <path class="a" d="M222 198c16 0 26-8 38-16" stroke-dasharray="4 6" />

  <!-- telefoon met profiel -->
  <rect x="262" y="12" width="176" height="246" rx="24" fill="#10283f" />
  <rect x="270" y="22" width="160" height="226" rx="16" fill="#fff" />
  <path d="M286 22h128a16 16 0 0 1 16 16v82H270V38a16 16 0 0 1 16-16z" fill="#e9eef3" />
  <path d="M270 96c40-12 76 12 160-10" stroke="#fff" stroke-width="10" fill="none" />
  <path d="M326 22c4 30-6 62 6 98" stroke="#fff" stroke-width="7" fill="none" />
  <rect x="282" y="38" width="34" height="22" rx="4" fill="#d7e6d8" />
  <rect x="384" y="104" width="34" height="14" rx="4" fill="#d7e6d8" />
  <path d="M340 64c0-8 5-14 12-14s12 6 12 14c0 10-12 22-12 22s-12-12-12-22z" fill="#ff6600" />
  <circle cx="352" cy="64" r="4.5" fill="#fff" />
  <text x="284" y="146" font-size="15" font-weight="800">Jouw bedrijf</text>
  <text x="284" y="164" font-size="10.5" class="zacht">Installateur · Assen</text>
  <text x="284" y="181" font-size="10.5" font-weight="700" fill="#1a7a50" style="fill:#1a7a50">Nu open</text>
  <circle class="v" cx="300" cy="206" r="13" />
  <circle class="v" cx="350" cy="206" r="13" />
  <circle class="v" cx="400" cy="206" r="13" />
  <path class="l" d="M294 210l12-9-4 13-2-5z" />
  <path class="l" d="M345 200c0 7 3 10 10 12l2-3-3-2-2 1c-2-1-3-2-4-4l1-2-2-3z" />
  <circle cx="400" cy="206" r="7" fill="none" stroke="#074663" stroke-width="2" />
  <ellipse cx="400" cy="206" rx="3" ry="7" fill="none" stroke="#074663" stroke-width="1.6" />
  <path d="M393 206h14" stroke="#074663" stroke-width="1.6" />
  <text x="300" y="235" font-size="9.5" text-anchor="middle" class="zacht">Route</text>
  <text x="350" y="235" font-size="9.5" text-anchor="middle" class="zacht">Bellen</text>
  <text x="400" y="235" font-size="9.5" text-anchor="middle" class="zacht">Website</text>

  {!mini && (
    <g>
      <circle class="ring" cx="352" cy="86" r="8" fill="none" stroke="#ff6600" stroke-width="2.5" />
      <g class="vink vink-2"><circle cx="58" cy="82" r="10" fill="#1a7a50" /><path d="M53 82l4 4 7-8" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="vink vink-3"><circle cx="58" cy="110" r="10" fill="#1a7a50" /><path d="M53 110l4 4 7-8" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="vink badge"><circle cx="406" cy="141" r="12" fill="#1a7a50" /><path d="M400 141l4 4 7-8" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
    </g>
  )}
</svg>
<style>
  .vink, .ring { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .vink { opacity: 0; }
  .in-beeld .vink-2 { animation: kennisbank-gidsen-google-bedrijfsprofiel-vink 0.5s cubic-bezier(.3,1.6,.5,1) 0.8s forwards; }
  .in-beeld .badge { animation: kennisbank-gidsen-google-bedrijfsprofiel-vink 0.5s cubic-bezier(.3,1.6,.5,1) 1.3s forwards; }
  .in-beeld .vink-3 { animation: kennisbank-gidsen-google-bedrijfsprofiel-vink 0.5s cubic-bezier(.3,1.6,.5,1) 1.9s forwards; }
  :global(.teken-js) .ring { opacity: 0; }
  .in-beeld .ring { animation: kennisbank-gidsen-google-bedrijfsprofiel-ring 3.2s ease-out 2.2s infinite; }
  @keyframes kennisbank-gidsen-google-bedrijfsprofiel-vink { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-google-bedrijfsprofiel-ring { 0% { opacity: 0.9; transform: scale(0.6); } 70%, 100% { opacity: 0; transform: scale(3.2); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .vink, .in-beeld .ring { animation: none; opacity: 1; } }
</style>
