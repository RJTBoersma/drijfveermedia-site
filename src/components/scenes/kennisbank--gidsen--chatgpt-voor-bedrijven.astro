---
// Scène voor /kennisbank/gidsen/chatgpt-voor-bedrijven/: een chatvenster met een opdracht en een antwoord, ernaast een kaartje met de teamafspraken.
// Als hij leeft: een verbeterde zin wordt gemarkeerd, er komt een stempel "Nagekeken" op en de typpuntjes blijven rustig knipperen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const antwoord = [
  { y: 132, w: 196 },
  { y: 146, w: 214 },
  { y: 160, w: 178 },
  { y: 174, w: 120 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een chatvenster waarin een ondernemer om een offertetekst vraagt en een antwoord krijgt dat een mens nakijkt, met ernaast de afspraken voor het team.'}>
  <!-- chatvenster -->
  <rect x="24" y="24" width="290" height="222" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M38 24h262a14 14 0 0 1 14 14v10H24V38a14 14 0 0 1 14-14z" fill="#e8eef4" />
  <circle cx="40" cy="36" r="4" fill="#d9e1ea" /><circle cx="52" cy="36" r="4" fill="#d9e1ea" /><circle cx="64" cy="36" r="4" fill="#d9e1ea" />

  <!-- vraag -->
  <rect x="112" y="62" width="186" height="42" rx="12" fill="#074663" />
  <text x="124" y="80" font-size="10.5" font-weight="700" style="fill:#fff">Maak deze offerte</text>
  <text x="124" y="95" font-size="10.5" font-weight="700" style="fill:#fff">helder voor een klant</text>

  <!-- antwoord -->
  <circle cx="46" cy="128" r="11" fill="#e8eef4" />
  <path d="M46 120l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="#ff6600" />
  <rect x="64" y="116" width="236" height="74" rx="12" fill="#f5f8fb" stroke="#e8eef4" stroke-width="2" />
  {antwoord.map((r) => <rect x="76" y={r.y - 6} width={r.w} height="7" rx="3.5" fill="#d9e1ea" />)}

  <!-- invoerveld -->
  <rect x="40" y="206" width="258" height="26" rx="13" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="282" cy="219" r="8" fill="#074663" />
  <path d="M278 219h7M282 215l4 4-4 4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />

  <!-- afspraken -->
  <rect x="332" y="52" width="124" height="166" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="346" y="76" font-size="11.5" font-weight="900">Afspraken</text>
  <g>
    <circle cx="352" cy="100" r="7" fill="#1a7a50" /><path d="M348.5 100l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <text x="366" y="104" font-size="10">Geen klantdata</text>
    <circle cx="352" cy="128" r="7" fill="#1a7a50" /><path d="M348.5 128l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <text x="366" y="132" font-size="10">Zakelijk account</text>
    <circle cx="352" cy="156" r="7" fill="#1a7a50" /><path d="M348.5 156l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <text x="366" y="160" font-size="10">Altijd nalezen</text>
  </g>
  <rect x="346" y="180" width="96" height="24" rx="12" fill="#e8eef4" />
  <path d="M358 192h8M362 188v8" stroke="#074663" stroke-width="2" stroke-linecap="round" />
  <text x="372" y="196" font-size="10" font-weight="700">AI-geletterd</text>

  {!mini && (
    <g>
      <rect class="markeer" x="74" y="138" width="218" height="11" rx="3" fill="#ffe3cf" />
      <rect x="76" y="140" width="214" height="7" rx="3.5" fill="#ffb27a" class="markeer" />
      <g class="typen">
        <circle cx="86" cy="219" r="3" fill="#9fb0c0" />
        <circle cx="96" cy="219" r="3" fill="#9fb0c0" />
        <circle cx="106" cy="219" r="3" fill="#9fb0c0" />
      </g>
      <g class="stempel"><rect x="206" y="166" width="90" height="22" rx="6" fill="#fff" stroke="#1a7a50" stroke-width="2" transform="rotate(-6 251 177)" /><text x="219" y="182" font-size="10.5" font-weight="900" style="fill:#1a7a50" transform="rotate(-6 251 177)">Nagekeken</text></g>
    </g>
  )}
</svg>
<style>
  .markeer { transform-box: fill-box; transform-origin: left center; }
  :global(.teken-js) .markeer { opacity: 0; }
  .in-beeld .markeer { animation: kennisbank-gidsen-chatgpt-voor-bedrijven-schrijf 0.9s ease-out 0.8s forwards; }
  :global(.teken-js) .stempel { opacity: 0; }
  .stempel { transform-box: fill-box; transform-origin: center; }
  .in-beeld .stempel { animation: kennisbank-gidsen-chatgpt-voor-bedrijven-stempel 0.45s cubic-bezier(.3,1.6,.5,1) 2.1s forwards; }
  .typen circle { transform-box: fill-box; transform-origin: center; }
  .in-beeld .typen circle { animation: kennisbank-gidsen-chatgpt-voor-bedrijven-punt 3s ease-in-out infinite; }
  .in-beeld .typen circle:nth-child(2) { animation-delay: 0.2s; }
  .in-beeld .typen circle:nth-child(3) { animation-delay: 0.4s; }
  @keyframes kennisbank-gidsen-chatgpt-voor-bedrijven-schrijf { from { opacity: 1; transform: scaleX(0); } to { opacity: 1; transform: scaleX(1); } }
  @keyframes kennisbank-gidsen-chatgpt-voor-bedrijven-stempel { from { opacity: 0; transform: scale(1.6); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-chatgpt-voor-bedrijven-punt { 0%, 60%, 100% { opacity: 0.3; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .markeer, .in-beeld .stempel, .in-beeld .typen circle { animation: none; }
  }
</style>
