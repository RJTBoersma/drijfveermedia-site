        <path class="werkgebied-route" style="--i:1" pathLength="1" d="M219.1 136.7Q173.6 92.6 110.4 87.6" />
        <path class="werkgebied-route" style="--i:2" pathLength="1" d="M219.1 136.7Q233.9 169.8 266.4 185.8" />
        <path class="werkgebied-route" style="--i:3" pathLength="1" d="M219.1 136.7Q190.8 111.3 152.9 109.8" />
        <path class="werkgebied-route" style="--i:4" pathLength="1" d="M219.1 136.7Q171.9 124.1 127.6 144.5" />
        <path class="werkgebied-route" style="--i:5" pathLength="1" d="M219.1 136.7Q156.5 109.2 90.7 128" />
        <path class="werkgebied-route" style="--i:6" pathLength="1" d="M219.1 136.7Q163.9 119.9 110.6 142.2" />
        <path class="werkgebied-route" style="--i:7" pathLength="1" d="M219.1 136.7Q201.4 166.3 206.6 200.5" />
        <path class="werkgebied-route" style="--i:8" pathLength="1" d="M219.1 136.7Q180.2 162.3 166.5 206.8" />
        <path class="werkgebied-route" style="--i:9" pathLength="1" d="M219.1 136.7Q246.0 131.4 263.4 110.1" />
        <path class="werkgebied-route" style="--i:10" pathLength="1" d="M219.1 136.7Q246.4 146.9 273.9 137.4" />
        <path class="werkgebied-route" style="--i:11" pathLength="1" d="M219.1 136.7Q165.3 181.4 152.3 250.2" />
      </g>
  )}
  <!-- provincienamen -->
  <g font-size="9" font-weight="800" letter-spacing="2" fill="#8aa0b4">
    <text class="zacht" x="108" y="168" text-anchor="middle" stroke="#eaf0f5" stroke-width="3" paint-order="stroke">FRIESLAND</text>
    <text class="zacht" x="252" y="56" text-anchor="middle">GRONINGEN</text>
    <text class="zacht" x="214" y="176" text-anchor="middle" stroke="#e6edf3" stroke-width="3" paint-order="stroke">DRENTHE</text>
  </g>
  <!-- plaatsen -->
  {steden.map(([naam, x, y, lx, ly, anker]) => (
    <g>
      <circle cx={x} cy={y} r="4" fill="#074663" stroke="#fff" stroke-width="2" />
      <text x={lx} y={ly} font-size="10" font-weight="700" text-anchor={anker ?? 'start'} stroke="#f4f7fa" stroke-width="3" paint-order="stroke">{naam}</text>
    </g>
  ))}
  <!-- Assen, ons kantoor -->
  <circle cx="219.1" cy="136.7" r="7.5" fill="#ff6600" stroke="#fff" stroke-width="3" />
  <text x="211" y="127" text-anchor="end" font-size="12.5" font-weight="900" stroke="#f4f7fa" stroke-width="3" paint-order="stroke">Assen</text>
