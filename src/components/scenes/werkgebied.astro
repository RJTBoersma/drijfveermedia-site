  {!mini && (
    <g>
      <circle class="werkgebied-ring" cx="219.1" cy="136.7" r="8" fill="none" stroke="#ff6600" stroke-width="2.5" />
      <path class="werkgebied-boog" d="M226 131C255 122 300 118 338 122" fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 7" />
      <path class="werkgebied-pijl" d="M331 117l8 5-9 4" fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <g class="werkgebied-label" transform="translate(340 196)">
        <rect width="128" height="30" rx="15" fill="#074663" />
        <text x="64" y="20" text-anchor="middle" font-size="10.5" font-weight="800" style="fill:#fff">Langs of op afstand</text>
      </g>
    </g>
