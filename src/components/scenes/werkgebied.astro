---
// Scène voor /werkgebied/: getekende kaart van het Noorden. Vanuit Assen lopen lijnen naar de plaatsen
// in Friesland, Groningen, Drenthe en Zwolle, en een stippellijn naar "heel Nederland en buitenland".
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const steden: [string, number, number, number, number, string?][] = [
  // naam, x, y, label-x, label-y, anker
  ['Groningen', 219.5, 83.4, 227, 87],
  ['Leeuwarden', 110.4, 87.6, 117, 91],
  ['Drachten', 152.9, 109.8, 160, 113],
  ['Sneek', 90.7, 128, 84, 131, 'end'],
  ['Joure', 110.6, 142.2, 104, 150, 'end'],
  ['Heerenveen', 127.6, 144.5, 134, 148],
  ['Emmen', 266.4, 185.8, 273, 189],
  ['Hoogeveen', 206.6, 200.5, 213, 204],
  ['Meppel', 166.5, 206.8, 160, 210, 'end'],
  ['Veendam', 263.4, 110.1, 270, 113],
  ['Stadskanaal', 273.9, 137.4, 274, 152, 'middle'],
  ['Zwolle', 152.3, 250.2, 159, 254],
