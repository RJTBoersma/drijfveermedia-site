</svg>
<style>
  .werkgebied-route { stroke-dasharray: 1; opacity: 0.75; }
  :global(.teken-js) .werkgebied-route { stroke-dashoffset: 1; }
  .in-beeld .werkgebied-route { animation: werkgebied-route 0.9s cubic-bezier(.6,.1,.3,1) calc(0.4s + var(--i) * 0.12s) forwards; }
  .werkgebied-ring { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .werkgebied-ring { opacity: 0; }
  .in-beeld .werkgebied-ring { animation: werkgebied-ring 3.2s ease-out 1.2s infinite; }
  :global(.teken-js) .werkgebied-boog, :global(.teken-js) .werkgebied-pijl, :global(.teken-js) .werkgebied-label { opacity: 0; }
  .in-beeld .werkgebied-boog { animation: werkgebied-op 0.6s ease 2s forwards, werkgebied-stroom 1.6s linear 2s infinite; }
  .in-beeld .werkgebied-pijl { animation: werkgebied-op 0.6s ease 2.2s forwards; }
  .werkgebied-label { transform-box: fill-box; }
  .in-beeld .werkgebied-label { animation: werkgebied-label 0.7s cubic-bezier(.3,1.6,.5,1) 2.6s forwards; }
  @keyframes werkgebied-route { to { stroke-dashoffset: 0; } }
  @keyframes werkgebied-ring { 0% { transform: scale(1); opacity: 0.9; } 70%, 100% { transform: scale(3.4); opacity: 0; } }
  @keyframes werkgebied-op { to { opacity: 1; } }
  @keyframes werkgebied-stroom { to { stroke-dashoffset: -20; } }
  @keyframes werkgebied-label { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .werkgebied-route, .in-beeld .werkgebied-ring, .in-beeld .werkgebied-boog, .in-beeld .werkgebied-pijl, .in-beeld .werkgebied-label { animation: none; }
  }
</style>
