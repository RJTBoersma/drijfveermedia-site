  <path d="M85 32C95 27 115 25 128 26C127 29 118 31 108 32C98 33 90 34 85 32Z" fill="#e3ebf2" stroke="#b9c8d6" stroke-width="1.5" />
  <path d="M153 23C162 19 175 18 185 19C184 22 176 23 168 24C161 25 156 25 153 23Z" fill="#e3ebf2" stroke="#b9c8d6" stroke-width="1.5" />
  <!-- Friesland, Groningen, Drenthe -->
  <path d="M55.2 95.0C56.8 89.1 58.7 79.6 63.7 73.7C68.7 67.8 74.8 64.7 85.0 59.6C95.2 54.4 111.5 46.2 124.8 43.0C138.0 39.9 157.4 37.5 164.6 40.7C171.7 43.8 164.6 54.1 167.4 61.9C170.2 69.8 178.5 79.6 181.6 87.9C184.7 96.1 185.9 104.4 185.9 111.5C185.9 118.6 184.2 123.3 181.6 130.4C179.0 137.4 174.5 147.3 170.2 154.0C166.0 160.6 162.4 166.5 156.0 170.5C149.6 174.4 139.5 176.0 131.9 177.6C124.3 179.1 117.4 180.3 110.6 179.9C103.7 179.5 98.3 178.0 90.7 175.2C83.1 172.4 72.0 166.9 65.1 163.4C58.3 159.9 51.4 159.9 49.5 154.0C47.6 148.1 53.1 135.5 53.8 128.0C54.5 120.5 53.5 114.6 53.8 109.1C54.0 103.6 53.5 100.9 55.2 95.0Z" fill="#eaf0f5" stroke="#b9c8d6" stroke-width="2" stroke-linejoin="round" />
  <path d="M167.4 40.7C173.3 35.6 190.6 33.6 202.9 31.2C215.2 28.9 230.6 25.7 241.2 26.5C251.9 27.3 260.9 30.8 266.8 36.0C272.7 41.1 271.5 50.9 276.8 57.2C282.0 63.5 292.6 67.8 298.1 73.7C303.5 79.6 307.3 83.2 309.4 92.6C311.5 102.0 313.2 117.8 310.8 130.4C308.5 142.9 299.0 161.4 295.2 168.1C291.4 174.8 291.0 174.0 288.1 170.5C285.3 166.9 282.2 154.7 278.2 146.9C274.1 139.0 269.4 130.0 264.0 123.3C258.5 116.6 251.7 112.7 245.5 106.8C239.4 100.9 233.0 91.0 227.0 87.9C221.1 84.7 215.2 87.1 210.0 87.9C204.8 88.7 199.8 88.7 195.8 92.6C191.8 96.5 188.2 112.3 185.9 111.5C183.5 110.7 184.7 96.1 181.6 87.9C178.5 79.6 169.8 69.8 167.4 61.9C165.0 54.1 161.5 45.8 167.4 40.7Z" fill="#dfe8f0" stroke="#b9c8d6" stroke-width="2" stroke-linejoin="round" />
  <path d="M154.6 205.9C158.2 210.6 166.4 213.9 174.5 215.3C182.5 216.7 194.1 213.0 202.9 214.1C211.7 215.3 219.9 221.8 227.0 222.4C234.1 223.0 238.9 218.1 245.5 217.7C252.1 217.3 259.2 219.6 266.8 220.0C274.4 220.4 286.5 224.4 291.0 220.0C295.5 215.7 294.3 202.3 293.8 194.1C293.3 185.8 290.7 178.3 288.1 170.5C285.5 162.6 282.2 154.7 278.2 146.9C274.1 139.0 269.4 130.0 264.0 123.3C258.5 116.6 251.7 112.7 245.5 106.8C239.4 100.9 233.0 91.0 227.0 87.9C221.1 84.7 215.2 87.1 210.0 87.9C204.8 88.7 199.8 88.7 195.8 92.6C191.8 96.5 188.2 105.2 185.9 111.5C183.5 117.8 184.2 123.3 181.6 130.4C179.0 137.4 174.5 147.3 170.2 154.0C166.0 160.6 158.9 165.0 156.0 170.5C153.2 176.0 153.4 181.1 153.2 187.0C153.0 192.9 151.1 201.2 154.6 205.9Z" fill="#e6edf3" stroke="#b9c8d6" stroke-width="2" stroke-linejoin="round" />
