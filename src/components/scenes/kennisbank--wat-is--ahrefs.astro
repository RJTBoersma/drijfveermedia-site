---
// Scène voor /kennisbank/wat-is/ahrefs/: een web van websites die naar elkaar linken, met in het midden jouw site en een kaartje met zijn Domain Rating. Een kleine crawler-robot loopt het web af.
// Als hij leeft: de robot wandelt rustig van site naar site, over de links lopen stipjes naar jouw site en er verschijnt een nieuw gevonden link.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const sites = [
  { x: 40, y: 34 },
  { x: 40, y: 182 },
  { x: 196, y: 16 },
  { x: 366, y: 40 },
  { x: 366, y: 190 },
];
// Middelpunt van elke kaart (64 x 44)
const mid = sites.map((s) => ({ x: s.x + 32, y: s.y + 22 }));
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: vijf websites linken naar jouw website in het midden, die een Domain Rating van 24 heeft. Een kleine crawler-robot loopt langs de sites en vindt een nieuwe link.'}>
  <!-- links tussen de sites -->
  {mid.map((m) => (
    <path d={`M${m.x} ${m.y}L240 140`} stroke="#d9e1ea" stroke-width="2" stroke-dasharray="4 6" fill="none" />
  ))}
  <path d={`M${mid[0].x} ${mid[0].y}L${mid[2].x} ${mid[2].y}M${mid[3].x} ${mid[3].y}L${mid[4].x} ${mid[4].y}`} stroke="#e8eef4" stroke-width="2" fill="none" />

  {sites.map((s) => (
    <g>
      <rect x={s.x} y={s.y} width="64" height="44" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <rect x={s.x + 9} y={s.y + 11} width="34" height="6" rx="3" fill="#10283f" opacity="0.7" />
      <rect x={s.x + 9} y={s.y + 24} width="46" height="5" rx="2.5" fill="#d9e1ea" />
    </g>
  ))}

  <!-- jouw site -->
  <rect x="180" y="102" width="120" height="78" rx="12" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <rect class="v" x="192" y="114" width="96" height="12" rx="6" />
  <rect x="192" y="134" width="70" height="6" rx="3" fill="#d9e1ea" />
  <rect x="192" y="146" width="84" height="6" rx="3" fill="#d9e1ea" />
  <text x="240" y="170" font-size="12" font-weight="800" text-anchor="middle">Jouw site</text>
  <g>
    <rect x="262" y="88" width="56" height="26" rx="13" fill="#074663" />
    <text x="290" y="105.5" font-size="12" font-weight="800" text-anchor="middle" style="fill:#fff">DR 24</text>
  </g>
  <text x="240" y="228" font-size="11" text-anchor="middle" class="zacht">verwijzende domeinen: 5</text>

  <!-- crawler-robot, in rust -->
  <g class="ahrefs-bot">
    <path d="M0 -17V-23" stroke="#074663" stroke-width="2" stroke-linecap="round" />
    <circle cx="0" cy="-25" r="3" class="o" />
    <rect x="-13" y="-17" width="26" height="22" rx="8" fill="#fff" stroke="#074663" stroke-width="2.5" />
    <circle cx="-5" cy="-6" r="2.6" fill="#074663" />
    <circle cx="5" cy="-6" r="2.6" fill="#074663" />
    <path d="M-8 5l-4 7M8 5l4 7" stroke="#074663" stroke-width="2.5" stroke-linecap="round" />
  </g>

  {!mini && (
    <g>
      {mid.map((m, i) => (
        <circle class="ahrefs-stip" style={`--i:${i};--dx:${240 - m.x}px;--dy:${140 - m.y}px`} cx={m.x} cy={m.y} r="4.5" fill="#ff6600" />
      ))}
      <g class="ahrefs-nieuw">
        <rect x="318" y="126" width="124" height="28" rx="14" fill="#fff" stroke="#1a7a50" stroke-width="2" />
        <circle cx="334" cy="140" r="7" fill="#1a7a50" />
        <path d="M330.5 140l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="388" y="144.5" font-size="11.5" font-weight="800" text-anchor="middle">nieuwe link</text>
      </g>
    </g>
  )}
</svg>
<style>
  .ahrefs-bot { transform: translate(150px, 238px); }
  .ahrefs-nieuw { transform-box: fill-box; transform-origin: left center; }
  :global(.teken-js) .ahrefs-stip, :global(.teken-js) .ahrefs-nieuw { opacity: 0; }
  .in-beeld .ahrefs-bot { animation: kennisbank-wat-is-ahrefs-loop 8s ease-in-out 0.4s infinite; }
  .in-beeld .ahrefs-stip { animation: kennisbank-wat-is-ahrefs-stip 4s ease-in calc(var(--i) * 0.8s) infinite; }
  .in-beeld .ahrefs-nieuw { animation: kennisbank-wat-is-ahrefs-nieuw 8s ease-out 0.4s infinite; }
  @keyframes kennisbank-wat-is-ahrefs-loop {
    0%, 6% { transform: translate(150px, 238px); }
    22%, 30% { transform: translate(72px, 168px); }
    46%, 54% { transform: translate(72px, 96px); }
    70%, 78% { transform: translate(398px, 106px); }
    100% { transform: translate(150px, 238px); }
  }
  @keyframes kennisbank-wat-is-ahrefs-stip {
    0% { transform: translate(0, 0); opacity: 0; }
    10% { opacity: 1; }
    55% { transform: translate(var(--dx), var(--dy)); opacity: 1; }
    65%, 100% { transform: translate(var(--dx), var(--dy)); opacity: 0; }
  }
  @keyframes kennisbank-wat-is-ahrefs-nieuw {
    0%, 70% { opacity: 0; transform: scale(0.6); }
    76%, 94% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .ahrefs-bot, .in-beeld .ahrefs-stip, .in-beeld .ahrefs-nieuw { animation: none; } }
</style>
