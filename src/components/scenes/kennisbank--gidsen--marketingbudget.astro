---
// Scène voor /kennisbank/gidsen/marketingbudget/: een begroting voor 2027 met vier kwartaalstaven, een stapel munten en een rekenmachine.
// Als hij leeft: munten vallen in de staven, de staven groeien, en een label "€ 250 per klant" verschijnt rustig steeds opnieuw.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const staven = [
  { x: 78, h: 54, k: 'K1' },
  { x: 128, h: 72, k: 'K2' },
  { x: 178, h: 64, k: 'K3' },
  { x: 228, h: 88, k: 'K4' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een begroting voor 2027 met vier kwartalen, een stapel munten en een rekenmachine. Munten vallen in de kwartalen en er verschijnt hoeveel een nieuwe klant mag kosten.'}>
  <!-- begrotingsvel -->
  <rect x="48" y="28" width="248" height="216" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="68" y="60" font-size="15" font-weight="900">Begroting 2027</text>
  <rect x="68" y="68" width="40" height="4" rx="2" fill="#ff6600" />
  <path d="M68 210h212" stroke="#d9e1ea" stroke-width="2" />
  {staven.map((s) => (
    <g>
      <rect class="v" x={s.x} y={210 - s.h} width="34" height={s.h} rx="6" />
      <text x={s.x + 9} y="228" font-size="10.5" font-weight="800" class="zacht">{s.k}</text>
    </g>
  ))}
  <path class="l" d="M95 150l50-20 50 8 50-26" fill="none" />

  <!-- munten -->
  <g>
    <ellipse cx="350" cy="214" rx="34" ry="10" fill="#e8eef4" stroke="#074663" stroke-width="2" />
    <path d="M316 214v-12M384 214v-12" stroke="#074663" stroke-width="2" />
    <ellipse cx="350" cy="202" rx="34" ry="10" fill="#fff" stroke="#074663" stroke-width="2" />
    <path d="M316 202v-12M384 202v-12" stroke="#074663" stroke-width="2" />
    <ellipse cx="350" cy="190" rx="34" ry="10" fill="#ffe3cf" stroke="#ff6600" stroke-width="2" />
    <text x="344" y="194.5" font-size="12" font-weight="900">€</text>
  </g>

  <!-- rekenmachine -->
  <rect x="360" y="40" width="84" height="112" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="372" y="52" width="60" height="24" rx="6" fill="#10283f" />
  <text x="377" y="69" font-size="12" font-weight="800" style="fill:#fff">€ 750</text>
  {[0, 1, 2].map((r) => [0, 1, 2].map((c) => (
    <rect x={374 + c * 20} y={86 + r * 20} width="14" height="12" rx="3" fill={r === 2 && c === 2 ? '#ff6600' : '#e8eef4'} />
  )))}

  {!mini && (
    <g>
      <g class="munt munt1"><circle cx="95" cy="92" r="9" fill="#ffe3cf" stroke="#ff6600" stroke-width="2" /></g>
      <g class="munt munt2"><circle cx="245" cy="92" r="9" fill="#ffe3cf" stroke="#ff6600" stroke-width="2" /></g>
      <path class="trend" d="M95 150l50-20 50 8 50-26" fill="none" stroke="#ff6600" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
      <g class="label">
        <rect x="168" y="76" width="116" height="26" rx="13" fill="#1f8a5b" />
        <text x="180" y="93.5" font-size="11.5" font-weight="900" style="fill:#fff">€ 250 per klant</text>
      </g>
    </g>
  )}
</svg>
<style>
  .trend { stroke-dasharray: 1; }
  :global(.teken-js) .trend { stroke-dashoffset: 1; }
  .in-beeld .trend { animation: kennisbank-gidsen-marketingbudget-lijn 1.4s cubic-bezier(.6,.1,.3,1) 0.4s forwards; }
  :global(.teken-js) .munt { opacity: 0; }
  .in-beeld .munt1 { animation: kennisbank-gidsen-marketingbudget-val 5s ease-in 0.8s infinite both; }
  .in-beeld .munt2 { animation: kennisbank-gidsen-marketingbudget-val 5s ease-in 2.6s infinite both; }
  :global(.teken-js) .label { opacity: 0; }
  .in-beeld .label { animation: kennisbank-gidsen-marketingbudget-label 6s ease-in-out 1.8s infinite both; }
  @keyframes kennisbank-gidsen-marketingbudget-lijn { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-gidsen-marketingbudget-val { 0% { opacity: 0; transform: translateY(-20px); } 15% { opacity: 1; } 45% { opacity: 1; transform: translateY(50px); } 55%, 100% { opacity: 0; transform: translateY(50px); } }
  @keyframes kennisbank-gidsen-marketingbudget-label { 0% { opacity: 0; transform: translateY(6px); } 15%, 80% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .trend, .in-beeld .munt1, .in-beeld .munt2, .in-beeld .label { animation: none; } }
</style>
