---
// Scène voor /kennisbank/wat-is/digital-marketing/: jouw website in het midden, met daaromheen vijf kanalen (zoeken, kaart, social, e-mail, AI) die er met lijnen naartoe leiden.
// Als hij leeft: bezoekers lopen als stipjes van elk kanaal naar je site, en steeds verschijnt er een nieuwe aanvraag.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const kanalen = [
  { x: 64, y: 58, label: 'Google' },
  { x: 64, y: 212, label: 'Maps' },
  { x: 240, y: 34, label: 'AI' },
  { x: 416, y: 58, label: 'Social' },
  { x: 416, y: 212, label: 'E-mail' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: jouw website in het midden, verbonden met vijf kanalen: Google, Maps, AI, social media en e-mail. Bezoekers komen via alle kanalen binnen en worden een aanvraag.'}>
  {kanalen.map((k) => (
    <path d={`M${k.x} ${k.y}L240 140`} stroke="#d9e1ea" stroke-width="2" stroke-dasharray="4 6" fill="none" />
  ))}

  <!-- kanalen -->
  {kanalen.map((k) => (
    <g>
      <circle cx={k.x} cy={k.y} r="24" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <text x={k.x} y={k.y + 40} font-size="11" font-weight="800" text-anchor="middle">{k.label}</text>
    </g>
  ))}
  <!-- iconen in de kanalen -->
  <circle cx="61" cy="55" r="8" fill="none" stroke="#074663" stroke-width="2.5" />
  <path d="M67 61l6 6" stroke="#074663" stroke-width="2.5" stroke-linecap="round" />
  <path d="M64 224c-7-9-11-14-11-19a11 11 0 0 1 22 0c0 5-4 10-11 19z" fill="#074663" />
  <circle cx="64" cy="205" r="4" fill="#fff" />
  <path d="M240 22l3.5 8.5L252 34l-8.5 3.5L240 46l-3.5-8.5L228 34l8.5-3.5z" class="o" />
  <rect x="402" y="47" width="28" height="18" rx="6" fill="#074663" />
  <path d="M410 65l-2 7 8-7" fill="#074663" />
  <rect x="402" y="203" width="28" height="19" rx="3" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path d="M403 205l13 9 13-9" fill="none" stroke="#074663" stroke-width="2.5" stroke-linejoin="round" />

  <!-- jouw website -->
  <rect x="176" y="96" width="128" height="94" rx="12" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path d="M176 116H304" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="190" cy="106" r="3.5" fill="#e8eef4" />
  <circle cx="201" cy="106" r="3.5" fill="#e8eef4" />
  <rect class="v" x="188" y="126" width="104" height="22" rx="5" />
  <rect x="188" y="156" width="66" height="6" rx="3" fill="#d9e1ea" />
  <rect x="188" y="168" width="48" height="12" rx="6" fill="#ff6600" />
  <text x="240" y="208" font-size="12" font-weight="800" text-anchor="middle">Jouw website</text>

  {!mini && (
    <g>
      {kanalen.map((k, i) => (
        <circle class="dm-stip" style={`--i:${i};--dx:${240 - k.x}px;--dy:${140 - k.y}px`} cx={k.x} cy={k.y} r="5" fill="#ff6600" />
      ))}
      <g class="dm-aanvraag">
        <rect x="262" y="214" width="112" height="28" rx="14" fill="#fff" stroke="#1f8a5b" stroke-width="2" />
        <circle cx="278" cy="228" r="7" fill="#1f8a5b" />
        <path d="M274.5 228l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="326" y="232.5" font-size="11.5" font-weight="800" text-anchor="middle">+1 aanvraag</text>
      </g>
    </g>
  )}
</svg>
<style>
  .dm-aanvraag { transform-box: fill-box; transform-origin: left center; }
  :global(.teken-js) .dm-stip, :global(.teken-js) .dm-aanvraag { opacity: 0; }
  .in-beeld .dm-stip { animation: kennisbank-wat-is-digital-marketing-stip 5s ease-in calc(var(--i) * 1s) infinite; }
  .in-beeld .dm-aanvraag { animation: kennisbank-wat-is-digital-marketing-aanvraag 5s ease-out 1.2s infinite; }
  @keyframes kennisbank-wat-is-digital-marketing-stip {
    0% { transform: translate(0, 0); opacity: 0; }
    8% { opacity: 1; }
    45% { transform: translate(var(--dx), var(--dy)); opacity: 1; }
    55%, 100% { transform: translate(var(--dx), var(--dy)); opacity: 0; }
  }
  @keyframes kennisbank-wat-is-digital-marketing-aanvraag {
    0%, 40% { opacity: 0; transform: translateY(8px) scale(0.7); }
    48%, 86% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .dm-stip, .in-beeld .dm-aanvraag { animation: none; } }
</style>
