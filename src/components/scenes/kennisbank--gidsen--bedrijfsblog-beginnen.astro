---
// Scène voor /kennisbank/gidsen/bedrijfsblog-beginnen/: een blogartikel op een website, met rechts lezers die binnenkomen via een zoekveld.
// Als hij leeft: een pen schrijft de laatste regel, drie lezers verschijnen een voor een en er komt rustig steeds opnieuw een aanvraag binnen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const lezers = [{ y: 112 }, { y: 154 }, { y: 196 }];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een blogartikel op een bedrijfswebsite, met een pen die de laatste regel schrijft. Rechts komen via een zoekveld drie lezers binnen, en daarna een nieuwe aanvraag.'}>
  <!-- browservenster met artikel -->
  <rect x="24" y="20" width="270" height="230" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M24 32a12 12 0 0 1 12-12h246a12 12 0 0 1 12 12v12H24z" fill="#e8eef4" />
  <circle cx="40" cy="32" r="4" fill="#fff" /><circle cx="54" cy="32" r="4" fill="#fff" /><circle cx="68" cy="32" r="4" fill="#fff" />
  <rect x="44" y="60" width="64" height="8" rx="4" fill="#ffd2b0" />
  <rect x="44" y="76" width="200" height="12" rx="5" fill="#10283f" />
  <rect x="44" y="94" width="150" height="12" rx="5" fill="#10283f" />
  <rect x="44" y="118" width="230" height="56" rx="8" class="v" />
  <path class="l" d="M60 162l26-24 18 16 14-10 28 18" />
  <circle cx="244" cy="136" r="8" fill="#fff" />
  <rect x="44" y="186" width="226" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="44" y="200" width="210" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="44" y="214" width="190" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="44" y="228" width="120" height="7" rx="3.5" fill="#d9e1ea" />

  <!-- zoekveld en lezers -->
  <rect x="318" y="34" width="140" height="34" rx="17" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="338" cy="51" r="7" fill="none" stroke="#074663" stroke-width="2.5" />
  <path d="M343 56l6 6" stroke="#074663" stroke-width="2.5" stroke-linecap="round" />
  <rect x="356" y="47" width="84" height="8" rx="4" fill="#d9e1ea" />
  <path d="M388 74v24" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="4 4" />
  {lezers.map((l) => (
    <g>
      <rect x="330" y={l.y} width="116" height="34" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <circle cx="350" cy={l.y + 17} r="9" class="v" />
      <rect x="366" y={l.y + 13} width="62" height="8" rx="4" fill="#d9e1ea" />
    </g>
  ))}

  {!mini && (
    <g>
      <rect class="bb-regel" x="164" y="228" width="80" height="7" rx="3.5" fill="#074663" />
      <g class="bb-pen">
        <g transform="rotate(40 252 222)">
          <rect x="246" y="190" width="11" height="40" rx="2" fill="#ffd2b0" stroke="#10283f" stroke-width="1.5" />
          <path d="M246 230l5.5 11 5.5-11z" fill="#fff" stroke="#10283f" stroke-width="1.5" stroke-linejoin="round" />
        </g>
      </g>
      {lezers.map((l, i) => <circle class="bb-lezer" style={`--i:${i}`} cx="350" cy={l.y + 17} r="9" fill="#074663" />)}
      <g class="bb-aanvraag">
        <rect x="300" y="232" width="164" height="30" rx="15" fill="#074663" />
        <text x="382" y="252" text-anchor="middle" font-size="12" font-weight="800" style="fill:#fff">Nieuwe aanvraag</text>
      </g>
    </g>
  )}
</svg>
<style>
  .bb-regel { transform-box: fill-box; transform-origin: left center; }
  .bb-lezer, .bb-aanvraag { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .bb-regel { transform: scaleX(0); }
  :global(.teken-js) .bb-lezer, :global(.teken-js) .bb-aanvraag, :global(.teken-js) .bb-pen { opacity: 0; }
  .in-beeld .bb-regel { animation: kennisbank-gidsen-bedrijfsblog-beginnen-regel 1.4s ease-in-out 0.5s forwards; }
  .in-beeld .bb-pen { animation: kennisbank-gidsen-bedrijfsblog-beginnen-pen 1.4s ease-in-out 0.5s forwards; }
  .in-beeld .bb-lezer { animation: kennisbank-gidsen-bedrijfsblog-beginnen-lezer 0.5s cubic-bezier(.3,1.7,.5,1) calc(2s + var(--i) * 0.4s) forwards; }
  .in-beeld .bb-aanvraag { animation: kennisbank-gidsen-bedrijfsblog-beginnen-aanvraag 6s ease-in-out 3.4s infinite both; }
  @keyframes kennisbank-gidsen-bedrijfsblog-beginnen-regel { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes kennisbank-gidsen-bedrijfsblog-beginnen-pen { 0% { opacity: 1; transform: translateX(-80px); } 90% { opacity: 1; transform: none; } 100% { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-bedrijfsblog-beginnen-lezer { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-bedrijfsblog-beginnen-aanvraag { 0% { opacity: 0; transform: translateY(10px); } 12%, 75% { opacity: 1; transform: none; } 90%, 100% { opacity: 0; transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .bb-regel, .in-beeld .bb-pen, .in-beeld .bb-lezer, .in-beeld .bb-aanvraag { animation: none; } }
</style>
