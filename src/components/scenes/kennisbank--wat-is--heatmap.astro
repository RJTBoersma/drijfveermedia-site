---
// Scène voor /kennisbank/wat-is/heatmap/: een webpagina met daaroverheen warme vlekken waar bezoekers klikken
// (fel op de knop, zwakker op de kop en op een foto die geen link is). Rechts een scrollbalk die laat zien hoeveel procent nog meekijkt.
// Als hij leeft: de vlekken ademen rustig, een cursor klikt op de knop en een streepje zakt langs de scrollbalk.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const s = mini ? '-m' : '';
const heet = `kennisbank-wat-is-heatmap-heet${s}`;
const warm = `kennisbank-wat-is-heatmap-warm${s}`;
const scroll = `kennisbank-wat-is-heatmap-scroll${s}`;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een webpagina met een heatmap eroverheen. De knop Offerte aanvragen kleurt fel oranje omdat daar het meest geklikt wordt, een foto zonder link kleurt ook warm. Rechts een scrollbalk: bovenaan ziet 100 procent van de bezoekers de pagina, halverwege nog 58 procent en onderaan 21 procent.'}>
  <defs>
    <radialGradient id={heet}>
      <stop offset="0" stop-color="#ff6600" stop-opacity="0.9" />
      <stop offset="0.45" stop-color="#ff8a33" stop-opacity="0.55" />
      <stop offset="1" stop-color="#ffd2b0" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={warm}>
      <stop offset="0" stop-color="#ff8a33" stop-opacity="0.6" />
      <stop offset="1" stop-color="#ffd2b0" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={scroll} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff6600" />
      <stop offset="0.5" stop-color="#ffb37a" />
      <stop offset="1" stop-color="#e8eef4" />
    </linearGradient>
  </defs>

  <!-- browservenster met webpagina -->
  <rect x="24" y="20" width="318" height="232" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M24 46h318" stroke="#e8eef4" stroke-width="2" />
  <circle cx="40" cy="33" r="4" fill="#d9e1ea" /><circle cx="52" cy="33" r="4" fill="#d9e1ea" /><circle cx="64" cy="33" r="4" fill="#d9e1ea" />
  <rect x="84" y="27" width="150" height="12" rx="6" fill="#e8eef4" />
  <text x="94" y="36.5" font-size="9" class="zacht">jouwbedrijf.nl</text>

  <rect x="42" y="62" width="70" height="8" rx="4" fill="#074663" />
  <rect x="236" y="62" width="88" height="8" rx="4" fill="#e8eef4" />
  <rect x="42" y="86" width="168" height="13" rx="4" fill="#10283f" />
  <rect x="42" y="106" width="130" height="13" rx="4" fill="#10283f" />
  <rect x="42" y="128" width="150" height="6" rx="3" fill="#d9e1ea" />
  <rect x="42" y="140" width="120" height="6" rx="3" fill="#d9e1ea" />
  <rect x="42" y="158" width="112" height="26" rx="8" fill="#074663" />
  <text x="98" y="175" font-size="10.5" font-weight="800" text-anchor="middle" style="fill:#fff">Offerte aanvragen</text>
  <rect class="v" x="226" y="84" width="98" height="100" rx="8" />
  <path d="M226 168l26-30 18 18 20-24 34 40v4a8 8 0 0 1-8 8h-82a8 8 0 0 1-8-8z" fill="#074663" opacity="0.85" />
  <rect x="42" y="204" width="282" height="6" rx="3" fill="#e8eef4" />
  <rect x="42" y="216" width="240" height="6" rx="3" fill="#e8eef4" />
  <rect x="42" y="228" width="262" height="6" rx="3" fill="#e8eef4" />

  <!-- de heatmaplaag -->
  <g class="heatmap-vlekken">
    <ellipse class="heatmap-v1" cx="98" cy="171" rx="70" ry="38" fill={`url(#${heet})`} />
    <ellipse class="heatmap-v2" cx="274" cy="130" rx="54" ry="44" fill={`url(#${warm})`} />
    <ellipse class="heatmap-v3" cx="120" cy="100" rx="80" ry="24" fill={`url(#${warm})`} opacity="0.7" />
  </g>

  <!-- scrollkaart -->
  <rect x="366" y="20" width="96" height="232" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="414" y="40" font-size="10" font-weight="800" text-anchor="middle">Scrolldiepte</text>
  <rect x="382" y="52" width="16" height="186" rx="8" fill={`url(#${scroll})`} />
  <text x="408" y="62" font-size="11" font-weight="800">100%</text>
  <text x="408" y="148" font-size="11" font-weight="800">58%</text>
  <text x="408" y="234" font-size="11" font-weight="800">21%</text>
  <path d="M402 144h4M402 230h4M402 58h4" stroke="#d9e1ea" stroke-width="2" />

  {!mini && (
    <g>
      <g class="heatmap-streep"><rect x="376" y="52" width="28" height="4" rx="2" fill="#10283f" /></g>
      <circle class="heatmap-ring" cx="132" cy="171" r="11" fill="none" stroke="#10283f" stroke-width="2.5" />
      <g class="heatmap-cursor"><path d="M132 171l0 21 6-6 5 11 5-2-5-11 9 0z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" /></g>
      <g class="heatmap-chip"><rect x="190" y="198" width="104" height="24" rx="12" fill="#1a7a50" /><text x="242" y="214.5" font-size="11" font-weight="800" text-anchor="middle" style="fill:#fff">meeste klikken</text></g>
    </g>
  )}
</svg>
<style>
  .heatmap-v1, .heatmap-v2, .heatmap-v3 { transform-box: fill-box; transform-origin: center; }
  .heatmap-cursor { transform-box: view-box; }
  .heatmap-ring, .heatmap-chip { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .heatmap-cursor, :global(.teken-js) .heatmap-ring, :global(.teken-js) .heatmap-chip { opacity: 0; }
  .in-beeld .heatmap-v1 { animation: kennisbank-wat-is-heatmap-adem 4s ease-in-out infinite; }
  .in-beeld .heatmap-v2 { animation: kennisbank-wat-is-heatmap-adem 4s ease-in-out 1.3s infinite; }
  .in-beeld .heatmap-v3 { animation: kennisbank-wat-is-heatmap-adem 4s ease-in-out 2.6s infinite; }
  .in-beeld .heatmap-cursor { animation: kennisbank-wat-is-heatmap-cursor 6s ease-in-out 0.5s infinite; }
  .in-beeld .heatmap-ring { animation: kennisbank-wat-is-heatmap-ring 6s ease-out 0.5s infinite; }
  .in-beeld .heatmap-chip { animation: kennisbank-wat-is-heatmap-chip 0.6s cubic-bezier(.3,1.6,.5,1) 2.4s forwards; }
  .in-beeld .heatmap-streep { animation: kennisbank-wat-is-heatmap-streep 6s ease-in-out 0.5s infinite; }
  @keyframes kennisbank-wat-is-heatmap-adem { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.08); opacity: 0.8; } }
  @keyframes kennisbank-wat-is-heatmap-cursor {
    0% { opacity: 0; transform: translate(150px, 60px); }
    10% { opacity: 1; }
    34% { transform: translate(0, 0); }
    40% { transform: translate(0, 0) scale(0.92); }
    46%, 82% { opacity: 1; transform: translate(0, 0); }
    94%, 100% { opacity: 0; transform: translate(0, 0); }
  }
  @keyframes kennisbank-wat-is-heatmap-ring { 0%, 37% { opacity: 0; transform: scale(0.4); } 41% { opacity: 1; } 58%, 100% { opacity: 0; transform: scale(1.9); } }
  @keyframes kennisbank-wat-is-heatmap-chip { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-wat-is-heatmap-streep { 0%, 8% { transform: translateY(0); } 70%, 84% { transform: translateY(178px); } 100% { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .heatmap-v1, .in-beeld .heatmap-v2, .in-beeld .heatmap-v3, .in-beeld .heatmap-cursor, .in-beeld .heatmap-ring, .in-beeld .heatmap-chip, .in-beeld .heatmap-streep { animation: none; } }
</style>
