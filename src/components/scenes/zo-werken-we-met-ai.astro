---
// Scène voor /zo-werken-we-met-ai/: AI schrijft een eerste versie, een mens met een pen streept door, verbetert
// en zet er een vinkje onder. Links het AI-deel, rechts het mensendeel, in het midden het papier.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const regels = [
  { y: 84, w: 130 },
  { y: 102, w: 150 },
  { y: 120, w: 112 },
  { y: 150, w: 146 },
  { y: 168, w: 124 },
  { y: 186, w: 98 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: een AI-assistent schrijft een eerste versie op papier. Een mens streept met een oranje pen een regel door, schrijft er iets bij en zet er een groen vinkje onder.'} aria-hidden={mini ? 'true' : undefined}>
  <!-- AI-kant -->
  <rect x="24" y="70" width="96" height="96" rx="22" fill="#e8eef4" />
  <path d="M72 92l6 15 15 6-15 6-6 15-6-15-15-6 15-6z" fill="#074663" />
  <path d="M98 82l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" fill="#ff6600" />
  <text x="72" y="190" text-anchor="middle" font-size="12" font-weight="800">AI</text>
  <text x="72" y="206" text-anchor="middle" font-size="10.5" class="zacht">eerste versie</text>
  <path class="l" d="M124 118h26" stroke-dasharray="3 5" />

  <!-- Papier -->
  <rect x="152" y="36" width="182" height="206" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="170" y="54" width="100" height="10" rx="4" fill="#10283f" />
  {regels.map((r) => <rect class="v" x="170" y={r.y} width={r.w} height="8" rx="4" />)}
  <path d="M296 112c10-6 18-2 20 6" fill="none" stroke="#ff6600" stroke-width="2" stroke-linecap="round" />
  <text x="282" y="140" font-size="10" font-weight="700" style="fill:#ff6600">klopt niet</text>

  <!-- Mens-kant -->
  <circle cx="408" cy="98" r="20" fill="#e8eef4" />
  <path d="M376 160c0-20 14-34 32-34s32 14 32 34z" fill="#e8eef4" />
  <text x="408" y="190" text-anchor="middle" font-size="12" font-weight="800">Mens</text>
  <text x="408" y="206" text-anchor="middle" font-size="10.5" class="zacht">beslist en checkt</text>
  <circle cx="306" cy="218" r="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />

  {!mini && (
    <g>
      {regels.map((r, i) => <rect class="regel" style={`--i:${i}`} x="170" y={r.y} width={r.w} height="8" rx="4" fill="#8aa0b4" />)}
      <path class="streep" d="M168 124h118" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" pathLength="1" />
      <g class="pen">
        <path d="M0 0l8-3 34-34-5-5-34 34z" fill="#10283f" />
        <path d="M0 0l8-3-5-5z" fill="#ff6600" />
      </g>
      <g class="vinkje">
        <circle cx="306" cy="218" r="14" fill="#1a7a50" />
        <path d="M299 218l5 5 9-10" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .regel { transform-box: fill-box; transform-origin: left center; }
  .vinkje { transform-box: fill-box; transform-origin: center; }
  .streep { stroke-dasharray: 1; }
  .pen { transform: translate(286px, 124px); }
  :global(.teken-js) .regel { transform: scaleX(0); }
  :global(.teken-js) .streep { stroke-dashoffset: 1; }
  :global(.teken-js) .vinkje { opacity: 0; transform: scale(0.4); }
  .in-beeld .regel { animation: zo-werken-we-met-ai-schrijf 0.5s ease-out forwards; animation-delay: calc(0.3s + var(--i) * 0.25s); }
  .in-beeld .streep { animation: zo-werken-we-met-ai-streep 0.8s ease-in-out 2s forwards; }
  .in-beeld .vinkje { animation: zo-werken-we-met-ai-vink 0.5s cubic-bezier(.3,1.7,.5,1) 3.2s forwards; }
  .in-beeld .pen { animation: zo-werken-we-met-ai-pen 6s ease-in-out 1.6s infinite; }
  @keyframes zo-werken-we-met-ai-schrijf { to { transform: none; } }
  @keyframes zo-werken-we-met-ai-streep { to { stroke-dashoffset: 0; } }
  @keyframes zo-werken-we-met-ai-vink { to { opacity: 1; transform: none; } }
  @keyframes zo-werken-we-met-ai-pen {
    0% { transform: translate(380px, 150px); }
    12% { transform: translate(168px, 124px); }
    28% { transform: translate(286px, 124px); }
    45% { transform: translate(300px, 216px); }
    55% { transform: translate(306px, 222px); }
    75%, 100% { transform: translate(380px, 150px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .regel, .in-beeld .streep, .in-beeld .vinkje, .in-beeld .pen { animation: none; }
  }
</style>
