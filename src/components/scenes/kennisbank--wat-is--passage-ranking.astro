---
// Scène voor /kennisbank/wat-is/passage-ranking/: een lange pagina met vijf blokken tekst, rechts een zoekvraag en een zoekresultaat.
// Als hij leeft: een vergrootglas zoekt rustig de pagina af, één alinea licht op en een lijn trekt hem naar het zoekresultaat.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const blokken = [44, 86, 128, 170, 212];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een lange webpagina met vijf alinea\'s. Eén alinea licht op en verschijnt als antwoord in de zoekresultaten.'}>
  <rect x="40" y="22" width="180" height="230" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="40" y="128" width="180" height="38" fill="#fff1e6" />
  {blokken.map((y, i) => (
    <g>
      <rect x="56" y={y} width={i === 2 ? 92 : 70 + (i % 2) * 18} height="7" rx="3.5" fill={i === 2 ? '#ff6600' : '#074663'} />
      <rect class="v" x="56" y={y + 13} width="148" height="5" rx="2.5" />
      <rect class="v" x="56" y={y + 22} width={i % 2 ? 120 : 136} height="5" rx="2.5" />
    </g>
  ))}

  <rect x="262" y="40" width="190" height="30" rx="15" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="280" cy="55" r="5.5" fill="none" stroke="#074663" stroke-width="2" />
  <path d="M284 59l4 4" stroke="#074663" stroke-width="2" stroke-linecap="round" />
  <text x="296" y="59.5" font-size="11.5">warmtepomp levensduur</text>

  <rect x="262" y="92" width="190" height="112" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="276" y="106" width="78" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="276" y="118" width="150" height="9" rx="4.5" fill="#074663" />
  <rect x="270" y="136" width="174" height="56" rx="6" fill="#fff1e6" />
  <rect x="278" y="146" width="150" height="5" rx="2.5" fill="#ffb47f" />
  <rect x="278" y="158" width="136" height="5" rx="2.5" fill="#ffb47f" />
  <rect x="278" y="170" width="108" height="5" rx="2.5" fill="#ffb47f" />

  {!mini && (
    <g>
      <path class="passage-lijn" d="M220 147C240 147 244 164 270 164" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" pathLength="1" />
      <g class="passage-glas">
        <circle cx="196" cy="50" r="15" fill="#ffffff" fill-opacity="0.35" stroke="#10283f" stroke-width="3" />
        <path d="M207 61l10 10" stroke="#10283f" stroke-width="4" stroke-linecap="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .passage-lijn { stroke-dasharray: 1; }
  :global(.teken-js) .passage-lijn { stroke-dashoffset: 1; }
  :global(.teken-js) .passage-glas { opacity: 0; }
  .in-beeld .passage-lijn { animation: kennisbank-wat-is-passage-ranking-lijn 1.2s cubic-bezier(.6,.1,.3,1) 1s forwards; }
  .in-beeld .passage-glas { animation: kennisbank-wat-is-passage-ranking-zoek 7s ease-in-out 0.4s infinite; }
  @keyframes kennisbank-wat-is-passage-ranking-lijn { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank-wat-is-passage-ranking-zoek {
    0% { opacity: 0; transform: translateY(0); }
    8% { opacity: 1; }
    30% { transform: translateY(80px); }
    45%, 70% { transform: translateY(97px); opacity: 1; }
    92% { transform: translateY(170px); opacity: 1; }
    100% { transform: translateY(170px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .passage-lijn, .in-beeld .passage-glas { animation: none; } }
</style>
