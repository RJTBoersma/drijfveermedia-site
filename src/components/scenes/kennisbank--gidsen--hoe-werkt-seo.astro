---
// Scène voor /kennisbank/gidsen/hoe-werkt-seo/: de drie stappen van Google. Een robotje leest pagina's (crawlen),
// een archiefkast bewaart ze (indexeren) en een lijstje zet ze op volgorde (rangschikken).
// Als hij leeft: een pagina reist van stap naar stap, het lampje van de robot knippert en de bovenste plek loopt vol.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-label={mini ? undefined : 'Getekend: een robotje leest webpagina\'s, een archiefkast slaat ze op en een lijst zet ze op volgorde. Crawlen, indexeren en rangschikken.'} aria-hidden={mini ? 'true' : undefined}>
  <!-- 1. crawlen -->
  <rect x="74" y="66" width="70" height="90" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="62" y="78" width="70" height="90" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="50" y="90" width="70" height="90" rx="6" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="60" y="102" width="42" height="7" rx="3.5" fill="#10283f" opacity="0.8" />
  <rect x="60" y="116" width="50" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="60" y="127" width="44" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="60" y="138" width="50" height="5" rx="2.5" fill="#d9e1ea" />
  <path class="l" d="M52 168v-14" />
  <circle cx="52" cy="152" r="4" fill="#ff6600" />
  <rect x="32" y="168" width="40" height="32" rx="12" fill="#074663" />
  <circle cx="44" cy="184" r="4.5" fill="#fff" /><circle cx="60" cy="184" r="4.5" fill="#fff" />
  <path d="M38 200l-6 10M66 200l6 10M46 200v12M58 200v12" stroke="#074663" stroke-width="3" stroke-linecap="round" />

  <!-- 2. indexeren -->
  <rect x="210" y="82" width="26" height="22" rx="3" fill="#e8eef4" stroke="#b9c8d6" stroke-width="1.5" />
  <rect x="232" y="76" width="26" height="28" rx="3" fill="#fff" stroke="#b9c8d6" stroke-width="1.5" />
  <rect x="254" y="86" width="22" height="18" rx="3" fill="#e8eef4" stroke="#b9c8d6" stroke-width="1.5" />
  <rect class="v" x="198" y="98" width="88" height="112" rx="8" style="fill:#fff" />
  <path class="l" d="M206 98h72a8 8 0 0 1 8 8v96a8 8 0 0 1-8 8h-72a8 8 0 0 1-8-8v-96a8 8 0 0 1 8-8zM198 135h88M198 172h88" />
  <rect x="230" y="113" width="24" height="7" rx="3.5" fill="#074663" />
  <rect x="230" y="150" width="24" height="7" rx="3.5" fill="#074663" />
  <rect x="230" y="187" width="24" height="7" rx="3.5" fill="#074663" />

  <!-- 3. rangschikken -->
  <rect x="330" y="84" width="122" height="126" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="350" cy="110" r="10" fill="#ff6600" />
  <text x="350" y="114.5" font-size="12" font-weight="800" text-anchor="middle" style="fill:#fff">1</text>
  <rect x="368" y="105" width="70" height="10" rx="5" fill="#e8eef4" />
  <circle cx="350" cy="146" r="10" fill="#e8eef4" />
  <text x="350" y="150.5" font-size="12" font-weight="800" text-anchor="middle">2</text>
  <rect x="368" y="141" width="56" height="10" rx="5" fill="#e8eef4" />
  <circle cx="350" cy="182" r="10" fill="#e8eef4" />
  <text x="350" y="186.5" font-size="12" font-weight="800" text-anchor="middle">3</text>
  <rect x="368" y="177" width="44" height="10" rx="5" fill="#e8eef4" />

  <!-- verbindingen en namen -->
  <path class="a" d="M150 130c16-20 32-20 44-6" stroke-dasharray="5 6" />
  <path class="a" d="M290 130c14-20 26-20 36-6" stroke-dasharray="5 6" />
  <text x="86" y="242" font-size="14" font-weight="800" text-anchor="middle">Crawlen</text>
  <text x="242" y="242" font-size="14" font-weight="800" text-anchor="middle">Indexeren</text>
  <text x="391" y="242" font-size="14" font-weight="800" text-anchor="middle">Rangschikken</text>

  {!mini && (
    <g>
      <circle class="lampje" cx="52" cy="152" r="4" fill="#ffd2b0" />
      <rect class="vol" x="368" y="105" width="70" height="10" rx="5" fill="#ff6600" />
      <g transform="translate(120 118)"><g class="reis"><rect x="-9" y="-11" width="18" height="22" rx="3" fill="#fff" stroke="#ff6600" stroke-width="2" /><path d="M-4-4h8M-4 1h8M-4 6h5" stroke="#ff6600" stroke-width="1.6" stroke-linecap="round" /></g></g>
    </g>
  )}
</svg>
<style>
  .vol { transform-box: fill-box; transform-origin: 0 50%; }
  :global(.teken-js) .vol { transform: scaleX(0); }
  .in-beeld .vol { animation: kennisbank-gidsen-hoe-werkt-seo-vol 1.2s cubic-bezier(.6,.1,.3,1) 1.4s forwards; }
  :global(.teken-js) .reis { opacity: 0; }
  .in-beeld .reis { animation: kennisbank-gidsen-hoe-werkt-seo-reis 6s ease-in-out 0.8s infinite; }
  .in-beeld .lampje { animation: kennisbank-gidsen-hoe-werkt-seo-lampje 1.6s ease-in-out 0.4s infinite; }
  @keyframes kennisbank-gidsen-hoe-werkt-seo-vol { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes kennisbank-gidsen-hoe-werkt-seo-reis {
    0% { opacity: 0; transform: translate(0, 0); }
    8% { opacity: 1; transform: translate(10px, -6px); }
    22% { transform: translate(52px, -18px); }
    34% { opacity: 1; transform: translate(102px, -26px) scale(0.9); }
    42% { opacity: 0; transform: translate(122px, 2px) scale(0.5); }
    54% { opacity: 0; transform: translate(176px, -2px) scale(0.5); }
    62% { opacity: 1; transform: translate(186px, -8px); }
    78% { opacity: 1; transform: translate(212px, -22px); }
    90% { opacity: 0; transform: translate(230px, -14px) scale(0.6); }
    100% { opacity: 0; transform: translate(230px, -14px) scale(0.6); }
  }
  @keyframes kennisbank-gidsen-hoe-werkt-seo-lampje { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .vol, .in-beeld .reis, .in-beeld .lampje { animation: none; } }
</style>
