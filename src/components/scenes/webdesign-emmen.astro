---
// Scène voor /webdesign-emmen/: een website op een laptop, met de dorpen rond Emmen eromheen. Uit elk dorp loopt een route naar de site, en er komt een aanvraag binnen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een website op een laptop, met routes uit Klazienaveen, Emmer-Compascuum, Nieuw-Amsterdam en Schoonebeek. Een cursor klikt op de belknop en er komt een aanvraag binnen.'}>
  <!-- routes uit de dorpen naar de site -->
  <g fill="none" stroke="#8aa0b4" stroke-width="2" stroke-dasharray="4 6" stroke-linecap="round">
    <path d="M418 64C392 66 362 74 334 94" />
    <path d="M392 222C382 196 362 178 334 166" />
    <path d="M74 188C102 178 124 164 148 150" />
    <path d="M206 236C210 222 214 206 218 192" />
  </g>
  <!-- de dorpen -->
  <g stroke="#fff" stroke-width="2.5" fill="#074663">
    <circle cx="420" cy="62" r="6" />
    <circle cx="394" cy="226" r="6" />
    <circle cx="70" cy="190" r="6" />
    <circle cx="204" cy="240" r="6" />
  </g>
  <g font-size="11" font-weight="700">
    <text x="420" y="44" text-anchor="middle">Emmer-Compascuum</text>
    <text x="394" y="250" text-anchor="middle">Klazienaveen</text>
    <text x="70" y="212" text-anchor="middle">Nieuw-Amsterdam</text>
    <text x="204" y="262" text-anchor="middle">Schoonebeek</text>
  </g>
  <!-- speld Emmen boven de laptop -->
  <path d="M232 22c0-9 7-15 14-15s14 6 14 15c0 10-14 22-14 22s-14-12-14-22z" fill="#ff6600" />
  <circle cx="246" cy="22" r="5" fill="#fff" />
  <text x="266" y="27" font-size="13" font-weight="800">Emmen</text>
  <!-- laptop met website -->
  <rect x="150" y="56" width="184" height="122" rx="9" fill="#10283f" />
  <rect x="158" y="64" width="168" height="106" rx="4" fill="#fff" />
  <path d="M134 178h216l-12 13H146z" fill="#c9d3dd" />
  <rect x="166" y="72" width="38" height="7" rx="3" fill="#074663" />
  <rect x="270" y="73" width="16" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="292" y="73" width="24" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="166" y="90" width="98" height="9" rx="3" fill="#10283f" />
  <rect x="166" y="105" width="74" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="166" y="114" width="64" height="5" rx="2.5" fill="#d9e1ea" />
  <rect x="166" y="130" width="64" height="20" rx="6" fill="#ff6600" />
  <text x="198" y="143.5" text-anchor="middle" font-size="9.5" font-weight="800" style="fill:#fff">Bel direct</text>
  <rect class="v" x="252" y="100" width="64" height="58" rx="5" />
  <path class="l" d="M262 148v-18l14-11 14 11v18M272 148v-9h8v9" />
  <path class="a" d="M294 120l8-6 8 6" />

  {!mini && (
    <g>
      <!-- stromende punten over de routes -->
      <g class="stroom" fill="none" stroke="#ff6600" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="1 19">
        <path d="M418 64C392 66 362 74 334 94" />
        <path d="M392 222C382 196 362 178 334 166" />
        <path d="M74 188C102 178 124 164 148 150" />
        <path d="M206 236C210 222 214 206 218 192" />
      </g>
      <!-- cursor klikt op de belknop -->
      <circle class="rimpel" cx="227" cy="148" r="8" fill="none" stroke="#ff6600" stroke-width="2.5" />
      <g transform="translate(228 150)">
        <g class="cursor">
          <path d="M0 0v19l5-5 4 9 4-2-4-9h7z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
        </g>
      </g>
      <!-- de aanvraag komt binnen -->
      <g class="melding">
        <rect x="14" y="16" width="158" height="44" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
        <circle cx="34" cy="38" r="9" fill="#1a7a50" />
        <path d="M29.5 38l3 3 5.5-6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="50" y="34" font-size="11.5" font-weight="800">Nieuwe aanvraag</text>
        <text x="50" y="49" font-size="10.5" class="zacht">uit Klazienaveen</text>
      </g>
    </g>
  )}
</svg>
<style>
  :global(.teken-js) .stroom, :global(.teken-js) .melding, :global(.teken-js) .rimpel { opacity: 0; }
  :global(.teken-js) .cursor { transform: translate(70px, 60px); opacity: 0; }
  .rimpel, .melding { transform-box: fill-box; transform-origin: center; }
  .in-beeld .stroom { animation: webdesign-emmen-zichtbaar 0.6s ease 0.4s forwards, webdesign-emmen-stroom 4s linear 0.4s infinite; }
  .in-beeld .cursor { animation: webdesign-emmen-cursor 1.2s cubic-bezier(.3,.8,.3,1) 0.6s forwards; }
  .in-beeld .rimpel { animation: webdesign-emmen-rimpel 3s ease-out 1.8s infinite; }
  .in-beeld .melding { animation: webdesign-emmen-melding 6s ease-in-out 2.2s infinite both; }
  @keyframes webdesign-emmen-zichtbaar { to { opacity: 1; } }
  @keyframes webdesign-emmen-stroom { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -40; } }
  @keyframes webdesign-emmen-cursor { to { transform: none; opacity: 1; } }
  @keyframes webdesign-emmen-rimpel { 0% { opacity: 0.9; transform: scale(0.5); } 60%, 100% { opacity: 0; transform: scale(1.7); } }
  @keyframes webdesign-emmen-melding { 0% { opacity: 0; transform: translateY(-8px); } 12%, 80% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .stroom, .in-beeld .cursor, .in-beeld .rimpel, .in-beeld .melding { animation: none; opacity: 1; transform: none; } }
</style>
