---
// Scène voor /kennisbank/wat-is/sea/: een zoekresultatenpagina met twee advertenties bovenaan (label Gesponsord) en daaronder de gewone resultaten.
// Rechts een kaartje: je betaalt pas per klik. Als hij leeft: een cursor klikt op de bovenste advertentie, er vliegt een munt naar het kaartje en de teller tikt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const advertenties = [82, 136];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een zoekresultatenpagina met twee gesponsorde advertenties bovenaan. Een bezoeker klikt op een advertentie en pas dan betaalt de adverteerder, hier 2,25 euro per klik.'}>
  <!-- zoekpagina -->
  <rect x="24" y="22" width="306" height="228" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="40" y="36" width="274" height="30" rx="15" fill="#e8eef4" />
  <text x="58" y="56" font-size="12" font-weight="700">loodgieter assen</text>
  <circle cx="292" cy="50" r="6" fill="none" stroke="#074663" stroke-width="2.2" />
  <path d="M296.5 54.5l4.5 4.5" stroke="#074663" stroke-width="2.2" stroke-linecap="round" />

  {advertenties.map((y) => (
    <g>
      <rect x="40" y={y} width="78" height="17" rx="8.5" fill="#fff4ec" stroke="#ff6600" stroke-width="1.4" />
      <text x="79" y={y + 12.5} font-size="10" font-weight="800" text-anchor="middle">Gesponsord</text>
      <rect x="40" y={y + 24} width="190" height="9" rx="4.5" fill="#074663" />
      <rect x="40" y={y + 38} width="250" height="6" rx="3" fill="#d9e1ea" />
    </g>
  ))}
  <path d="M40 190h274" stroke="#e8eef4" stroke-width="2" />
  <rect x="40" y="202" width="150" height="8" rx="4" fill="#10283f" opacity="0.7" />
  <rect x="40" y="216" width="236" height="6" rx="3" fill="#e8eef4" />
  <rect x="40" y="230" width="200" height="6" rx="3" fill="#e8eef4" />

  <!-- betalen per klik -->
  <rect x="350" y="74" width="110" height="112" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="405" y="100" font-size="11" font-weight="800" text-anchor="middle" class="zacht">Je betaalt</text>
  <text x="405" y="136" font-size="24" font-weight="800" text-anchor="middle">€ 2,25</text>
  <text x="405" y="160" font-size="11" text-anchor="middle" class="zacht">per klik</text>
  <path class="a" d="M318 114c12 0 18-8 28-8" />

  {!mini && (
    <g>
      <rect class="sea-gloed" x="34" y="100" width="290" height="30" rx="8" fill="none" stroke="#ff6600" stroke-width="2" />
      <circle class="sea-ring" cx="200" cy="111" r="12" fill="none" stroke="#ff6600" stroke-width="2.5" />
      <g class="sea-cursor"><path d="M200 111l0 22 6-6 5 11 5-2-5-11 9 0z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" /></g>
      <g class="sea-munt"><circle cx="210" cy="111" r="11" fill="#ff6600" /><text x="210" y="115.5" font-size="12" font-weight="800" text-anchor="middle" style="fill:#fff">€</text></g>
      <g class="sea-chip"><rect x="364" y="196" width="82" height="24" rx="12" fill="#1f8a5b" /><text x="405" y="212.5" font-size="12" font-weight="800" text-anchor="middle" style="fill:#fff">+1 klik</text></g>
    </g>
  )}
</svg>
<style>
  .sea-cursor, .sea-munt { transform-box: view-box; }
  .sea-ring, .sea-chip { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .sea-cursor, :global(.teken-js) .sea-munt, :global(.teken-js) .sea-ring, :global(.teken-js) .sea-chip, :global(.teken-js) .sea-gloed { opacity: 0; }
  .in-beeld .sea-cursor { animation: kennisbank--wat-is--sea-cursor 5s ease-in-out 0.4s infinite; }
  .in-beeld .sea-ring { animation: kennisbank--wat-is--sea-ring 5s ease-out 0.4s infinite; }
  .in-beeld .sea-munt { animation: kennisbank--wat-is--sea-munt 5s ease-in-out 0.4s infinite; }
  .in-beeld .sea-chip { animation: kennisbank--wat-is--sea-chip 5s ease-out 0.4s infinite; }
  .in-beeld .sea-gloed { animation: kennisbank--wat-is--sea-gloed 0.8s ease-out 0.3s forwards; }
  @keyframes kennisbank--wat-is--sea-cursor {
    0% { opacity: 0; transform: translate(170px, 110px); }
    10% { opacity: 1; }
    34% { transform: translate(0, 0); }
    40% { transform: translate(0, 0) scale(0.94); }
    46%, 80% { opacity: 1; transform: translate(0, 0); }
    92%, 100% { opacity: 0; transform: translate(0, 0); }
  }
  @keyframes kennisbank--wat-is--sea-ring { 0%, 36% { opacity: 0; transform: scale(0.4); } 40% { opacity: 1; } 56%, 100% { opacity: 0; transform: scale(1.8); } }
  @keyframes kennisbank--wat-is--sea-munt {
    0%, 42% { opacity: 0; transform: translate(0, 0); }
    48% { opacity: 1; transform: translate(40px, -36px); }
    66% { opacity: 1; transform: translate(195px, 14px); }
    72%, 100% { opacity: 0; transform: translate(195px, 14px); }
  }
  @keyframes kennisbank--wat-is--sea-chip { 0%, 66% { opacity: 0; transform: translateY(6px); } 72%, 90% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes kennisbank--wat-is--sea-gloed { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .sea-cursor, .in-beeld .sea-ring, .in-beeld .sea-munt, .in-beeld .sea-chip, .in-beeld .sea-gloed { animation: none; } }
</style>
