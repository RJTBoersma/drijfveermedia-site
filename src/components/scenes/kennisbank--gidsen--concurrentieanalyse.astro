---
// Scène voor /kennisbank/gidsen/concurrentieanalyse/: vier bedrijven naast elkaar (jij en drie concurrenten) met sterren, en daaronder een concurrentiematrix met scores per criterium.
// Als hij leeft: een vergrootglas schuift rustig langs de concurrenten en in de matrix licht een gat op met het label "Kans".
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const bedrijven = [
  { x: 36, naam: 'Jij', sterren: 4, jij: true },
  { x: 142, naam: 'A', sterren: 4 },
  { x: 248, naam: 'B', sterren: 2 },
  { x: 354, naam: 'C', sterren: 3 },
];
const rijen = [
  { y: 174, label: 'Prijs', scores: [3, 3, 5, 2] },
  { y: 198, label: 'Reviews', scores: [4, 4, 2, 3] },
  { y: 222, label: 'Snelheid', scores: [2, 2, 1, 2] },
];
const ster = (cx: number, cy: number) => `M${cx} ${cy - 4.5}l1.3 2.8 3.1.4-2.3 2.1.6 3.1-2.7-1.5-2.7 1.5.6-3.1-2.3-2.1 3.1-.4z`;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: jouw bedrijf en drie concurrenten naast elkaar met sterren voor reviews, en daaronder een matrix met scores op prijs, reviews en snelheid. Een vergrootglas schuift langs de concurrenten en in de matrix licht een kans op.'}>
  <!-- vier bedrijven -->
  {bedrijven.map((b) => (
    <g>
      <rect x={b.x} y="34" width="90" height="96" rx="10" fill="#fff" stroke={b.jij ? '#ff6600' : '#d9e1ea'} stroke-width="2" />
      <path d={`M${b.x + 14} 62l31-16 31 16`} fill="none" stroke={b.jij ? '#ff6600' : '#074663'} stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      <rect x={b.x + 20} y="62" width="50" height="30" rx="3" fill={b.jij ? '#ffe3cf' : '#e8eef4'} />
      <rect x={b.x + 39} y="74" width="12" height="18" rx="2" fill={b.jij ? '#ff6600' : '#074663'} />
      <text x={b.x + 45} y="108" font-size="10.5" font-weight="900" text-anchor="middle">{b.naam}</text>
      {[0, 1, 2, 3, 4].map((i) => <path d={ster(b.x + 21 + i * 12, 120)} fill={i < b.sterren ? '#ff6600' : '#d9e1ea'} />)}
    </g>
  ))}

  <!-- matrix -->
  <rect x="36" y="146" width="408" height="98" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  {bedrijven.map((b, i) => <text x={150 + i * 74} y="163" font-size="9.5" font-weight="800" class="zacht" text-anchor="middle">{b.naam}</text>)}
  {rijen.map((r) => (
    <g>
      <text x="50" y={r.y + 4} font-size="10" font-weight="800">{r.label}</text>
      {r.scores.map((s, i) => (
        <g>
          <rect x={124 + i * 74} y={r.y - 4} width="52" height="8" rx="4" fill="#eef2f6" />
          <rect x={124 + i * 74} y={r.y - 4} width={s * 10.4} height="8" rx="4" fill={i === 0 ? '#ff6600' : '#074663'} />
        </g>
      ))}
    </g>
  ))}

  {!mini && (
    <g>
      <g class="kans">
        <rect x="116" y="211" width="298" height="22" rx="8" fill="none" stroke="#1a7a50" stroke-width="2" stroke-dasharray="4 3" />
        <rect x="378" y="150" width="58" height="18" rx="9" fill="#1a7a50" />
        <text x="394" y="162.5" font-size="10" font-weight="800" style="fill:#fff">Kans</text>
      </g>
      <g class="loep">
        <circle cx="187" cy="80" r="26" fill="#fff" fill-opacity="0.25" stroke="#10283f" stroke-width="4" />
        <path d="M206 99l16 16" stroke="#10283f" stroke-width="7" stroke-linecap="round" />
      </g>
    </g>
  )}
</svg>
<style>
  .loep { transform-box: view-box; }
  :global(.teken-js) .loep { opacity: 0; }
  .in-beeld .loep { animation: kennisbank-gidsen-concurrentieanalyse-loep 7s ease-in-out 0.6s infinite; }
  :global(.teken-js) .kans { opacity: 0; }
  .in-beeld .kans { animation: kennisbank-gidsen-concurrentieanalyse-kans 7s ease-in-out 0.6s infinite; }
  @keyframes kennisbank-gidsen-concurrentieanalyse-loep {
    0% { opacity: 0; transform: translateX(0); }
    8% { opacity: 1; transform: translateX(0); }
    35% { transform: translateX(106px); }
    62% { opacity: 1; transform: translateX(212px); }
    80% { opacity: 1; transform: translateX(212px); }
    100% { opacity: 0; transform: translateX(212px); }
  }
  @keyframes kennisbank-gidsen-concurrentieanalyse-kans { 0%, 60% { opacity: 0; } 68%, 92% { opacity: 1; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .loep, .in-beeld .kans { animation: none; } }
</style>
