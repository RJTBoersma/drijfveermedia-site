---
// Scène voor /kennisbank/gidsen/wix-squarespace-wordpress/: drie platforms naast elkaar, elk met balkjes voor
// gemak en vrijheid. De balkjes lopen vol en een cursor beweegt rustig heen en weer tussen de kaarten.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const kaarten = [
  { x: 24, naam: 'Wix', gemak: 0.9, vrij: 0.45 },
  { x: 176, naam: 'Squarespace', gemak: 0.8, vrij: 0.4 },
  { x: 328, naam: 'WordPress', gemak: 0.5, vrij: 0.95 },
];
const breed = 96;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: Wix, Squarespace en WordPress naast elkaar, met balkjes voor gemak en vrijheid. Wix en Squarespace scoren hoog op gemak, WordPress op vrijheid.'}>
  {kaarten.map((k, i) => (
    <g>
      <rect x={k.x} y="40" width="128" height="190" rx="14" fill="#fff" stroke={i === 2 ? '#074663' : '#d9e1ea'} stroke-width="2" />
      <rect class="v" x={k.x + 14} y="56" width="100" height="56" rx="8" />
      <rect x={k.x + 24} y="66" width="50" height="7" rx="3.5" fill="#10283f" />
      <rect x={k.x + 24} y="80" width="70" height="5" rx="2.5" fill="#fff" />
      <rect x={k.x + 24} y="92" width="30" height="10" rx="4" fill="#ff6600" />
      <text x={k.x + 64} y="136" font-size="12.5" font-weight="800" text-anchor="middle">{k.naam}</text>
      <text x={k.x + 16} y="160" font-size="9" font-weight="700" class="zacht">Gemak</text>
      <rect x={k.x + 16} y="166" width={breed} height="8" rx="4" fill="#e8eef4" />
      <rect class={mini ? undefined : `balk balk${i}`} x={k.x + 16} y="166" width={breed * k.gemak} height="8" rx="4" fill="#074663" />
      <text x={k.x + 16} y="192" font-size="9" font-weight="700" class="zacht">Vrijheid</text>
      <rect x={k.x + 16} y="198" width={breed} height="8" rx="4" fill="#e8eef4" />
      <rect class={mini ? undefined : `balk balk${i + 3}`} x={k.x + 16} y="198" width={breed * k.vrij} height="8" rx="4" fill="#ff6600" />
    </g>
  ))}
  <text x="240" y="26" font-size="11" font-weight="800" text-anchor="middle" class="zacht">Wat past bij jouw bedrijf?</text>

  {!mini && (
    <g class="wijs">
      <path d="M88 206l0 20 5-5 4 9 4-2-4-9h7z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
    </g>
  )}
</svg>
<style>
  .balk { transform-box: fill-box; transform-origin: left center; }
  :global(.teken-js) .balk { transform: scaleX(0); }
  :global(.teken-js) .wijs { opacity: 0; }
  .in-beeld .balk0 { animation: kennisbank-gidsen-wix-squarespace-wordpress-balk 0.7s ease-out 0.3s forwards; }
  .in-beeld .balk1 { animation: kennisbank-gidsen-wix-squarespace-wordpress-balk 0.7s ease-out 0.5s forwards; }
  .in-beeld .balk2 { animation: kennisbank-gidsen-wix-squarespace-wordpress-balk 0.7s ease-out 0.7s forwards; }
  .in-beeld .balk3 { animation: kennisbank-gidsen-wix-squarespace-wordpress-balk 0.7s ease-out 0.9s forwards; }
  .in-beeld .balk4 { animation: kennisbank-gidsen-wix-squarespace-wordpress-balk 0.7s ease-out 1.1s forwards; }
  .in-beeld .balk5 { animation: kennisbank-gidsen-wix-squarespace-wordpress-balk 0.7s ease-out 1.3s forwards; }
  .in-beeld .wijs { animation: kennisbank-gidsen-wix-squarespace-wordpress-wijs 7s ease-in-out 1.6s infinite; }
  @keyframes kennisbank-gidsen-wix-squarespace-wordpress-balk { to { transform: none; } }
  @keyframes kennisbank-gidsen-wix-squarespace-wordpress-wijs {
    0% { opacity: 0; transform: none; }
    8%, 25% { opacity: 1; transform: none; }
    40%, 55% { opacity: 1; transform: translateX(152px); }
    70%, 90% { opacity: 1; transform: translateX(304px); }
    100% { opacity: 0; transform: translateX(304px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .balk0, .in-beeld .balk1, .in-beeld .balk2, .in-beeld .balk3, .in-beeld .balk4, .in-beeld .balk5 { animation: none; transform: none; }
    .in-beeld .wijs { animation: none; opacity: 0; }
  }
</style>
