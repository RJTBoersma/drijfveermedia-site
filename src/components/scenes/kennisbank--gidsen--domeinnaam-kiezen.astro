---
// Scène voor /kennisbank/gidsen/domeinnaam-kiezen/: een zoekveld waarin een domeinnaam wordt getypt, met daaronder
// de uitslag per extensie. De naam verschijnt letter voor letter, de uitslagen komen erbij en de cursor knippert rustig.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const uitslag = [
  { y: 128, naam: 'jouwbedrijfsnaam.nl', vrij: true },
  { y: 168, naam: 'jouwbedrijfsnaam.com', vrij: true },
  { y: 208, naam: 'jouw-bedrijfsnaam.nl', vrij: false },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: in een zoekveld wordt een domeinnaam getypt. De .nl- en .com-versie zijn vrij, de variant met streepjes is bezet.'}>
  <!-- kaart -->
  <rect x="40" y="22" width="400" height="230" rx="16" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="64" y="52" font-size="11" font-weight="800" class="zacht">Is je domeinnaam nog vrij? (voorbeeld)</text>
  <!-- zoekveld -->
  <rect x="64" y="64" width="352" height="38" rx="19" fill="#fff" stroke="#074663" stroke-width="2" />
  <circle cx="86" cy="82" r="7" fill="none" stroke="#074663" stroke-width="2.2" />
  <path d="M91 87l5 5" stroke="#074663" stroke-width="2.2" stroke-linecap="round" />
  <text x="106" y="88" font-size="14" font-weight="800">jouwbedrijfsnaam</text>
  {!mini && <rect class="dekking" x="104" y="70" width="146" height="26" fill="#fff" />}
  <rect class={mini ? undefined : 'knipper'} x="248" y="72" width="2.5" height="20" rx="1" fill="#10283f" />
  <rect x="344" y="70" width="64" height="26" rx="13" fill="#ff6600" />
  <text x="376" y="87.5" font-size="11" font-weight="800" text-anchor="middle" style="fill:#fff">Zoek</text>

  <!-- uitslagen -->
  {uitslag.map((u, i) => (
    <g class={mini ? undefined : `uitslag uitslag${i}`}>
      <rect x="64" y={u.y - 18} width="352" height="32" rx="10" fill={u.vrij ? '#fff' : '#f4f6f8'} stroke="#e8eef4" stroke-width="2" />
      <text x="82" y={u.y + 3} font-size="12" font-weight="700" class={u.vrij ? undefined : 'zacht'}>{u.naam}</text>
      {u.vrij ? (
        <g>
          <circle cx="330" cy={u.y - 2} r="8" fill="#1a7a50" />
          <path d={`M326 ${u.y - 2}l3 3 5-6`} fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <text x="346" y={u.y + 2} font-size="11" font-weight="800" style="fill:#1a7a50">vrij</text>
        </g>
      ) : (
        <g>
          <circle cx="330" cy={u.y - 2} r="8" fill="#9fb3c4" />
          <path d={`M326.5 ${u.y - 5.5}l7 7M333.5 ${u.y - 5.5}l-7 7`} stroke="#fff" stroke-width="2" stroke-linecap="round" />
          <text x="346" y={u.y + 2} font-size="11" font-weight="800" class="zacht">bezet</text>
        </g>
      )}
    </g>
  ))}
</svg>
<style>
  .dekking, .uitslag { transform-box: fill-box; }
  .dekking { transform-origin: right center; transform: scaleX(0); }
  :global(.teken-js) .dekking { transform: none; }
  :global(.teken-js) .uitslag { opacity: 0; }
  :global(.teken-js) .knipper { transform: translateX(-132px); }
  .in-beeld .dekking { animation: kennisbank-gidsen-domeinnaam-kiezen-typ 1.4s steps(16) 0.3s forwards; }
  .in-beeld .knipper { animation: kennisbank-gidsen-domeinnaam-kiezen-cursor 1.4s steps(16) 0.3s forwards, kennisbank-gidsen-domeinnaam-kiezen-knipper 1.1s steps(1) 1.7s infinite; }
  .in-beeld .uitslag0 { animation: kennisbank-gidsen-domeinnaam-kiezen-uitslag 0.5s ease-out 2s forwards; }
  .in-beeld .uitslag1 { animation: kennisbank-gidsen-domeinnaam-kiezen-uitslag 0.5s ease-out 2.3s forwards; }
  .in-beeld .uitslag2 { animation: kennisbank-gidsen-domeinnaam-kiezen-uitslag 0.5s ease-out 2.6s forwards; }
  @keyframes kennisbank-gidsen-domeinnaam-kiezen-typ { to { transform: scaleX(0); } }
  @keyframes kennisbank-gidsen-domeinnaam-kiezen-cursor { to { transform: none; } }
  @keyframes kennisbank-gidsen-domeinnaam-kiezen-knipper { 50% { opacity: 0; } }
  @keyframes kennisbank-gidsen-domeinnaam-kiezen-uitslag { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .dekking { animation: none; transform: scaleX(0); }
    .in-beeld .knipper { animation: none; transform: none; }
    .in-beeld .uitslag0, .in-beeld .uitslag1, .in-beeld .uitslag2 { animation: none; opacity: 1; transform: none; }
  }
</style>
