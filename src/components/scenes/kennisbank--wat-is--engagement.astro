---
// Scène voor /kennisbank/wat-is/engagement/: een telefoon met een bericht, een reactie ernaast en rechts de engagement rate.
// Als hij leeft: hartjes stijgen op uit het bericht, er komt een nieuwe reactie bij en de balk van de engagement rate groeit.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const hart = 'M0 4c0-4 5-6 8-2c3-4 8-2 8 2c0 5-8 9-8 9s-8-4-8-9z';
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een telefoon met een bericht, met daaronder een hartje, een reactie, delen en opslaan. Links een reactie "Mooi werk", rechts de engagement rate van 7,4 procent die groeit.'}>
  <!-- de telefoon -->
  <rect x="170" y="14" width="140" height="244" rx="20" fill="#fff" stroke="#074663" stroke-width="2.5" />
  <path d="M222 26h36" stroke="#d9e1ea" stroke-width="4" stroke-linecap="round" />
  <circle cx="192" cy="50" r="10" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <rect x="208" y="44" width="64" height="7" rx="3.5" fill="#10283f" />
  <rect x="208" y="55" width="40" height="5" rx="2.5" fill="#d9e1ea" />
  <!-- de foto in het bericht -->
  <rect class="v" x="182" y="70" width="116" height="92" rx="8" />
  <circle class="o" cx="270" cy="92" r="10" />
  <path d="M182 162V146l30-30 22 22 16-14 48 38z" fill="#074663" />
  <!-- knoppen onder het bericht -->
  <path transform="translate(184 174) scale(1.1)" d={hart} fill="none" stroke="#074663" stroke-width="2.2" stroke-linejoin="round" />
  <path class="l" d="M210 176h16a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-10l-6 5v-5a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4z" />
  <path class="l" d="M240 189l16-12M246 176h10v10" />
  <path class="l" d="M280 175h12v18l-6-5-6 5z" />
  <rect x="184" y="206" width="104" height="7" rx="3.5" fill="#d9e1ea" />
  <rect x="184" y="220" width="80" height="7" rx="3.5" fill="#e8eef4" />

  <!-- een reactie -->
  <rect x="24" y="74" width="128" height="40" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="42" cy="94" r="8" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <text x="56" y="99" font-size="12" font-weight="800">Mooi werk</text>
  <path d="M152 100l12 4-12 4" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-linejoin="round" />

  <!-- engagement rate -->
  <rect x="334" y="70" width="124" height="112" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="350" y="94" font-size="11" font-weight="800" class="zacht">Engagement rate</text>
  <text x="350" y="128" font-size="28" font-weight="900" style="fill:#074663">7,4%</text>
  <rect x="350" y="150" width="92" height="10" rx="5" fill="#e8eef4" />
  <rect x="350" y="150" width="40" height="10" rx="5" fill="#074663" />

  {!mini && (
    <g>
      <path class="eg-vol" transform="translate(184 174) scale(1.1)" d={hart} fill="#ff6600" />
      <path class="eg-hart eg-hart-1" transform="translate(186 150)" d={hart} fill="#ff6600" />
      <path class="eg-hart eg-hart-2" transform="translate(196 156)" d={hart} fill="#ff6600" />
      <path class="eg-hart eg-hart-3" transform="translate(176 158)" d={hart} fill="#ff6600" />
      <rect class="eg-balk" x="350" y="150" width="70" height="10" rx="5" fill="#ff6600" />
      <g class="eg-reactie">
        <rect x="16" y="140" width="142" height="40" rx="12" fill="#fff" stroke="#1f8a5b" stroke-width="2" />
        <circle cx="34" cy="160" r="8" fill="#1f8a5b" />
        <text x="48" y="165" font-size="11.5" font-weight="800">Wanneer kan het?</text>
      </g>
    </g>
  )}
</svg>
<style>
  .eg-balk { transform-box: fill-box; transform-origin: left center; }
  .eg-reactie { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .eg-balk { transform: scaleX(0); }
  :global(.teken-js) .eg-reactie, :global(.teken-js) .eg-hart, :global(.teken-js) .eg-vol { opacity: 0; }
  .in-beeld .eg-vol { animation: kennisbank-wat-is-engagement-vol 4s ease-in-out 0.6s infinite; }
  .in-beeld .eg-hart-1 { animation: kennisbank-wat-is-engagement-stijg 4s ease-out 0.8s infinite; }
  .in-beeld .eg-hart-2 { animation: kennisbank-wat-is-engagement-stijg 4s ease-out 1.4s infinite; }
  .in-beeld .eg-hart-3 { animation: kennisbank-wat-is-engagement-stijg 4s ease-out 2s infinite; }
  .in-beeld .eg-balk { animation: kennisbank-wat-is-engagement-balk 1.2s cubic-bezier(.3,1.2,.5,1) 1s forwards; }
  .in-beeld .eg-reactie { animation: kennisbank-wat-is-engagement-reactie 0.6s cubic-bezier(.3,1.6,.5,1) 2.2s forwards; }
  @keyframes kennisbank-wat-is-engagement-vol { 0%, 100% { opacity: 0; } 15%, 70% { opacity: 1; } }
  @keyframes kennisbank-wat-is-engagement-stijg { 0% { opacity: 0; translate: 0 0; } 15% { opacity: 1; } 70% { opacity: 0; translate: 6px -90px; } 100% { opacity: 0; translate: 6px -90px; } }
  @keyframes kennisbank-wat-is-engagement-balk { to { transform: none; } }
  @keyframes kennisbank-wat-is-engagement-reactie { from { opacity: 0; transform: translateY(10px) scale(.9); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .eg-vol, .in-beeld .eg-hart-1, .in-beeld .eg-hart-2, .in-beeld .eg-hart-3, .in-beeld .eg-balk, .in-beeld .eg-reactie { animation: none; } }
</style>
