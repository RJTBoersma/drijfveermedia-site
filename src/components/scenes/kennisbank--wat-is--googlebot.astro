---
// Scène voor /kennisbank/wat-is/googlebot/: een robotje in de vorm van een telefoon (de smartphone-crawler)
// volgt de links tussen drie pagina's en brengt ze naar de kaartenbak van de index. Links staat het bordje van robots.txt.
// Als hij leeft: het robotje loopt van pagina naar pagina, de pagina's krijgen een vinkje en een kaartje schuift de index in.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const paginas = [
  { x: 40, y: 34 },
  { x: 196, y: 34 },
  { x: 352, y: 34 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een robotje in de vorm van een telefoon volgt de links tussen drie webpagina\'s en brengt ze naar de kaartenbak van de index. Een bordje met robots.txt geeft aan waar hij niet mag komen.'}>
  <!-- pagina's -->
  {paginas.map((p) => (
    <g>
      <rect x={p.x} y={p.y} width="88" height="64" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <rect x={p.x + 10} y={p.y + 12} width="44" height="7" rx="3.5" fill="#074663" />
      <rect x={p.x + 10} y={p.y + 26} width="66" height="5" rx="2.5" fill="#d9e1ea" />
      <rect x={p.x + 10} y={p.y + 36} width="56" height="5" rx="2.5" fill="#d9e1ea" />
      <rect x={p.x + 10} y={p.y + 48} width="26" height="7" rx="3.5" fill="#ff6600" />
    </g>
  ))}
  <!-- links -->
  <path d="M128 60c22-14 46-14 68 0M284 60c22-14 46-14 68 0" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round" />
  <path d="M190 56l6 4-7 2M346 56l6 4-7 2" fill="none" stroke="#ff6600" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

  <!-- index: kaartenbak -->
  <rect x="290" y="176" width="150" height="66" rx="10" fill="#fff" stroke="#074663" stroke-width="2" />
  <path d="M290 196h150" stroke="#074663" stroke-width="2" />
  <text x="365" y="191" font-size="12" font-weight="800" text-anchor="middle">Index</text>
  <rect x="304" y="206" width="122" height="8" rx="4" class="v" />
  <rect x="304" y="220" width="122" height="8" rx="4" class="v" />

  <!-- robots.txt-bordje -->
  <path d="M64 252V176" stroke="#074663" stroke-width="4" stroke-linecap="round" />
  <rect x="24" y="150" width="96" height="44" rx="8" fill="#fff" stroke="#074663" stroke-width="2" />
  <text x="72" y="168" font-size="11" font-weight="800" text-anchor="middle">robots.txt</text>
  <text x="72" y="184" font-size="9.5" text-anchor="middle" class="zacht">Disallow: /beheer/</text>
  <path d="M40 252h48" stroke="#d9e1ea" stroke-width="4" stroke-linecap="round" />

  <!-- de crawler: een telefoon met ogen -->
  <g class="bot-loop">
    <g transform="translate(150 150)">
      <path d="M0-30v-8" stroke="#074663" stroke-width="2" stroke-linecap="round" />
      <circle cx="0" cy="-40" r="3" fill="#ff6600" />
      <rect x="-20" y="-30" width="40" height="64" rx="9" fill="#074663" />
      <rect x="-15" y="-23" width="30" height="44" rx="4" fill="#fff" />
      <circle cx="-6" cy="-6" r="3.2" fill="#074663" />
      <circle cx="6" cy="-6" r="3.2" fill="#074663" />
      <path d="M-6 6c3 3 9 3 12 0" fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" />
      <circle cx="0" cy="28" r="2.5" fill="#fff" />
    </g>
  </g>

  {!mini && (
    <g>
      {paginas.map((p, i) => (
        <g class="bot-vink" style={`--i:${i}`}>
          <circle cx={p.x + 80} cy={p.y + 8} r="9" fill="#1a7a50" />
          <path d={`M${p.x + 76} ${p.y + 8}l2.6 2.6 5-5.4`} fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
      <rect class="bot-kaart" x="318" y="150" width="94" height="14" rx="4" fill="#fff" stroke="#ff6600" stroke-width="2" />
    </g>
  )}
</svg>
<style>
  .bot-vink { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .bot-vink, :global(.teken-js) .bot-kaart { opacity: 0; }
  .in-beeld .bot-loop { animation: kennisbank-wat-is-googlebot-loop 8s ease-in-out 0.3s infinite; }
  .in-beeld .bot-vink { animation: kennisbank-wat-is-googlebot-vink 8s ease-out calc(0.3s + var(--i) * 1.6s) infinite; }
  .in-beeld .bot-kaart { animation: kennisbank-wat-is-googlebot-kaart 8s ease-in-out 0.3s infinite; }
  @keyframes kennisbank-wat-is-googlebot-loop {
    0%, 6% { transform: translate(0, 0); }
    16%, 22% { transform: translate(-66px, -60px); }
    34%, 40% { transform: translate(90px, -60px); }
    52%, 58% { transform: translate(246px, -60px); }
    72%, 80% { transform: translate(170px, 0); }
    94%, 100% { transform: translate(0, 0); }
  }
  @keyframes kennisbank-wat-is-googlebot-vink { 0%, 14% { opacity: 0; transform: scale(0.4); } 20%, 80% { opacity: 1; transform: none; } 90%, 100% { opacity: 0; } }
  @keyframes kennisbank-wat-is-googlebot-kaart {
    0%, 70% { opacity: 0; transform: translateY(-10px); }
    76% { opacity: 1; transform: translateY(0); }
    86% { opacity: 1; transform: translateY(46px); }
    92%, 100% { opacity: 0; transform: translateY(52px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .bot-loop, .in-beeld .bot-vink, .in-beeld .bot-kaart { animation: none; }
  }
</style>
