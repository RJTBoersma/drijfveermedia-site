---
// Scène voor /cases/conflictbemiddeling/: een zoekvenster met "mediation opleiding". Het oranje resultaat schuift naar plek 1, ernaast twee mensen in gesprek.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een zoekvenster met de zoekopdracht mediation opleiding. Het oranje resultaat schuift naar de eerste plek en er verschijnt plus 47 procent bezoekers. Ernaast zitten twee mensen aan tafel in gesprek.'}>
  <rect x="24" y="26" width="300" height="214" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path class="l" d="M24 50h300" />
  <circle cx="40" cy="38" r="4" fill="#d9e1ea" /><circle cx="52" cy="38" r="4" fill="#d9e1ea" /><circle cx="64" cy="38" r="4" fill="#d9e1ea" />
  <rect x="44" y="62" width="260" height="28" rx="14" fill="#fff" stroke="#074663" stroke-width="2" />
  <text x="62" y="81" font-size="13" font-weight="700">mediation opleiding</text>
  <circle class="l" cx="282" cy="74" r="6" /><path class="l" d="M286 78l6 6" />
  <g>
    <rect class="v" x="52" y="108" width="150" height="9" rx="4" /><rect x="52" y="122" width="220" height="7" rx="3" fill="#eef2f6" />
    <rect class="v" x="52" y="150" width="170" height="9" rx="4" /><rect x="52" y="164" width="200" height="7" rx="3" fill="#eef2f6" />
    <rect class="v" x="52" y="192" width="130" height="9" rx="4" /><rect x="52" y="206" width="210" height="7" rx="3" fill="#eef2f6" />
  </g>
  <path class="l" d="M352 218h112" />
  <path class="l" d="M362 218v20M454 218v20" />
  <circle cx="372" cy="170" r="13" fill="#e8eef4" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M352 214c0-16 9-26 20-26s20 10 20 26" />
  <circle cx="444" cy="170" r="13" fill="#e8eef4" stroke="#074663" stroke-width="2.5" />
  <path class="l" d="M424 214c0-16 9-26 20-26s20 10 20 26" />
  <path d="M344 96h62a10 10 0 0 1 10 10v18a10 10 0 0 1-10 10h-40l-10 12v-12h-12a10 10 0 0 1-10-10v-18a10 10 0 0 1 10-10z" fill="#fff" stroke="#074663" stroke-width="2.5" stroke-linejoin="round" />
  <path class="v" d="M416 58h46a10 10 0 0 1 10 10v16a10 10 0 0 1-10 10h-6v11l-10-11h-30a10 10 0 0 1-10-10v-16a10 10 0 0 1 10-10z" />
  {!mini && (
    <g>
      <g class="cfb-top">
        <rect x="42" y="100" width="270" height="36" rx="9" fill="#fff4ec" stroke="#ff6600" stroke-width="2" />
        <rect x="52" y="108" width="150" height="9" rx="4" fill="#ff6600" />
        <rect x="52" y="122" width="200" height="7" rx="3" fill="#ffd2b0" />
        <text x="292" y="123" text-anchor="middle" font-size="13" font-weight="900" fill="#10283f">1</text>
      </g>
      <g class="cfb-badge">
        <rect x="196" y="216" width="138" height="36" rx="10" fill="#10283f" />
        <text x="265" y="239" text-anchor="middle" font-size="14" font-weight="800" style="fill:#fff">+47% bezoekers</text>
      </g>
      <g class="cfb-typen">
        <circle class="cfb-stip" style="--i:0" cx="364" cy="116" r="4" fill="#074663" />
        <circle class="cfb-stip" style="--i:1" cx="376" cy="116" r="4" fill="#074663" />
        <circle class="cfb-stip" style="--i:2" cx="388" cy="116" r="4" fill="#074663" />
      </g>
    </g>
  )}
</svg>
<style>
  :global(.teken-js) .cfb-top { opacity: 0; transform: translateY(84px); }
  .in-beeld .cfb-top { animation: cfb-omhoog 1.4s cubic-bezier(.5,0,.2,1) 0.5s forwards; }
  .cfb-badge { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .cfb-badge { opacity: 0; transform: scale(0.6); }
  .in-beeld .cfb-badge { animation: cfb-pop 0.6s cubic-bezier(.3,1.6,.5,1) 2s forwards; }
  .in-beeld .cfb-stip { animation: cfb-typ 4s ease-in-out calc(1s + var(--i) * 0.25s) infinite; }
  @keyframes cfb-omhoog { 0% { opacity: 1; transform: translateY(84px); } 35% { transform: translateY(84px); } 100% { opacity: 1; transform: none; } }
  @keyframes cfb-pop { to { opacity: 1; transform: none; } }
  @keyframes cfb-typ { 0%, 60%, 100% { opacity: 0.25; } 15% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .cfb-top, .in-beeld .cfb-badge, .in-beeld .cfb-stip { animation: none; } }
</style>
