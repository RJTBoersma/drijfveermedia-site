---
// Scène voor /kennisbank/gidsen/leads-genereren/: een trechter van bezoekers naar leads, afspraken en klanten,
// rechts de aantallen van deze maand (verzonnen voorbeeld). Als hij leeft: bezoekers vallen in de trechter,
// de meeste haken onderweg af, één komt er onderin uit als klant en er verschijnt +1.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const randL = (y: number) => 40 + (98 * (y - 40)) / 156;
const randR = (y: number) => 280 - (98 * (y - 40)) / 156;
const lagen = [
  { van: 40, tot: 79, kleur: '#e8eef4', tekst: 'Bezoekers', wit: false },
  { van: 79, tot: 118, kleur: '#c9d6e2', tekst: 'Leads', wit: false },
  { van: 118, tot: 157, kleur: '#8aa0b4', tekst: 'Afspraken', wit: true },
  { van: 157, tot: 196, kleur: '#074663', tekst: 'Klanten', wit: true },
];
const cijfers = [
  { n: '400', label: 'bezoekers' },
  { n: '24', label: 'leads' },
  { n: '9', label: 'afspraken' },
  { n: '4', label: 'nieuwe klanten' },
];
const vallers = [
  { x: 128, d: 44, i: 0 },
  { x: 192, d: 84, i: 1 },
  { x: 160, d: 196, i: 2 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een trechter van bezoekers naar leads, afspraken en klanten. Rechts staan de aantallen van een verzonnen maand: 400 bezoekers, 24 leads, 9 afspraken en 4 nieuwe klanten.'}>
  <!-- trechter -->
  {lagen.map((l) => (
    <g>
      <path d={`M${randL(l.van).toFixed(1)} ${l.van}H${randR(l.van).toFixed(1)}L${randR(l.tot).toFixed(1)} ${l.tot}H${randL(l.tot).toFixed(1)}z`} fill={l.kleur} stroke="#fff" stroke-width="2" />
      <text x="160" y={l.van + 24} font-size="11.5" font-weight="800" text-anchor="middle" style={l.wit ? 'fill:#fff' : undefined}>{l.tekst}</text>
    </g>
  ))}
  <rect x="149" y="196" width="22" height="16" fill="#074663" />
  <circle cx="160" cy="232" r="14" fill="#1a7a50" />
  <path d="M153.5 232l4.5 4.5 8.5-9" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

  <!-- aantallen -->
  <rect x="304" y="36" width="156" height="184" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="320" y="60" font-size="11.5" font-weight="800">Deze maand</text>
  {cijfers.map((c, i) => (
    <g>
      <text x="320" y={94 + i * 32} font-size="19" font-weight="900" style={i === 3 ? 'fill:#ff6600' : undefined}>{c.n}</text>
      <text x="362" y={93 + i * 32} font-size="10.5">{c.label}</text>
    </g>
  ))}
  <text x="320" y="208" font-size="9.5" class="zacht">verzonnen voorbeeld</text>

  {!mini && (
    <g>
      {vallers.map((v) => (
        <circle class="valler" cx={v.x} cy="22" r="6" fill="#ff6600" style={`--d:${v.d}px;--i:${v.i}`} />
      ))}
      <g class="plus">
        <rect x="184" y="221" width="38" height="22" rx="11" fill="#ff6600" />
        <text x="203" y="236" font-size="12" font-weight="900" text-anchor="middle" style="fill:#fff">+1</text>
      </g>
    </g>
  )}
</svg>
<style>
  .valler { transform-box: fill-box; transform-origin: center; }
  .plus { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .valler, :global(.teken-js) .plus { opacity: 0; }
  .in-beeld .valler { animation: kennisbank-gidsen-leads-genereren-val 4.8s ease-in infinite both; animation-delay: calc(0.4s + var(--i) * 0.7s); }
  .in-beeld .plus { animation: kennisbank-gidsen-leads-genereren-plus 4.8s ease-out 1.8s infinite both; }
  @keyframes kennisbank-gidsen-leads-genereren-val {
    0% { opacity: 0; transform: translateY(0) scale(1); }
    10% { opacity: 1; }
    55% { opacity: 1; transform: translateY(var(--d)) scale(0.8); }
    65%, 100% { opacity: 0; transform: translateY(var(--d)) scale(0.4); }
  }
  @keyframes kennisbank-gidsen-leads-genereren-plus {
    0%, 30% { opacity: 0; transform: translateY(6px) scale(0.6); }
    38% { opacity: 1; transform: scale(1.1); }
    44%, 70% { opacity: 1; transform: none; }
    85%, 100% { opacity: 0; transform: translateY(-6px); }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .valler, .in-beeld .plus { animation: none; } }
</style>
