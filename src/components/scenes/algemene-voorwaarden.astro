---
// Scène voor /algemene-voorwaarden/: een overzichtelijk document met genummerde artikelen. De vinkjes verschijnen een voor een, een pen zet steeds opnieuw een handtekening.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const rijen = [
  { y: 92, w: 150 },
  { y: 128, w: 128 },
  { y: 164, w: 142 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een document met genummerde artikelen. Achter elk artikel verschijnt een vinkje en een pen zet een handtekening onderaan.'}>
  <path class="l" d="M24 246h432" />
  <rect x="96" y="26" width="236" height="214" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="118" y="46" width="120" height="12" rx="6" fill="#10283f" />
  <rect class="v" x="118" y="64" width="80" height="7" rx="3.5" />
  {rijen.map((r, i) => (
    <g>
      <circle cx="128" cy={r.y + 4} r="11" fill="#e8eef4" />
      <text x="128" y={r.y + 9} text-anchor="middle" font-size="12" font-weight="900">{i + 1}</text>
      <rect class="v" x="148" y={r.y - 3} width={r.w} height="8" rx="4" />
      <rect x="148" y={r.y + 10} width={r.w - 30} height="6" rx="3" fill="#eef2f6" />
    </g>
  ))}
  <path class="l" d="M118 214h120" />
  <text x="118" y="230" font-size="10" class="zacht">Akkoord</text>
  <g transform="rotate(35 380 150)">
    <rect x="372" y="70" width="16" height="120" rx="4" fill="#fff" stroke="#074663" stroke-width="2.5" />
    <path class="o" d="M372 190h16l-8 20z" />
    <rect x="372" y="70" width="16" height="16" rx="4" fill="#074663" />
  </g>
  {!mini && (
    <g>
      {rijen.map((r, i) => (
        <g class="av-vink" style={`--i:${i}`}>
          <circle cx="310" cy={r.y + 4} r="11" fill="#1f8a5b" />
          <path d={`M304 ${r.y + 4}l4 4 8-8`} stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
      <path class="av-krabbel" d="M122 208c10-16 16-16 14 0s8-14 16-10 4 12 12 6 10-12 18-4 10 2 18-2" stroke="#ff6600" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
    </g>
  )}
</svg>
<style>
  .av-vink { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .av-vink { opacity: 0; transform: scale(0.4); }
  .in-beeld .av-vink { animation: algemene-voorwaarden-vink 0.5s cubic-bezier(.3,1.7,.5,1) calc(0.6s + var(--i) * 0.45s) forwards; }
  .av-krabbel { stroke-dasharray: 1; }
  :global(.teken-js) .av-krabbel { stroke-dashoffset: 1; }
  .in-beeld .av-krabbel { animation: algemene-voorwaarden-teken 5s ease-in-out 2s infinite both; }
  @keyframes algemene-voorwaarden-vink { to { opacity: 1; transform: none; } }
  @keyframes algemene-voorwaarden-teken { 0% { stroke-dashoffset: 1; opacity: 1; } 40%, 80% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .av-vink, .in-beeld .av-krabbel { animation: none; } }
</style>
