---
// Scène voor /online-adverteren/google-shopping/: een productfeed stuurt gegevens naar een rij productadvertenties in Google. Het product van jouw webshop licht op en er komt een bestelling binnen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const tegels = [
  { x: 150, prijs: '€ 79,95', winkel: 'Winkel A', jij: false },
  { x: 258, prijs: '€ 89,95', winkel: 'Jouw webshop', jij: true },
  { x: 366, prijs: '€ 94,00', winkel: 'Winkel B', jij: false },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een productfeed vult een rij productadvertenties in Google, met foto, prijs en winkelnaam. Het product van jouw webshop licht op en er komt een bestelling binnen.'}>
  <!-- zoekbalk -->
  <rect x="150" y="18" width="311" height="34" rx="17" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle class="l" cx="170" cy="34" r="6" />
  <path class="l" d="M175 39l5 5" />
  <text x="188" y="39" font-size="13" font-weight="700">wandelschoenen heren</text>
  <!-- productfeed -->
  <rect x="20" y="70" width="104" height="170" rx="10" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="32" y="92" font-size="11.5" font-weight="800">Productfeed</text>
  <g font-size="9.5" font-weight="700">
    <text x="32" y="116" class="zacht">titel</text>
    <text x="32" y="140" class="zacht">prijs</text>
    <text x="32" y="164" class="zacht">GTIN</text>
    <text x="32" y="188" class="zacht">foto</text>
    <text x="32" y="212" class="zacht">voorraad</text>
  </g>
  <rect class="v" x="70" y="108" width="42" height="10" rx="5" />
  <rect class="v" x="70" y="132" width="34" height="10" rx="5" />
  <rect class="v" x="70" y="156" width="42" height="10" rx="5" />
  <rect class="v" x="70" y="180" width="28" height="10" rx="5" />
  <rect class="v" x="80" y="204" width="32" height="10" rx="5" />
  <path class="a" d="M124 154c10 0 14-6 22-6" />
  <!-- productadvertenties -->
  {tegels.map((t) => (
    <g>
      <rect x={t.x} y="70" width="95" height="170" rx="10" fill="#fff" stroke={t.jij ? '#ff6600' : '#d9e1ea'} stroke-width={t.jij ? 3 : 2} />
      <rect x={t.x + 8} y="78" width="79" height="66" rx="7" fill="#e8eef4" />
      <path class="l" d={`M${t.x + 18} 128v-18q0-6 6-6h10q4 10 14 12l18 3q9 2 9 9v4h-57z`} style="fill:#fff" />
      <path class="l" d={`M${t.x + 18} 134h57`} />
      <rect class="v" x={t.x + 8} y="154" width="72" height="8" rx="4" />
      <rect class="v" x={t.x + 8} y="168" width="52" height="8" rx="4" />
      <text x={t.x + 8} y="198" font-size="14.5" font-weight="900">{t.prijs}</text>
      <text x={t.x + 8} y="222" font-size="10.5" font-weight="700" class={t.jij ? undefined : 'zacht'}>{t.winkel}</text>
    </g>
  ))}
  {!mini && (
    <g>
      <g class="stroom">
        <circle class="o stip stip-1" cx="0" cy="0" r="4" />
        <circle class="o stip stip-2" cx="0" cy="0" r="4" />
        <circle class="o stip stip-3" cx="0" cy="0" r="4" />
      </g>
      <g class="bestelling">
        <rect x="246" y="238" width="124" height="28" rx="9" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
        <circle cx="262" cy="252" r="7" fill="#1f8a5b" />
        <path d="M258.5 252l2.5 2.5 4.5-5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <text x="275" y="256.5" font-size="11.5" font-weight="800">Nieuwe bestelling</text>
      </g>
    </g>
  )}
</svg>
<style>
  .stip { transform: translate(124px, 154px); }
  :global(.teken-js) .stip { opacity: 0; }
  .in-beeld .stip-1 { animation: online-adverteren--google-shopping-stroom 3.6s linear 0.6s infinite; }
  .in-beeld .stip-2 { animation: online-adverteren--google-shopping-stroom 3.6s linear 1.8s infinite; }
  .in-beeld .stip-3 { animation: online-adverteren--google-shopping-stroom 3.6s linear 3s infinite; }
  :global(.teken-js) .bestelling { opacity: 0; }
  .in-beeld .bestelling { animation: online-adverteren--google-shopping-bestelling 7s ease-in-out 2s infinite both; }
  @keyframes online-adverteren--google-shopping-stroom { 0% { transform: translate(124px, 154px); opacity: 0; } 10% { opacity: 1; } 30% { transform: translate(160px, 140px); } 55% { transform: translate(205px, 114px); } 85% { opacity: 1; } 100% { transform: translate(300px, 110px); opacity: 0; } }
  @keyframes online-adverteren--google-shopping-bestelling { 0%, 20% { opacity: 0; transform: translateY(10px); } 30%, 85% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .stip-1, .in-beeld .stip-2, .in-beeld .stip-3, .in-beeld .bestelling { animation: none; } }
</style>
