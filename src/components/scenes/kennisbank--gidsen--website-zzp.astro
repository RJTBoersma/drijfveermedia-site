---
// Scène voor /kennisbank/gidsen/website-zzp/: de website van een zzp'er op een telefoon, met ernaast de checklist
// van wat erop moet. De vinkjes verschijnen een voor een en de belknop op de telefoon nodigt rustig uit.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const lijst = [
  { y: 82, t: 'Wat je doet en waar' },
  { y: 114, t: 'Je werk en reviews' },
  { y: 146, t: 'Over jou, met foto' },
  { y: 178, t: 'Bel- en mailknop' },
  { y: 210, t: 'KvK- en btw-nummer' },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: de website van een zzp-schilder op een telefoon, met ernaast een checklist van vijf onderdelen die een voor een worden afgevinkt.'}>
  <!-- telefoon -->
  <rect x="44" y="18" width="136" height="236" rx="22" fill="#10283f" />
  <rect x="52" y="30" width="120" height="212" rx="14" fill="#fff" />
  <rect x="96" y="36" width="32" height="5" rx="2.5" fill="#d9e1ea" />
  <circle cx="112" cy="76" r="20" fill="#e8eef4" />
  <circle cx="112" cy="70" r="7" fill="#074663" />
  <path d="M99 89c3-8 23-8 26 0" fill="#074663" />
  <text x="112" y="114" font-size="11" font-weight="800" text-anchor="middle">Sanne (voorbeeld)</text>
  <text x="112" y="128" font-size="9" font-weight="700" text-anchor="middle" class="zacht">Schilder in Hoogeveen</text>
  <rect x="64" y="140" width="96" height="6" rx="3" fill="#d9e1ea" />
  <rect x="64" y="152" width="80" height="6" rx="3" fill="#d9e1ea" />
  <rect class="v" x="64" y="166" width="44" height="30" rx="6" />
  <rect class="v" x="116" y="166" width="44" height="30" rx="6" />
  <path class="l" d="M70 190l9-10 7 6 6-5 10 9" />
  <path class="l" d="M122 190l9-10 7 6 6-5 10 9" />
  <g class={mini ? undefined : 'belknop'}>
    <rect x="64" y="208" width="96" height="24" rx="12" fill="#ff6600" />
    <path d="M86 214.5c-1 0-2 1-1.6 2.4 1.2 4 4.3 7 8.2 8.2 1.4.4 2.4-.6 2.4-1.6v-1.6l-3-1.4-1.4 1.4c-1.6-.7-3-2.1-3.7-3.7l1.4-1.4-1.4-3z" fill="#fff" />
    <text x="127" y="224" font-size="10.5" font-weight="800" text-anchor="middle" style="fill:#fff">Bel direct</text>
  </g>

  <!-- checklist -->
  <rect x="214" y="44" width="240" height="196" rx="14" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <text x="234" y="66" font-size="11" font-weight="800" class="zacht">Wat moet erop?</text>
  {lijst.map((r, i) => (
    <g>
      <rect x="234" y={r.y - 4} width="18" height="18" rx="5" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
      <text x="264" y={r.y + 9.5} font-size="12" font-weight="700">{r.t}</text>
      <path class={mini ? undefined : `vinkje vinkje${i}`} d={`M238 ${r.y + 5}l4 4 7-8`} fill="none" stroke="#1f8a5b" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  ))}
</svg>
<style>
  .vinkje, .belknop { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .vinkje { opacity: 0; transform: scale(0.3); }
  .in-beeld .vinkje0 { animation: kennisbank-gidsen-website-zzp-vink 0.45s cubic-bezier(.3,1.7,.5,1) 0.4s forwards; }
  .in-beeld .vinkje1 { animation: kennisbank-gidsen-website-zzp-vink 0.45s cubic-bezier(.3,1.7,.5,1) 0.8s forwards; }
  .in-beeld .vinkje2 { animation: kennisbank-gidsen-website-zzp-vink 0.45s cubic-bezier(.3,1.7,.5,1) 1.2s forwards; }
  .in-beeld .vinkje3 { animation: kennisbank-gidsen-website-zzp-vink 0.45s cubic-bezier(.3,1.7,.5,1) 1.6s forwards; }
  .in-beeld .vinkje4 { animation: kennisbank-gidsen-website-zzp-vink 0.45s cubic-bezier(.3,1.7,.5,1) 2s forwards; }
  .in-beeld .belknop { animation: kennisbank-gidsen-website-zzp-bel 4s ease-in-out 2.6s infinite; }
  @keyframes kennisbank-gidsen-website-zzp-vink { to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-website-zzp-bel { 0%, 70%, 100% { transform: none; } 78% { transform: scale(1.06) rotate(-2deg); } 86% { transform: scale(1.06) rotate(2deg); } 94% { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .vinkje0, .in-beeld .vinkje1, .in-beeld .vinkje2, .in-beeld .vinkje3, .in-beeld .vinkje4 { animation: none; opacity: 1; transform: none; }
    .in-beeld .belknop { animation: none; }
  }
</style>
