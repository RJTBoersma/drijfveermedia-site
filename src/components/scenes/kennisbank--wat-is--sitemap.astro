---
// Scène voor /kennisbank/wat-is/sitemap/: links een sitemapbestand met een lijst adressen, rechts de boomstructuur van de website.
// Als hij leeft: de regels in het bestand krijgen één voor één een vinkje en een stip loopt rustig langs de takken, zoals een crawler.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const regels = [72, 100, 128, 156, 184, 212];
const kinderen = [228, 300, 372];
const kleinkinderen = [214, 270, 358, 414];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een sitemapbestand met een lijst van pagina\'s naast de boomstructuur van een website, waar een crawler langs loopt.'}>
  <rect x="36" y="28" width="156" height="214" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <path d="M48 28h132a12 12 0 0 1 12 12v12H36V40a12 12 0 0 1 12-12z" fill="#10283f" />
  <text x="50" y="46" font-size="11" font-weight="700" font-family="ui-monospace, monospace" style="fill:#fff">sitemap.xml</text>
  {regels.map((y, i) => (
    <g>
      <rect x="50" y={y} width="12" height="14" rx="2" fill="none" stroke="#074663" stroke-width="1.6" />
      <rect class="v" x="70" y={y + 4} width={i % 3 === 0 ? 84 : 70 + (i % 2) * 8} height="6" rx="3" />
    </g>
  ))}

  <path class="l" d="M332 64V88M260 88H404M260 88V110M332 88V110M404 88V110M260 136V156M232 156H288M232 156V176M288 156V176M404 136V156M376 156H432M376 156V176M432 156V176" />
  <rect x="292" y="34" width="80" height="30" rx="8" fill="#074663" />
  <path d="M320 54v-8l12-8 12 8v8z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" />
  {kinderen.map((x) => <rect x={x} y="110" width="64" height="26" rx="7" fill="#fff" stroke="#074663" stroke-width="2" />)}
  {kinderen.map((x) => <rect class="v" x={x + 12} y="120" width="40" height="6" rx="3" />)}
  {kleinkinderen.map((x) => <rect x={x} y="176" width="36" height="22" rx="6" fill="#e8eef4" stroke="#d9e1ea" stroke-width="2" />)}

  {!mini && (
    <g>
      {regels.map((y, i) => (
        <g class="sitemap-vink" style={`animation-delay:${0.6 + i * 0.25}s`}>
          <circle cx="174" cy={y + 7} r="7" fill="#1a7a50" />
          <path d={`M170.5 ${y + 7}l2.5 2.5 4.5-5`} stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ))}
      <circle class="sitemap-stip" cx="332" cy="64" r="6" fill="#ff6600" />
    </g>
  )}
</svg>
<style>
  .sitemap-vink { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .sitemap-vink, :global(.teken-js) .sitemap-stip { opacity: 0; }
  .in-beeld .sitemap-vink { animation: kennisbank-wat-is-sitemap-vink 0.4s cubic-bezier(.3,1.6,.5,1) both; }
  .in-beeld .sitemap-stip { animation: kennisbank-wat-is-sitemap-loop 7s ease-in-out 2.4s infinite; }
  @keyframes kennisbank-wat-is-sitemap-vink { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  @keyframes kennisbank-wat-is-sitemap-loop {
    0% { opacity: 0; transform: translate(0, 0); }
    6% { opacity: 1; }
    14% { transform: translate(0, 24px); }
    26% { transform: translate(-72px, 24px); }
    34%, 42% { transform: translate(-72px, 46px); }
    52% { transform: translate(-72px, 24px); }
    68% { transform: translate(72px, 24px); }
    76%, 86% { transform: translate(72px, 46px); opacity: 1; }
    100% { transform: translate(72px, 46px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .in-beeld .sitemap-vink, .in-beeld .sitemap-stip { animation: none; } }
</style>
