---
// Scène voor /kennisbank/gidsen/meta-description/: een zoekresultaat waarin de omschrijving zich vult met een overtuigende tekst, waarna een cursor op het resultaat klikt.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een zoekresultaat in Google voor een dakkapel. Onder de titel verschijnt een duidelijke omschrijving, en een cursor klikt op het resultaat.'}>
  <!-- zoekbalk -->
  <rect x="40" y="26" width="400" height="32" rx="16" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle class="l" cx="62" cy="42" r="6" />
  <path class="l" d="M66.5 46.5l4 4" />
  <text x="80" y="47" font-size="13">dakkapel plaatsen kosten</text>

  <!-- zoekresultaat -->
  <rect x="40" y="72" width="400" height="128" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle class="v" cx="64" cy="96" r="10" />
  <text x="82" y="94" font-size="11" font-weight="700">Jouw bedrijf</text>
  <text class="zacht" x="82" y="107" font-size="10">jouwbedrijf.nl › dakkapel</text>
  <text x="58" y="134" font-size="15" font-weight="800" fill="#074663" style="fill:#074663">Dakkapel plaatsen: prijs en planning</text>
  <rect x="58" y="148" width="352" height="8" rx="4" fill="#e8eef4" />
  <rect x="58" y="164" width="318" height="8" rx="4" fill="#e8eef4" />
  <rect x="58" y="180" width="210" height="8" rx="4" fill="#e8eef4" />

  <!-- liniaal -->
  <path d="M58 222H410M58 216v12M146 218v8M234 218v8M322 218v8M410 216v12" fill="none" stroke="#b9c8d6" stroke-width="2" />
  <text class="zacht" x="234" y="248" font-size="11" text-anchor="middle">ruimte in pixels, niet in tekens</text>

  {!mini && (
    <g>
      <g class="omschrijving">
        <rect x="56" y="142" width="370" height="52" fill="#fff" />
        <text x="58" y="155" font-size="11">Wat kost een dakkapel? Prijzen per meter, de</text>
        <text x="58" y="171" font-size="11">doorlooptijd en een offerte binnen één werkdag.</text>
        <text x="58" y="187" font-size="11" font-weight="700">Bekijk de prijzen.</text>
      </g>
      <path class="vul" d="M58 222H330" fill="none" stroke="#1f8a5b" stroke-width="4" stroke-linecap="round" pathLength="1" />
      <g transform="translate(300 128)">
        <g class="cursor">
          <circle class="tik" cx="0" cy="0" r="12" fill="none" stroke="#ff6600" stroke-width="2.5" />
          <path d="M0 0v20l5-5 4 9 4-2-4-9h7z" fill="#10283f" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
        </g>
      </g>
    </g>
  )}
</svg>
<style>
  .vul { stroke-dasharray: 1; }
  .omschrijving { clip-path: inset(0 0 0 0); }
  .cursor, .tik { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .omschrijving { clip-path: inset(0 100% 0 0); }
  :global(.teken-js) .vul { stroke-dashoffset: 1; }
  :global(.teken-js) .cursor { opacity: 0; }
  :global(.teken-js) .tik { opacity: 0; }
  .in-beeld .omschrijving { animation: kennisbank--gidsen--meta-description-typ 1.6s steps(24, end) 0.5s forwards; }
  .in-beeld .vul { animation: kennisbank--gidsen--meta-description-vul 1.6s cubic-bezier(.6,.1,.3,1) 0.5s forwards; }
  .in-beeld .cursor { animation: kennisbank--gidsen--meta-description-wijs 5s ease-in-out 2.3s infinite; }
  .in-beeld .tik { animation: kennisbank--gidsen--meta-description-tik 5s ease-out 2.3s infinite; }
  @keyframes kennisbank--gidsen--meta-description-typ { to { clip-path: inset(0 0 0 0); } }
  @keyframes kennisbank--gidsen--meta-description-vul { to { stroke-dashoffset: 0; } }
  @keyframes kennisbank--gidsen--meta-description-wijs { 0% { opacity: 0; transform: translate(70px, 70px); } 15% { opacity: 1; } 40%, 80% { opacity: 1; transform: none; } 100% { opacity: 0; transform: none; } }
  @keyframes kennisbank--gidsen--meta-description-tik { 0%, 42% { opacity: 0; transform: scale(0.3); } 46% { opacity: 1; } 65%, 100% { opacity: 0; transform: scale(1.6); } }
  @media (prefers-reduced-motion: reduce) { .in-beeld .omschrijving, .in-beeld .vul, .in-beeld .cursor, .in-beeld .tik { animation: none; } }
</style>
