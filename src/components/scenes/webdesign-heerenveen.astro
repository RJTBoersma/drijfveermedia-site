---
// Scène voor /webdesign-heerenveen/: een website opgebouwd uit blokken (openingstijden, route, agenda, reserveren). Het laatste blok wordt erin geschoven. Op de achtergrond flats en een molen.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een website die is opgebouwd uit blokken voor openingstijden, route, agenda en reserveren. Het blok reserveren wordt op zijn plek geschoven. Op de achtergrond staan flats en een molen.'}>
  <!-- achtergrond: flats en molen -->
  <path class="l" d="M14 236H466" />
  <rect x="18" y="148" width="18" height="88" rx="2" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <rect x="40" y="140" width="18" height="96" rx="2" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <rect x="62" y="148" width="18" height="88" rx="2" fill="#e8eef4" stroke="#074663" stroke-width="2" />
  <path d="M23 160h8M23 172h8M23 184h8M23 196h8M45 152h8M45 164h8M45 176h8M45 188h8M67 160h8M67 172h8M67 184h8M67 196h8" stroke="#8aa0b4" stroke-width="2" />
  <path class="v" d="M101 236L106 196H118L123 236Z" />
  <path class="l" d="M101 236L106 196H118L123 236Z" />
  <g class="wdh-wieken">
    <path class="l" d="M112 186V160M112 186H138M112 186V212M112 186H86" style="stroke-width:2" />
    <path d="M113 162h6v20h-6zM116 187h20v6h-20zM105 190h6v20h-6zM88 179h20v6h-20z" fill="#fff" stroke="#074663" stroke-width="1.5" />
  </g>
  <circle cx="112" cy="186" r="3.5" fill="#074663" />
  <!-- browservenster -->
  <rect x="152" y="34" width="302" height="194" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <circle cx="170" cy="50" r="4" fill="#d9e1ea" />
  <circle cx="183" cy="50" r="4" fill="#d9e1ea" />
  <circle cx="196" cy="50" r="4" fill="#d9e1ea" />
  <rect x="212" y="43" width="226" height="14" rx="7" fill="#e8eef4" />
  <rect x="166" y="68" width="274" height="34" rx="6" fill="#074663" />
  <text x="180" y="90" font-size="13" font-weight="800" style="fill:#fff">Jouw zaak</text>
  <rect x="374" y="78" width="54" height="14" rx="7" fill="#fff" opacity="0.25" />
  <!-- blokken -->
  <g font-size="11" font-weight="800">
    <rect x="166" y="112" width="132" height="48" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
    <circle cx="186" cy="136" r="9" fill="none" stroke="#074663" stroke-width="2" />
    <path d="M186 130v6l4 3" fill="none" stroke="#074663" stroke-width="2" stroke-linecap="round" />
    <text x="202" y="140">Openingstijden</text>
    <rect x="308" y="112" width="132" height="48" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
    <path d="M320 132c0-6 4-10 9-10s9 4 9 10c0 7-9 15-9 15s-9-8-9-15z" fill="#ff6600" />
    <circle cx="329" cy="132" r="3" fill="#fff" />
    <text x="346" y="140">Route</text>
    <rect x="166" y="170" width="132" height="48" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="1.5" />
    <rect x="177" y="184" width="20" height="20" rx="3" fill="none" stroke="#074663" stroke-width="2" />
    <path d="M177 190h20M182 181v5M192 181v5" stroke="#074663" stroke-width="2" stroke-linecap="round" />
    <text x="206" y="198">Agenda</text>
    <rect x="308" y="170" width="132" height="48" rx="8" fill="#ff6600" />
    <text x="374" y="198" text-anchor="middle" style="fill:#fff">Reserveren</text>
  </g>
  {!mini && (
    <g>
      <rect class="wdh-gat" x="308" y="170" width="132" height="48" rx="8" fill="#fff" stroke="#d9e1ea" stroke-width="2" stroke-dasharray="6 5" />
      <g class="wdh-blok">
        <rect x="308" y="170" width="132" height="48" rx="8" fill="#ff6600" />
        <text x="374" y="198" text-anchor="middle" font-size="11" font-weight="800" style="fill:#fff">Reserveren</text>
        <path d="M410 200l0 16 4.5-4 3 7 3-1.4-3-6.8 6-.4z" fill="#10283f" stroke="#fff" stroke-width="1.2" />
      </g>
    </g>
  )}
</svg>
<style>
  .wdh-wieken { transform-box: view-box; transform-origin: 112px 186px; }
  .wdh-gat { opacity: 0; }
  :global(.teken-js) .wdh-gat { opacity: 1; }
  :global(.teken-js) .wdh-blok { transform: translate(30px, 40px); opacity: 0; }
  .in-beeld .wdh-wieken { animation: webdesign-heerenveen-wieken 8s linear infinite; }
  .in-beeld .wdh-blok { animation: webdesign-heerenveen-blok 1.3s cubic-bezier(.3,1.3,.5,1) 0.8s forwards; }
  .in-beeld .wdh-gat { animation: webdesign-heerenveen-gat 0.3s ease 2s forwards; }
  @keyframes webdesign-heerenveen-wieken { to { transform: rotate(360deg); } }
  @keyframes webdesign-heerenveen-blok {
    0% { transform: translate(30px, 40px); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: none; opacity: 1; }
  }
  @keyframes webdesign-heerenveen-gat { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .wdh-wieken { animation: none; }
    .in-beeld .wdh-blok, .in-beeld .wdh-gat { animation: none; }
  }
</style>
