---
// Scène voor /kennisbank/gidsen/google-trends/: een grafiek van 0 tot 100 met twee vergeleken zoektermen die elk jaar pieken,
// rechts een kaartje met de interesse per provincie in het Noorden.
// In de volledige versie springt het label "100" op bij de piek, lopen de provinciebalkjes vol en schuift een meetlijn rustig over de grafiek.
interface Props { mini?: boolean }
const { mini = false } = Astro.props;
const regio = [
  { y: 120, t: 'Drenthe', w: 70 },
  { y: 150, t: 'Friesland', w: 56 },
  { y: 180, t: 'Groningen', w: 44 },
];
---
<svg class="scene" viewBox="0 0 480 270" data-leeft={mini ? undefined : ''} role={mini ? undefined : 'img'} aria-hidden={mini ? 'true' : undefined} aria-label={mini ? undefined : 'Getekend: een grafiek van 0 tot 100 waarin twee zoektermen worden vergeleken. Ze pieken elk jaar in hetzelfde seizoen. Ernaast staat de interesse per provincie voor Drenthe, Friesland en Groningen.'}>
  <!-- grafiekkaart -->
  <rect x="22" y="30" width="300" height="214" rx="12" fill="#fff" stroke="#d9e1ea" stroke-width="2" />
  <rect x="36" y="44" width="92" height="22" rx="11" fill="#e8eef4" />
  <circle cx="48" cy="55" r="4" fill="#074663" />
  <text x="58" y="59" font-size="10" font-weight="800">warmtepomp</text>
  <rect x="136" y="44" width="68" height="22" rx="11" fill="#fff4ec" />
  <circle cx="148" cy="55" r="4" fill="#ff6600" />
  <text x="158" y="59" font-size="10" font-weight="800">airco</text>

  <text class="zacht" x="34" y="94" font-size="9">100</text>
  <text class="zacht" x="40" y="146" font-size="9">50</text>
  <text class="zacht" x="44" y="203" font-size="9">0</text>
  <path d="M58 90H306M58 143H306" stroke="#e8eef4" stroke-width="1.5" stroke-dasharray="3 4" />
  <path d="M58 200H306" stroke="#d9e1ea" stroke-width="2" />
  <text class="zacht" x="96" y="222" font-size="9">2025</text>
  <text class="zacht" x="222" y="222" font-size="9">2026</text>

  <path d="M58 190C84 188 98 96 122 92C146 96 162 188 184 190C208 188 222 94 246 90C268 96 284 186 306 188" fill="none" stroke="#074663" stroke-width="3.5" stroke-linecap="round" />
  <path d="M58 174C82 172 104 150 134 150C162 150 178 174 200 172C224 170 248 146 274 146C290 148 300 158 306 162" fill="none" stroke="#ff6600" stroke-width="3" stroke-linecap="round" />

  <!-- regiokaartje -->
  <rect x="338" y="82" width="122" height="122" rx="12" fill="#fff" stroke="#074663" stroke-width="2" />
  <text x="350" y="102" font-size="10" font-weight="800">Per provincie</text>
  {regio.map((r) => (
    <g>
      <text x="350" y={r.y - 2} font-size="9.5" font-weight="700">{r.t}</text>
      <rect x="350" y={r.y + 3} width="96" height="7" rx="3.5" fill="#e8eef4" />
    </g>
  ))}

  {mini ? (
    <g>
      {regio.map((r) => <rect x="350" y={r.y + 3} width={r.w * 1.3} height="7" rx="3.5" fill="#074663" />)}
      <circle cx="246" cy="90" r="5" fill="#074663" />
    </g>
  ) : (
    <g>
      {regio.map((r, i) => <rect class={`balk b${i}`} x="350" y={r.y + 3} width={r.w * 1.3} height="7" rx="3.5" fill="#074663" />)}
      <g class="meet">
        <path d="M122 76V200" stroke="#10283f" stroke-width="1.5" stroke-dasharray="3 3" />
        <circle cx="122" cy="92" r="5" fill="#fff" stroke="#074663" stroke-width="3" />
      </g>
      <g class="piek">
        <circle cx="246" cy="90" r="6" fill="#074663" />
        <rect x="226" y="62" width="40" height="20" rx="10" fill="#10283f" />
        <text x="236" y="76" font-size="10.5" font-weight="800" style="fill:#fff">100</text>
      </g>
    </g>
  )}
</svg>
<style>
  .balk { transform-box: fill-box; transform-origin: left center; }
  .piek { transform-box: fill-box; transform-origin: center bottom; }
  :global(.teken-js) .balk { transform: scaleX(0); }
  :global(.teken-js) .piek { opacity: 0; transform: translateY(6px); }
  .in-beeld .b0 { animation: kennisbank-gidsen-google-trends-groei 0.9s cubic-bezier(.6,.1,.3,1) 0.5s forwards; }
  .in-beeld .b1 { animation: kennisbank-gidsen-google-trends-groei 0.9s cubic-bezier(.6,.1,.3,1) 0.7s forwards; }
  .in-beeld .b2 { animation: kennisbank-gidsen-google-trends-groei 0.9s cubic-bezier(.6,.1,.3,1) 0.9s forwards; }
  .in-beeld .piek { animation: kennisbank-gidsen-google-trends-op 0.5s cubic-bezier(.3,1.6,.5,1) 1.4s forwards; }
  .in-beeld .meet { animation: kennisbank-gidsen-google-trends-schuif 7s ease-in-out 1.8s infinite; }
  @keyframes kennisbank-gidsen-google-trends-groei { to { transform: none; } }
  @keyframes kennisbank-gidsen-google-trends-op { to { opacity: 1; transform: none; } }
  @keyframes kennisbank-gidsen-google-trends-schuif { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(124px); } }
  @media (prefers-reduced-motion: reduce) {
    .in-beeld .balk, .in-beeld .piek, .in-beeld .meet { animation: none; opacity: 1; transform: none; }
  }
</style>
