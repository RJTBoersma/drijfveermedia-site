---
// Over ons: de vakantie in België. Dag 1 zon, dag 2 regen en praten, dag 3 de auto terug naar huis en de inschrijving.
---
<figure class="rit card">
  <svg class="scene" viewBox="0 0 600 250" data-teken role="img" aria-label="Getekend: in 2011 reden Robert en Evelien op dag drie van hun vakantie terug naar huis en schreven Drijfveer Media in.">
    <!-- tijdlijn bovenin -->
    <path class="l" pathLength="1" d="M40 42H560" />
    <circle class="o" cx="110" cy="42" r="6" /><circle class="o" cx="300" cy="42" r="6" /><circle class="o" cx="490" cy="42" r="6" />
    <text x="110" y="24" text-anchor="middle" font-weight="800" font-size="15">Dag 1</text>
    <text x="300" y="24" text-anchor="middle" font-weight="800" font-size="15">Dag 2</text>
    <text x="490" y="24" text-anchor="middle" font-weight="800" font-size="15">Dag 3</text>
    <!-- dag 1: zon -->
    <circle class="a" pathLength="1" cx="110" cy="92" r="16" />
    <path class="a" pathLength="1" d="M110 64v-8M110 128v-8M82 92h-8M146 92h-8M90 72l-6-6M136 118l-6-6M130 72l6-6M84 118l6-6" />
    <!-- dag 2: wolk, regen en twee tekstballonnen -->
    <path class="v" d="M270 104a16 16 0 0 1 4-31 22 22 0 0 1 42 4 14 14 0 0 1 2 27z" />
    <path class="l" pathLength="1" d="M270 104a16 16 0 0 1 4-31 22 22 0 0 1 42 4 14 14 0 0 1 2 27z" />
    <path class="l regen" pathLength="1" d="M282 114l-4 10M298 114l-4 10M314 114l-4 10" />
    <path class="o" d="M340 70h34a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6h-22l-8 7v-7h-4a6 6 0 0 1-6-6V76a6 6 0 0 1 6-6z" />
    <text x="357" y="86" text-anchor="middle" font-weight="900" font-size="12" fill="#10283f">Hmm</text>
    <!-- dag 3: huis met inschrijving -->
    <path class="v" d="M470 200v-60l40-30 40 30v60z" />
    <path class="l" pathLength="1" d="M462 146l48-38 48 38M470 200v-60M550 200v-60M498 200v-28h24v28" />
    <g class="papier">
      <path class="v" d="M520 96h44v54h-44z" style="fill:#fff" />
      <path class="l" pathLength="1" d="M520 96h44v54h-44zM528 108h28M528 116h28M528 124h18" />
      <circle class="o" cx="552" cy="138" r="10" />
      <text x="552" y="142" text-anchor="middle" font-weight="900" font-size="8" fill="#10283f">2011</text>
    </g>
    <!-- weg -->
    <path class="l" pathLength="1" d="M20 200H580" />
    <path class="a" pathLength="1" d="M40 214h30M100 214h30M160 214h30M220 214h30M280 214h30M340 214h30M400 214h30" />
    <!-- bordje België -->
    <path class="l" pathLength="1" d="M60 200v-50" />
    <ellipse class="v" cx="60" cy="140" rx="24" ry="16" style="fill:#fff" />
    <ellipse class="l" pathLength="1" cx="60" cy="140" rx="24" ry="16" />
    <text x="60" y="146" text-anchor="middle" font-weight="900" font-size="17">B</text>
    <!-- de auto -->
    <g class="auto">
      <path class="o" d="M96 186l10-22h44l14 22h12a6 6 0 0 1 6 6v8H86v-8a6 6 0 0 1 6-6z" />
      <path class="v" d="M112 168h14v16h-22zM132 168h14l10 16h-24z" style="fill:#fff" />
      <circle cx="108" cy="200" r="9" fill="#10283f" /><circle cx="160" cy="200" r="9" fill="#10283f" />
      <circle cx="108" cy="200" r="3" fill="#fff" /><circle cx="160" cy="200" r="3" fill="#fff" />
    </g>
  </svg>
  <figcaption class="klein muted">Dag 1 zon, dag 2 regen en plannen maken, dag 3 terug naar huis en ingeschreven.</figcaption>
</figure>
<style>
  .rit { margin: 28px 0; padding: 20px 20px 14px; overflow: hidden; }
  .auto { transform: translateX(270px); }
  :global(.teken-js) .auto { transform: none; transition: transform 2.8s cubic-bezier(.5,0,.2,1) 1.6s; }
  :global(.teken-js) :global(.in-beeld) .auto { transform: translateX(270px); }
  :global(.teken-js) .papier { opacity: 0; transform: translateY(10px) rotate(-6deg); transform-box: fill-box; transition: all 0.6s cubic-bezier(.3,1.6,.5,1) 4.4s; }
  :global(.teken-js) :global(.in-beeld) .papier { opacity: 1; transform: none; }
  :global(.in-beeld) .regen { animation: regen 0.9s linear 1.4s infinite; }
  @keyframes regen { to { transform: translateY(6px); opacity: 0.2; } }
  figcaption { margin-top: 8px; }
  @media (prefers-reduced-motion: reduce) { :global(.in-beeld) .regen { animation: none; } }
</style>
