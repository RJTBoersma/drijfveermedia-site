---
// Gratis scan: een website waar een scanlijn overheen gaat. Per regel verschijnt een vinkje of een verbeterpunt.
const regels = [
  { y: 92, w: 190, ok: true },
  { y: 128, w: 230, ok: false },
  { y: 164, w: 170, ok: true },
  { y: 200, w: 210, ok: false },
  { y: 236, w: 150, ok: true },
];
---
<figure class="scanner card">
  <svg class="scene" viewBox="0 0 420 290" data-teken role="img" aria-label="Getekend: een website wordt regel voor regel nagekeken, met vinkjes en verbeterpunten.">
    <path class="v" d="M20 20h380v250H20z" style="fill:#fff" />
    <path class="l" pathLength="1" d="M20 20h380v250H20zM20 52h380" />
    <circle class="o" cx="38" cy="36" r="5" /><circle class="o" cx="54" cy="36" r="5" style="opacity:.5" />
    <path class="v" d="M80 28h240a8 8 0 0 1 0 16H80a8 8 0 0 1 0-16z" />
    {regels.map((r, i) => (
      <g class="regel" style={`--i:${i}`}>
        <path class="v" d={`M48 ${r.y - 9}h${r.w}a9 9 0 0 1 0 18H48a9 9 0 0 1 0-18z`} />
        {r.ok ? (
          <g class="merk"><circle cx="356" cy={r.y} r="13" fill="#1f8a5b" /><path d={`M349 ${r.y}l5 5 9-10`} stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
        ) : (
          <g class="merk"><circle cx="356" cy={r.y} r="13" fill="#ff6600" /><path d={`M356 ${r.y - 7}v8M356 ${r.y + 6}v.5`} stroke="#10283f" stroke-width="3.2" fill="none" stroke-linecap="round" /></g>
        )}
      </g>
    ))}
    <g class="balk"><rect x="20" y="0" width="380" height="4" fill="#ff6600" /><rect x="20" y="4" width="380" height="26" fill="url(#gloed)" /></g>
    <defs><linearGradient id="gloed" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#ff6600" stop-opacity=".25" /><stop offset="1" stop-color="#ff6600" stop-opacity="0" /></linearGradient></defs>
  </svg>
  <figcaption class="klein muted">Groen klopt, oranje kan beter. Je hoort de drie belangrijkste.</figcaption>
</figure>
<style>
  .scanner { margin: 0; padding: 16px; box-shadow: 0 24px 60px -30px rgb(7 70 99 / 0.4); }
  .balk { opacity: 0; }
  :global(.in-beeld) .balk { animation: scan 3.6s ease-in-out 0.9s infinite; }
  @keyframes scan { 0% { transform: translateY(60px); opacity: 0; } 8% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(250px); opacity: 0; } }
  .merk { transform-box: fill-box; transform-origin: center; }
  :global(.teken-js) .merk { opacity: 0; transform: scale(0.4); transition: all 0.4s cubic-bezier(.3,1.7,.5,1); transition-delay: calc(1.2s + var(--i) * 0.55s); }
  :global(.teken-js) :global(.in-beeld) .merk { opacity: 1; transform: none; }
  figcaption { margin-top: 8px; }
  @media (prefers-reduced-motion: reduce) { :global(.in-beeld) .balk { animation: none; } }
</style>
