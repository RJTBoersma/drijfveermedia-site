---
// Contact: een getekend stukje Assen met de route naar ons kantoor en een kop koffie die klaarstaat.
---
<figure class="route card">
  <svg class="scene" viewBox="0 0 440 250" data-teken role="img" aria-label="Getekende route naar Lauwers 9 in Assen, met koffie die klaarstaat.">
    <rect width="440" height="250" rx="12" fill="#e9eef3" />
    <path d="M300 0c-10 60 10 120 0 250" stroke="#fff" stroke-width="22" fill="none" />
    <path d="M0 70c120 10 240-20 440 0" stroke="#fff" stroke-width="12" fill="none" />
    <path d="M0 170c100-20 200 30 300 10s100-20 140-10" stroke="#fff" stroke-width="10" fill="none" />
    <path d="M150 0c10 80-20 160 10 250" stroke="#fff" stroke-width="8" fill="none" />
    <rect x="30" y="96" width="80" height="50" rx="8" fill="#d7e6d8" />
    <rect x="330" y="190" width="80" height="44" rx="8" fill="#d7e6d8" />
    <rect x="292" y="12" width="34" height="18" rx="4" fill="#10283f" />
    <text x="309" y="25" text-anchor="middle" font-size="11" font-weight="800" style="fill:#fff">A28</text>
    <path class="a" pathLength="1" d="M300 250c2-30 2-50 0-80-40 4-80-6-120-2-14 2-20 10-22 22" stroke-dasharray="1" style="stroke-width:4" />
    <g class="speld">
      <path d="M158 150c0-12 9-20 20-20s20 8 20 20c0 14-20 32-20 32s-20-18-20-32z" fill="#ff6600" />
      <circle cx="178" cy="150" r="7" fill="#fff" />
    </g>
    <g transform="translate(206 112)">
      <rect width="96" height="30" rx="8" fill="#fff" stroke="#d9e1ea" />
      <text x="48" y="20" text-anchor="middle" font-size="13" font-weight="800">Lauwers 9</text>
    </g>
    <g transform="translate(60 182) scale(0.8)" class="kop">
      <path class="v" d="M12 28h34v14a14 14 0 0 1-14 14h-6a14 14 0 0 1-14-14z" style="fill:#fff" />
      <path class="l" pathLength="1" d="M12 28h34v14a14 14 0 0 1-14 14h-6a14 14 0 0 1-14-14zM46 32h4a6 6 0 0 1 0 12h-5" />
      <path class="a stoom" pathLength="1" d="M22 8c-4 5 4 8 0 13M32 6c-4 5 4 8 0 13M42 8c-4 5 4 8 0 13" />
    </g>
  </svg>
  <figcaption class="klein muted">Getekend, niet op schaal. Bel even van tevoren, dan staat de koffie klaar.</figcaption>
</figure>
<style>
  .route { margin: 24px 0; padding: 14px; }
  .speld { transform-box: fill-box; transform-origin: 50% 100%; }
  :global(.teken-js) .speld { opacity: 0; transform: translateY(-24px); transition: all 0.6s cubic-bezier(.3,1.6,.5,1) 1.4s; }
  :global(.teken-js) :global(.in-beeld) .speld { opacity: 1; transform: none; }
  :global(.in-beeld) .route-ring { animation: ring 2s ease-out 2s infinite; }
  figcaption { margin-top: 8px; }
</style>
