---
import LinkNaarTool from './LinkNaarTool.astro';
// "Hoeveel marketingbudget heb je nodig?" Terugrekenen vanaf de klant: brutowinst per klant, het deel daarvan dat een nieuwe klant
// mag kosten, hoeveel aanvragen klant worden en hoeveel klanten je erbij wilt. Uitkomst: maximaal per klant, per aanvraag, per maand en per jaar.
// Optioneel de jaaromzet: dan zie je het budget ook als percentage van de omzet, naast de vuistregel van 5 tot 10 procent
// en het gemiddelde van 7,8 procent uit de Gartner CMO Spend Survey 2026 (vooral grote bedrijven, zie de bronnen op de gids).
import { site } from '../../data/site';
interface Props { id?: string; kop?: 'h2' | 'h3' }
const { id = 'budget-rekenhulp', kop = 'h3' } = Astro.props;
const Kop = kop;
---
<div class="tool card" id={id} data-mbudget>
  <p class="kicker">Rekenhulp · Marketingbudget</p>
  <Kop class="titel">Hoeveel mag je marketing kosten?</Kop>
  <p class="intro muted">Vul in wat een klant je oplevert en hoeveel klanten je erbij wilt. Je ziet wat een nieuwe klant en een aanvraag mogen kosten, en welk budget daarbij hoort.</p>

  <form class="velden" novalidate>
    <div class="veld">
      <label for={`${id}-winst`}>Brutowinst per nieuwe klant</label>
      <span class="invoer"><span class="voor" aria-hidden="true">€</span><input id={`${id}-winst`} name="w" inputmode="decimal" autocomplete="off" value="750" /></span>
    </div>
    <div class="veld">
      <label for={`${id}-klanten`}>Extra klanten per maand</label>
      <input id={`${id}-klanten`} name="k" inputmode="decimal" autocomplete="off" value="6" />
    </div>
    <div class="veld">
      <label for={`${id}-deel`}>Deel van de winst dat een klant mag kosten</label>
      <span class="invoer"><input id={`${id}-deel`} name="d" inputmode="decimal" autocomplete="off" value="30" /><span class="na" aria-hidden="true">%</span></span>
    </div>
    <div class="veld">
      <label for={`${id}-conv`}>Aanvragen die klant worden</label>
      <span class="invoer"><input id={`${id}-conv`} name="c" inputmode="decimal" autocomplete="off" value="25" /><span class="na" aria-hidden="true">%</span></span>
    </div>
    <div class="veld breed">
      <label for={`${id}-omzet`}>Jaaromzet (mag leeg blijven)</label>
      <span class="invoer"><span class="voor" aria-hidden="true">€</span><input id={`${id}-omzet`} name="o" inputmode="decimal" autocomplete="off" value="" placeholder="bijvoorbeeld 400.000" /></span>
    </div>
  </form>

  <p class="sr-only" aria-live="polite" data-meld></p>
  <div class="uitkomst" data-uit>
    <p class="leeg">Zo reken je het zelf: brutowinst per klant maal het deel dat een klant mag kosten, is je maximum per klant. Vermenigvuldig dat met het aantal klanten dat je erbij wilt, dan heb je je budget per maand. Zet JavaScript aan om het hier uit te laten rekenen.</p>
  </div>

  <div class="acties">
    <a class="btn" href="/contact/" data-cta>Vraag {site.contactpersoon} wat jouw budget oplevert</a>
  </div>
  <p class="bron klein muted">Alle bedragen exclusief btw. De standaardwaarden zijn een verzonnen voorbeeld: vul je eigen cijfers in. Het gemiddelde van 7,8 procent komt uit de Gartner CMO Spend Survey 2026 (<a href="#bronnen">bronnen</a>).</p>
  <LinkNaarTool naam="marketingbudget-rekenhulp" href="/kennisbank/gidsen/marketingbudget/" />
</div>

<script>
  const eur = (n: number) => '€ ' + Math.round(n).toLocaleString('nl-NL');
  const gt = (n: number, d = 0) => n.toLocaleString('nl-NL', { maximumFractionDigits: d });
  const getal = (s: string) => {
    let t = s.trim().replace(/[€%\s]/g, '');
    if (t === '') return NaN;
    if (t.includes(',')) t = t.replace(/\./g, '').replace(',', '.');
    else if (/^\d{1,3}(\.\d{3})+$/.test(t)) t = t.replace(/\./g, '');
    const n = parseFloat(t);
    return Number.isFinite(n) ? n : NaN;
  };
  const tel = (stap: string) => { try { if (location.hostname === 'www.drijfveermedia.nl') navigator.sendBeacon('/api/teller.php', JSON.stringify({ p: `/_tool/marketingbudget/${stap}`, r: '' })); (window as unknown as { dmMeet?: (n: string, p: object) => void }).dmMeet?.('tool_gebruikt', { tool: 'marketingbudget', stap }); } catch {} };

  document.querySelectorAll<HTMLElement>('[data-mbudget]').forEach((el) => {
    const form = el.querySelector('form')!;
    const uit = el.querySelector<HTMLElement>('[data-uit]')!;
    const cta = el.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const meld = el.querySelector<HTMLElement>('[data-meld]')!;
    const veld = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const foutId = `${el.id}-fout`;
    let gebruikt = false;
    let geteld = false;
    const zeg = (t: string) => { if (gebruikt) meld.textContent = t; };
    const markeer = (fout: string[]) => ['w', 'k', 'd', 'c', 'o'].forEach((n) => {
      const v = veld(n);
      if (fout.includes(n)) { v.setAttribute('aria-invalid', 'true'); v.setAttribute('aria-describedby', foutId); }
      else { v.removeAttribute('aria-invalid'); v.removeAttribute('aria-describedby'); }
    });

    const reken = () => {
      const winst = getal(veld('w').value), klanten = getal(veld('k').value), deel = getal(veld('d').value), conv = getal(veld('c').value);
      const omzetTekst = veld('o').value.trim();
      const omzet = omzetTekst === '' ? NaN : getal(omzetTekst);
      const fouten: [string, string][] = [];
      if (!(winst > 0) || winst > 10000000) fouten.push(['w', 'Brutowinst per klant: vul een bedrag groter dan nul in.']);
      if (!(klanten > 0) || klanten > 10000) fouten.push(['k', 'Extra klanten: vul een aantal groter dan nul in.']);
      if (!(deel > 0) || deel > 100) fouten.push(['d', 'Deel van de winst: vul een percentage tussen 0 en 100 in.']);
      if (!(conv > 0) || conv > 100) fouten.push(['c', 'Aanvragen die klant worden: vul een percentage tussen 0 en 100 in.']);
      if (omzetTekst !== '' && !(omzet > 0)) fouten.push(['o', 'Jaaromzet: vul een bedrag in of laat het veld leeg.']);
      markeer(fouten.map(([f]) => f));
      if (fouten.length) {
        uit.innerHTML = `<p class="leeg fout" id="${foutId}">${fouten.map(([, t]) => t).join(' ')}</p>`;
        zeg(fouten.map(([, t]) => t).join(' '));
        return;
      }
      const perKlant = winst * deel / 100;
      const perAanvraag = perKlant * conv / 100;
      const aanvragen = klanten / (conv / 100);
      const perMaand = perKlant * klanten;
      const perJaar = perMaand * 12;
      let pct = '';
      if (omzet > 0) {
        const p = perJaar / omzet * 100;
        const oordeel = p > 15
          ? 'Dat is veel. Het kan als je snel wilt groeien en je marges het toelaten. Begin dan klein en schaal op wat bewezen werkt.'
          : p > 10
            ? 'Dat is meer dan de vuistregel van 5 tot 10 procent. Prima als je wilt groeien en elke klant het waard is.'
            : p >= 5
              ? 'Dat valt binnen de vuistregel van 5 tot 10 procent.'
              : p >= 3
                ? 'Dat is iets minder dan de vuistregel van 5 tot 10 procent. Met goede marges en een duidelijk doel kan dat prima.'
                : 'Dat is weinig. Prima als je vooral via via groeit. Reken er alleen niet op dat je hiermee een nieuwe markt opent.';
        pct = `<p class="uitleg">Per jaar is dat <b>${gt(p, 1)} procent</b> van je omzet van ${eur(omzet)}. ${oordeel} Grote bedrijven besteedden in 2026 gemiddeld 7,8 procent.</p>`;
      }
      const kop = `Ongeveer ${eur(perMaand)} per maand`;
      zeg(`${kop}. Een nieuwe klant mag ${eur(perKlant)} kosten, een aanvraag ${eur(perAanvraag)}.`);
      uit.innerHTML = `
        <p class="oordeel">${kop}</p>
        <dl class="getallen-rij">
          <div><dt>Per nieuwe klant</dt><dd>${eur(perKlant)}</dd></div>
          <div><dt>Per aanvraag</dt><dd>${eur(perAanvraag)}</dd></div>
          <div><dt>Aanvragen nodig</dt><dd>${gt(Math.ceil(aanvragen))} per maand</dd></div>
          <div><dt>Per jaar</dt><dd>${eur(perJaar)}</dd></div>
        </dl>
        <p class="uitleg">Voor ${gt(klanten, 1)} extra klanten per maand heb je ongeveer ${gt(Math.ceil(aanvragen))} aanvragen nodig, als ${gt(conv, 1)} procent daarvan klant wordt. Kost een aanvraag je meer dan ${eur(perAanvraag)}, dan kost de klant je meer dan je wilde.</p>
        ${pct}
        <p class="klein muted">Dit is het totale budget: advertenties, werk van een bureau of freelancer, tools en de waarde van je eigen uren samen.</p>`;
      const vraag = `Ik wil ongeveer ${gt(klanten, 1)} klanten per maand erbij en heb zo'n ${eur(perMaand)} per maand. Wat kan Thorgall daarmee doen?`;
      const context = `Marketingbudget-rekenhulp: brutowinst ${eur(winst)} per klant, ${gt(deel, 1)}% mag naar marketing, ${gt(conv, 1)}% van de aanvragen wordt klant, ${gt(klanten, 1)} klanten per maand erbij.`;
      cta.href = `/contact/?${new URLSearchParams({ soort: 'Uitslag tool', vraag, context })}`;
      if (!geteld && gebruikt) { geteld = true; tel('uitkomst'); }
    };

    let wacht: number | undefined;
    form.addEventListener('input', () => { gebruikt = true; clearTimeout(wacht); wacht = window.setTimeout(reken, 250); });
    form.addEventListener('submit', (e) => { e.preventDefault(); reken(); });
    reken();
  });
</script>

<style>
  .tool { margin: 28px 0; padding: clamp(20px, 4vw, 32px); border: 2px solid var(--navy); box-shadow: 0 30px 70px -40px rgb(7 70 99 / 0.5); max-width: 100%; min-width: 0; }
  .titel { font-weight: 750; font-size: var(--step-1); line-height: 1.2; margin: 4px 0 8px; }
  .intro { margin: 0 0 18px; max-width: 60ch; }
  .velden { display: grid; align-items: end; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); margin-bottom: 18px; }
  .velden .breed { grid-column: 1 / -1; }
  .veld label { font-size: 0.95rem; }
  .veld input { min-height: 48px; width: 100%; }
  .invoer { position: relative; display: flex; align-items: center; }
  .invoer input { width: 100%; }
  .invoer .voor, .invoer .na { position: absolute; color: var(--muted); font-weight: 700; pointer-events: none; }
  .invoer .voor { left: 14px; }
  .invoer .na { right: 14px; }
  .invoer .voor + input { padding-left: 32px; }
  .uitkomst { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-bottom: 16px; min-width: 0; }
  .uitkomst :global(p) { margin: 0 0 10px; }
  .uitkomst :global(p:last-child) { margin-bottom: 0; }
  .uitkomst :global(.leeg) { color: var(--muted); }
  .uitkomst :global(.leeg.fout) { color: #b3261e; font-weight: 600; }
  .uitkomst :global(.oordeel) { font-weight: 800; font-size: 1.25rem; line-height: 1.25; color: var(--navy); }
  .uitkomst :global(.getallen-rij) { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr)); margin: 14px 0; }
  .uitkomst :global(.getallen-rij div) { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .uitkomst :global(dt) { font-size: 0.85rem; color: var(--muted); line-height: 1.3; }
  .uitkomst :global(dd) { margin: 4px 0 0; font-size: 1.2rem; font-weight: 800; color: var(--navy); letter-spacing: -0.02em; }
  .acties { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
  .acties .btn { min-height: 48px; text-align: center; }
  .bron { margin: 0; }
</style>
