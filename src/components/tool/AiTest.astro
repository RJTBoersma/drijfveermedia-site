---
// "Noemt AI jou?" De bezoeker vult vak, plaats en bedrijfsnaam in. De tool maakt vijf vragen zoals klanten ze stellen,
// opent elke vraag met één klik in ChatGPT, Perplexity, Copilot of de AI-modus van Google, en geeft na het afvinken een score
// met de drie belangrijkste verbeterpunten. Alles gebeurt in de browser: er gaan geen gegevens naar ons of naar een API.
// Later kan dezelfde tool overstappen op echte API-antwoorden (route 1), zonder dat de pagina verandert.
// De uitslag is deelbaar: #ai-test&vak=...&plaats=...&score=... (zonder bedrijfsnaam). Wie zo'n link opent, ziet de score en kan zelf de test doen.
// "Test ook een concurrent" start opnieuw met hetzelfde vak en dezelfde plaats.
interface Props { id?: string }
const { id = 'ai-test' } = Astro.props;
---
<section class="wrap sectie" id={id}>
  <div class="ai-test card" data-ai-test>
    <div class="kop">
      <p class="kicker">Gratis test · vijf minuten</p>
      <h2>Noemt AI jou? Test het zelf</h2>
      <p class="muted">Vul in wat je doet en waar. Je krijgt vijf vragen zoals je klanten ze stellen. Eén klik opent de vraag in een AI-assistent. Jij kijkt of je genoemd wordt. Wat je invult, blijft in je eigen browser.</p>
    </div>

    <form class="stap stap-1" data-stap="1">
      <div class="veld-rij">
        <div class="veld"><label for={`${id}-vak`}>Wat doe je?</label><input id={`${id}-vak`} name="vak" required placeholder="Bijvoorbeeld: loodgieter" autocomplete="off" /></div>
        <div class="veld"><label for={`${id}-plaats`}>In welke plaats?</label><input id={`${id}-plaats`} name="plaats" required placeholder="Bijvoorbeeld: Emmen" autocomplete="address-level2" /></div>
        <div class="veld"><label for={`${id}-naam`}>Je bedrijfsnaam</label><input id={`${id}-naam`} name="naam" required placeholder="Bijvoorbeeld: Installatiebedrijf Jansen" autocomplete="organization" /></div>
      </div>
      <p class="klein muted concurrent-tip" data-concurrent-tip hidden></p>
      <button class="btn" type="submit">Maak mijn vijf vragen</button>
    </form>

    <p class="sr-only" aria-live="polite" data-meld></p>
    <div class="stap stap-2" data-stap="2" hidden>
      <h3 class="sr-only" tabindex="-1" data-stap2-kop>Je vijf vragen</h3>
      <ol class="vragen" data-vragen></ol>
      <p class="klein melding" data-ontbreekt hidden></p>
      <p class="klein muted tip">Tip: open de assistent in een privévenster, dan telt je eigen zoekgeschiedenis niet mee. Gemini en Claude? Kopieer de vraag en plak hem daar.</p>
      <div class="acties">
        <button class="btn" type="button" data-uitslag>Bekijk mijn score</button>
        <button class="btn-tekst" type="button" data-opnieuw>Andere gegevens</button>
      </div>
    </div>

    <div class="stap stap-3" data-stap="3" hidden>
      <div class="uitslag">
        <div class="meter" data-meter style="--score:0"><span data-score>0</span><small>van 100</small></div>
        <div>
          <h3 data-oordeel tabindex="-1"></h3>
          <p data-uitleg></p>
        </div>
      </div>
      <p class="gedeeld" data-gedeeld hidden></p>
      <h3 class="punten-kop" data-eigen>Hier zit je winst</h3>
      <ol class="punten" data-punten data-eigen></ol>
      <div class="acties">
        <a class="btn" data-cta href="/generative-engine-optimization/ai-vindbaarheidsanalyse/#aanvragen">Laat Thorgall het gratis nakijken</a>
        <button class="btn btn-ghost" type="button" data-zelf hidden>Doe de test zelf</button>
      </div>
      <p class="tekstacties" data-eigen>
        <button class="btn-tekst" type="button" data-deel>Deel je uitslag</button><span aria-hidden="true">·</span>
        <button class="btn-tekst" type="button" data-concurrent>Test ook een concurrent</button><span aria-hidden="true">·</span>
        <button class="btn-tekst" type="button" data-terug>Terug naar de vragen</button>
      </p>
      <p class="klein muted deel-status" data-deel-status role="status"></p>
      <p class="klein muted">De gratis analyse gaat verder dan deze test: we stellen de vragen meerdere keren, in vijf assistenten, en kijken welke websites AI als bron gebruikt.</p>
    </div>
    <noscript><p class="klein">Deze test werkt met JavaScript. Wil je dat wij kijken? Vraag de <a href="/generative-engine-optimization/ai-vindbaarheidsanalyse/">gratis AI-vindbaarheidsanalyse</a> aan.</p></noscript>
  </div>
</section>

<script>
  type Antwoord = 'eerst' | 'genoemd' | 'nee' | '';
  const OPSLAG = 'dm-ai-test';
  const assistenten = [
    { naam: 'ChatGPT', url: (q: string) => `https://chatgpt.com/?q=${encodeURIComponent(q)}` },
    { naam: 'Perplexity', url: (q: string) => `https://www.perplexity.ai/search?q=${encodeURIComponent(q)}` },
    { naam: 'Copilot', url: (q: string) => `https://copilot.microsoft.com/?q=${encodeURIComponent(q)}` },
    { naam: 'Google AI-modus', url: (q: string) => `https://www.google.com/search?udm=50&q=${encodeURIComponent(q)}` },
  ];
  // Vijf vragen zoals klanten ze stellen: drie lokale zoekvragen, een prijsvraag en een vraag naar je merk.
  const vragenVoor = (vak: string, plaats: string, naam: string) => [
    { soort: 'lokaal', q: `Welke ${vak} in ${plaats} raad je aan?` },
    { soort: 'lokaal', q: `Ik zoek een betrouwbare ${vak} in de buurt van ${plaats}. Wie kan ik het beste bellen?` },
    { soort: 'vergelijk', q: `Wat is de best beoordeelde ${vak} rond ${plaats}, en waarom?` },
    { soort: 'prijs', q: `Wat kost een ${vak} in ${plaats} ongeveer, en welke bedrijven geven een eerlijke prijs?` },
    { soort: 'merk', q: `Wat weet je over ${naam} in ${plaats}? Is het een goede keuze?` },
  ];
  const punten: Record<string, string> = {
    lokaal: 'AI kent je nog niet als aanrader in je eigen plaats. Zorg dat je Google Bedrijfsprofiel en Bing Places volledig zijn, verzamel reviews en maak een pagina die duidelijk zegt wat je doet en waar.',
    vergelijk: 'Bij vergelijkingsvragen leunt AI op reviews en op sites die bedrijven vergelijken. Vraag tevreden klanten om een review en zorg dat je op de vergelijkingssites in je vak staat.',
    prijs: 'Op prijsvragen noemt AI de bedrijven die er zelf helder over zijn. Zet op je site wat een klus ongeveer kost en waar dat van afhangt.',
    merk: 'AI weet weinig over je bedrijf zelf. Vermeldingen op andere sites, een over-ons-pagina met feiten en structured data helpen AI om je te herkennen.',
    eerst: 'Je wordt wel genoemd, maar niet als eerste. Meer vermeldingen in je regio en antwoorden op de vragen van klanten op je site schuiven je omhoog.',
    goed: 'Je wordt al vaak genoemd. Houd het vast: meet elk kwartaal met dezelfde vragen en kijk of concurrenten inlopen.',
  };
  const oordeelVoor = (score: number) => (score >= 70 ? 'AI noemt je vaak' : score >= 30 ? 'AI kent je, maar niet overal' : 'AI noemt je (nog) niet');
  const uitlegVoor = (score: number, vak: string, plaats: string) => score >= 70
    ? `Bij de meeste vragen over ${vak} in ${plaats} kom je in beeld. Dat hebben weinig bedrijven.`
    : score >= 30
      ? `Bij een deel van de vragen kom je in beeld. Bij de rest gaat de klant naar een ander.`
      : `Wie AI vraagt naar een ${vak} in ${plaats}, krijgt nu andere namen. Dat is goed te verbeteren.`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const lees = () => { try { return JSON.parse(localStorage.getItem(OPSLAG) || 'null'); } catch { return null; } };
  const bewaar = (d: unknown) => { try { localStorage.setItem(OPSLAG, JSON.stringify(d)); } catch {} };
  const tel = (stap: string) => { try { if (location.hostname === 'www.drijfveermedia.nl') navigator.sendBeacon('/api/teller.php', JSON.stringify({ p: `/_tool/ai-test/${stap}`, r: '' })); } catch {} };

  document.querySelectorAll<HTMLElement>('[data-ai-test]').forEach((el) => {
    const stappen = [...el.querySelectorAll<HTMLElement>('[data-stap]')];
    const toon = (n: number) => { stappen.forEach((s) => (s.hidden = s.dataset.stap !== String(n))); };
    // Na elke stap gaat de focus naar het begin van die stap, en een schermlezer hoort wat er gebeurde (WCAG 2.4.3, 4.1.3)
    const meld = el.querySelector<HTMLElement>('[data-meld]')!;
    const zeg = (t: string) => { meld.textContent = ''; setTimeout(() => (meld.textContent = t), 60); };
    const ontbreekt = el.querySelector<HTMLElement>('[data-ontbreekt]')!;
    const form = el.querySelector<HTMLFormElement>('.stap-1')!;
    const lijst = el.querySelector<HTMLOListElement>('[data-vragen]')!;
    let staat: { vak: string; plaats: string; naam: string; antwoorden: Antwoord[] } = { vak: '', plaats: '', naam: '', antwoorden: [] };
    let laatsteScore = -1;
    const id = el.closest('section')?.id || 'ai-test';
    const deelStatus = el.querySelector<HTMLElement>('[data-deel-status]')!;
    const tip = el.querySelector<HTMLElement>('[data-concurrent-tip]')!;
    const veld = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const deelLink = (score: number) => {
      const p = new URLSearchParams();
      p.set(id, ''); p.set('vak', staat.vak); p.set('plaats', staat.plaats); p.set('score', String(score));
      return `${location.origin}${location.pathname}#${p.toString().replace(`${id}=`, id)}`;
    };
    const wisHash = () => { if (new URLSearchParams(location.hash.slice(1)).has(id)) { try { history.replaceState(null, '', location.pathname + location.search); } catch {} } };
    // Toont de uitslag. Bij een gedeelde link (gedeeld = true) kennen we alleen vak, plaats en score: dan geen persoonlijke verbeterpunten.
    const toonUitslag = (score: number, gedeeld: boolean, lijstPunten: string[] = []) => {
      el.querySelector('[data-score]')!.textContent = String(score);
      el.querySelector<HTMLElement>('[data-meter]')!.style.setProperty('--score', String(score));
      el.querySelector('[data-oordeel]')!.textContent = oordeelVoor(score);
      el.querySelector('[data-uitleg]')!.textContent = uitlegVoor(score, staat.vak, staat.plaats);
      el.querySelector('[data-punten]')!.innerHTML = lijstPunten.slice(0, 3).map((p) => `<li>${esc(p)}</li>`).join('');
      el.querySelectorAll<HTMLElement>('[data-eigen]').forEach((x) => (x.hidden = gedeeld));
      el.querySelector<HTMLElement>('[data-zelf]')!.hidden = !gedeeld;
      const g = el.querySelector<HTMLElement>('[data-gedeeld]')!;
      g.hidden = !gedeeld;
      g.textContent = gedeeld ? `Dit is een gedeelde uitslag voor een ${staat.vak} in ${staat.plaats}. Doe de test zelf met je eigen bedrijfsnaam, dan zie je ook waar jouw winst zit.` : '';
      el.querySelector<HTMLAnchorElement>('[data-cta]')!.href = `/generative-engine-optimization/ai-vindbaarheidsanalyse/?vak=${encodeURIComponent(staat.vak)}&plaats=${encodeURIComponent(staat.plaats)}&context=${encodeURIComponent(`AI-test: score ${score} van 100 (${oordeelVoor(score)})`)}#aanvragen`;
      deelStatus.textContent = '';
      laatsteScore = gedeeld ? -1 : score;
      toon(3);
    };

    const bouwVragen = () => {
      const vragen = vragenVoor(staat.vak, staat.plaats, staat.naam);
      lijst.innerHTML = vragen.map((v, i) => `
        <li class="vraag" data-i="${i}">
          <p class="q">${esc(v.q)}</p>
          <div class="open">${assistenten.map((a) => `<a href="${a.url(v.q)}" target="_blank" rel="noopener">${a.naam}</a>`).join('')}<button type="button" class="kopieer" data-q="${esc(v.q)}">Kopieer</button></div>
          <fieldset class="keuze keuze-pil"><legend>Werd ${esc(staat.naam)} genoemd?</legend>
            ${[['eerst', 'Ja, als eerste'], ['genoemd', 'Ja, maar niet als eerste'], ['nee', 'Nee']].map(([w, t]) => `<label><input type="radio" name="v${i}" value="${w}" ${staat.antwoorden[i] === w ? 'checked' : ''}> ${t}</label>`).join('')}
          </fieldset>
        </li>`).join('');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const nieuw = { vak: String(f.get('vak')).trim().toLowerCase(), plaats: String(f.get('plaats')).trim(), naam: String(f.get('naam')).trim() };
      const zelfde = nieuw.vak === staat.vak && nieuw.plaats === staat.plaats && nieuw.naam === staat.naam;
      staat = { ...nieuw, antwoorden: zelfde ? staat.antwoorden : [] };
      bewaar(staat); bouwVragen(); toon(2); tel('vragen'); tip.hidden = true; wisHash(); ontbreekt.hidden = true;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      el.querySelector<HTMLElement>('[data-stap2-kop]')!.focus({ preventScroll: true });
      zeg('Je vijf vragen staan klaar. Open elke vraag in een AI-assistent en kies of je genoemd werd.');
    });

    lijst.addEventListener('change', (e) => {
      const r = e.target as HTMLInputElement;
      const i = Number(r.closest<HTMLElement>('.vraag')?.dataset.i);
      staat.antwoorden[i] = r.value as Antwoord; bewaar(staat);
    });
    lijst.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.kopieer');
      if (!b) return;
      try { await navigator.clipboard.writeText(b.dataset.q || ''); b.textContent = 'Gekopieerd'; zeg('De vraag staat op je klembord.'); setTimeout(() => (b.textContent = 'Kopieer'), 1600); } catch { b.textContent = 'Selecteer en kopieer'; }
    });

    el.querySelector('[data-uitslag]')!.addEventListener('click', () => {
      const vragen = vragenVoor(staat.vak, staat.plaats, staat.naam);
      const ingevuld = staat.antwoorden.filter(Boolean).length;
      if (ingevuld < vragen.length) {
        // Niet alleen een kleur: een zin die zegt welke vraag nog open staat, en de focus op die vraag (WCAG 3.3.1, 1.4.1)
        const open = vragen.map((_, i) => i).filter((i) => !staat.antwoorden[i]);
        const eerste = lijst.querySelector<HTMLElement>(`.vraag:nth-child(${open[0] + 1})`);
        const tekst = open.length === 1 ? `Vraag ${open[0] + 1} heeft nog geen antwoord.` : `De vragen ${open.slice(0, -1).map((i) => i + 1).join(', ')} en ${open[open.length - 1] + 1} hebben nog geen antwoord.`;
        ontbreekt.textContent = `${tekst} Kies bij elke vraag of je genoemd werd.`;
        ontbreekt.hidden = false;
        zeg(tekst);
        eerste?.classList.add('let-op'); eerste?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        eerste?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
        setTimeout(() => eerste?.classList.remove('let-op'), 1800);
        return;
      }
      ontbreekt.hidden = true;
      const waarde = { eerst: 2, genoemd: 1, nee: 0, '': 0 };
      const score = Math.round((staat.antwoorden.reduce((s, a) => s + waarde[a], 0) / (vragen.length * 2)) * 100);
      // Verbeterpunten: eerst de soorten vragen waar je niet genoemd werd, dan de vragen waar je niet bovenaan stond
      const gemist = [...new Set(vragen.filter((_, i) => staat.antwoorden[i] === 'nee').map((v) => v.soort))];
      const lijstPunten = gemist.map((s) => punten[s]);
      if (lijstPunten.length < 3 && staat.antwoorden.includes('genoemd')) lijstPunten.push(punten.eerst);
      if (!lijstPunten.length) lijstPunten.push(punten.goed);
      toonUitslag(score, false, lijstPunten);
      tel('score'); el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      el.querySelector<HTMLElement>('[data-oordeel]')!.focus({ preventScroll: true });
      zeg(`Je score is ${score} van 100: ${oordeelVoor(score)}.`);
    });
    el.querySelector('[data-opnieuw]')!.addEventListener('click', () => { toon(1); veld('vak').focus(); });
    el.querySelector('[data-terug]')!.addEventListener('click', () => { toon(2); el.querySelector<HTMLElement>('[data-stap2-kop]')!.focus(); });
    el.querySelector('[data-deel]')!.addEventListener('click', async () => {
      if (laatsteScore < 0) return;
      const link = deelLink(laatsteScore);
      try { await navigator.clipboard.writeText(link); deelStatus.textContent = 'De link naar je uitslag staat op je klembord. Je bedrijfsnaam zit er niet in.'; }
      catch { window.prompt('Kopieer deze link:', link); }
    });
    // Opnieuw beginnen met hetzelfde vak en dezelfde plaats: eerst de naam van een concurrent invullen.
    const opnieuwMet = (concurrent: boolean) => {
      const eigenScore = laatsteScore;
      veld('vak').value = staat.vak; veld('plaats').value = staat.plaats;
      if (concurrent) veld('naam').value = '';
      tip.hidden = !concurrent;
      tip.textContent = concurrent ? `Vul de naam van een concurrent in. Vak en plaats blijven staan${eigenScore >= 0 ? `, zodat je zijn score kunt vergelijken met jouw ${eigenScore}` : ''}.` : '';
      staat = { ...staat, naam: veld('naam').value.trim(), antwoorden: [] };
      wisHash(); toon(1);
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      veld('naam').focus({ preventScroll: true });
    };
    el.querySelector('[data-concurrent]')!.addEventListener('click', () => opnieuwMet(true));
    el.querySelector('[data-zelf]')!.addEventListener('click', () => opnieuwMet(false));

    // Terugkerende bezoeker: gegevens staan al klaar
    const oud = lees();
    if (oud?.vak) {
      staat = { antwoorden: [], ...oud };
      (form.elements.namedItem('vak') as HTMLInputElement).value = staat.vak;
      (form.elements.namedItem('plaats') as HTMLInputElement).value = staat.plaats;
      (form.elements.namedItem('naam') as HTMLInputElement).value = staat.naam;
    }

    // Gedeelde uitslag: #ai-test&vak=...&plaats=...&score=...
    const h = new URLSearchParams(location.hash.slice(1));
    const gedeeldeScore = Number(h.get('score'));
    if (h.has(id) && h.get('vak') && h.get('plaats') && h.get('score') !== null && Number.isInteger(gedeeldeScore) && gedeeldeScore >= 0 && gedeeldeScore <= 100) {
      staat = { vak: (h.get('vak') || '').slice(0, 60).toLowerCase(), plaats: (h.get('plaats') || '').slice(0, 60), naam: '', antwoorden: [] };
      veld('vak').value = staat.vak; veld('plaats').value = staat.plaats;
      toonUitslag(gedeeldeScore, true);
      el.scrollIntoView({ block: 'start' });
    }
  });
</script>

<style>
  .ai-test { padding: clamp(22px, 4vw, 40px); border: 2px solid var(--navy); box-shadow: 0 30px 70px -40px rgb(7 70 99 / 0.5); }
  .ai-test.card { border-color: var(--navy); }
  .kop { max-width: 62ch; margin-bottom: 22px; }
  .kop h2 { margin: 6px 0 10px; }
  .stap-1 .btn { margin-top: 6px; }
  .vragen { list-style: none; counter-reset: v; padding: 0; margin: 0 0 14px; display: grid; gap: 12px; }
  .vragen :global(.vraag) { counter-increment: v; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; transition: box-shadow 0.2s; }
  .vragen :global(.vraag.let-op) { box-shadow: 0 0 0 3px var(--orange); }
  .vragen :global(.q) { font-weight: 800; margin: 0 0 10px; }
  .vragen :global(.q)::before { content: counter(v) '. '; color: var(--orange-tekst); }
  .vragen :global(.open) { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .vragen :global(.open a), .vragen :global(.kopieer) { font: inherit; font-size: 0.92rem; font-weight: 700; color: var(--navy); background: #fff; border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent); border-radius: 999px; padding: 5px 12px; text-decoration: none; cursor: pointer; }
  .vragen :global(.open a:hover), .vragen :global(.kopieer:hover) { border-color: var(--navy); }
  .vragen :global(.open a)::after { content: ' ↗'; font-weight: 400; }
  .vragen :global(.keuze > legend) { font-size: 0.85rem; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
  .tekstacties { display: flex; flex-wrap: wrap; align-items: center; gap: 0 10px; margin: 0 0 6px; color: var(--muted); }
  .melding { margin: 0 0 12px; padding: 10px 14px; border-radius: 10px; background: var(--tint); border: 1px solid #ffd6b8; color: var(--ink); font-weight: 600; }
  [data-oordeel]:focus, [data-stap2-kop]:focus { outline: none; }
  [data-oordeel]:focus-visible { outline: 3px solid var(--navy); outline-offset: 4px; }
  .tip { margin: 0 0 16px; }
  .acties { display: flex; flex-wrap: wrap; gap: 12px; margin: 8px 0 14px; }
  .uitslag { display: grid; grid-template-columns: auto 1fr; gap: 24px; align-items: center; margin-bottom: 18px; }
  .uitslag h3 { margin: 0 0 6px; }
  .uitslag p { margin: 0; color: var(--muted); }
  .meter { --score: 0; width: 132px; aspect-ratio: 1; border-radius: 50%; display: grid; place-content: center; text-align: center;
    background: radial-gradient(closest-side, var(--panel) 78%, transparent 79% 100%), conic-gradient(var(--orange) calc(var(--score) * 1%), var(--chip) 0); }
  .meter span { font-size: 2.4rem; font-weight: 800; line-height: 1; color: var(--ink); }
  .meter small { color: var(--muted); font-size: 0.85rem; }
  .punten-kop { font-size: 1.15rem; margin: 6px 0 8px; }
  .gedeeld { background: var(--tint); border: 1px solid #ffd6b8; border-radius: 10px; padding: 12px 14px; margin: 0 0 14px; }
  .deel-status { min-height: 1.4em; margin: 0 0 8px; }
  .concurrent-tip { margin: 0; }
  .punten { padding-left: 1.2em; margin: 0 0 12px; display: grid; gap: 8px; }
  .punten :global(li::marker) { color: var(--orange); font-weight: 800; }
  @media (max-width: 560px) { .uitslag { grid-template-columns: 1fr; justify-items: start; } .meter { width: 112px; } }
</style>
