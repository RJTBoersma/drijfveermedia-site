---
// Website-prijs en terugverdientijd. Aantal pagina's, eigen ontwerp ja/nee, teksten, logo en twee extra's.
// Uitkomst: de route die past (website met AI of maatwerk in WordPress) met de vanaf-prijs uit STRUCTUUR.md en
// "na X klussen terugverdiend" op basis van wat één klus oplevert.
// Prijzen (vanaf, excl. btw, uit scripts/briefing/STRUCTUUR.md): website met AI € 250, maatwerk in WordPress € 2.000,
// teksten € 75 per pagina, logo € 495, Google Bedrijfsprofiel + Bing + Apple € 249, onderhoud WordPress € 39 per maand.
// Een afsprakenplanner of koppeling staat niet in STRUCTUUR.md met een prijs, dus die rekent de tool niet.
// De grens van tien pagina's voor de AI-route is een vuistregel ("een compacte site"); de precieze grens volgt uit het gesprek.
interface Props {
  id?: string;
  plaats?: string; // gaat mee naar het contactformulier (?plaats=)
  paginas?: number;
  ontwerp?: boolean; // eigen ontwerp rond je merk
  teksten?: boolean; // wij schrijven de teksten
  logo?: boolean; // logo nodig
  profiel?: boolean;
  onderhoud?: boolean;
  marge?: number; // wat één klus oplevert
}
const { id = 'website-prijs', plaats, paginas = 5, ontwerp = false, teksten = true, logo = false, profiel = false, onderhoud = false, marge = 600 } = Astro.props;
---
<div class="tool card" id={id} data-website-prijs data-plaats={plaats}>
  <p class="kicker">Rekenhulp · Website</p>
  <p class="titel">Wat kost jouw website, en wanneer verdien je hem terug?</p>
  <p class="intro muted">Vul in wat je nodig hebt. Je ziet welke route past, de vanaf-prijs en na hoeveel klussen de site betaald is.</p>

  <form class="velden" novalidate>
    <div class="veld">
      <label for={`${id}-pag`}>Hoeveel pagina's?</label>
      <input id={`${id}-pag`} name="p" inputmode="numeric" autocomplete="off" value={paginas} />
    </div>
    <div class="veld">
      <label for={`${id}-marge`}>Wat houd je over aan één klus?</label>
      <span class="invoer"><span class="voor" aria-hidden="true">€</span><input id={`${id}-marge`} name="m" inputmode="decimal" autocomplete="off" value={marge} /></span>
    </div>
    <fieldset class="breed keuzes">
      <legend>Ontwerp</legend>
      <label><input type="radio" name="o" value="0" checked={!ontwerp} /> Een strakke, beproefde opzet</label>
      <label><input type="radio" name="o" value="1" checked={ontwerp} /> Een eigen ontwerp rond mijn merk</label>
    </fieldset>
    <fieldset class="breed keuzes">
      <legend>Teksten</legend>
      <label><input type="radio" name="t" value="0" checked={!teksten} /> Lever ik zelf aan</label>
      <label><input type="radio" name="t" value="1" checked={teksten} /> Schrijven jullie (€ 75 per pagina)</label>
    </fieldset>
    <fieldset class="breed keuzes">
      <legend>Logo</legend>
      <label><input type="radio" name="l" value="0" checked={!logo} /> Heb ik al</label>
      <label><input type="radio" name="l" value="1" checked={logo} /> Heb ik nog niet (€ 495)</label>
    </fieldset>
    <fieldset class="breed keuzes">
      <legend>Extra</legend>
      <label><input type="checkbox" name="g" value="1" checked={profiel} /> Google Bedrijfsprofiel, Bing en Apple inrichten (€ 249)</label>
      <label><input type="checkbox" name="u" value="1" checked={onderhoud} /> Onderhoud: updates, back-ups en beveiliging (€ 39 per maand)</label>
    </fieldset>
  </form>

  <div class="uitkomst" aria-live="polite" data-uit>
    <p class="leeg">Zo reken je het zelf: een website met AI begint bij € 250, maatwerk in WordPress bij € 2.000. Tel er € 75 per pagina bij als wij de teksten schrijven en € 495 voor een logo. Deel het totaal door wat je aan één klus overhoudt, dan weet je na hoeveel klussen de site terugverdiend is.</p>
  </div>

  <div class="acties">
    <a class="btn" href={plaats ? `/contact/?plaats=${encodeURIComponent(plaats)}` : '/contact/'} data-cta>Vraag een vaste prijs aan</a>
    <button class="btn btn-ghost deel" type="button" data-deel hidden>Kopieer link naar deze uitkomst</button>
  </div>
  <p class="bron klein muted">Onze vanaf-prijzen, exclusief btw. Een afsprakenplanner of koppeling met je software rekenen we hier niet mee; die prijs hoor je in het gesprek. Hosting regel je zelf, meestal een paar euro per maand.</p>
</div>

<script>
  const PRIJS = { ai: 250, maatwerk: 2000, tekst: 75, logo: 495, profiel: 249, onderhoud: 39 };
  const MAX_AI = 10; // vuistregel: tot ongeveer tien pagina's past de snelle route
  const eur = (n: number) => '€ ' + Math.round(n).toLocaleString('nl-NL');
  const getal = (s: string) => {
    let t = s.trim().replace(/[€%\s]/g, '');
    if (t.includes(',')) t = t.replace(/\./g, '').replace(',', '.');
    else if (/^\d{1,3}(\.\d{3})+$/.test(t)) t = t.replace(/\./g, '');
    const n = parseFloat(t);
    return Number.isFinite(n) ? n : NaN;
  };
  const tel = (stap: string) => { try { if (location.hostname === 'www.drijfveermedia.nl') navigator.sendBeacon('/api/teller.php', JSON.stringify({ p: `/_tool/website-prijs/${stap}`, r: '' })); } catch {} };

  document.querySelectorAll<HTMLElement>('[data-website-prijs]').forEach((el) => {
    const form = el.querySelector('form')!;
    const uit = el.querySelector<HTMLElement>('[data-uit]')!;
    const cta = el.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const deel = el.querySelector<HTMLButtonElement>('[data-deel]')!;
    const plaats = el.dataset.plaats;
    const tekst = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const keuze = (n: string) => form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value === '1';
    const zet = (n: string, aan: boolean) => form.querySelectorAll<HTMLInputElement>(`input[name="${n}"]`).forEach((i) => { i.checked = i.type === 'checkbox' ? aan : (i.value === '1') === aan; });
    let geteld = false;

    const q = new URLSearchParams(location.search);
    if (q.has('w_p')) tekst('p').value = q.get('w_p')!.slice(0, 4);
    if (q.has('w_m')) tekst('m').value = q.get('w_m')!.slice(0, 12);
    ['o', 't', 'l', 'g', 'u'].forEach((n) => { const v = q.get(`w_${n}`); if (v === '0' || v === '1') zet(n, v === '1'); });

    const reken = () => {
      const pag = Math.round(getal(tekst('p').value));
      const marge = getal(tekst('m').value);
      if (!(pag >= 1 && pag <= 200) || !(marge > 0)) {
        uit.innerHTML = '<p class="leeg">Vul een aantal pagina\'s (1 tot 200) en een bedrag per klus in.</p>';
        return;
      }
      const o = keuze('o'), t = keuze('t'), l = keuze('l'), g = keuze('g'), u = keuze('u');
      const maatwerk = o || pag > MAX_AI;
      const posten = (route: 'ai' | 'maatwerk') => [
        [route === 'ai' ? 'Website met AI' : 'Maatwerk in WordPress', PRIJS[route]],
        ...(t ? [[`Teksten voor ${pag} pagina's (€ 75 per pagina)`, pag * PRIJS.tekst]] : []),
        ...(l ? [['Logo', PRIJS.logo]] : []),
        ...(g ? [['Google Bedrijfsprofiel, Bing en Apple', PRIJS.profiel]] : []),
      ] as [string, number][];
      const eenmalig = (route: 'ai' | 'maatwerk') => posten(route).reduce((s, [, b]) => s + b, 0);
      const route = maatwerk ? 'maatwerk' : 'ai';
      const totaal = eenmalig(route);
      const jaar = totaal + (u ? 12 * PRIJS.onderhoud : 0);
      const klussen = Math.max(1, Math.ceil(jaar / marge));
      const ander = maatwerk ? 'ai' : 'maatwerk';
      const anderKlussen = Math.max(1, Math.ceil((eenmalig(ander) + (u ? 12 * PRIJS.onderhoud : 0)) / marge));
      const waarom = maatwerk
        ? (o ? 'Je wilt een eigen ontwerp rond je merk. Dat is maatwerk.' : `Met ${pag} pagina's past maatwerk meestal beter dan de compacte route met AI.`)
        : 'Een compacte site met een beproefde opzet: de snelle route met AI past. Vaak staat hij er binnen twee weken.';
      const naam = maatwerk ? 'Maatwerk in WordPress' : 'Website met AI';
      uit.innerHTML = `
        <p class="oordeel ruim"><span class="stip" aria-hidden="true"></span>${naam}: vanaf ${eur(totaal)}${u ? ` plus ${eur(PRIJS.onderhoud)} per maand` : ''}</p>
        <p class="uitleg">${waarom}</p>
        <ul class="posten">${posten(route).map(([n, b]) => `<li><span>${n}</span><b>${eur(b)}</b></li>`).join('')}${u ? `<li><span>Onderhoud, eerste jaar (12 × € 39)</span><b>${eur(12 * PRIJS.onderhoud)}</b></li>` : ''}<li class="som"><span>${u ? 'Eerste jaar samen' : 'Samen, eenmalig'}</span><b>${eur(jaar)}</b></li></ul>
        <dl class="getallen-rij">
          <div><dt>Terugverdiend na</dt><dd>${klussen} ${klussen === 1 ? 'klus' : 'klussen'}</dd></div>
          <div><dt>${maatwerk ? 'Met de AI-route' : 'Met maatwerk'}</dt><dd>${anderKlussen} ${anderKlussen === 1 ? 'klus' : 'klussen'}</dd></div>
        </dl>
        <p class="klein muted">Bij ${eur(marge)} per klus. ${maatwerk ? `De route met AI begint bij ${eur(eenmalig('ai'))} met dezelfde keuzes.` : `Maatwerk zou met dezelfde keuzes vanaf ${eur(eenmalig('maatwerk'))} kosten.`} Na een kort gesprek krijg je een vaste prijs.</p>`;
      const vraag = `Vaste prijs voor een website: ${naam.toLowerCase()}, ${pag} pagina's${t ? ', teksten door jullie' : ''}${l ? ', logo' : ''}${g ? ', bedrijfsprofiel' : ''}${u ? ', onderhoud' : ''}. Indicatie vanaf ${eur(totaal).replace(' ', ' ')}.`;
      const cq = new URLSearchParams();
      if (plaats) cq.set('plaats', plaats);
      cq.set('vraag', vraag);
      cta.href = `/contact/?${cq}`;
      const p = new URLSearchParams(location.search);
      p.set('w_p', String(pag)); p.set('w_m', tekst('m').value.trim());
      [['o', o], ['t', t], ['l', l], ['g', g], ['u', u]].forEach(([n, v]) => p.set(`w_${n}`, v ? '1' : '0'));
      history.replaceState(null, '', `${location.pathname}?${p}${location.hash}`);
      if (!geteld) { geteld = true; tel('uitkomst'); }
    };

    let wacht: number | undefined;
    form.addEventListener('input', () => { clearTimeout(wacht); wacht = window.setTimeout(reken, 250); });
    form.addEventListener('change', reken);
    form.addEventListener('submit', (e) => { e.preventDefault(); reken(); });
    deel.hidden = false;
    deel.addEventListener('click', async () => {
      const link = `${location.origin}${location.pathname}${location.search}#${el.id}`;
      try { await navigator.clipboard.writeText(link); deel.textContent = 'Link gekopieerd'; }
      catch { window.prompt('Kopieer deze link', link); }
      setTimeout(() => (deel.textContent = 'Kopieer link naar deze uitkomst'), 2000);
    });
    reken();
  });
</script>

<style>
  .tool { margin: 28px 0; padding: clamp(20px, 4vw, 32px); border: 2px solid var(--navy); box-shadow: 0 30px 70px -40px rgb(7 70 99 / 0.5); max-width: 100%; }
  .titel { font-weight: 900; font-size: var(--step-1); line-height: 1.2; margin: 4px 0 8px; }
  .intro { margin: 0 0 18px; max-width: 60ch; }
  .velden { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); margin-bottom: 18px; }
  .velden .breed { grid-column: 1 / -1; }
  .veld label { font-size: 0.95rem; }
  .veld input { min-height: 48px; }
  .invoer { position: relative; display: flex; align-items: center; }
  .invoer input { width: 100%; }
  .invoer .voor { position: absolute; left: 14px; color: var(--muted); font-weight: 700; pointer-events: none; }
  .invoer .voor + input { padding-left: 32px; }
  .keuzes { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }
  .keuzes legend { font-weight: 700; font-size: 0.95rem; margin-bottom: 8px; padding: 0; width: 100%; }
  .keuzes label { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border: 1.5px solid var(--line); border-radius: 22px; background: #fff; font-weight: 600; font-size: 0.95rem; line-height: 1.3; cursor: pointer; max-width: 100%; }
  .keuzes input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .keuzes label:has(input:checked) { background: var(--navy); border-color: var(--navy); color: #fff; }
  .keuzes label:has(input[type="checkbox"]:checked)::before { content: ''; flex: none; width: 12px; height: 7px; margin: -3px 10px 0 0; border-left: 2.5px solid currentColor; border-bottom: 2.5px solid currentColor; transform: rotate(-45deg); }
  .keuzes label:has(input:focus-visible) { outline: 3px solid var(--orange); outline-offset: 2px; }
  .uitkomst { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; margin-bottom: 16px; }
  .uitkomst :global(p) { margin: 0 0 10px; }
  .uitkomst :global(p:last-child) { margin-bottom: 0; }
  .uitkomst :global(.leeg) { color: var(--muted); }
  .uitkomst :global(.oordeel) { display: flex; align-items: center; gap: 10px; font-weight: 900; font-size: 1.25rem; line-height: 1.25; }
  .uitkomst :global(.stip) { flex: none; width: 14px; height: 14px; border-radius: 50%; background: var(--ok); }
  .uitkomst :global(.posten) { list-style: none; padding: 0; margin: 12px 0; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
  .uitkomst :global(.posten li) { display: flex; justify-content: space-between; gap: 12px; padding: 9px 14px; margin: 0; border-bottom: 1px solid var(--line); font-size: 0.98rem; }
  .uitkomst :global(.posten li:last-child) { border-bottom: 0; }
  .uitkomst :global(.posten li::marker) { content: none; }
  .uitkomst :global(.posten b) { white-space: nowrap; }
  .uitkomst :global(.posten .som) { font-weight: 800; background: var(--chip); }
  .uitkomst :global(.getallen-rij) { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); margin: 14px 0; }
  .uitkomst :global(.getallen-rij div) { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .uitkomst :global(dt) { font-size: 0.85rem; color: var(--muted); line-height: 1.3; }
  .uitkomst :global(dd) { margin: 4px 0 0; font-size: 1.45rem; font-weight: 900; color: var(--navy); letter-spacing: -0.02em; }
  .acties { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
  .acties .btn { min-height: 48px; text-align: center; }
  .deel { font-size: 1rem; }
  .bron { margin: 0; }
</style>
