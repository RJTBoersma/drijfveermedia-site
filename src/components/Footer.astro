---
// Footer: compact, korte kolommen per pijler (Gevonden, Genoemd, Gekozen), regio en over ons. De complete lijst staat op /sitemap/.
import { site } from '../data/site';
const jaar = new Date().getFullYear();
const kolommen = [
  { kop: 'Gevonden', links: [['SEO', '/zoekmachine-optimalisatie/'], ['Lokale SEO', '/lokale-seo/'], ['Linkbuilding', '/linkbuilding/'], ['Online adverteren', '/online-adverteren/'], ['Google Ads', '/online-adverteren/google-ads-bureau/']] },
  { kop: 'Genoemd', links: [['GEO', '/generative-engine-optimization/'], ['Gratis AI-test', '/generative-engine-optimization/#ai-test'], ['Reviews', '/lokale-seo/reviews/'], ['Social media beheer', '/social-media-beheer/']] },
  { kop: 'Gekozen', links: [['Website laten maken', '/website-laten-maken/'], ['Tekstschrijver', '/tekstschrijver/'], ['Branding', '/branding/'], ['Leadgeneratie', '/leadgeneratie/']] },
  { kop: 'In de regio', links: [['Online marketing Assen', '/online-marketing-assen/'], ['Webdesign Assen', '/webdesign-assen/'], ['SEO Groningen', '/seo-groningen/'], ['SEO Leeuwarden', '/seo-leeuwarden/'], ['SEO Zwolle', '/seo-zwolle/'], ['Alle plaatsen', '/werkgebied/']] },
  { kop: 'Over ons', links: [['Wie we zijn', '/over-ons/'], ['Werkwijze', '/werkwijze/'], ['Garantie', '/garantie/'], ['Ons proeflab', '/proeflab/'], ['Veelgestelde vragen', '/veelgestelde-vragen/'], ['Contact', '/contact/']] },
  { kop: 'Verder', links: [['Prijzen', '/prijzen/'], ['Cases', '/cases/'], ['Kennisbank', '/kennisbank/'], ['Logboek', '/logboek/'], ['Werken bij', '/werken-bij/']] },
];
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="merk">
      <p class="woordmerk">Drijfveer Media<span>.</span></p>
      <p class="slogan">Gevonden. Genoemd. Gekozen.</p>
      <address>
        {site.straat}, {site.postcode} {site.plaats}<br />
        <a href={site.telefoonLink}>{site.telefoon}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
      <p class="profielen"><a href="https://www.linkedin.com/company/2549664/" rel="noopener me" target="_blank">LinkedIn</a><a href={site.kaart} rel="noopener" target="_blank">Google-reviews</a></p>
      <p class="muted klein">{site.belofte}, {site.kantoortijden}.</p>
    </div>
    {kolommen.map((k) => (
      <nav aria-label={k.kop}>
        <p class="kop">{k.kop}</p>
        <ul>{k.links.map(([t, u]) => <li><a href={u}>{t}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="wrap onder">
    <span>© {jaar} {site.naam}{site.rechtsvorm && ` (${site.rechtsvorm})`} · KvK {site.kvk}{site.btwId && ` · btw-id ${site.btwId}`}</span>
    <span class="juridisch"><a href="/algemene-voorwaarden/">Voorwaarden</a><a href="/privacyverklaring/">Privacy</a><a href="/disclaimer/">Disclaimer</a><a href="/sitemap/">Sitemap</a><a href="/en/" lang="en" hreflang="en">In English</a></span>
    <span class="muted">Gemaakt in Assen, tussen de hunebedden en het TT-circuit.</span>
  </div>
</footer>
<style>
  .site-footer { margin-top: 96px; background: var(--navy); color: #dfe7f0; padding-block: 56px calc(96px + env(safe-area-inset-bottom, 0px)); }
  .site-footer a { color: #fff; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .grid { display: grid; grid-template-columns: 1.4fr repeat(6, 1fr); gap: 32px 22px; }
  .woordmerk { font-size: 1.5rem; font-weight: 900; color: #fff; margin: 0; letter-spacing: -0.02em; }
  .woordmerk span { color: var(--orange); }
  .slogan { margin: 2px 0 18px; color: #a9bacb; font-weight: 600; }
  address { font-style: normal; line-height: 1.7; margin-bottom: 10px; }
  .kop { font-weight: 800; color: #fff; margin: 0 0 12px; font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 0.98rem; }
  .klein { font-size: 0.9rem; }
  .profielen { display: flex; gap: 16px; margin: 0 0 10px; font-weight: 700; }
  .muted { color: #a9bacb; }
  .onder { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 28px; justify-content: space-between; border-top: 1px solid rgb(255 255 255 / 0.15); margin-top: 44px; padding-top: 22px; font-size: 0.9rem; }
  .juridisch { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  @media (max-width: 1240px) { .grid { grid-template-columns: repeat(6, 1fr); } .merk { grid-column: 1 / -1; } }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr 1fr; } ul { gap: 0; } ul a, address a { display: inline-block; padding-block: 11px; } }
</style>
