---
// Links naar de plaatspagina's van één dienst (of van alle diensten), zodat ze vanaf de pijler bereikbaar zijn.
import paginas from '../../../scripts/paginas.json';
interface Props { titel?: string; intro?: string; soort?: 'seo' | 'webdesign' | 'online-marketing' | 'alles' }
const { soort = 'alles', titel = 'In jouw regio', intro = 'Ons kantoor staat in Assen. Per plaats lees je wat we daar doen, wat de markt is en wat het kost.' } = Astro.props;
const alle = (paginas as any[]).filter((p) => (p.type === 'plaats' || p.type === 'provincie') && !p.wachtOpInhoud);
const kies = soort === 'alles'
  ? alle.filter((p) => p.type === 'provincie' || /-assen\/$/.test(p.url) || ['/seo-groningen/', '/seo-leeuwarden/', '/seo-zwolle/', '/webdesign-zwolle/', '/online-marketing-groningen/', '/webdesign-emmen/'].includes(p.url))
  : alle.filter((p) => p.url.startsWith(`/${soort}-`));
const lijst = kies.sort((a, b) => (a.type === 'provincie' ? -1 : 0) - (b.type === 'provincie' ? -1 : 0) || a.naam.localeCompare(b.naam, 'nl'));
---
{lijst.length > 0 && (
  <dm-extra><section class="wrap sectie regio-links" aria-labelledby={`regio-${soort}`}>
    <h2 id={`regio-${soort}`}>{titel}</h2>
    <p class="muted">{intro}</p>
    <ul class="chips chips-scroll">
      {lijst.map((p) => <li><a class="chip-link" href={p.url}>{p.naam}</a></li>)}
      <li><a class="chip-link alle" href="/werkgebied/">Hele werkgebied</a></li>
    </ul>
  </section></dm-extra>
)}
<style>
  .regio-links ul { margin-top: 16px; }
  .regio-links .chip-link { min-height: 44px; padding-inline: 16px; }
  .regio-links .alle { font-weight: 800; }
</style>
