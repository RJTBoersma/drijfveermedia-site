---
// Een vervolgstap halverwege een lange pagina: voor wie nu al weet dat hij het liever laat doen.
import { stapVoor } from '../../data/actie';
interface Props { titel?: string; tekst?: string; knop?: { tekst: string; href: string } }
const pad = Astro.url.pathname;
const stap = stapVoor(pad);
const opDienst = stap.dienst && pad.startsWith(stap.dienst.url);
// Per pagina telt hij mee: de eerste tussenactie krijgt de vraag die bij het onderwerp past, de volgende een andere.
const g = globalThis as unknown as { __dmTussen?: Map<string, number> };
g.__dmTussen ??= new Map();
const nr = g.__dmTussen.get(pad) ?? 0;
g.__dmTussen.set(pad, nr + 1);
const reserve = ['Weet je al genoeg?', 'Zelf geen tijd voor?', 'Wil je weten wat dit bij jou oplevert?'];
const {
  titel = opDienst ? reserve[nr % reserve.length] : nr === 0 ? stap.vraag ?? 'Zelf geen tijd voor?' : reserve[(nr - 1) % reserve.length],
  tekst = opDienst || !stap.dienst ? stap.zin : `${stap.dienst.naam}: ${stap.dienst.prijs}. ${stap.zin}`,
  knop = { tekst: stap.knop, href: stap.href },
} = Astro.props;
---
<dm-extra><div class="tussenactie" role="note">
  <img src="/img/team/thorgall-klein.webp" width="56" height="56" alt="" loading="lazy" decoding="async" />
  <div>
    <p class="t"><b>{titel}</b></p>
    <p>{tekst}</p>
  </div>
  <a class="btn" href={knop.href}>{knop.tekst}</a>
</div></dm-extra>
<style>
  .tussenactie { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px 16px; align-items: center; margin: 36px 0; padding: 20px 22px; background: var(--tint); border: 1px solid #ffd9bf; border-radius: var(--radius); }
  .tussenactie img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: top; background: #e8eef4; }
  .tussenactie p { margin: 0; color: var(--ink); line-height: 1.45; }
  .tussenactie .t { margin-bottom: 2px; font-size: 1.08rem; }
  .tussenactie .btn { grid-column: 1 / -1; justify-self: start; white-space: normal; line-height: 1.25; }
  @media (min-width: 700px) { .tussenactie { grid-template-columns: auto minmax(0, 1fr) auto; } .tussenactie .btn { grid-column: auto; } }
</style>
