---
// "In het kort" bovenaan elke plaatspagina: wie, wat, waar en vanaf welke prijs, in feitelijke zinnen.
// Zo kan een zoekmachine of AI-assistent het antwoord in één keer overnemen.
import paginas from '../../../scripts/paginas.json';
import { site } from '../../data/site';
const pad = Astro.url.pathname;
const p = (paginas as any[]).find((x) => x.url === pad);
const slug = pad.replace(/\//g, '');
const dienst = slug.startsWith('seo-') ? 'seo' : slug.startsWith('webdesign-') ? 'webdesign' : 'online-marketing';
const plaatsSlug = slug.replace(/^(seo|webdesign|online-marketing)-/, '');
const plaats = (p?.naam ?? '').replace(/^(SEO|Webdesign|Online marketing)\s+/, '');
// Coördinaten van de plaatsen (centrum), voor de afstand hemelsbreed vanaf ons kantoor
const ligging: Record<string, [number, number]> = {
  emmen: [52.779, 6.907], hoogeveen: [52.723, 6.476], meppel: [52.696, 6.194], groningen: [53.219, 6.567],
  veendam: [53.107, 6.879], stadskanaal: [52.990, 6.950], leeuwarden: [53.201, 5.800], drachten: [53.105, 6.099],
  heerenveen: [52.960, 5.920], sneek: [53.033, 5.659], joure: [52.967, 5.800], zwolle: [52.517, 6.083],
};
const km = (a: [number, number], b: [number, number]) => {
  const r = Math.PI / 180, dLat = (b[0] - a[0]) * r, dLng = (b[1] - a[1]) * r;
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLng / 2) ** 2;
  return Math.round((12742 * Math.asin(Math.sqrt(h))) / 5) * 5;
};
const afstand = ligging[plaatsSlug] ? km([site.geo.lat, site.geo.lng], ligging[plaatsSlug]) : null;
const wat = { seo: `SEO (zoekmachine optimalisatie) voor ondernemers in ${plaats}`, webdesign: `websites laten maken voor ondernemers in ${plaats}`, 'online-marketing': `online marketing voor ondernemers in ${plaats}: SEO, Google Ads, je website en de opvolging van aanvragen` }[dienst];
const prijs = {
  seo: 'SEO vanaf € 495 per maand, lokale SEO vanaf € 295 per maand. Maandelijks opzegbaar, met stijggarantie.',
  webdesign: 'Een website met AI vanaf € 250, maatwerk in WordPress vanaf € 2.000. Je krijgt vooraf een vaste prijs.',
  'online-marketing': 'Alles in één hand vanaf € 595 per maand, losse diensten vanaf € 295 per maand. Maandelijks opzegbaar.',
}[dienst];
const waar = plaatsSlug === 'assen'
  ? `Ons kantoor staat in Assen zelf, aan de ${site.straat}. Je kunt gewoon langskomen.`
  : afstand ? `Vanuit ons kantoor aan de ${site.straat} in Assen, ongeveer ${afstand} km hemelsbreed van ${plaats}. Langskomen kan, en wij komen ook naar jou toe.`
  : `Vanuit ons kantoor aan de ${site.straat} in Assen, midden in het Noorden.`;
---
{p && (
  <dm-extra><div class="kader kader-oranje in-het-kort plaatsfeiten">
    <p class="kader-titel">In het kort</p>
    <ul>
      <li><b>Wat:</b> Drijfveer Media doet {wat}.</li>
      <li><b>Waar:</b>{" "}{waar}</li>
      <li><b>Prijs:</b>{" "}{prijs}</li>
      <li><b>Contact:</b> bel {site.telefoon}. Op werkdagen tussen 8.00 en 17.00 uur bellen we je binnen 15 minuten terug.</li>
    </ul>
  </div></dm-extra>
)}
