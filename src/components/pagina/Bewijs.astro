---
// Het antwoord op "Hoe weet ik dat jullie waarmaken wat jullie zeggen?" (AIDA: desire).
// Twee varianten: maandelijkse diensten (garantie en opzegbaar) en eenmalig werk (vaste prijs vooraf).
// In de kennisbank één korte alinea: wie leest wat een sitemap is, zoekt nog geen garantie.
// De case-strook wisselt per onderwerp, zodat niet op elke pagina hetzelfde cijfer staat.
import Tekening from '../teken/Tekening.astro';
import Veer from '../teken/Veer.astro';
import Plaatje from '../teken/Plaatje.astro';
import { diensten } from '../../data/diensten';
import { stapVoor } from '../../data/actie';
type CaseNaam = 'willemfikstt' | 'willemfikstt-aanvragen' | 'conflictbemiddeling' | 'dakraamconcurrent' | 'dakraamplaza' | 'zoekeenvakantiepark';
// Vorm: 'groot' (vier kaarten en een case, op home, prijzen, garantie en de hoofddiensten), 'strook' (één regel, op de andere
// dienst- en plaatspagina's) of 'geen' (kennisbank: wie leest wat een sitemap is, zoekt nog geen garantie).
interface Props { titel?: string; intro?: string; case?: boolean | CaseNaam; eenmalig?: boolean; kort?: boolean; vorm?: 'groot' | 'strook' | 'geen' }
const pad = Astro.url.pathname;
const groot = ['/', '/prijzen/', '/garantie/'].includes(pad) || diensten.some((d) => d.pillar && d.url === pad);
const dienst = diensten.find((d) => d.url === pad);
const stapDienst = diensten.find((d) => d.url === stapVoor(pad).dienst?.url);
const isEenmalig = (d?: typeof dienst) => !!d && ['eenmalig', 'pagina', 'uur'].includes(d.prijsEenheid ?? '') && !d.maandelijks;
const eenmaligAuto = pad.startsWith('/webdesign-') || isEenmalig(dienst) || (pad.startsWith('/kennisbank/') && isEenmalig(stapDienst));
// Bouw- en ontwerpwerk (website, UX, logo, huisstijl, landingspagina): na de oplevering lossen we kleine fouten gratis op (besluit Robert, 19-10-2026).
const oplevering = /^\/(webdesign-|website-laten-maken\/($|website-met-ai\/|ux-ui-design\/)|branding\/|leadgeneratie\/landingspagina-laten-maken\/)/.test(pad);
// Werk per uur (hack, disavow, interim): een vast uurtarief met een inschatting vooraf, geen 'vaste prijs'. Het consult krijgt eigen tekst.
const perUur = !!dienst && dienst.prijsEenheid === 'uur' && !dienst.maandelijks && dienst.url !== '/consult/';
const consult = pad === '/consult/';
const {
  titel = groot ? 'Hoe weet je dat wij waarmaken wat we zeggen?' : 'Wat je bij ons zeker weet',
  intro,
  case: caseKeuze = true,
  eenmalig = eenmaligAuto,
  kort = false,
  vorm = pad.startsWith('/kennisbank/') ? 'geen' : groot ? 'groot' : 'strook',
} = Astro.props;
const cases: Record<CaseNaam, { href: string; naam: string; getal: string; wat: string; tekst: string; onderwerp: string }> = {
  willemfikstt: { href: '/cases/#willemfikstt', naam: 'Willemfikstt.nl', getal: '+87%', wat: 'bezoekers uit Google', tekst: 'kreeg 87% meer bezoekers uit Google', onderwerp: 'raket' },
  conflictbemiddeling: { href: '/cases/#conflictbemiddeling', naam: 'Conflictbemiddeling.nl', getal: '+47%', wat: 'bezoekers uit Google', tekst: 'kreeg 47% meer bezoekers uit Google, na een nieuwe site, SEO, linkbuilding en Google Ads', onderwerp: 'raket' },
  'willemfikstt-aanvragen': { href: '/cases/#willemfikstt', naam: 'Willemfikstt.nl', getal: '+60%', wat: 'aanvragen via de site', tekst: 'kreeg 60% meer aanvragen via de site', onderwerp: 'raket' },
  dakraamconcurrent: { href: '/cases/#dakraamconcurrent', naam: 'Dakraamconcurrent.nl', getal: '+32%', wat: 'bezoekers uit Google', tekst: 'kreeg 32% meer bezoekers uit Google, na een nieuwe site en linkbuilding', onderwerp: 'raket' },
  dakraamplaza: { href: '/cases/#dakraamplaza', naam: 'Dakraamplaza.nl', getal: '#1', wat: 'op "VELUX dakraam"', tekst: 'begon bij nul en staat nu op 1 voor "VELUX dakraam", met 11.602 zoekwoorden in de top 10 van Google', onderwerp: 'raket' },
  zoekeenvakantiepark: { href: '/cases/#zoekeenvakantiepark', naam: 'ZoekEenVakantiepark.nl', getal: '+575%', wat: 'zoekwoorden in de top 10', tekst: 'kreeg na een nieuwe naam 575% meer zoekwoorden in de top 10, met linkbuilding', onderwerp: 'raket' },
};
const caseAuto: CaseNaam = /^\/leadgeneratie/.test(pad) ? 'willemfikstt-aanvragen' : /^\/(website-laten-maken|webdesign-|online-adverteren|branding)/.test(pad) ? 'conflictbemiddeling' : /^\/linkbuilding/.test(pad) ? 'zoekeenvakantiepark' : /^\/(zoekmachine-optimalisatie|seo-)/.test(pad) ? 'dakraamplaza' : 'willemfikstt';
const gekozenCase = caseKeuze === false ? null : cases[caseKeuze === true ? caseAuto : caseKeuze];
---
{vorm === 'strook' && (
  <section class="wrap sectie bewijs-strook-sectie" data-aida="desire">
    <h2 class="strook-kop">{titel}</h2>
    <ul class="card bewijs-strook">
      {perUur ? <li><b>Vast uurtarief</b><span>{dienst?.prijs.replace(/^consult /, '')}, met vooraf een inschatting</span></li> : eenmalig ? <>
        <li><b>Vaste prijs vooraf</b><span>Binnen twee werkdagen na het eerste gesprek</span></li>
        {oplevering && <li><b>Kleine fouten gratis opgelost</b><span>Ook na de oplevering</span></li>}
      </> : <>
        <li><b><a href="/garantie/">Een doel op papier</a></b><span>Niet gehaald door ons? Een maand gratis</span></li>
        <li><b>Per maand opzegbaar</b><span>Eén maand opzegtermijn</span></li>
      </>}
      <li><b><a href="/proeflab/">Getest in ons proeflab</a></b><span>Meer dan 100 eigen sites</span></li>
      <li><b>Binnen 15 minuten gebeld</b><span>Op werkdagen, 8.00 tot 17.00 uur</span></li>
      {gekozenCase && <li><b><a href={gekozenCase.href}>{gekozenCase.getal} bij {gekozenCase.naam}</a></b><span>{gekozenCase.wat}</span></li>}
    </ul>
  </section>
)}
{vorm === 'groot' && (
<section class="wrap sectie band-donker" data-aida="desire">
  <Veer />
  <h2>{titel}</h2>
  {intro && <p class="sectie-intro">{intro}</p>}
  {kort ? (
    eenmalig ? <p class="bewijs-kort">Laat je het ons doen, dan heb je binnen twee werkdagen na het eerste gesprek een vaste prijs in de offerte, voordat we beginnen.{oplevering && ' Na de oplevering lossen we kleine fouten gratis op.'} Wat we bij jou doen, hebben we eerst op onze eigen sites getest (<a href="/proeflab/">het proeflab</a>), en op werkdagen bellen we je binnen 15 minuten terug.</p> :
    <p class="bewijs-kort">Bij maandelijkse diensten leggen we vooraf een doel vast. Halen we dat niet en ligt het aan ons, dan werken we een maand gratis door (<a href="/garantie/">zo werkt de garantie</a>). Je zegt per maand op, en wat we bij jou doen, hebben we eerst op onze eigen sites getest (<a href="/proeflab/">het proeflab</a>).</p>
  ) : (
    <div class:list={['raster', 'bewijs', { drie: eenmalig }]}>
      {eenmalig ? (
        consult ? <div class="card"><Tekening naam="kalender" /><h3>Vaste prijs vooraf</h3><p>Een uur kost € 85, exclusief btw, en dat weet je vooraf. Word je daarna klant, dan verrekenen we dat uur.</p><a class="meer" href="/prijzen/">Alle prijzen</a></div> :
        <div class="card"><Tekening naam="kalender" /><h3>Vaste prijs vooraf</h3><p>Binnen twee werkdagen na het eerste gesprek weet je wat het kost. Dat bedrag staat in de offerte, voordat we beginnen.{oplevering && ' Na de oplevering lossen we kleine fouten gratis op.'}</p><a class="meer" href="/prijzen/">Alle prijzen</a></div>
      ) : (
        <>
          <div class="card"><Tekening naam="schild" /><h3>Een doel op papier</h3><p>We leggen bij de start een meetbaar doel vast, met een datum. Halen we het niet en ligt het aan ons, dan werk je de maand erna zonder factuur met ons door.</p><a class="meer" href="/garantie/">Zo werkt de garantie</a></div>
          <div class="card"><Tekening naam="kalender" vertraging={150} /><h3>Per maand opzegbaar</h3><p>Eén maand opzegtermijn, per e-mail. Je blijft alleen zolang het iets oplevert. Onze langstlopende klant zit al meer dan vijf jaar bij ons.</p></div>
        </>
      )}
      <div class="card"><Tekening naam="kolf" vertraging={300} /><h3>Getest in ons proeflab</h3><p>Sinds 2011 bouwden we een proeflab op van meer dan 100 eigen websites. Een nieuwe techniek proberen we daar eerst, zodat jouw site geen proefkonijn is.</p><a class="meer" href="/proeflab/">Over het proeflab</a></div>
      <div class="card"><Tekening naam="telefoon" vertraging={450} /><h3>Binnen 15 minuten gebeld</h3><p>Op werkdagen tussen 8.00 en 17.00 uur. Thorgall vraagt eerst wat je wilt bereiken. Over geld praat je pas als jij dat wilt.</p></div>
    </div>
  )}
  {gekozenCase && !kort && (
    <div class="card case-strook kaart-link">
      <div class="mini" aria-hidden="true"><Plaatje href={gekozenCase.href} onderwerp={gekozenCase.onderwerp} overgang={false} /></div>
      <span class="getal">{gekozenCase.getal}</span>
      <span class="wat"><a href={gekozenCase.href}><b>{gekozenCase.naam}</b>{' '}{gekozenCase.tekst}</a>{gekozenCase.getal === '+87%' && ', en 60% meer aanvragen via de site'}.</span>
      <span class="meer" aria-hidden="true">Bekijk de resultaten</span>
    </div>
  )}
</section>
)}
<style>
  .bewijs-strook-sectie { padding-block: 24px; }
  .strook-kop { font-size: var(--step-1); margin-bottom: 12px; }
  .bewijs-strook { list-style: none; margin: 0; padding: 16px 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px 24px; }
  .bewijs-strook li { display: grid; gap: 2px; margin: 0; }
  .bewijs-strook b { color: var(--navy); }
  .bewijs-strook span { color: var(--muted); font-size: 0.95rem; }
  .bewijs :global(.tekening) { margin-bottom: 4px; }
  @media (min-width: 900px) { .bewijs.drie { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bewijs-kort { max-width: 68ch; }
  .case-strook { margin-top: 16px; padding: 20px 24px; display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; gap: 8px 24px; align-items: center; }
  .case-strook .mini { width: 150px; }
  .case-strook .mini :global(.plaatje) { margin: 0; }
  .case-strook .getal { font-size: var(--step-2); font-weight: 900; color: var(--orange-tekst); letter-spacing: -0.03em; }
  .case-strook .meer { font-weight: 800; color: var(--navy); }
  @media (max-width: 640px) { .case-strook { grid-template-columns: minmax(0, 1fr); } }
</style>
