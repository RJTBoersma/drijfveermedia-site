---
// Formulier dat naar /api/aanvraag.php post (PHP-mail op Vimexx). Met honeypot en tijdcontrole tegen spam.
interface Props { soort: string; knop?: string; vak?: boolean; website?: boolean; bericht?: boolean; bron?: string; moment?: boolean; vakVerplicht?: boolean }
const { soort, knop = 'Verstuur', vak = false, website = false, bericht = true, bron, moment = false } = Astro.props;
const id = soort.toLowerCase().replace(/[^a-z]+/g, '-');
---
<form class="formulier card aanvraag" method="post" action="/api/aanvraag.php" data-aanvraag>
  <input type="hidden" name="soort" value={soort} />
  <input type="hidden" name="pagina" value={Astro.url.pathname} />
  <input type="hidden" name="t" value="" data-t />
  {bron && <input type="hidden" name="bron" value={bron} />}
  <div class="honing" aria-hidden="true"><label for={`${id}-extra`}>Laat dit veld leeg</label><input id={`${id}-extra`} name="hp_veld_x" type="text" tabindex="-1" autocomplete="new-password" /></div>
  {website && <div class="veld"><label for={`${id}-website`}>Je website</label><input id={`${id}-website`} name="website" type="text" inputmode="url" autocomplete="url" placeholder="jouwbedrijf.nl" required /></div>}
  <div class="veld-rij">
    <div class="veld"><label for={`${id}-naam`}>Je naam</label><input id={`${id}-naam`} name="naam" autocomplete="name" required /></div>
    <div class="veld"><label for={`${id}-tel`}>Telefoonnummer</label><input id={`${id}-tel`} name="telefoon" type="tel" autocomplete="tel" required /></div>
  </div>
  <div class="veld"><label for={`${id}-mail`}>E-mailadres <span class="muted">(mag leeg)</span></label><input id={`${id}-mail`} name="email" type="email" autocomplete="email" /></div>
  {bericht && <div class="veld"><label for={`${id}-bericht`}>Je vraag <span class="muted">(mag leeg)</span></label><textarea id={`${id}-bericht`} name="bericht" data-vul="vraag"></textarea></div>}
  {vak && (
    <details class="meer-velden" data-meer>
      <summary>Vertel er iets meer bij <span class="muted">(mag leeg)</span></summary>
      <div class="veld-rij">
        <div class="veld"><label for={`${id}-vak`}>Wat doe je?</label><input id={`${id}-vak`} name="vak" placeholder="Bijvoorbeeld: loodgieter" data-vul="vak" /></div>
        <div class="veld"><label for={`${id}-plaats`}>Waar zit je?</label><input id={`${id}-plaats`} name="plaats" placeholder="Bijvoorbeeld: Emmen" autocomplete="address-level2" data-vul="plaats" /></div>
      </div>
    </details>
  )}
  {moment && (
    <div class="veld"><label for={`${id}-moment`}>Wanneer schikt het?</label>
      <select id={`${id}-moment`} name="moment">
        <option>Zo snel mogelijk</option>
        <option>Vandaag na 12.00 uur</option>
        <option>Morgenochtend</option>
        <option>Morgenmiddag</option>
      </select>
    </div>
  )}
  <button class="btn" type="submit">{knop}</button>
  <p class="muted klein">We gebruiken je gegevens alleen om je terug te bellen. Lees de <a href="/privacyverklaring/">privacyverklaring</a>.</p>
</form>
<script>
  document.querySelectorAll<HTMLInputElement>('[data-t]').forEach((i) => (i.value = String(Date.now())));
  // Vak, plaats en vraag overnemen uit de link (?vak=...&plaats=...&vraag=...), bijvoorbeeld vanuit een rekenhulp
  const q = new URLSearchParams(location.search);
  document.querySelectorAll<HTMLInputElement>('[data-vul]').forEach((i) => { const v = q.get(i.dataset.vul!); if (v) { i.value = v.slice(0, i.tagName === 'TEXTAREA' ? 400 : 80); const d = i.closest('details'); if (d) d.open = true; } });
</script>
<style>
  .aanvraag { padding: 26px; }
  .aanvraag .btn { justify-self: start; }
  .aanvraag p { margin: 0; }
  .meer-velden summary { cursor: pointer; font-weight: 700; padding: 8px 0; min-height: 44px; display: flex; align-items: center; gap: 6px; }
  .meer-velden[open] summary { margin-bottom: 8px; }
</style>
