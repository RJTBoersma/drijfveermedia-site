---
// Prijs van een dienst, met wat erbij zit.
// De knop volgt de vervolgstap van de pagina (actie.ts). Opzegbaar en garantie alleen bij een maandbedrag.
import { knopVoor } from '../../data/actie';
interface Props { naam: string; prijs: string; eenheid?: string; punten: string[]; noot?: string; eenmalig?: boolean; knop?: { tekst: string; href: string } }
const { naam, prijs, eenheid, punten, noot, eenmalig = false, knop: eigenKnop } = Astro.props;
const knop = knopVoor(Astro.url.pathname, eigenKnop);
const perMaand = !eenmalig && /maand|p\/m/.test(`${eenheid ?? ''} ${prijs}`);
---
<div class="card prijskaart">
  <p class="kicker">{naam}</p>
  <p class="bedrag"><span>vanaf</span> {prijs}{eenheid && <small> {eenheid}</small>}</p>
  <p class="muted klein">{eenmalig ? 'Eenmalig, exclusief btw.' : perMaand ? 'Exclusief btw. Per maand opzegbaar, met een doel op papier.' : 'Exclusief btw.'}</p>
  <ul class="vink">{punten.map((p) => <li>{p}</li>)}</ul>
  <a class="btn" href={knop.href}>{knop.tekst}</a>
  {noot && <p class="muted klein noot">{noot}</p>}
</div>
<style>
  .prijskaart { padding: 24px; }
  .bedrag { font-size: var(--step-3); font-weight: 900; letter-spacing: -0.03em; line-height: 1; margin: 8px 0 6px; }
  .bedrag span { font-size: 1rem; font-weight: 600; color: var(--muted); letter-spacing: 0; }
  .bedrag small { font-size: 1rem; font-weight: 600; letter-spacing: 0; }
  .vink { margin-top: 18px; }
  .btn { width: 100%; }
  .noot { margin: 12px 0 0; }
</style>
