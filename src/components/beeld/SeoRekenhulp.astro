---
// Rekenhulp: een indicatie van het SEO-budget op basis van drie vragen.
// Rekent met onze eigen vanaf-prijzen: lokale SEO € 295, SEO € 495 per maand.
---
<figure class="reken card" aria-label="Rekenhulp SEO-kosten">
  <p class="kicker">Rekenhulp</p>
  <p class="titel">Wat kost SEO voor jouw bedrijf?</p>
  <form class="vragen" data-reken>
    <fieldset>
      <legend>Waar zitten je klanten?</legend>
      <label><input type="radio" name="gebied" value="lokaal" checked /> In mijn regio</label>
      <label><input type="radio" name="gebied" value="landelijk" /> In heel Nederland</label>
    </fieldset>
    <fieldset>
      <legend>Hoeveel concurrentie heb je in Google?</legend>
      <label><input type="radio" name="conc" value="1" checked /> Weinig</label>
      <label><input type="radio" name="conc" value="1.4" /> Gemiddeld</label>
      <label><input type="radio" name="conc" value="2" /> Veel</label>
    </fieldset>
    <fieldset>
      <legend>Voor hoeveel diensten wil je gevonden worden?</legend>
      <label><input type="radio" name="diensten" value="1" checked /> 1 tot 3</label>
      <label><input type="radio" name="diensten" value="1.3" /> 4 tot 10</label>
      <label><input type="radio" name="diensten" value="1.7" /> Meer dan 10</label>
    </fieldset>
  </form>
  <div class="uitkomst" aria-live="polite">
    <span>Indicatie bij Drijfveer Media</span>
    <b data-bedrag>€ 295</b>
    <span>per maand, excl. btw</span>
  </div>
  <figcaption class="klein muted">Een eerste indicatie. Na de gratis scan hoor je de precieze prijs.</figcaption>
</figure>
<script>
  const f = document.querySelector<HTMLFormElement>('[data-reken]');
  const uit = document.querySelector<HTMLElement>('[data-bedrag]');
  function reken() {
    if (!f || !uit) return;
    const d = new FormData(f);
    const basis = d.get('gebied') === 'landelijk' ? 495 : 295;
    const bedrag = basis * Number(d.get('conc')) * Number(d.get('diensten'));
    const afgerond = Math.round(bedrag / 5) * 5;
    uit.textContent = '€ ' + afgerond.toLocaleString('nl-NL');
  }
  f?.addEventListener('change', reken);
  reken();
</script>
<style>
  .reken { margin: 0; padding: 24px; box-shadow: 0 24px 60px -30px rgb(7 70 99 / 0.45); }
  .titel { font-weight: 900; font-size: 1.35rem; margin: 6px 0 14px; line-height: 1.2; }
  fieldset { border: 0; padding: 0; margin: 0 0 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  legend { font-weight: 700; font-size: 0.95rem; margin-bottom: 8px; width: 100%; }
  label { cursor: pointer; }
  label input { position: absolute; opacity: 0; pointer-events: none; }
  label { display: inline-block; padding: 7px 14px; border: 1.5px solid var(--line); border-radius: 999px; font-size: 0.92rem; font-weight: 600; background: #fff; transition: all 0.15s; }
  label:has(input:checked) { background: var(--navy); border-color: var(--navy); color: #fff; }
  label:has(input:focus-visible) { outline: 3px solid var(--orange); outline-offset: 2px; }
  .uitkomst { margin-top: 6px; padding: 16px 18px; border-radius: 12px; background: var(--tint); display: grid; gap: 2px; }
  .uitkomst span { font-size: 0.9rem; color: var(--muted); }
  .uitkomst b { font-size: var(--step-3); font-weight: 900; letter-spacing: -0.03em; line-height: 1.05; }
  figcaption { margin-top: 10px; }
</style>
