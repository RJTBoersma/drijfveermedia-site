---
// Getekend AI-gesprek: een vraag, en een antwoord dat zich woord voor woord opbouwt.
// Het merk in het antwoord krijgt een oranje markering. Zonder JavaScript of met
// "minder beweging" staat het hele antwoord er meteen.
interface Props { vraag: string; antwoord: string; merk: string; bronnen?: string[]; label?: string }
const { vraag, antwoord, merk, bronnen = [], label = 'Voorbeeld van een AI-antwoord' } = Astro.props;
const delen = antwoord.split(merk);
---
<figure class="ai card" aria-label={label}>
  <div class="balk"><span></span><span></span><span></span><b>AI-assistent</b></div>
  <div class="gesprek">
    <p class="vraag">{vraag}</p>
    <div class="antwoord">
      <span class="bot" aria-hidden="true">✦</span>
      <p data-typ>
        {delen.map((d, i) => (<>{d}{i < delen.length - 1 && <mark>{merk}</mark>}</>))}
      </p>
    </div>
    {bronnen.length > 0 && (
      <ul class="bronnen" aria-label="Bronnen">
        {bronnen.map((b, i) => <li class:list={{ eigen: i === 0 }}>{b}</li>)}
      </ul>
    )}
  </div>
  <figcaption class="klein muted">{label}</figcaption>
</figure>
<script>
  const el = document.querySelector<HTMLElement>('[data-typ]');
  const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !rustig && 'IntersectionObserver' in window) {
    // Verberg woorden en laat ze een voor een verschijnen zodra het blok in beeld komt.
    const loop = (n: Node) => {
      if (n.nodeType === 3) {
        const frag = document.createDocumentFragment();
        (n.textContent ?? '').split(/(\s+)/).forEach((w) => {
          if (!w) return;
          if (/^\s+$/.test(w)) frag.append(w);
          else { const s = document.createElement('span'); s.className = 'w'; s.textContent = w; frag.append(s); }
        });
        n.parentNode?.replaceChild(frag, n);
      } else [...n.childNodes].forEach(loop);
    };
    [...el.childNodes].forEach(loop);
    const woorden = [...el.querySelectorAll<HTMLElement>('.w, mark')];
    woorden.forEach((w) => w.classList.add('weg'));
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      woorden.forEach((w, i) => setTimeout(() => w.classList.remove('weg'), 120 + i * 55));
    }, { threshold: 0.4 });
    io.observe(el);
  }
</script>
<style>
  .ai { margin: 0; overflow: hidden; box-shadow: 0 24px 60px -30px rgb(7 70 99 / 0.45); }
  .balk { display: flex; align-items: center; gap: 6px; padding: 12px 16px; border-bottom: 1px solid var(--line); background: #fbfcfd; }
  .balk span { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .balk b { margin-left: 10px; font-size: 0.85rem; color: var(--muted); font-weight: 700; }
  .gesprek { padding: 20px; display: grid; gap: 16px; }
  .vraag { justify-self: end; max-width: 85%; margin: 0; background: var(--navy); color: #fff; padding: 12px 16px; border-radius: 16px 16px 4px 16px; font-size: 1rem; }
  .antwoord { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; }
  .bot { width: 28px; height: 28px; border-radius: 50%; background: var(--chip); display: grid; place-items: center; color: var(--navy); font-size: 0.9rem; }
  .antwoord p { margin: 0; font-size: 1rem; line-height: 1.55; }
  mark { background: #ffe2cc; color: var(--ink); font-weight: 800; padding: 0 3px; border-radius: 4px; transition: background 0.4s; }
  :global(.w) { transition: opacity 0.25s; }
  :global(.weg) { opacity: 0; }
  .bronnen { list-style: none; padding: 0 0 0 38px; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .bronnen li { font-size: 0.8rem; padding: 3px 10px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); color: var(--muted); }
  .bronnen li.eigen { border-color: var(--orange); color: var(--ink); font-weight: 700; }
  figcaption { padding: 0 20px 14px; }
</style>
