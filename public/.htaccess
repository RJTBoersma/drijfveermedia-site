# Drijfveer Media, Apache-instellingen (Vimexx). Gegenereerd door scripts/redirects.py; pas scripts/htaccess-basis.txt aan, niet dit bestand.
Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

RewriteEngine On
# Altijd https en www, in één stap
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.drijfveermedia.nl/$1 [L,R=301]
# Mappen altijd met slash aan het eind
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-z0-9]{2,5}|/)$ [NC]
RewriteRule ^(.*)$ https://www.drijfveermedia.nl/$1/ [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(css|js|woff2|svg|webp|png|jpg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>

# Oude URL's van de vorige site (één stap, geen ketens)
