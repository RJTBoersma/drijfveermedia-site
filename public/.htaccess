# Drijfveer Media, Apache-instellingen (Vimexx). Gegenereerd door scripts/redirects.py; pas scripts/htaccess-basis.txt aan, niet dit bestand.
Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

RewriteEngine On
# Korte link voor klanten om een Google-review te schrijven: drijfveermedia.nl/review
RewriteRule ^review/?$ https://search.google.com/local/writereview?placeid=ChIJ3WI9wErNyUcR-qmlID9Y-YA [R=302,L,NE]
